# QT3 test case K2-StringLT-1 of test set op-string-less-than, which tests the XPath expression
#   "" lt "𑅰"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/string-less-than.xml#L52
ASK {
  BIND(( "" < "𑅰" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
