# QT3 test case K-StringLT-1 of test set op-string-less-than, which tests the XPath expression
#   'a' lt 'abc'
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/string-less-than.xml#L7
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "a" < "abc" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
