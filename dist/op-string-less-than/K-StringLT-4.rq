# QT3 test case K-StringLT-4 of test set op-string-less-than, which tests the XPath expression
#   not('abc' le 'a')
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/string-less-than.xml#L34
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( "abc" <= "a" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
