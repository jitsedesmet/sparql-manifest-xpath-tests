# QT3 test case K-SubstringBeforeFunc-10 of test set fn-substring-before, which tests the XPath expression
#   substring-before("a string", "not in other") eq ""
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring-before.xml#L578
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( STRBEFORE( "a string" , "not in other" ) = "" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
