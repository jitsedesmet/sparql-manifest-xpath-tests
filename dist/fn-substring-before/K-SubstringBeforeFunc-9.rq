# QT3 test case K-SubstringBeforeFunc-9 of test set fn-substring-before, which tests the XPath expression
#   substring-before("a string", "") eq ""
ASK {
  BIND(( STRBEFORE( "a string" , "" ) = "" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
