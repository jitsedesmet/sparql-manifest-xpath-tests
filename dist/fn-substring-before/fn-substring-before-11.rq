# QT3 test case fn-substring-before-11 of test set fn-substring-before, which tests the XPath expression
#   fn:not(fn:substring-before("A","A"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring-before.xml#L124
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! STRBEFORE( "A" , "A" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
