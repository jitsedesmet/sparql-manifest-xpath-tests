# QT3 test case fn-substring-before-25 of test set fn-substring-before, which tests the XPath expression
#   substring-before("𐀁𐀂𐀃", "𐀂")
# Expecting:
#   <assert-eq>"𐀁"</assert-eq>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring-before.xml#L287
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(STRBEFORE( "𐀁𐀂𐀃" , "𐀂" ) AS ?result)
  FILTER(SAMETERM( ?result , "𐀁" ))
}
