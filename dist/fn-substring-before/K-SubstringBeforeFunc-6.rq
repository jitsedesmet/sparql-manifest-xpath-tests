# QT3 test case K-SubstringBeforeFunc-6 of test set fn-substring-before, which tests the XPath expression
#   substring-before("tattoo", "attoo") eq "t"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring-before.xml#L542
ASK {
  BIND(( STRBEFORE( "tattoo" , "attoo" ) = "t" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
