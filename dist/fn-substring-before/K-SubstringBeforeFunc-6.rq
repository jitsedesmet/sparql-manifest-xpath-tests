# QT3 test case K-SubstringBeforeFunc-6 of test set fn-substring-before, which tests the XPath expression
#   substring-before("tattoo", "attoo") eq "t"
ASK {
  BIND(( STRBEFORE( "tattoo" , "attoo" ) = "t" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
