# QT3 test case xs-float-002 of test set xs-float, which tests the XPath expression
#   1 div xs:float("-0") ne 1 div xs:float("0")
ASK {
  BIND(( ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> / <http://www.w3.org/2001/XMLSchema#float> ( "-0" ) ) != ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> / <http://www.w3.org/2001/XMLSchema#float> ( "0" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
