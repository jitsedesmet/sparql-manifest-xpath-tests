# QT3 test case xs-float-001 of test set xs-float, which tests the XPath expression
#   fn:string(xs:float("-0"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/xs/float.xml#L7
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#float> ( "-0" ) ) AS ?result)
  FILTER(( ?result = <http://www.w3.org/2001/XMLSchema#string> ( "-0" ) ))
}
