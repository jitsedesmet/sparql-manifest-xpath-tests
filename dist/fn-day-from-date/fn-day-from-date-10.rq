# QT3 test case fn-day-from-date-10 of test set fn-day-from-date, which tests the XPath expression
#   fn:day-from-date(xs:date("1970-01-03Z")) * fn:day-from-date(xs:date("0002-01-01Z"))
ASK {
  BIND(( DAY( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-03Z" ) ) * DAY( <http://www.w3.org/2001/XMLSchema#date> ( "0002-01-01Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "3" ))
}
