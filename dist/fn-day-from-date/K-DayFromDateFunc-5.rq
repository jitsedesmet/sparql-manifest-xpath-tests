# QT3 test case K-DayFromDateFunc-5 of test set fn-day-from-date, which tests the XPath expression
#   day-from-date(xs:date("2000-02-03")) eq 3
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/day-from-date.xml#L241
# The test needs the constructor function xsd:date, DAY on xsd:date, which SPARQL does not define
ASK {
  BIND(( DAY( <http://www.w3.org/2001/XMLSchema#date> ( "2000-02-03" ) ) = "3"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
