# QT3 test case fn-day-from-date1args-3 of test set fn-day-from-date, which tests the XPath expression
#   fn:day-from-date(xs:date("2030-12-31Z"))
ASK {
  BIND(DAY( <http://www.w3.org/2001/XMLSchema#date> ( "2030-12-31Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "31" ))
}
