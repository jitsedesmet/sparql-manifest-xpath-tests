# QT3 test case fn-day-from-date-19 of test set fn-day-from-date, which tests the XPath expression
#   fn:day-from-date(xs:date("1970-01-03Z")) ge fn:day-from-date(xs:date("1970-01-01Z"))
ASK {
  BIND(( DAY( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-03Z" ) ) >= DAY( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
