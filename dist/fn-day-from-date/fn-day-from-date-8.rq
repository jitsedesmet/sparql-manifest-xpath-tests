# QT3 test case fn-day-from-date-8 of test set fn-day-from-date, which tests the XPath expression
#   fn:day-from-date(xs:date("1970-01-01Z")) + fn:day-from-date(xs:date("1970-01-01Z"))
ASK {
  BIND(( DAY( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) ) + DAY( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2" ))
}
