# QT3 test case fn-day-from-date-17 of test set fn-day-from-date, which tests the XPath expression
#   fn:month-from-date(xs:date("1970-01-01Z")) ne fn:month-from-date(xs:date("1970-01-03Z"))
ASK {
  BIND(( MONTH( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) ) != MONTH( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-03Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
