# QT3 test case fn-day-from-date-4 of test set fn-day-from-date, which tests the XPath expression
#   fn:day-from-date(xs:date("1999-12-31Z")) le fn:day-from-date(xs:date("1999-12-31Z"))
ASK {
  BIND(( DAY( <http://www.w3.org/2001/XMLSchema#date> ( "1999-12-31Z" ) ) <= DAY( <http://www.w3.org/2001/XMLSchema#date> ( "1999-12-31Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
