# QT3 test case fn-day-from-date-3 of test set fn-day-from-date, which tests the XPath expression
#   fn:day-from-date(xs:date("1999-12-31Z")) lt fn:day-from-date(xs:date("1999-12-31Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/day-from-date.xml#L52
# The test needs the constructor function xsd:date, DAY on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( DAY( xsd:date ( "1999-12-31Z" ) ) < DAY( xsd:date ( "1999-12-31Z" ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
