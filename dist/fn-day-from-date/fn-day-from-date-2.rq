# QT3 test case fn-day-from-date-2 of test set fn-day-from-date, which tests the XPath expression
#   fn:day-from-date(xs:date("2000-01-01+05:00"))
ASK {
  BIND(DAY( <http://www.w3.org/2001/XMLSchema#date> ( "2000-01-01+05:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1" ))
}
