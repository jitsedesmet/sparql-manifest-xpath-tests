# QT3 test case fn-day-from-date-11 of test set fn-day-from-date, which tests the XPath expression
#   fn:day-from-date(xs:date("1970-01-02Z")) div fn:day-from-date(xs:date("1970-01-01Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/day-from-date.xml#L124
ASK {
  BIND(( DAY( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-02Z" ) ) / DAY( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2" ))
}
