# QT3 test case fn-day-from-date-1 of test set fn-day-from-date, which tests the XPath expression
#   fn:day-from-date(xs:date("1999-05-31-05:00"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/day-from-date.xml#L34
ASK {
  BIND(DAY( <http://www.w3.org/2001/XMLSchema#date> ( "1999-05-31-05:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "31" ))
}
