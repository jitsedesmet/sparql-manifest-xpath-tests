# QT3 test case op-dateTime-less-than-13 of test set op-dateTime-less-than, which tests the XPath expression
#   (xs:dateTime("1981-04-02T12:00:00Z") lt xs:dateTime("2003-04-02T12:10:00Z")) or (fn:false())
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1981-04-02T12:00:00Z" ) < <http://www.w3.org/2001/XMLSchema#dateTime> ( "2003-04-02T12:10:00Z" ) ) || "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
