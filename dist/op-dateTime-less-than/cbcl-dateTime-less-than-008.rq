# QT3 test case cbcl-dateTime-less-than-008 of test set op-dateTime-less-than, which tests the XPath expression
#   xs:dateTime("2008-01-31T00:01:00+09:00") le xs:dateTime("2008-01-30T00:01:00")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dateTime-less-than.xml#L548
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:dateTime ( "2008-01-31T00:01:00+09:00" ) <= xsd:dateTime ( "2008-01-30T00:01:00" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
