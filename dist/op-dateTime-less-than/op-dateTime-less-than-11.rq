# QT3 test case op-dateTime-less-than-11 of test set op-dateTime-less-than, which tests the XPath expression
#   (xs:dateTime("1990-04-02T12:00:10Z") lt xs:dateTime("2006-06-02T12:10:00Z")) or (fn:true())
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dateTime-less-than.xml#L314
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1990-04-02T12:00:10Z" ) < <http://www.w3.org/2001/XMLSchema#dateTime> ( "2006-06-02T12:10:00Z" ) ) || "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
