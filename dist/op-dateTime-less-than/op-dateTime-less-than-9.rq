# QT3 test case op-dateTime-less-than-9 of test set op-dateTime-less-than, which tests the XPath expression
#   (xs:dateTime("2002-06-02T12:00:10Z") lt xs:dateTime("2000-04-04T12:00:00Z")) or (xs:dateTime("2002-04-02T13:00:10Z") lt xs:dateTime("2001-04-02T10:00:00Z"))
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dateTime-less-than.xml#L282
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:dateTime ( "2002-06-02T12:00:10Z" ) < xsd:dateTime ( "2000-04-04T12:00:00Z" ) ) || ( xsd:dateTime ( "2002-04-02T13:00:10Z" ) < xsd:dateTime ( "2001-04-02T10:00:00Z" ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
