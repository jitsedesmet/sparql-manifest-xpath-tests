# QT3 test case op-dateTime-less-than-12 of test set op-dateTime-less-than, which tests the XPath expression
#   (xs:dateTime("1970-04-02T12:00:20Z") le xs:dateTime("1980-04-02T12:00:20Z")) or (fn:true())
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-04-02T12:00:20Z" ) <= <http://www.w3.org/2001/XMLSchema#dateTime> ( "1980-04-02T12:00:20Z" ) ) || "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
