# QT3 test case K-DateTimeLT-2 of test set op-dateTime-less-than, which tests the XPath expression
#   not(xs:dateTime("2004-07-13T23:01:04.12") lt xs:dateTime("2004-07-12T23:01:04.12"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2004-07-13T23:01:04.12" ) < <http://www.w3.org/2001/XMLSchema#dateTime> ( "2004-07-12T23:01:04.12" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
