# QT3 test case op-dateTime-less-than-14 of test set op-dateTime-less-than, which tests the XPath expression
#   (xs:dateTime("1976-04-03T12:00:00Z") le xs:dateTime("2002-07-02T12:00:30Z")) or (fn:false())
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dateTime-less-than.xml#L362
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1976-04-03T12:00:00Z" ) <= <http://www.w3.org/2001/XMLSchema#dateTime> ( "2002-07-02T12:00:30Z" ) ) || "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
