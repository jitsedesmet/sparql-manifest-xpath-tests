# QT3 test case op-dateTime-less-than-8 of test set op-dateTime-less-than, which tests the XPath expression
#   (xs:dateTime("2002-04-02T12:00:00Z") le xs:dateTime("2005-04-02T12:00:20Z")) and (xs:dateTime("2002-04-02T12:10:00Z") le xs:dateTime("2002-04-03T12:00:00Z"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dateTime-less-than.xml#L266
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:dateTime ( "2002-04-02T12:00:00Z" ) <= xsd:dateTime ( "2005-04-02T12:00:20Z" ) ) && ( xsd:dateTime ( "2002-04-02T12:10:00Z" ) <= xsd:dateTime ( "2002-04-03T12:00:00Z" ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
