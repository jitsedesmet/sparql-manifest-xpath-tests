# QT3 test case op-dateTime-less-than-10 of test set op-dateTime-less-than, which tests the XPath expression
#   (xs:dateTime("2002-04-03T12:00:10Z") le xs:dateTime("1990-04-02T12:10:00Z")) or (xs:dateTime("1975-04-03T12:10:00Z") le xs:dateTime("2000-02-02T12:00:09Z"))
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2002-04-03T12:00:10Z" ) <= <http://www.w3.org/2001/XMLSchema#dateTime> ( "1990-04-02T12:10:00Z" ) ) || ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1975-04-03T12:10:00Z" ) <= <http://www.w3.org/2001/XMLSchema#dateTime> ( "2000-02-02T12:00:09Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
