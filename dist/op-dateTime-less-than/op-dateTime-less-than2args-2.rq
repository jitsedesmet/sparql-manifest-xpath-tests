# QT3 test case op-dateTime-less-than2args-2 of test set op-dateTime-less-than, which tests the XPath expression
#   xs:dateTime("1996-04-07T01:40:52Z") lt xs:dateTime("1970-01-01T00:00:00Z")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dateTime-less-than.xml#L24
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:dateTime ( "1996-04-07T01:40:52Z" ) < xsd:dateTime ( "1970-01-01T00:00:00Z" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
