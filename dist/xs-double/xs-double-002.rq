# QT3 test case xs-double-002 of test set xs-double, which tests the XPath expression
#   1 div xs:double("-0") ne 1 div xs:double("0")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/xs/double.xml#L17
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( "1"^^xsd:integer / xsd:double ( "-0" ) ) != ( "1"^^xsd:integer / xsd:double ( "0" ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
