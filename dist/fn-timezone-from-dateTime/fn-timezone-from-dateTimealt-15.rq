# QT3 test case fn-timezone-from-dateTimealt-15 of test set fn-timezone-from-dateTime, which tests the XPath expression
#   fn:string(fn:timezone-from-dateTime(xs:dateTime("1970-01-01T10:00:00Z"))) and fn:string(fn:timezone-from-dateTime(xs:dateTime("1970-01-01T10:00:00Z")))
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( TIMEZONE( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T10:00:00Z" ) ) ) && <http://www.w3.org/2001/XMLSchema#string> ( TIMEZONE( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T10:00:00Z" ) ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
