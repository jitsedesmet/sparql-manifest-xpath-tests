# QT3 test case fn-timezone-from-dateTimealt-9 of test set fn-timezone-from-dateTime, which tests the XPath expression
#   fn:timezone-from-dateTime(xs:dateTime("1970-01-01T00:00:00+04:00")) - fn:timezone-from-dateTime(xs:dateTime("1970-01-01T10:00:00+02:00"))
# Expecting:
#   <assert-string-value>PT2H</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/timezone-from-dateTime.xml#L80
# The test needs - on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( TIMEZONE( xsd:dateTime ( "1970-01-01T00:00:00+04:00" ) ) - TIMEZONE( xsd:dateTime ( "1970-01-01T10:00:00+02:00" ) ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "PT2H" ))
}
