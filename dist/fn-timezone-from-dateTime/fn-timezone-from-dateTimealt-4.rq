# QT3 test case fn-timezone-from-dateTimealt-4 of test set fn-timezone-from-dateTime, which tests the XPath expression
#   fn:timezone-from-dateTime(xs:dateTime("1999-12-31T12:00:00+02:00")) le fn:timezone-from-dateTime(xs:dateTime("1999-12-30T12:00:00+03:00"))
ASK {
  BIND(( TIMEZONE( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-12-31T12:00:00+02:00" ) ) <= TIMEZONE( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-12-30T12:00:00+03:00" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
