# QT3 test case K-TimezoneFromDateTimeFunc-6 of test set fn-timezone-from-dateTime, which tests the XPath expression
#   timezone-from-dateTime(xs:dateTime("2004-10-12T23:43:12-08:23")) eq xs:dayTimeDuration("-PT8H23M")
ASK {
  BIND(( TIMEZONE( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2004-10-12T23:43:12-08:23" ) ) = <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "-PT8H23M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
