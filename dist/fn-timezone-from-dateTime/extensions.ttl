<#fn-timezone-from-dateTimealt-1> a mf:QueryEvaluationTest ;
  mf:name "fn-timezone-from-dateTimealt-1" ;
  rdfs:comment "Evaluates The \"timezone-from-dateTime\" function As per example 1 (for this function) of the F&O specs" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/timezone-from-dateTime.xml#L8> ;
  mf:action [ qt:query <fn-timezone-from-dateTimealt-1.rq> ] ;
  mf:result <../true.srj> .

<#fn-timezone-from-dateTimealt-2> a mf:QueryEvaluationTest ;
  mf:name "fn-timezone-from-dateTimealt-2" ;
  rdfs:comment "Evaluates The \"timezone-from-dateTime\" function As per example 2 (for this function) of the F&O specs." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/timezone-from-dateTime.xml#L17> ;
  mf:action [ qt:query <fn-timezone-from-dateTimealt-2.rq> ] ;
  mf:result <../true.srj> .

<#fn-timezone-from-dateTimealt-4> a mf:QueryEvaluationTest ;
  mf:name "fn-timezone-from-dateTimealt-4" ;
  rdfs:comment "Evaluates The \"timezone-from-dateTime\" function uses as part of a numeric-less-than expression (le operator)." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/timezone-from-dateTime.xml#L35> ;
  mf:action [ qt:query <fn-timezone-from-dateTimealt-4.rq> ] ;
  mf:result <../true.srj> .

<#fn-timezone-from-dateTimealt-6> a mf:QueryEvaluationTest ;
  mf:name "fn-timezone-from-dateTimealt-6" ;
  rdfs:comment "Evaluates The \"timezone-from-dateTime\" function that returns dayTimeDuration of 0." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/timezone-from-dateTime.xml#L53> ;
  mf:action [ qt:query <fn-timezone-from-dateTimealt-6.rq> ] ;
  mf:result <../true.srj> .

<#fn-timezone-from-dateTimealt-7> a mf:QueryEvaluationTest ;
  mf:name "fn-timezone-from-dateTimealt-7" ;
  rdfs:comment "Evaluates The \"timezone-from-dateTime\" function that evaluates a timezone of \"-00:00\"." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/timezone-from-dateTime.xml#L62> ;
  mf:action [ qt:query <fn-timezone-from-dateTimealt-7.rq> ] ;
  mf:result <../true.srj> .

