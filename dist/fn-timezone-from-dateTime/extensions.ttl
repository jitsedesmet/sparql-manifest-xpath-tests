<#fn-timezone-from-dateTimealt-19> a mf:QueryEvaluationTest ;
  mf:name "fn-timezone-from-dateTimealt-19" ;
  rdfs:comment "Evaluates The \"timezone-from-dateTime\" function as part of a \"numeric-equal\" expression (ge operator)" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/timezone-from-dateTime.xml#L170> ;
