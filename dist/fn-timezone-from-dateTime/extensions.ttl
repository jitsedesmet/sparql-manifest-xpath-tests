  mf:name "fn-timezone-from-dateTimealt-8" ;
  rdfs:comment "Evaluates The \"timezone-from-dateTime\" function as part of a \"+\" expression." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/timezone-from-dateTime.xml#L71> ;
  mf:action [ qt:query <fn-timezone-from-dateTimealt-8.rq> ] ;
  mf:result <../true.srj> .

