<#K-TimezoneFromDateTimeFunc-5> a mf:QueryEvaluationTest ;
  mf:name "K-TimezoneFromDateTimeFunc-5" ;
  rdfs:comment "A test whose essence is: `timezone-from-dateTime(xs:dateTime(\"2004-10-12T23:43:12Z\")) eq xs:dayTimeDuration(\"PT0S\")`." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/timezone-from-dateTime.xml#L224> ;
  mf:action [ qt:query <K-TimezoneFromDateTimeFunc-5.rq> ] ;
  mf:result <../true.srj> .

<#K-TimezoneFromDateTimeFunc-6> a mf:QueryEvaluationTest ;
  mf:name "K-TimezoneFromDateTimeFunc-6" ;
  rdfs:comment "A test whose essence is: `timezone-from-dateTime(xs:dateTime(\"2004-10-12T23:43:12-08:23\")) eq xs:dayTimeDuration(\"-PT8H23M\")`." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/timezone-from-dateTime.xml#L233> ;
  mf:action [ qt:query <K-TimezoneFromDateTimeFunc-6.rq> ] ;
  mf:result <../true.srj> .
