<#fn-timezone-from-dateTimealt-15> a mf:QueryEvaluationTest ;
  mf:name "fn-timezone-from-dateTimealt-15" ;
  rdfs:comment "Evaluates The \"timezone-from-dateTime\" function as part of an \"and\" expression. Uses the \"fn:string\" function to account for new EBV rules." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/timezone-from-dateTime.xml#L134> ;
