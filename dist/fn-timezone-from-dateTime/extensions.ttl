  mf:name "fn-timezone-from-dateTimealt-11" ;
  rdfs:comment "Evaluates The \"timezone-from-dateTime\" function as part of a \"div\" expression." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/timezone-from-dateTime.xml#L98> ;
  mf:action [ qt:query <fn-timezone-from-dateTimealt-11.rq> ] ;
  mf:result <../true.srj> .

<#fn-timezone-from-dateTimealt-14> a mf:QueryEvaluationTest ;
  mf:name "fn-timezone-from-dateTimealt-14" ;
  rdfs:comment "Evaluates The \"timezone-from-dateTime\" function as an argument to the \"fn:string\" function" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/timezone-from-dateTime.xml#L125> ;
