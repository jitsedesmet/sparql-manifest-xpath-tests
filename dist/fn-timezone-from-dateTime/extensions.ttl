  mf:action [ qt:query <fn-timezone-from-dateTimealt-17.rq> ] ;
  mf:result <../true.srj> .

<#fn-timezone-from-dateTimealt-18> a mf:QueryEvaluationTest ;
  mf:name "fn-timezone-from-dateTimealt-18" ;
  rdfs:comment "Evaluates The \"timezone-from-dateTime\" function as part of a \"numeric-equal\" expression (le operator)" ;
