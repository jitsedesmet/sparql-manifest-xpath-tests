  mf:result <../true.srj> .

<#fn-timezone-from-dateTimealt-16> a mf:QueryEvaluationTest ;
  mf:name "fn-timezone-from-dateTimealt-16" ;
  rdfs:comment "Evaluates The \"timezone-from-dateTime\" function as part of a \"numeric-equal\" expression (eq operator)" ;
