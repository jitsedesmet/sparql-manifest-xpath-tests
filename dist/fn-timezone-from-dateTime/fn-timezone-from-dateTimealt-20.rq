# QT3 test case fn-timezone-from-dateTimealt-20 of test set fn-timezone-from-dateTime, which tests the XPath expression
#   fn:string(fn:timezone-from-dateTime(xs:dateTime("1970-01-01T10:00:00Z"))) or fn:string(fn:timezone-from-dateTime(xs:dateTime("1970-01-01T10:00:00Z")))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/timezone-from-dateTime.xml#L179
# The test needs xsd:string on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( TIMEZONE( xsd:dateTime ( "1970-01-01T10:00:00Z" ) ) ) || xsd:string ( TIMEZONE( xsd:dateTime ( "1970-01-01T10:00:00Z" ) ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
