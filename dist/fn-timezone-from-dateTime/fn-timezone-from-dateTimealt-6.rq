# QT3 test case fn-timezone-from-dateTimealt-6 of test set fn-timezone-from-dateTime, which tests the XPath expression
#   fn:timezone-from-dateTime(xs:dateTime("1999-05-31T00:20:00+00:00"))
ASK {
  BIND(TIMEZONE( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-05-31T00:20:00+00:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "PT0S" ))
}
