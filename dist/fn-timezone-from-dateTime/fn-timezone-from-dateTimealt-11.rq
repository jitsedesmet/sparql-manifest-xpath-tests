# QT3 test case fn-timezone-from-dateTimealt-11 of test set fn-timezone-from-dateTime, which tests the XPath expression
#   fn:timezone-from-dateTime(xs:dateTime("1970-01-01T02:00:00+10:00")) div fn:timezone-from-dateTime(xs:dateTime("1970-01-01T10:00:00+05:00"))
ASK {
  BIND(( TIMEZONE( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T02:00:00+10:00" ) ) / TIMEZONE( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T10:00:00+05:00" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2" ))
}
