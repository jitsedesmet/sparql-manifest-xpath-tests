# QT3 test case fn-month-from-dateTime-17 of test set fn-month-from-dateTime, which tests the XPath expression
#   fn:month-from-dateTime(xs:dateTime("1970-01-01T10:00:00Z")) ne fn:month-from-dateTime(xs:dateTime("1970-02-01T10:00:00Z"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/month-from-dateTime.xml#L178
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( MONTH( xsd:dateTime ( "1970-01-01T10:00:00Z" ) ) != MONTH( xsd:dateTime ( "1970-02-01T10:00:00Z" ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
