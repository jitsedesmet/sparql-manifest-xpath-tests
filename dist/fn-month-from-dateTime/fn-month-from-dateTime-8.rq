# QT3 test case fn-month-from-dateTime-8 of test set fn-month-from-dateTime, which tests the XPath expression
#   fn:month-from-dateTime(xs:dateTime("1970-01-01T00:00:00Z")) + fn:month-from-dateTime(xs:dateTime("1970-01-01T10:00:00Z"))
ASK {
  BIND(( MONTH( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T00:00:00Z" ) ) + MONTH( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T10:00:00Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2" ))
}
