# QT3 test case fn-month-from-dateTime-14 of test set fn-month-from-dateTime, which tests the XPath expression
#   +fn:month-from-dateTime(xs:dateTime("1971-01-01T10:00:00Z"))
# Expecting:
#   <assert-string-value>1</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/month-from-dateTime.xml#L151
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(+ MONTH( xsd:dateTime ( "1971-01-01T10:00:00Z" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1" ))
}
