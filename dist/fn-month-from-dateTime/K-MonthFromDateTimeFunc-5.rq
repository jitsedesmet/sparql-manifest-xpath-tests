# QT3 test case K-MonthFromDateTimeFunc-5 of test set fn-month-from-dateTime, which tests the XPath expression
#   month-from-dateTime(xs:dateTime("2001-02-03T08:23:12.43")) eq 2
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/month-from-dateTime.xml#L241
ASK {
  BIND(( MONTH( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2001-02-03T08:23:12.43" ) ) = "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
