# QT3 test case fn-month-from-dateTime-18 of test set fn-month-from-dateTime, which tests the XPath expression
#   fn:month-from-dateTime(xs:dateTime("1970-02-01T10:00:00Z")) le fn:month-from-dateTime(xs:dateTime("1971-01-01T10:00:00Z"))
ASK {
  BIND(( MONTH( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-02-01T10:00:00Z" ) ) <= MONTH( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1971-01-01T10:00:00Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
