# QT3 test case fn-month-from-dateTime-11 of test set fn-month-from-dateTime, which tests the XPath expression
#   fn:month-from-dateTime(xs:dateTime("1000-10-01T02:00:00Z")) div fn:month-from-dateTime(xs:dateTime("0050-05-01T10:00:00Z"))
ASK {
  BIND(( MONTH( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1000-10-01T02:00:00Z" ) ) / MONTH( <http://www.w3.org/2001/XMLSchema#dateTime> ( "0050-05-01T10:00:00Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2" ))
}
