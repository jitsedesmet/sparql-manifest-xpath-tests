# QT3 test case op-boolean-greater-than-more-args-002 of test set op-boolean-greater-than, which tests the XPath expression
#   xs:boolean("1") gt xs:boolean("true")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-greater-than.xml#L405
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "1" ) > <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
