# QT3 test case op-boolean-greater-than2args-1 of test set op-boolean-greater-than, which tests the XPath expression
#   xs:boolean("false") gt xs:boolean("false")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) > <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
