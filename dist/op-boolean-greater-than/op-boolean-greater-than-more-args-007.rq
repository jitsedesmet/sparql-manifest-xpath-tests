# QT3 test case op-boolean-greater-than-more-args-007 of test set op-boolean-greater-than, which tests the XPath expression
#   xs:boolean("false") gt xs:boolean("true")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) > <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
