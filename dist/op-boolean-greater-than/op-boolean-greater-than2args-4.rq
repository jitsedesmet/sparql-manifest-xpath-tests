# QT3 test case op-boolean-greater-than2args-4 of test set op-boolean-greater-than, which tests the XPath expression
#   xs:boolean("false") gt xs:boolean("1")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-greater-than.xml#L60
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:boolean ( "false" ) > xsd:boolean ( "1" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
