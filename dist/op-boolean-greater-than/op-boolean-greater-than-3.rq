# QT3 test case op-boolean-greater-than-3 of test set op-boolean-greater-than, which tests the XPath expression
#   fn:not(xs:boolean("true")) gt xs:boolean("false")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-greater-than.xml#L220
ASK {
  BIND(( ! <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) > <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
