# QT3 test case op-boolean-greater-than2args-6 of test set op-boolean-greater-than, which tests the XPath expression
#   xs:boolean("false") le xs:boolean("false")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-greater-than.xml#L96
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) <= <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
