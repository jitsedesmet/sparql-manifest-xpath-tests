# QT3 test case op-boolean-greater-than-more-args-005 of test set op-boolean-greater-than, which tests the XPath expression
#   xs:boolean("true") gt xs:boolean("0")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-greater-than.xml#L450
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:boolean ( "true" ) > xsd:boolean ( "0" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
