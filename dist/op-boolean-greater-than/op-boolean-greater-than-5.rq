# QT3 test case op-boolean-greater-than-5 of test set op-boolean-greater-than, which tests the XPath expression
#   fn:not(xs:boolean("false")) gt xs:boolean("true")
ASK {
  BIND(( ! <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) > <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
