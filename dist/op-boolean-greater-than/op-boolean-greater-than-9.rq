# QT3 test case op-boolean-greater-than-9 of test set op-boolean-greater-than, which tests the XPath expression
#   (7 eq 7) gt xs:boolean("true")
ASK {
  BIND(( ( "7"^^<http://www.w3.org/2001/XMLSchema#integer> = "7"^^<http://www.w3.org/2001/XMLSchema#integer> ) > <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
