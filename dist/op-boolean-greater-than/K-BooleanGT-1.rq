# QT3 test case K-BooleanGT-1 of test set op-boolean-greater-than, which tests the XPath expression
#   true() gt false()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-greater-than.xml#L600
ASK {
  BIND(( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> > "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
