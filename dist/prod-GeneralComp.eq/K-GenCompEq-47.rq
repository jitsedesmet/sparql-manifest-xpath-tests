# QT3 test case K-GenCompEq-47 of test set prod-GeneralComp.eq, which tests the XPath expression
#   "1" = 1
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/GeneralComp.eq.xml#L1444
ASK {
  BIND(( "1" = "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(! BOUND( ?result ))
}
