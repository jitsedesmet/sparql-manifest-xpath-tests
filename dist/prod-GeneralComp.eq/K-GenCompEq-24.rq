# QT3 test case K-GenCompEq-24 of test set prod-GeneralComp.eq, which tests the XPath expression
#   "a string" = "a string"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/GeneralComp.eq.xml#L1225
ASK {
  BIND(( "a string" = "a string" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
