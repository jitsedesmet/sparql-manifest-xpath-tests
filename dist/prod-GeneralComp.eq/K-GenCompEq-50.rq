# QT3 test case K-GenCompEq-50 of test set prod-GeneralComp.eq, which tests the XPath expression
#   5 = false()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/GeneralComp.eq.xml#L1471
ASK {
  BIND(( "5"^^<http://www.w3.org/2001/XMLSchema#integer> = "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(! BOUND( ?result ))
}
