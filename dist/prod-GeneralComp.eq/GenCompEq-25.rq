# QT3 test case GenCompEq-25 of test set prod-GeneralComp.eq, which tests the XPath expression
#   ((true() = true()) = true()) = true()
ASK {
  BIND(( ( ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> = "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) = "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) = "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
