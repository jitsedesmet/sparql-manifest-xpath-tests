# QT3 test case GenCompEq-25 of test set prod-GeneralComp.eq, which tests the XPath expression
#   ((true() = true()) = true()) = true()
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/GeneralComp.eq.xml#L1910
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( ( "true"^^xsd:boolean = "true"^^xsd:boolean ) = "true"^^xsd:boolean ) = "true"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
