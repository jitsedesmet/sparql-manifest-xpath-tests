# QT3 test case K-GenCompEq-49 of test set prod-GeneralComp.eq, which tests the XPath expression
#   false() = 5
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/GeneralComp.eq.xml#L1462
ASK {
  BIND(( "false"^^<http://www.w3.org/2001/XMLSchema#boolean> = "5"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(! BOUND( ?result ))
}
