# QT3 test case op-boolean-equal-19 of test set op-boolean-equal, which tests the XPath expression
#   ((true() eq true()) eq true()) eq true()
ASK {
  BIND(( ( ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> = "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) = "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) = "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
