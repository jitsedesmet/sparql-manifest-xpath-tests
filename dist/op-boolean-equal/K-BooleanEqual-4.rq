# QT3 test case K-BooleanEqual-4 of test set op-boolean-equal, which tests the XPath expression
#   true() ne false()
ASK {
  BIND(( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> != "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
