# QT3 test case op-boolean-equal-11 of test set op-boolean-equal, which tests the XPath expression
#   fn:not(7 lt 7) eq xs:boolean("true")
ASK {
  BIND(( ! ( "7"^^<http://www.w3.org/2001/XMLSchema#integer> < "7"^^<http://www.w3.org/2001/XMLSchema#integer> ) = <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
