# QT3 test case op-boolean-equal2args-3 of test set op-boolean-equal, which tests the XPath expression
#   xs:boolean("0") eq xs:boolean("false")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-equal.xml#L42
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "0" ) = <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
