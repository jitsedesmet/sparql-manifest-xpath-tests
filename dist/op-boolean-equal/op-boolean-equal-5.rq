# QT3 test case op-boolean-equal-5 of test set op-boolean-equal, which tests the XPath expression
#   fn:not(xs:boolean("true") and xs:boolean("true")) eq xs:boolean("true")
ASK {
  BIND(( ! ( <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) && <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) = <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
