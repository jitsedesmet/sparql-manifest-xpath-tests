# QT3 test case op-boolean-equal-7 of test set op-boolean-equal, which tests the XPath expression
#   fn:not(xs:boolean("false")) eq fn:not(xs:boolean("false"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-equal.xml#L198
ASK {
  BIND(( ! <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) = ! <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
