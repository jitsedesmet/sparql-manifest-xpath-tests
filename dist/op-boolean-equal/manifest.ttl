<#op-boolean-equal-1> a mf:QueryEvaluationTest ;
  mf:name "op-boolean-equal-1" ;
  rdfs:comment "*******************************************************\nTest: op-boolean-equal-1                               \nWritten By: Carmelo Montanez                           \nDate: June 24, 2005                                    \nPurpose: Evaluates The \"boolean-equal\" function        \n with operands set to \"not(true)\", \"true\" respectively.\n Use of eq operator.                                   \n*******************************************************" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-equal.xml#L96> ;
  mf:action [ qt:query <op-boolean-equal-1.rq> ] ;
  mf:result <../true.srj> .

