# QT3 test case op-boolean-equal-more-args-019 of test set op-boolean-equal, which tests the XPath expression
#   xs:boolean("true") eq false()
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) = "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
