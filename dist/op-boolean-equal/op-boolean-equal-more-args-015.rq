# QT3 test case op-boolean-equal-more-args-015 of test set op-boolean-equal, which tests the XPath expression
#   xs:boolean('true') eq xs:boolean('0')
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) = <http://www.w3.org/2001/XMLSchema#boolean> ( "0" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
