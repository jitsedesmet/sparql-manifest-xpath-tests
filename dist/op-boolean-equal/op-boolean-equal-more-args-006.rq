# QT3 test case op-boolean-equal-more-args-006 of test set op-boolean-equal, which tests the XPath expression
#   xs:boolean("false") eq true()
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) = "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
