# QT3 test case op-boolean-equal2args-2 of test set op-boolean-equal, which tests the XPath expression
#   xs:boolean("1") eq xs:boolean("false")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "1" ) = <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
