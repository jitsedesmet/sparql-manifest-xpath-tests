# QT3 test case op-boolean-equal-more-args-010 of test set op-boolean-equal, which tests the XPath expression
#   xs:boolean("true") eq xs:boolean("1")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) = <http://www.w3.org/2001/XMLSchema#boolean> ( "1" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
