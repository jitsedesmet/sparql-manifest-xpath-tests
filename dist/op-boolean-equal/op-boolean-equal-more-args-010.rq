# QT3 test case op-boolean-equal-more-args-010 of test set op-boolean-equal, which tests the XPath expression
#   xs:boolean("true") eq xs:boolean("1")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-equal.xml#L532
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:boolean ( "true" ) = xsd:boolean ( "1" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
