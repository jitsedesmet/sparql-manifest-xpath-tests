# QT3 test case op-boolean-equal-more-args-005 of test set op-boolean-equal, which tests the XPath expression
#   xs:boolean("false") eq xs:boolean("1")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) = <http://www.w3.org/2001/XMLSchema#boolean> ( "1" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
