# QT3 test case op-boolean-equal-12 of test set op-boolean-equal, which tests the XPath expression
#   fn:not(7 lt 7) and xs:boolean("false")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-equal.xml#L282
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ! ( "7"^^xsd:integer < "7"^^xsd:integer ) && xsd:boolean ( "false" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
