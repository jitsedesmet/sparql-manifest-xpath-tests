# QT3 test case op-boolean-equal-12 of test set op-boolean-equal, which tests the XPath expression
#   fn:not(7 lt 7) and xs:boolean("false")
ASK {
  BIND(( ! ( "7"^^<http://www.w3.org/2001/XMLSchema#integer> < "7"^^<http://www.w3.org/2001/XMLSchema#integer> ) && <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
