# QT3 test case op-boolean-equal-6 of test set op-boolean-equal, which tests the XPath expression
#   fn:not(xs:boolean("false") and xs:boolean("false")) eq xs:boolean("false")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-equal.xml#L181
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ! ( xsd:boolean ( "false" ) && xsd:boolean ( "false" ) ) = xsd:boolean ( "false" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
