# QT3 test case op-boolean-equal-6 of test set op-boolean-equal, which tests the XPath expression
#   fn:not(xs:boolean("false") and xs:boolean("false")) eq xs:boolean("false")
ASK {
  BIND(( ! ( <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) && <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) ) = <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
