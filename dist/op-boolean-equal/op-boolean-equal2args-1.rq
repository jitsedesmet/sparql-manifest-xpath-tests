# QT3 test case op-boolean-equal2args-1 of test set op-boolean-equal, which tests the XPath expression
#   xs:boolean("false") eq xs:boolean("false")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) = <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
