# QT3 test case op-boolean-equal-more-args-018 of test set op-boolean-equal, which tests the XPath expression
#   xs:boolean("true") eq true()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-equal.xml#L652
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) = "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
