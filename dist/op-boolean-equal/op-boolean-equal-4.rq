# QT3 test case op-boolean-equal-4 of test set op-boolean-equal, which tests the XPath expression
#   (xs:boolean("true") and xs:boolean("true")) eq (xs:boolean("false") and xs:boolean("false"))
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) && <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) = ( <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) && <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
