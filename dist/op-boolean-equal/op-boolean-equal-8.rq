# QT3 test case op-boolean-equal-8 of test set op-boolean-equal, which tests the XPath expression
#   fn:not(xs:boolean("false") and xs:boolean("true")) eq fn:not(xs:boolean("false") and xs:boolean("true"))
ASK {
  BIND(( ! ( <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) && <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) = ! ( <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) && <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
