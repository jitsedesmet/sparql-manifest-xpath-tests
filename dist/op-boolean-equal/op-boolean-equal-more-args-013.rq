# QT3 test case op-boolean-equal-more-args-013 of test set op-boolean-equal, which tests the XPath expression
#   xs:boolean("0") eq xs:boolean("true")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "0" ) = <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
