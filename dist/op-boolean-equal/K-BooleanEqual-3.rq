# QT3 test case K-BooleanEqual-3 of test set op-boolean-equal, which tests the XPath expression
#   false() ne true()
ASK {
  BIND(( "false"^^<http://www.w3.org/2001/XMLSchema#boolean> != "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
