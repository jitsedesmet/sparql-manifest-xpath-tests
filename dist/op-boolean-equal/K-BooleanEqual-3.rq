# QT3 test case K-BooleanEqual-3 of test set op-boolean-equal, which tests the XPath expression
#   false() ne true()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-equal.xml#L712
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "false"^^xsd:boolean != "true"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
