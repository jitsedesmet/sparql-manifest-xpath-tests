# QT3 test case op-dateTime-greater-than-5 of test set op-dateTime-greater-than, which tests the XPath expression
#   fn:not(xs:dateTime("2002-04-02T12:00:00Z") gt xs:dateTime("2002-05-02T12:00:00Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dateTime-greater-than.xml#L219
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2002-04-02T12:00:00Z" ) > <http://www.w3.org/2001/XMLSchema#dateTime> ( "2002-05-02T12:00:00Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
