# QT3 test case K-DateTimeGT-6 of test set op-dateTime-greater-than, which tests the XPath expression
#   not(xs:dateTime("2004-07-11T23:01:04.12") ge xs:dateTime("2004-07-12T23:01:04.12"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dateTime-greater-than.xml#L454
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( xsd:dateTime ( "2004-07-11T23:01:04.12" ) >= xsd:dateTime ( "2004-07-12T23:01:04.12" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
