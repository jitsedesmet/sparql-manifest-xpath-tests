# QT3 test case op-dateTime-greater-than-11 of test set op-dateTime-greater-than, which tests the XPath expression
#   (xs:dateTime("1990-04-02T12:00:10Z") gt xs:dateTime("2006-06-02T12:10:00Z")) or (fn:true())
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1990-04-02T12:00:10Z" ) > <http://www.w3.org/2001/XMLSchema#dateTime> ( "2006-06-02T12:10:00Z" ) ) || "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
