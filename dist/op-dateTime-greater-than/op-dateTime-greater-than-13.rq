# QT3 test case op-dateTime-greater-than-13 of test set op-dateTime-greater-than, which tests the XPath expression
#   (xs:dateTime("1981-04-02T12:00:00Z") gt xs:dateTime("2003-04-02T12:10:00Z")) or (fn:false())
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dateTime-greater-than.xml#L347
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1981-04-02T12:00:00Z" ) > <http://www.w3.org/2001/XMLSchema#dateTime> ( "2003-04-02T12:10:00Z" ) ) || "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
