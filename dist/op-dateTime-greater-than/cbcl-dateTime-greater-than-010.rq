# QT3 test case cbcl-dateTime-greater-than-010 of test set op-dateTime-greater-than, which tests the XPath expression
#   xs:dateTime("2008-01-31T00:01:00+09:00") ge xs:dateTime("2008-01-31T00:01:00")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dateTime-greater-than.xml#L572
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2008-01-31T00:01:00+09:00" ) >= <http://www.w3.org/2001/XMLSchema#dateTime> ( "2008-01-31T00:01:00" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
