# QT3 test case op-dateTime-greater-than-12 of test set op-dateTime-greater-than, which tests the XPath expression
#   (xs:dateTime("1970-04-02T12:00:20Z") ge xs:dateTime("1980-04-02T12:00:20Z")) or (fn:true())
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dateTime-greater-than.xml#L331
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-04-02T12:00:20Z" ) >= <http://www.w3.org/2001/XMLSchema#dateTime> ( "1980-04-02T12:00:20Z" ) ) || "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
