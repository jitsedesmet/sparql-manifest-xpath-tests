# QT3 test case op-dateTime-greater-than2args-3 of test set op-dateTime-greater-than, which tests the XPath expression
#   xs:dateTime("2030-12-31T23:59:59Z") gt xs:dateTime("1970-01-01T00:00:00Z")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dateTime-greater-than.xml#L43
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2030-12-31T23:59:59Z" ) > <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T00:00:00Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
