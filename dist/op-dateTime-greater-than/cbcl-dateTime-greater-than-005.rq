# QT3 test case cbcl-dateTime-greater-than-005 of test set op-dateTime-greater-than, which tests the XPath expression
#   xs:dateTime("2008-01-31T00:01:00+09:00") gt xs:dateTime("2008-01-31T00:01:00")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2008-01-31T00:01:00+09:00" ) > <http://www.w3.org/2001/XMLSchema#dateTime> ( "2008-01-31T00:01:00" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
