# QT3 test case op-dateTime-greater-than-8 of test set op-dateTime-greater-than, which tests the XPath expression
#   (xs:dateTime("2002-04-02T12:00:00Z") ge xs:dateTime("2005-04-02T12:00:20Z")) and (xs:dateTime("2002-04-02T12:10:00Z") ge xs:dateTime("2002-04-03T12:00:00Z"))
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2002-04-02T12:00:00Z" ) >= <http://www.w3.org/2001/XMLSchema#dateTime> ( "2005-04-02T12:00:20Z" ) ) && ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2002-04-02T12:10:00Z" ) >= <http://www.w3.org/2001/XMLSchema#dateTime> ( "2002-04-03T12:00:00Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
