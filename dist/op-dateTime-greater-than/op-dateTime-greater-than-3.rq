# QT3 test case op-dateTime-greater-than-3 of test set op-dateTime-greater-than, which tests the XPath expression
#   fn:not((xs:dateTime("2004-04-02T12:00:00Z") gt xs:dateTime("2003-04-02T12:00:00Z")))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2004-04-02T12:00:00Z" ) > <http://www.w3.org/2001/XMLSchema#dateTime> ( "2003-04-02T12:00:00Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
