# QT3 test case op-dateTime-greater-than-9 of test set op-dateTime-greater-than, which tests the XPath expression
#   (xs:dateTime("2002-06-02T12:00:10Z") gt xs:dateTime("2000-04-04T12:00:00Z")) or (xs:dateTime("2002-04-02T13:00:10Z") gt xs:dateTime("2001-04-02T10:00:00Z"))
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2002-06-02T12:00:10Z" ) > <http://www.w3.org/2001/XMLSchema#dateTime> ( "2000-04-04T12:00:00Z" ) ) || ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2002-04-02T13:00:10Z" ) > <http://www.w3.org/2001/XMLSchema#dateTime> ( "2001-04-02T10:00:00Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
