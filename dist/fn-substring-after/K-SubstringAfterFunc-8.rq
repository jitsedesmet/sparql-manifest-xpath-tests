# QT3 test case K-SubstringAfterFunc-8 of test set fn-substring-after, which tests the XPath expression
#   substring-after("abcdefgedij", "def") eq "gedij"
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring-after.xml#L548
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( STRAFTER( "abcdefgedij" , "def" ) = "gedij" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
