# QT3 test case K-SubstringAfterFunc-7 of test set fn-substring-after, which tests the XPath expression
#   substring-after("tattoo", "tattoo") eq ""
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring-after.xml#L539
ASK {
  BIND(( STRAFTER( "tattoo" , "tattoo" ) = "" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
