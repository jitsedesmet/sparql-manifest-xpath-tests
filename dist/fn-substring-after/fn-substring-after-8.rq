# QT3 test case fn-substring-after-8 of test set fn-substring-after, which tests the XPath expression
#   fn:substring-after("AAAAABBBBBCCCCC","BBBBB")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring-after.xml#L91
ASK {
  BIND(STRAFTER( "AAAAABBBBBCCCCC" , "BBBBB" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "CCCCC" ))
}
