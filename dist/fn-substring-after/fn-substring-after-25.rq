# QT3 test case fn-substring-after-25 of test set fn-substring-after, which tests the XPath expression
#   substring-after("𐀁𐀂𐀃", "𐀂")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring-after.xml#L276
ASK {
  BIND(STRAFTER( "𐀁𐀂𐀃" , "𐀂" ) AS ?result)
  FILTER(( ?result = "𐀃" ))
}
