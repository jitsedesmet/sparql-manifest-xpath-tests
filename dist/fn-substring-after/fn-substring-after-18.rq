# QT3 test case fn-substring-after-18 of test set fn-substring-after, which tests the XPath expression
#   fn:substring-after("substring-aftersubstring-after","substring-after")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring-after.xml#L202
ASK {
  BIND(STRAFTER( "substring-aftersubstring-after" , "substring-after" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "substring-after" ))
}
