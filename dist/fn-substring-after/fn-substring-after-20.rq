# QT3 test case fn-substring-after-20 of test set fn-substring-after, which tests the XPath expression
#   fn:substring-after("12345","1234")
# Expecting:
#   <assert-string-value>5</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring-after.xml#L220
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(STRAFTER( "12345" , "1234" ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "5" ))
}
