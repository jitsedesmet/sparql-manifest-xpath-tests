# QT3 test case fn-substring-after-19 of test set fn-substring-after, which tests the XPath expression
#   fn:substring-after("****","***")
# Expecting:
#   <assert-string-value>*</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring-after.xml#L211
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(STRAFTER( "****" , "***" ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "*" ))
}
