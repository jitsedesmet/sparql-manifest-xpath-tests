<#K-ContainsFunc-6> a mf:QueryEvaluationTest ;
  mf:name "K-ContainsFunc-6" ;
  rdfs:comment "A test whose essence is: `contains(\"tattoo\", \"t\")`." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/contains.xml> ;
