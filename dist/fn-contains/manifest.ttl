  ) .

<#fn-contains2args-1> a mf:QueryEvaluationTest ;
  mf:name "fn-contains2args-1" ;
  rdfs:comment "Evaluates The \"contains\" function with the arguments set as follows: $arg1 = xs:string(lower bound) $arg2 = xs:string(lower bound)" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/contains.xml> ;
  mf:action [ qt:query <fn-contains2args-1.rq> ] ;
  mf:result <../true.srj> .

<#fn-contains2args-2> a mf:QueryEvaluationTest ;
  mf:name "fn-contains2args-2" ;
  rdfs:comment "Evaluates The \"contains\" function with the arguments set as follows: $arg1 = xs:string(mid range) $arg2 = xs:string(lower bound)" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/contains.xml> ;
  mf:action [ qt:query <fn-contains2args-2.rq> ] ;
  mf:result <../true.srj> .

