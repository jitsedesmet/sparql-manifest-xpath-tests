# QT3 test case fn-contains-9 of test set fn-contains, which tests the XPath expression
#   fn:contains("AAAAABBBBB"," ")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/contains.xml#L172
ASK {
  BIND(CONTAINS( "AAAAABBBBB" , " " ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
