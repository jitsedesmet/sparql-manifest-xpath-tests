# QT3 test case fn-contains-14 of test set fn-contains, which tests the XPath expression
#   fn:contains("A",xs:string("A"))
ASK {
  BIND(CONTAINS( "A" , <http://www.w3.org/2001/XMLSchema#string> ( "A" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
