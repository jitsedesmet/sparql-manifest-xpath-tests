# QT3 test case K-ContainsFunc-7 of test set fn-contains, which tests the XPath expression
#   not(contains("tattoo", "ttt"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/contains.xml#L600
ASK {
  BIND(! CONTAINS( "tattoo" , "ttt" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
