# QT3 test case fn-contains-13 of test set fn-contains, which tests the XPath expression
#   fn:contains(xs:string("A"),"A")
ASK {
  BIND(CONTAINS( <http://www.w3.org/2001/XMLSchema#string> ( "A" ) , "A" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
