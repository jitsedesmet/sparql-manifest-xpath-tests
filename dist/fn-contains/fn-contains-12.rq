# QT3 test case fn-contains-12 of test set fn-contains, which tests the XPath expression
#   fn:not(fn:contains("A","B"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/contains.xml#L211
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! CONTAINS( "A" , "B" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
