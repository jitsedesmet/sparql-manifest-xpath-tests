# QT3 test case op-numeric-unary-plusflt1args-1 of test set op-numeric-unary-plus, which tests the XPath expression
#   +(xs:float("-3.4028235E38"))
ASK {
  BIND(+ <http://www.w3.org/2001/XMLSchema#float> ( "-3.4028235E38" ) AS ?result)
  FILTER(( ?result = <http://www.w3.org/2001/XMLSchema#float> ( - "3.4028235E38"^^<http://www.w3.org/2001/XMLSchema#double> ) ))
}
