# QT3 test case op-numeric-unary-plusintg1args-3 of test set op-numeric-unary-plus, which tests the XPath expression
#   +(xs:integer("999999999999999999"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-plus.xml#L52
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(+ xsd:integer ( "999999999999999999" ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "999999999999999999"^^xsd:integer ) ))
}
