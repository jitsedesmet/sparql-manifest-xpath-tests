# QT3 test case K-NumericUnaryPlus-6 of test set op-numeric-unary-plus, which tests the XPath expression
#   +(3) eq +3
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-plus.xml#L403
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( + "3"^^xsd:integer = + "3"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
