# QT3 test case op-numeric-unary-plusint1args-2 of test set op-numeric-unary-plus, which tests the XPath expression
#   +(xs:int("-1873914410"))
ASK {
  BIND(+ "-1873914410"^^<http://www.w3.org/2001/XMLSchema#int> AS ?result)
  FILTER(( ?result = - "1873914410"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
