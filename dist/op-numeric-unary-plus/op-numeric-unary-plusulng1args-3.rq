# QT3 test case op-numeric-unary-plusulng1args-3 of test set op-numeric-unary-plus, which tests the XPath expression
#   +(xs:unsignedLong("184467440737095516"))
ASK {
  BIND(+ "184467440737095516"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> AS ?result)
  FILTER(( ?result = "184467440737095516"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
