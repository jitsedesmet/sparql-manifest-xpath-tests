# QT3 test case op-numeric-unary-plusnpi1args-3 of test set op-numeric-unary-plus, which tests the XPath expression
#   +(xs:nonPositiveInteger("0"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-plus.xml#L295
ASK {
  BIND(+ "0"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
