# QT3 test case op-numeric-unary-plussht1args-2 of test set op-numeric-unary-plus, which tests the XPath expression
#   +(xs:short("-5324"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-plus.xml#L340
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(+ "-5324"^^xsd:short AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-5324"^^xsd:integer ) ))
}
