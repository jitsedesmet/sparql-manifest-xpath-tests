# QT3 test case K-NumericUnaryPlus-1 of test set op-numeric-unary-plus, which tests the XPath expression
#   +"a string"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-plus.xml#L358
ASK {
  BIND(+ "a string" AS ?result)
  FILTER(! BOUND( ?result ))
}
