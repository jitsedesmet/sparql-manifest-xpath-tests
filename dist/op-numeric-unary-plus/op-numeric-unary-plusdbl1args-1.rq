# QT3 test case op-numeric-unary-plusdbl1args-1 of test set op-numeric-unary-plus, which tests the XPath expression
#   +(xs:double("-1.7976931348623157E308"))
ASK {
  BIND(+ <http://www.w3.org/2001/XMLSchema#double> ( "-1.7976931348623157E308" ) AS ?result)
  FILTER(( ?result = - "1.7976931348623157E308"^^<http://www.w3.org/2001/XMLSchema#double> ))
}
