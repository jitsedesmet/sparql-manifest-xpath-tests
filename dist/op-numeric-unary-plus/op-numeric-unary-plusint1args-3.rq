# QT3 test case op-numeric-unary-plusint1args-3 of test set op-numeric-unary-plus, which tests the XPath expression
#   +(xs:int("2147483647"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-plus.xml#L25
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(+ "2147483647"^^xsd:int AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "2147483647"^^xsd:integer ) ))
}
