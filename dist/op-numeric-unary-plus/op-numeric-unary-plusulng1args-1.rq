# QT3 test case op-numeric-unary-plusulng1args-1 of test set op-numeric-unary-plus, which tests the XPath expression
#   +(xs:unsignedLong("0"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-plus.xml#L250
ASK {
  BIND(+ "0"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
