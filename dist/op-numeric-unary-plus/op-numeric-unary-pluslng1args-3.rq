# QT3 test case op-numeric-unary-pluslng1args-3 of test set op-numeric-unary-plus, which tests the XPath expression
#   +(xs:long("92233720368547758"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-plus.xml#L160
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(+ "92233720368547758"^^xsd:long AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "92233720368547758"^^xsd:integer ) ))
}
