<#op-numeric-unary-plusint1args-1> a mf:QueryEvaluationTest ;
  mf:name "op-numeric-unary-plusint1args-1" ;
  rdfs:comment "Evaluates The \"op:numeric-unary-plus\" operator with the arguments set as follows: $arg = xs:int(lower bound)" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-plus.xml#L7> ;
  mf:action [ qt:query <op-numeric-unary-plusint1args-1.rq> ] ;
  mf:result <../true.srj> .

