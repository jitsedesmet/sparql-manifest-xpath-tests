# QT3 test case op-numeric-unary-plusnni1args-1 of test set op-numeric-unary-plus, which tests the XPath expression
#   +(xs:nonNegativeInteger("0"))
ASK {
  BIND(+ "0"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
