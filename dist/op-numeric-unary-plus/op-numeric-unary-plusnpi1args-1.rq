# QT3 test case op-numeric-unary-plusnpi1args-1 of test set op-numeric-unary-plus, which tests the XPath expression
#   +(xs:nonPositiveInteger("-999999999999999999"))
ASK {
  BIND(+ "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> AS ?result)
  FILTER(( ?result = - "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
