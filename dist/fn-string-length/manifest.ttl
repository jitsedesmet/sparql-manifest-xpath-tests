<#fn-string-length-14> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-14" ;
  rdfs:comment "Evaluation of string-length function as an argument to the \"fn:not\" function" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L151> ;
  mf:action [ qt:query <fn-string-length-14.rq> ] ;
  mf:result <../true.srj> .

<#fn-string-length-15> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-15" ;
  rdfs:comment "Evaluation of string-length function with argument set to \"%$#@!\"" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L160> ;
  mf:action [ qt:query <fn-string-length-15.rq> ] ;
  mf:result <../true.srj> .

<#fn-string-length-16> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-16" ;
  rdfs:comment "Evaluation of string-length function with argument set to \"string-length\"" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L169> ;
