@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "QT3 test set fn-string-length" ;
  dct:license <../LICENSE.txt> ;
  mf:entries (
    <#fn-string-length1args-1>
    <#fn-string-length1args-2>
    <#fn-string-length1args-3>
    <#fn-string-length-1>
    <#fn-string-length-3>
    <#fn-string-length-4>
    <#fn-string-length-5>
    <#fn-string-length-6>
