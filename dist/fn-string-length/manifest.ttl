  ) .

<#fn-string-length1args-1> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length1args-1" ;
  rdfs:comment "Evaluates The \"string-length\" function with the arguments set as follows: $arg = xs:string(lower bound)" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L7> ;
  mf:action [ qt:query <fn-string-length1args-1.rq> ] ;
  mf:result <../true.srj> .

<#fn-string-length1args-2> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length1args-2" ;
  rdfs:comment "Evaluates The \"string-length\" function with the arguments set as follows: $arg = xs:string(mid range)" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L16> ;
  mf:action [ qt:query <fn-string-length1args-2.rq> ] ;
  mf:result <../true.srj> .

<#fn-string-length1args-3> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length1args-3" ;
  rdfs:comment "Evaluates The \"string-length\" function with the arguments set as follows: $arg = xs:string(upper bound)" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L25> ;
  mf:action [ qt:query <fn-string-length1args-3.rq> ] ;
  mf:result <../true.srj> .

<#fn-string-length-1> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-1" ;
  rdfs:comment "Evaluation of string-length function as per example 1 (for this function) from the F&O specs." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L34> ;
  mf:action [ qt:query <fn-string-length-1.rq> ] ;
  mf:result <../true.srj> .

<#fn-string-length-3> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-3" ;
  rdfs:comment "Evaluation of string-length function that uses only numbers as part of argument" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L52> ;
  mf:action [ qt:query <fn-string-length-3.rq> ] ;
  mf:result <../true.srj> .

<#fn-string-length-4> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-4" ;
  rdfs:comment "Evaluation of string-length function that uses both numbers and letters as part of argument" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L61> ;
  mf:action [ qt:query <fn-string-length-4.rq> ] ;
  mf:result <../true.srj> .

<#fn-string-length-5> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-5" ;
  rdfs:comment "Evaluation of string-length function that uses only upper case letters as part of argument" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L70> ;
  mf:action [ qt:query <fn-string-length-5.rq> ] ;
  mf:result <../true.srj> .

<#fn-string-length-6> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-6" ;
  rdfs:comment "Evaluation of string-length function that uses only lower case letters as part of argument" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L79> ;
  mf:action [ qt:query <fn-string-length-6.rq> ] ;
  mf:result <../true.srj> .

<#fn-string-length-7> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-7" ;
  rdfs:comment "Evaluation of string-length function that uses both upper and lower case letters as part of argument" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L88> ;
  mf:action [ qt:query <fn-string-length-7.rq> ] ;
  mf:result <../true.srj> .

<#fn-string-length-8> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-8" ;
  rdfs:comment "Evaluation of string-length function that uses the empty string as part of argument" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L97> ;
  mf:action [ qt:query <fn-string-length-8.rq> ] ;
  mf:result <../true.srj> .

<#fn-string-length-9> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-9" ;
  rdfs:comment "Evaluation of string-length function that uses the \"string\" as part of argument" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L106> ;
  mf:action [ qt:query <fn-string-length-9.rq> ] ;
  mf:result <../true.srj> .

<#fn-string-length-10> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-10" ;
  rdfs:comment "Evaluation of string-length function with argument set to \"*****\"" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L115> ;
  mf:action [ qt:query <fn-string-length-10.rq> ] ;
  mf:result <../true.srj> .

<#fn-string-length-11> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-11" ;
  rdfs:comment "Evaluation of string-length function as part of an addition operation" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L124> ;
  mf:action [ qt:query <fn-string-length-11.rq> ] ;
  mf:result <../true.srj> .

<#fn-string-length-12> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-12" ;
  rdfs:comment "Evaluation of string-length function as an argument to the \"fn:boolean\" function" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L133> ;
  mf:action [ qt:query <fn-string-length-12.rq> ] ;
  mf:result <../true.srj> .

<#fn-string-length-13> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-13" ;
  rdfs:comment "Evaluation of string-length function as an argument to the \"fn:concat\" function" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L142> ;
  mf:action [ qt:query <fn-string-length-13.rq> ] ;
