  mf:result <../true.srj> .

<#fn-string-length-20> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-20" ;
  rdfs:comment "Evaluation of string-length function with non-BMP characters." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L207> ;
  mf:action [ qt:query <fn-string-length-20.rq> ] ;
  mf:result <../true.srj> .

<#K-StringLengthFunc-2> a mf:QueryEvaluationTest ;
  mf:name "K-StringLengthFunc-2" ;
  rdfs:comment "A test whose essence is: `string-length(\"ebv\") eq 3`." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L284> ;
  mf:action [ qt:query <K-StringLengthFunc-2.rq> ] ;
  mf:result <../true.srj> .

<#K-StringLengthFunc-5> a mf:QueryEvaluationTest ;
  mf:name "K-StringLengthFunc-5" ;
  rdfs:comment "A test whose essence is: `string-length(\"\") eq 0`." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L311> ;
  mf:action [ qt:query <K-StringLengthFunc-5.rq> ] ;
  mf:result <../true.srj> .

<#K-StringLengthFunc-8> a mf:QueryEvaluationTest ;
  mf:name "K-StringLengthFunc-8" ;
  rdfs:comment "A test whose essence is: `string-length(\"Harp not on that string, madam; that is past.\") eq 45`." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L341> ;
  mf:action [ qt:query <K-StringLengthFunc-8.rq> ] ;
  mf:result <../true.srj> .
