<#fn-string-length-17> a mf:QueryEvaluationTest ;
  mf:name "fn-string-length-17" ;
  rdfs:comment "Evaluation of string-length function as part of a boolean expression" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L178> ;
