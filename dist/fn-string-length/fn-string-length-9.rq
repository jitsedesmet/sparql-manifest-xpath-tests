# QT3 test case fn-string-length-9 of test set fn-string-length, which tests the XPath expression
#   fn:string-length(fn:string("AbcDH"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L106
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(STRLEN( xsd:string ( "AbcDH" ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "5"^^xsd:integer ) ))
}
