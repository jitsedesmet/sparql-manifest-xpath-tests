# QT3 test case fn-string-length-5 of test set fn-string-length, which tests the XPath expression
#   fn:string-length("ABCD")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L70
ASK {
  BIND(STRLEN( "ABCD" ) AS ?result)
  FILTER(( ?result = "4"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
