# QT3 test case fn-string-length-20 of test set fn-string-length, which tests the XPath expression
#   string-length("𐀂")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L207
ASK {
  BIND(STRLEN( "𐀂" ) AS ?result)
  FILTER(( ?result = "1"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
