# QT3 test case fn-string-length1args-2 of test set fn-string-length, which tests the XPath expression
#   fn:string-length(xs:string("This is a characte"))
ASK {
  BIND(STRLEN( <http://www.w3.org/2001/XMLSchema#string> ( "This is a characte" ) ) AS ?result)
  FILTER(( ?result = "18"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
