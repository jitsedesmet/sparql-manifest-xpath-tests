# QT3 test case fn-string-length-14 of test set fn-string-length, which tests the XPath expression
#   fn:not(fn:string-length("abcde"))
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L151
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! STRLEN( "abcde" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
