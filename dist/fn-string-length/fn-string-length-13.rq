# QT3 test case fn-string-length-13 of test set fn-string-length, which tests the XPath expression
#   fn:concat(fn:string-length("abcde"), fn:string-length("fghi"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L142
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( STRLEN( "abcde" ) ) , <http://www.w3.org/2001/XMLSchema#string> ( STRLEN( "fghi" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#string> , <http://www.w3.org/2001/XMLSchema#normalizedString> , <http://www.w3.org/2001/XMLSchema#token> , <http://www.w3.org/2001/XMLSchema#language> , <http://www.w3.org/2001/XMLSchema#NMTOKEN> , <http://www.w3.org/2001/XMLSchema#Name> , <http://www.w3.org/2001/XMLSchema#NCName> , <http://www.w3.org/2001/XMLSchema#ID> , <http://www.w3.org/2001/XMLSchema#IDREF> , <http://www.w3.org/2001/XMLSchema#ENTITY> ) ) && SAMETERM( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) , "54" ) ))
}
