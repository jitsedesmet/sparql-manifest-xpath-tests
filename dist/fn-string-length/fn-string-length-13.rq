# QT3 test case fn-string-length-13 of test set fn-string-length, which tests the XPath expression
#   fn:concat(fn:string-length("abcde"), fn:string-length("fghi"))
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( STRLEN( "abcde" ) ) , <http://www.w3.org/2001/XMLSchema#string> ( STRLEN( "fghi" ) ) ) AS ?result)
  FILTER(( ?result = "54" ))
}
