# QT3 test case fn-string-length-13 of test set fn-string-length, which tests the XPath expression
#   fn:concat(fn:string-length("abcde"), fn:string-length("fghi"))
# Expecting:
#   <assert-eq>"54"</assert-eq>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L142
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( STRLEN( "abcde" ) ) , xsd:string ( STRLEN( "fghi" ) ) ) AS ?result)
  FILTER(( ( SAMETERM( DATATYPE( ?result ) , xsd:string ) || SAMETERM( DATATYPE( ?result ) , xsd:normalizedString ) || SAMETERM( DATATYPE( ?result ) , xsd:token ) || SAMETERM( DATATYPE( ?result ) , xsd:language ) || SAMETERM( DATATYPE( ?result ) , xsd:NMTOKEN ) || SAMETERM( DATATYPE( ?result ) , xsd:Name ) || SAMETERM( DATATYPE( ?result ) , xsd:NCName ) || SAMETERM( DATATYPE( ?result ) , xsd:ID ) || SAMETERM( DATATYPE( ?result ) , xsd:IDREF ) || SAMETERM( DATATYPE( ?result ) , xsd:ENTITY ) ) && SAMETERM( xsd:string ( ?result ) , "54" ) ))
}
