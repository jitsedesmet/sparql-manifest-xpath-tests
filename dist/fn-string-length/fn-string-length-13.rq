# QT3 test case fn-string-length-13 of test set fn-string-length, which tests the XPath expression
#   fn:concat(fn:string-length("abcde"), fn:string-length("fghi"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L142
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( STRLEN( "abcde" ) ) , <http://www.w3.org/2001/XMLSchema#string> ( STRLEN( "fghi" ) ) ) AS ?result)
  FILTER(( ( ( ( ( ( ( ( ( ( SAMETERM( DATATYPE( ?result ) , <http://www.w3.org/2001/XMLSchema#string> ) || SAMETERM( DATATYPE( ?result ) , <http://www.w3.org/2001/XMLSchema#normalizedString> ) ) || SAMETERM( DATATYPE( ?result ) , <http://www.w3.org/2001/XMLSchema#token> ) ) || SAMETERM( DATATYPE( ?result ) , <http://www.w3.org/2001/XMLSchema#language> ) ) || SAMETERM( DATATYPE( ?result ) , <http://www.w3.org/2001/XMLSchema#NMTOKEN> ) ) || SAMETERM( DATATYPE( ?result ) , <http://www.w3.org/2001/XMLSchema#Name> ) ) || SAMETERM( DATATYPE( ?result ) , <http://www.w3.org/2001/XMLSchema#NCName> ) ) || SAMETERM( DATATYPE( ?result ) , <http://www.w3.org/2001/XMLSchema#ID> ) ) || SAMETERM( DATATYPE( ?result ) , <http://www.w3.org/2001/XMLSchema#IDREF> ) ) || SAMETERM( DATATYPE( ?result ) , <http://www.w3.org/2001/XMLSchema#ENTITY> ) ) && SAMETERM( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) , "54" ) ))
}
