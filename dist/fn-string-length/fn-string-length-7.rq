# QT3 test case fn-string-length-7 of test set fn-string-length, which tests the XPath expression
#   fn:string-length("ABCDEabcde")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L88
ASK {
  BIND(STRLEN( "ABCDEabcde" ) AS ?result)
  FILTER(( ?result = "10"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
