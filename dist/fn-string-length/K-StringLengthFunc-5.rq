# QT3 test case K-StringLengthFunc-5 of test set fn-string-length, which tests the XPath expression
#   string-length("") eq 0
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L311
ASK {
  BIND(( STRLEN( "" ) = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
