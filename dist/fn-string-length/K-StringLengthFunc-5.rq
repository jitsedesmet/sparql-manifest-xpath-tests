# QT3 test case K-StringLengthFunc-5 of test set fn-string-length, which tests the XPath expression
#   string-length("") eq 0
ASK {
  BIND(( STRLEN( "" ) = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
