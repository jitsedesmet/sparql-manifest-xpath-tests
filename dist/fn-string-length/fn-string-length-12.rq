# QT3 test case fn-string-length-12 of test set fn-string-length, which tests the XPath expression
#   fn:boolean(fn:string-length("abcde"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L133
ASK {
  BIND(! ( ! STRLEN( "abcde" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
