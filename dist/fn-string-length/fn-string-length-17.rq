# QT3 test case fn-string-length-17 of test set fn-string-length, which tests the XPath expression
#   fn:string-length("abc") and fn:string-length("abc")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string-length.xml#L178
ASK {
  BIND(( STRLEN( "abc" ) && STRLEN( "abc" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
