# QT3 test case fn-true-1 of test set fn-true, which tests the XPath expression
#   fn:true()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/true.xml#L7
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND("true"^^xsd:boolean AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
