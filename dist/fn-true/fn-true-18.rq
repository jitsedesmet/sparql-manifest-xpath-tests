# QT3 test case fn-true-18 of test set fn-true, which tests the XPath expression
#   fn:string(fn:true())
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/true.xml#L163
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ?result = "true" ))
}
