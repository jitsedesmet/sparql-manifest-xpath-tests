# QT3 test case K-TrueFunc-2 of test set fn-true, which tests the XPath expression
#   true() eq true()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/true.xml#L219
ASK {
  BIND(( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> = "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
