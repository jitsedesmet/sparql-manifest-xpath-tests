# QT3 test case fn-true-19 of test set fn-true, which tests the XPath expression
#   fn:concat(xs:string(fn:true()),xs:string(fn:true()))
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#string> ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ) , <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#string> ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "truetrue" ))
}
