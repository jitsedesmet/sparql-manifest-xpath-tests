# QT3 test case fn-true-17 of test set fn-true, which tests the XPath expression
#   xs:boolean(fn:true())
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#boolean> ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
