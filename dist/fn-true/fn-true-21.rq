# QT3 test case fn-true-21 of test set fn-true, which tests the XPath expression
#   fn:string-length(xs:string(fn:true()))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/true.xml#L190
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(STRLEN( xsd:string ( "true"^^xsd:boolean ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "4" ))
}
