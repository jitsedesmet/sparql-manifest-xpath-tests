# QT3 test case K-CondExpr-1 of test set prod-IfExpr, which tests the XPath expression
#   (if(2) then 1 else 0) eq 1
ASK {
  BIND(( IF( "2"^^<http://www.w3.org/2001/XMLSchema#integer> , "1"^^<http://www.w3.org/2001/XMLSchema#integer> , "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) = "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
