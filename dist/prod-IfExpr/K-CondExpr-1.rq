# QT3 test case K-CondExpr-1 of test set prod-IfExpr, which tests the XPath expression
#   (if(2) then 1 else 0) eq 1
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/IfExpr.xml#L275
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( IF( "2"^^xsd:integer , "1"^^xsd:integer , "0"^^xsd:integer ) = "1"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
