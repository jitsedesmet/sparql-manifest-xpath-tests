# QT3 test case CondExpr015 of test set prod-IfExpr, which tests the XPath expression
#   (if (3 != 2) then 16 else 0) + (if (8 = 7) then 4 else 1)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/IfExpr.xml#L171
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( IF( ( "3"^^xsd:integer != "2"^^xsd:integer ) , "16"^^xsd:integer , "0"^^xsd:integer ) + IF( ( "8"^^xsd:integer = "7"^^xsd:integer ) , "4"^^xsd:integer , "1"^^xsd:integer ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "17"^^xsd:integer ) ))
}
