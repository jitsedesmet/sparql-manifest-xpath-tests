# QT3 test case op-subtract-yearMonthDurations2args-4 of test set op-subtract-yearMonthDurations, which tests the XPath expression
#   xs:yearMonthDuration("P0Y0M") - xs:yearMonthDuration("P1000Y6M")
# Expecting:
#   <assert-string-value>-P1000Y6M</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDurations.xml#L61
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:yearMonthDuration ( "P0Y0M" ) - xsd:yearMonthDuration ( "P1000Y6M" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-P1000Y6M" ))
}
