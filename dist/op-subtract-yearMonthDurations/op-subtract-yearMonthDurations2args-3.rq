# QT3 test case op-subtract-yearMonthDurations2args-3 of test set op-subtract-yearMonthDurations, which tests the XPath expression
#   xs:yearMonthDuration("P2030Y12M") - xs:yearMonthDuration("P0Y0M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P2030Y12M" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P0Y0M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "P2031Y" ))
}
