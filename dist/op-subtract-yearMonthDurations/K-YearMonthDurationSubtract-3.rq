# QT3 test case K-YearMonthDurationSubtract-3 of test set op-subtract-yearMonthDurations, which tests the XPath expression
#   xs:yearMonthDuration("P32Y43M") - xs:yearMonthDuration("P12Y13M") eq xs:yearMonthDuration("P22Y6M")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDurations.xml#L390
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, = on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:yearMonthDuration ( "P32Y43M" ) - xsd:yearMonthDuration ( "P12Y13M" ) ) = xsd:yearMonthDuration ( "P22Y6M" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
