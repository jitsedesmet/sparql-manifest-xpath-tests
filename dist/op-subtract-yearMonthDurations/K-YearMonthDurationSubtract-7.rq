# QT3 test case K-YearMonthDurationSubtract-7 of test set op-subtract-yearMonthDurations, which tests the XPath expression
#   xs:yearMonthDuration("P3Y3M") + xs:duration("P3D")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDurations.xml#L450
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:yearMonthDuration ( "P3Y3M" ) + xsd:duration ( "P3D" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
