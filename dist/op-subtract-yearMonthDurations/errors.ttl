  rdfs:comment "*******************************************************\n Test: K-YearMonthDurationSubtract-4                   \n Written by: Frans Englich                             \n Date: 2007-11-22T11:31:21+01:00                       \n Purpose: The addition operator is not available between xs:dayTimeDuration and xs:yearMonthDuration. \n*******************************************************" ;
