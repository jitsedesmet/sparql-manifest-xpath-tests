# QT3 test case op-subtract-yearMonthDurations2args-5 of test set op-subtract-yearMonthDurations, which tests the XPath expression
#   xs:yearMonthDuration("P0Y0M") - xs:yearMonthDuration("P2030Y12M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDurations.xml#L79
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P0Y0M" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P2030Y12M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-P2031Y" ))
}
