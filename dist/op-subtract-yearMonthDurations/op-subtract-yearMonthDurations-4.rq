# QT3 test case op-subtract-yearMonthDurations-4 of test set op-subtract-yearMonthDurations, which tests the XPath expression
#   fn:not(fn:string(xs:yearMonthDuration("P11Y04M") - xs:yearMonthDuration("P02Y11M")))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDurations.xml#L147
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, which SPARQL does not define
ASK {
  BIND(! <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P11Y04M" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P02Y11M" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
