# QT3 test case op-subtract-yearMonthDurations-12 of test set op-subtract-yearMonthDurations, which tests the XPath expression
#   fn:string((xs:yearMonthDuration("P10Y11M") - xs:yearMonthDuration("P05Y07M"))) and (fn:true())
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P10Y11M" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P05Y07M" ) ) ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
