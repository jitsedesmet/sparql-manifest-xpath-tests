# QT3 test case op-subtract-yearMonthDurations-15 of test set op-subtract-yearMonthDurations, which tests the XPath expression
#   (xs:yearMonthDuration("P10Y01M") - xs:yearMonthDuration("P17Y02M")) le xs:yearMonthDuration("P17Y02M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDurations.xml#L328
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, <= on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:yearMonthDuration ( "P10Y01M" ) - xsd:yearMonthDuration ( "P17Y02M" ) ) <= xsd:yearMonthDuration ( "P17Y02M" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
