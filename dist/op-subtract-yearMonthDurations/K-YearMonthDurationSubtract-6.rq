# QT3 test case K-YearMonthDurationSubtract-6 of test set op-subtract-yearMonthDurations, which tests the XPath expression
#   xs:duration("P3D") + xs:yearMonthDuration("P3Y3M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#duration> ( "P3D" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P3Y3M" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
