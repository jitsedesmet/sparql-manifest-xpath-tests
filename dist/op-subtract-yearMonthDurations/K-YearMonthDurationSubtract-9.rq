# QT3 test case K-YearMonthDurationSubtract-9 of test set op-subtract-yearMonthDurations, which tests the XPath expression
#   xs:duration("P3Y3M") + xs:dayTimeDuration("P3D")
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDurations.xml#L480
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:duration ( "P3Y3M" ) + xsd:dayTimeDuration ( "P3D" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
