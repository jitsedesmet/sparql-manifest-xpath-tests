# QT3 test case op-subtract-yearMonthDurations-14 of test set op-subtract-yearMonthDurations, which tests the XPath expression
#   (xs:yearMonthDuration("P21Y12M") - xs:yearMonthDuration("P08Y05M")) ne xs:yearMonthDuration("P08Y05M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDurations.xml#L312
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, != on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:yearMonthDuration ( "P21Y12M" ) - xsd:yearMonthDuration ( "P08Y05M" ) ) != xsd:yearMonthDuration ( "P08Y05M" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
