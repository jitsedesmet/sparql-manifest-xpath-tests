# QT3 test case op-subtract-yearMonthDurations-10 of test set op-subtract-yearMonthDurations, which tests the XPath expression
#   fn:string((xs:yearMonthDuration("P05Y02M") - xs:yearMonthDuration("P03Y04M"))) or fn:string((xs:yearMonthDuration("P05Y03M") - xs:yearMonthDuration("P01Y03M")))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDurations.xml#L246
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:yearMonthDuration ( "P05Y02M" ) - xsd:yearMonthDuration ( "P03Y04M" ) ) ) || xsd:string ( ( xsd:yearMonthDuration ( "P05Y03M" ) - xsd:yearMonthDuration ( "P01Y03M" ) ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
