# QT3 test case K-YearMonthDurationSubtract-8 of test set op-subtract-yearMonthDurations, which tests the XPath expression
#   xs:dayTimeDuration("P3D") + xs:duration("P3Y3M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDurations.xml#L465
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:dayTimeDuration ( "P3D" ) + xsd:duration ( "P3Y3M" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
