# QT3 test case CastAs117 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("P3DT10H30M") cast as xs:dayTimeDuration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( <http://www.w3.org/2001/XMLSchema#string> ( "P3DT10H30M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "P3DT10H30M" ))
}
