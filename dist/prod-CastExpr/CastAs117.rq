# QT3 test case CastAs117 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("P3DT10H30M") cast as xs:dayTimeDuration
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L1446
# The test needs the constructor function xsd:dayTimeDuration, xsd:string on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:dayTimeDuration ( xsd:string ( "P3DT10H30M" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "P3DT10H30M" ))
}
