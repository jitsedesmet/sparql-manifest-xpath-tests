# QT3 test case K2-SeqExprCast-6 of test set prod-CastExpr, which tests the XPath expression
#   xs:int("2147483647")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L20742
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND("2147483647"^^xsd:int AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "2147483647"^^xsd:integer ) ))
}
