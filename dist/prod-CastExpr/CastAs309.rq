# QT3 test case CastAs309 of test set prod-CastExpr, which tests the XPath expression
#   xs:yearMonthDuration("P1Y2M") cast as xs:duration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#duration> ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1Y2M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "P1Y2M" ))
}
