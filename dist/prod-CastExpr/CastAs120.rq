# QT3 test case CastAs120 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("1999-05-31T13:20:00") cast as xs:dateTime
# Expecting:
#   <assert-string-value>1999-05-31T13:20:00</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L1473
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:dateTime ( xsd:string ( "1999-05-31T13:20:00" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1999-05-31T13:20:00" ))
}
