# QT3 test case CastAs120 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("1999-05-31T13:20:00") cast as xs:dateTime
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dateTime> ( <http://www.w3.org/2001/XMLSchema#string> ( "1999-05-31T13:20:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1999-05-31T13:20:00" ))
}
