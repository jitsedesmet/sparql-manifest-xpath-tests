# QT3 test case K-SeqExprCast-17 of test set prod-CastExpr, which tests the XPath expression
#   '0' cast as xs:boolean eq false()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L7371
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "0" ) = "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
