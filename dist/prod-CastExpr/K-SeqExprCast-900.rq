# QT3 test case K-SeqExprCast-900 of test set prod-CastExpr, which tests the XPath expression
#   xs:date(" 2004-10-13 ") eq xs:date(" 2004-10-13 ")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( " 2004-10-13 " ) = <http://www.w3.org/2001/XMLSchema#date> ( " 2004-10-13 " ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
