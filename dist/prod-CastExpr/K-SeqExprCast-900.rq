# QT3 test case K-SeqExprCast-900 of test set prod-CastExpr, which tests the XPath expression
#   xs:date(" 2004-10-13 ") eq xs:date(" 2004-10-13 ")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L15345
# The test needs the constructor function xsd:date, = on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:date ( " 2004-10-13 " ) = xsd:date ( " 2004-10-13 " ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
