# QT3 test case casthc5 of test set prod-CastExpr, which tests the XPath expression
#   (5 + 5) cast as xs:decimal
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L51
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#decimal> ( ( "5"^^<http://www.w3.org/2001/XMLSchema#integer> + "5"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ?result = "10"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
