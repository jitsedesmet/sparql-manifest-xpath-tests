# QT3 test case K-SeqExprCast-712 of test set prod-CastExpr, which tests the XPath expression
#   xs:yearMonthDuration("P1Y12M") cast as xs:dayTimeDuration ne xs:dayTimeDuration("P3DT2H")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L13649
# The test needs the constructor function xsd:yearMonthDuration, xsd:dayTimeDuration on xsd:yearMonthDuration, the constructor function xsd:dayTimeDuration, != on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:dayTimeDuration ( xsd:yearMonthDuration ( "P1Y12M" ) ) != xsd:dayTimeDuration ( "P3DT2H" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
