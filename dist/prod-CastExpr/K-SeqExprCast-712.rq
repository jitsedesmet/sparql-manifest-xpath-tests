# QT3 test case K-SeqExprCast-712 of test set prod-CastExpr, which tests the XPath expression
#   xs:yearMonthDuration("P1Y12M") cast as xs:dayTimeDuration ne xs:dayTimeDuration("P3DT2H")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1Y12M" ) ) != <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P3DT2H" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
