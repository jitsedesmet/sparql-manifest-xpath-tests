# QT3 test case K-SeqExprCast-536 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal(" 10.01 ") eq xs:decimal(" 10.01 ")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( " 10.01 " ) = <http://www.w3.org/2001/XMLSchema#decimal> ( " 10.01 " ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
