# QT3 test case K-SeqExprCast-536 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal(" 10.01 ") eq xs:decimal(" 10.01 ")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L12062
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:decimal ( " 10.01 " ) = xsd:decimal ( " 10.01 " ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
