# QT3 test case K-SeqExprCast-309 of test set prod-CastExpr, which tests the XPath expression
#   xs:dateTime("02004-08-01T12:44:05")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L10010
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dateTime> ( "02004-08-01T12:44:05" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
