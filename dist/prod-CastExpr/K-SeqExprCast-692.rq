# QT3 test case K-SeqExprCast-692 of test set prod-CastExpr, which tests the XPath expression
#   xs:yearMonthDuration(" P1Y12M ") eq xs:yearMonthDuration(" P1Y12M ")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L13469
# The test needs the constructor function xsd:yearMonthDuration, = on xsd:yearMonthDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( " P1Y12M " ) = <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( " P1Y12M " ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
