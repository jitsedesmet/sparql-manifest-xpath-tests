# QT3 test case K-SeqExprCast-402 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:date("1999-12-01+00:00")) eq "1999-12-01Z"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L10847
# The test needs the constructor function xsd:date, xsd:string on xsd:date, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#date> ( "1999-12-01+00:00" ) ) = "1999-12-01Z" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
