# QT3 test case CastAs102 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("5.5432") cast as xs:decimal
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#decimal> ( <http://www.w3.org/2001/XMLSchema#string> ( "5.5432" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "5.5432" ))
}
