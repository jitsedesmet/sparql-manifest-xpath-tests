# QT3 test case CastAs115 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("true") cast as xs:yearMonthDuration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( <http://www.w3.org/2001/XMLSchema#string> ( "true" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
