# QT3 test case K2-SeqExprCast-522 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("naN")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L25494
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#float> ( "naN" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
