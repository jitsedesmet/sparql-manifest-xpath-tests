# QT3 test case K2-SeqExprCast-485 of test set prod-CastExpr, which tests the XPath expression
#   "-inF " cast as xs:decimal
# Expecting:
#   <error code="FORG0001"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L25159
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:decimal ( "-inF " ) AS ?result)
  FILTER(! BOUND( ?result ))
}
