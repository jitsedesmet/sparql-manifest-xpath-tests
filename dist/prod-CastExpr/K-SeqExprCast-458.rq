# QT3 test case K-SeqExprCast-458 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("3.4e5") cast as xs:dateTime
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L11358
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dateTime> ( <http://www.w3.org/2001/XMLSchema#float> ( "3.4e5" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
