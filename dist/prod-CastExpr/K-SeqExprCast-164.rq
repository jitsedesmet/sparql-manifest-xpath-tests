# QT3 test case K-SeqExprCast-164 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:duration("-PT0S")) eq "PT0S"
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L8714
# The test needs the constructor function xsd:duration, xsd:string on xsd:duration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( xsd:duration ( "-PT0S" ) ) = "PT0S" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
