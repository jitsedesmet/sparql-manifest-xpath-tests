# QT3 test case CastAs692 of test set prod-CastExpr, which tests the XPath expression
#   xs:dayTimeDuration('PT10M1e2S')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L6800
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "PT10M1e2S" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
