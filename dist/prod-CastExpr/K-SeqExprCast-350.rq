# QT3 test case K-SeqExprCast-350 of test set prod-CastExpr, which tests the XPath expression
#   string(xs:dateTime("2004-03-31T24:00:00")) eq "2004-04-01T00:00:00"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L10379
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2004-03-31T24:00:00" ) ) = "2004-04-01T00:00:00" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
