# QT3 test case CastAs680 of test set prod-CastExpr, which tests the XPath expression
#   xs:time('12:00:00-00:30')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L6672
# The test needs the constructor function xsd:time, xsd:string on xsd:time, which SPARQL does not define
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#time> ( "12:00:00-00:30" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "12:00:00-00:30" ))
}
