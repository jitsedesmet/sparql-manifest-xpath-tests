# QT3 test case CastAs240 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("5.5432") cast as xs:integer
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#integer> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "5.5432" ) ) AS ?result)
  FILTER(( ?result = "5"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
