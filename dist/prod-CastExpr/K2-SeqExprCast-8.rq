# QT3 test case K2-SeqExprCast-8 of test set prod-CastExpr, which tests the XPath expression
#   xs:byte("-128")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L20760
ASK {
  BIND("-128"^^<http://www.w3.org/2001/XMLSchema#byte> AS ?result)
  FILTER(( ?result = - "128"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
