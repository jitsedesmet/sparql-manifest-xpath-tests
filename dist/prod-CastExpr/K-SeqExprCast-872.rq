# QT3 test case K-SeqExprCast-872 of test set prod-CastExpr, which tests the XPath expression
#   xs:time("03:20:00-05:00") cast as xs:time eq xs:time("03:20:00-05:00")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L15092
# The test needs the constructor function xsd:time, xsd:time on xsd:time, = on xsd:time, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( <http://www.w3.org/2001/XMLSchema#time> ( "03:20:00-05:00" ) ) = <http://www.w3.org/2001/XMLSchema#time> ( "03:20:00-05:00" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
