# QT3 test case CastAs202 of test set prod-CastExpr, which tests the XPath expression
#   xs:double("INF") cast as xs:string
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#double> ( "INF" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "INF" ))
}
