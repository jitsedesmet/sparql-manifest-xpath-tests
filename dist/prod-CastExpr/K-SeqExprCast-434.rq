# QT3 test case K-SeqExprCast-434 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("an arbitrary string") cast as xs:string eq xs:string("an arbitrary string")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L11141
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#string> ( "an arbitrary string" ) ) = <http://www.w3.org/2001/XMLSchema#string> ( "an arbitrary string" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
