# QT3 test case K-SeqExprCast-367 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:time("21:01:23.000")) eq "21:01:23"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#time> ( "21:01:23.000" ) ) = "21:01:23" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
