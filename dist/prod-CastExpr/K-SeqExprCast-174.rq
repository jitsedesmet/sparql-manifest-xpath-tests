# QT3 test case K-SeqExprCast-174 of test set prod-CastExpr, which tests the XPath expression
#   xs:dayTimeDuration("P1DT")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L8804
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P1DT" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
