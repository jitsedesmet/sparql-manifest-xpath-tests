# QT3 test case K-SeqExprCast-183 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:dayTimeDuration("P9876DT1M")) eq "P9876DT1M"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P9876DT1M" ) ) = "P9876DT1M" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
