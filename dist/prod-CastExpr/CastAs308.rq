# QT3 test case CastAs308 of test set prod-CastExpr, which tests the XPath expression
#   xs:yearMonthDuration("P1Y2M") cast as xs:integer
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#integer> ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1Y2M" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
