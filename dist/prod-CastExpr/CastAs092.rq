# QT3 test case CastAs092 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("-10000000") cast as xs:float
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#float> ( <http://www.w3.org/2001/XMLSchema#string> ( "-10000000" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-1.0E7" ))
}
