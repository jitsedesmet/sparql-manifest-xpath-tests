# QT3 test case CastAs092 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("-10000000") cast as xs:float
# Expecting:
#   <assert-string-value>-1.0E7</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L1221
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:float ( xsd:string ( "-10000000" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-1.0E7" ))
}
