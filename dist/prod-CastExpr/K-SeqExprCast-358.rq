# QT3 test case K-SeqExprCast-358 of test set prod-CastExpr, which tests the XPath expression
#   xs:time("2002-02-15T08:12:12")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L10451
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#time> ( "2002-02-15T08:12:12" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
