# QT3 test case CastAs176 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("1e5") cast as xs:decimal
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#decimal> ( <http://www.w3.org/2001/XMLSchema#float> ( "1e5" ) ) AS ?result)
  FILTER(( ?result = "100000"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
