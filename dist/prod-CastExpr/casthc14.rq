# QT3 test case casthc14 of test set prod-CastExpr, which tests the XPath expression
#   (xs:double(1267.43233E12) cast as xs:float) eq xs:float(1267.43233E12)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L132
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:float ( xsd:double ( "1267.43233E12"^^xsd:double ) ) = xsd:float ( "1267.43233E12"^^xsd:double ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
