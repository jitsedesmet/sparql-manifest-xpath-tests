# QT3 test case casthc14 of test set prod-CastExpr, which tests the XPath expression
#   (xs:double(1267.43233E12) cast as xs:float) eq xs:float(1267.43233E12)
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( <http://www.w3.org/2001/XMLSchema#double> ( "1267.43233E12"^^<http://www.w3.org/2001/XMLSchema#double> ) ) = <http://www.w3.org/2001/XMLSchema#float> ( "1267.43233E12"^^<http://www.w3.org/2001/XMLSchema#double> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
