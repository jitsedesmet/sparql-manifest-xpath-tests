# QT3 test case K-SeqExprCast-522 of test set prod-CastExpr, which tests the XPath expression
#   xs:double("3.3e3") cast as xs:boolean eq xs:boolean("true")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L11935
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( <http://www.w3.org/2001/XMLSchema#double> ( "3.3e3" ) ) = <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
