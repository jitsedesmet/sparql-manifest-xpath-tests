# QT3 test case CastAs095 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("NaN") cast as xs:double
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L1248
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#double> ( <http://www.w3.org/2001/XMLSchema#string> ( "NaN" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "NaN" ))
}
