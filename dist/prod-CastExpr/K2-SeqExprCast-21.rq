# QT3 test case K2-SeqExprCast-21 of test set prod-CastExpr, which tests the XPath expression
#   xs:nonNegativeInteger("999999999999999999")
ASK {
  BIND("999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> AS ?result)
  FILTER(( ?result = "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
