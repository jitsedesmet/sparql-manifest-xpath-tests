<#CastAs688> a mf:QueryEvaluationTest ;
  mf:name "CastAs688" ;
  rdfs:comment "Leading decimal point in duration values. This is contentious:\n         XSD 1.0 clearly requires a digit before and after the decimal\n         point. XSD 1.1 apparently doesn't, but this is believed to\n         be an error in the spec." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L6744> ;
  mf:action [ qt:query <CastAs688.rq> ] ;
  mf:result <../true.srj> .

<#CastAs689> a mf:QueryEvaluationTest ;
  mf:name "CastAs689" ;
  rdfs:comment "Leading decimal point in duration values. This is contentious:\n         XSD 1.0 clearly requires a digit before and after the decimal\n         point. XSD 1.1 apparently doesn't, but this is believed to\n         be an error in the spec." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L6758> ;
  mf:action [ qt:query <CastAs689.rq> ] ;
  mf:result <../true.srj> .

<#CastAs690> a mf:QueryEvaluationTest ;
  mf:name "CastAs690" ;
  rdfs:comment "Trailing decimal point in duration values. This is contentious:\n         XSD 1.0 clearly requires a digit before and after the decimal\n         point. XSD 1.1 apparently doesn't, but this is believed to\n         be an error in the spec." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L6772> ;
  mf:action [ qt:query <CastAs690.rq> ] ;
  mf:result <../true.srj> .

