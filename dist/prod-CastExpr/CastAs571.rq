# QT3 test case CastAs571 of test set prod-CastExpr, which tests the XPath expression
#   xs:boolean("true") cast as xs:boolean
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#boolean> ( <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
