# QT3 test case casthc4 of test set prod-CastExpr, which tests the XPath expression
#   (5 + 5) cast as xs:double
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L42
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:double ( ( "5"^^xsd:integer + "5"^^xsd:integer ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "10"^^xsd:integer ) ))
}
