# QT3 test case K2-SeqExprCast-4 of test set prod-CastExpr, which tests the XPath expression
#   xs:negativeInteger("-1")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L20724
ASK {
  BIND("-1"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> AS ?result)
  FILTER(( ?result = - "1"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
