# QT3 test case K-SeqExprCast-851 of test set prod-CastExpr, which tests the XPath expression
#   boolean(xs:time("03:20:00-05:00"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L14903
ASK {
  BIND(! ( ! <http://www.w3.org/2001/XMLSchema#time> ( "03:20:00-05:00" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
