# QT3 test case K-SeqExprCast-21 of test set prod-CastExpr, which tests the XPath expression
#   xs:boolean(xs:string(1)) eq true()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L7407
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( <http://www.w3.org/2001/XMLSchema#string> ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) = "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
