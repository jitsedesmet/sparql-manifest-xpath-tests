# QT3 test case K-SeqExprCast-454 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("3.4e5") cast as xs:yearMonthDuration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( <http://www.w3.org/2001/XMLSchema#float> ( "3.4e5" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
