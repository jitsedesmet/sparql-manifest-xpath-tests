# QT3 test case K-SeqExprCast-157 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:duration("-PT8H23M0S")) eq "-PT8H23M"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L8651
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#duration> ( "-PT8H23M0S" ) ) = "-PT8H23M" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
