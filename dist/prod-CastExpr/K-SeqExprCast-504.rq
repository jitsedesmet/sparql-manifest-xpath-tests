# QT3 test case K-SeqExprCast-504 of test set prod-CastExpr, which tests the XPath expression
#   xs:double("3.3e3") cast as xs:dayTimeDuration
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L11773
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( <http://www.w3.org/2001/XMLSchema#double> ( "3.3e3" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
