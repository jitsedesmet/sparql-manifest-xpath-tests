# QT3 test case K-SeqExprCast-340 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:dateTime("1999-12-01T23:59:12.999-00:00")) eq "1999-12-01T23:59:12.999Z"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-12-01T23:59:12.999-00:00" ) ) = "1999-12-01T23:59:12.999Z" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
