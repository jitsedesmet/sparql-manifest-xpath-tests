# QT3 test case K-SeqExprCast-319 of test set prod-CastExpr, which tests the XPath expression
#   xs:dateTime("2002-02-15T21:01:60")
# Expecting:
#   <error code="FORG0001"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L10100
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:dateTime ( "2002-02-15T21:01:60" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
