# QT3 test case K2-SeqExprCast-7 of test set prod-CastExpr, which tests the XPath expression
#   xs:short("-32768")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L20751
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND("-32768"^^xsd:short AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-32768"^^xsd:integer ) ))
}
