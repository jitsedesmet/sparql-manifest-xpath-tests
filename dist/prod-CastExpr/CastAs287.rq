# QT3 test case CastAs287 of test set prod-CastExpr, which tests the XPath expression
#   xs:duration("P24M") cast as xs:yearMonthDuration
# Expecting:
#   <assert-string-value>P2Y</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L3024
# The test needs the constructor function xsd:duration, xsd:yearMonthDuration on xsd:duration, the constructor function xsd:yearMonthDuration, xsd:string on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:yearMonthDuration ( xsd:duration ( "P24M" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "P2Y" ))
}
