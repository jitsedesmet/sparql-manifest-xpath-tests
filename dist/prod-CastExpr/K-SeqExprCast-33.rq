# QT3 test case K-SeqExprCast-33 of test set prod-CastExpr, which tests the XPath expression
#   xs:boolean(0.0E0) eq false()
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "0.0E0"^^<http://www.w3.org/2001/XMLSchema#double> ) = "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
