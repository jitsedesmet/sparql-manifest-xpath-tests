# QT3 test case casthc23 of test set prod-CastExpr, which tests the XPath expression
#   (xs:integer(12678967543233) cast as xs:float) eq xs:float(12678967543233)
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( <http://www.w3.org/2001/XMLSchema#integer> ( "12678967543233"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) = <http://www.w3.org/2001/XMLSchema#float> ( "12678967543233"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
