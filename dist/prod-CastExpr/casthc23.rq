# QT3 test case casthc23 of test set prod-CastExpr, which tests the XPath expression
#   (xs:integer(12678967543233) cast as xs:float) eq xs:float(12678967543233)
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L213
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:float ( xsd:integer ( "12678967543233"^^xsd:integer ) ) = xsd:float ( "12678967543233"^^xsd:integer ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
