# QT3 test case CastAs180 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("INF") cast as xs:integer
# Expecting:
#   <error code="FOCA0002"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L2016
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:integer ( xsd:float ( "INF" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
