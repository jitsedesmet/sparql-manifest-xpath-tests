# QT3 test case K-SeqExprCast-443 of test set prod-CastExpr, which tests the XPath expression
#   boolean(xs:float("3.4e5"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L11223
ASK {
  BIND(! ( ! <http://www.w3.org/2001/XMLSchema#float> ( "3.4e5" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
