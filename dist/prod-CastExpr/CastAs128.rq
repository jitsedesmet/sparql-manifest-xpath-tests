# QT3 test case CastAs128 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("1999-05-31") cast as xs:date
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#date> ( <http://www.w3.org/2001/XMLSchema#string> ( "1999-05-31" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1999-05-31" ))
}
