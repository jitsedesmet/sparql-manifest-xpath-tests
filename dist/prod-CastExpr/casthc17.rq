# QT3 test case casthc17 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal(12678967.543233) cast as xs:float
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#float> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "12678967.543233"^^<http://www.w3.org/2001/XMLSchema#decimal> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1.2678968E7" ))
}
