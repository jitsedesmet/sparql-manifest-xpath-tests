# QT3 test case casthc17 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal(12678967.543233) cast as xs:float
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L159
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:float ( xsd:decimal ( "12678967.543233"^^xsd:decimal ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1.2678968E7" ))
}
