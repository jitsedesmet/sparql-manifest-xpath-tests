# QT3 test case CastAs561 of test set prod-CastExpr, which tests the XPath expression
#   xs:boolean("true") cast as xs:yearMonthDuration
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L5514
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
