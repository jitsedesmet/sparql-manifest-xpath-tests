# QT3 test case K-SeqExprCast-159 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:duration("P365D")) eq "P365D"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#duration> ( "P365D" ) ) = "P365D" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
