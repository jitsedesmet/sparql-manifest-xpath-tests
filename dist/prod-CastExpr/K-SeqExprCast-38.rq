# QT3 test case K-SeqExprCast-38 of test set prod-CastExpr, which tests the XPath expression
#   true() cast as xs:string eq "true"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) = "true" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
