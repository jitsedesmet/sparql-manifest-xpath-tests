# QT3 test case K-SeqExprCast-640 of test set prod-CastExpr, which tests the XPath expression
#   xs:duration(" P1Y2M3DT10H30M ") eq xs:duration(" P1Y2M3DT10H30M ")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#duration> ( " P1Y2M3DT10H30M " ) = <http://www.w3.org/2001/XMLSchema#duration> ( " P1Y2M3DT10H30M " ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
