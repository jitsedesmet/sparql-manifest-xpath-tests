# QT3 test case K-SeqExprCast-640 of test set prod-CastExpr, which tests the XPath expression
#   xs:duration(" P1Y2M3DT10H30M ") eq xs:duration(" P1Y2M3DT10H30M ")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L13000
# The test needs the constructor function xsd:duration, = on xsd:duration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#duration> ( " P1Y2M3DT10H30M " ) = <http://www.w3.org/2001/XMLSchema#duration> ( " P1Y2M3DT10H30M " ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
