# QT3 test case K-SeqExprCast-168 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:duration(xs:yearMonthDuration("-P543Y456M"))) eq "-P581Y"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#duration> ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "-P543Y456M" ) ) ) = "-P581Y" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
