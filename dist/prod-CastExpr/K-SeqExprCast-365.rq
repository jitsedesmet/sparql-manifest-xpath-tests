# QT3 test case K-SeqExprCast-365 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:time("23:59:12.999-00:00")) eq "23:59:12.999Z"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L10514
# The test needs the constructor function xsd:time, xsd:string on xsd:time, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#time> ( "23:59:12.999-00:00" ) ) = "23:59:12.999Z" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
