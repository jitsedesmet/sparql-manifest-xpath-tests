# QT3 test case K-SeqExprCast-365 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:time("23:59:12.999-00:00")) eq "23:59:12.999Z"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#time> ( "23:59:12.999-00:00" ) ) = "23:59:12.999Z" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
