# QT3 test case CastAs091 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("1e-5") cast as xs:float
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#float> ( <http://www.w3.org/2001/XMLSchema#string> ( "1e-5" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0.00001" ))
}
