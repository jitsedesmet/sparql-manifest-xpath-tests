# QT3 test case CastAs091 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("1e-5") cast as xs:float
# Expecting:
#   <assert-string-value>0.00001</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L1212
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:float ( xsd:string ( "1e-5" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "0.00001" ))
}
