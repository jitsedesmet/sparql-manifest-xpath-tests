# QT3 test case CastAs693 of test set prod-CastExpr, which tests the XPath expression
#   xs:yearMonthDuration('P1e3M')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L6811
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1e3M" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
