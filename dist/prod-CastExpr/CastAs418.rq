# QT3 test case CastAs418 of test set prod-CastExpr, which tests the XPath expression
#   xs:date("1999-05-31") cast as xs:date
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L4211
# The test needs the constructor function xsd:date, xsd:date on xsd:date, xsd:string on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:date ( xsd:date ( "1999-05-31" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1999-05-31" ))
}
