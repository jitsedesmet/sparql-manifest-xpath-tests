# QT3 test case K2-SeqExprCast-138 of test set prod-CastExpr, which tests the XPath expression
#   xs:byte("000000001")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L21951
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND("000000001"^^xsd:byte AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "1"^^xsd:integer ) ))
}
