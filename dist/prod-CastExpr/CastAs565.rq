# QT3 test case CastAs565 of test set prod-CastExpr, which tests the XPath expression
#   xs:boolean("true") cast as xs:date
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L5550
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:date ( xsd:boolean ( "true" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
