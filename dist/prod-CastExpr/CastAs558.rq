# QT3 test case CastAs558 of test set prod-CastExpr, which tests the XPath expression
#   xs:boolean("true") cast as xs:integer
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#integer> ( <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ?result = "1"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
