# QT3 test case K-SeqExprCast-196 of test set prod-CastExpr, which tests the XPath expression
#   xs:yearMonthDuration("20Y15M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L9002
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "20Y15M" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
