# QT3 test case K2-SeqExprCast-512 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("inf")
# Expecting:
#   <error code="FORG0001"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L25404
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:decimal ( "inf" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
