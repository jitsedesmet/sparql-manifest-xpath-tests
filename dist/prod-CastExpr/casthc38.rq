# QT3 test case casthc38 of test set prod-CastExpr, which tests the XPath expression
#   fn:true() cast as xs:float
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L348
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:float ( "true"^^xsd:boolean ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "1"^^xsd:integer ) ))
}
