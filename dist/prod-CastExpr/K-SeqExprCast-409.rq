# QT3 test case K-SeqExprCast-409 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:date("2002-02-15")) eq "2002-02-15"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#date> ( "2002-02-15" ) ) = "2002-02-15" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
