# QT3 test case K-SeqExprCast-209 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:yearMonthDuration(xs:dayTimeDuration("P31DT3H2M10.001S"))) eq "P0M"
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L9119
# The test needs the constructor function xsd:dayTimeDuration, xsd:yearMonthDuration on xsd:dayTimeDuration, the constructor function xsd:yearMonthDuration, xsd:string on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( xsd:yearMonthDuration ( xsd:dayTimeDuration ( "P31DT3H2M10.001S" ) ) ) = "P0M" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
