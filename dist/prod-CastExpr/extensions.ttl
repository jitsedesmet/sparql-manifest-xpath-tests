  rdfs:comment "A simple test exercising the whitespace facet for type xs:date." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L15345> ;
  mf:action [ qt:query <K-SeqExprCast-900.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-906> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-906" ;
  rdfs:comment "Casting from xs:date to xs:string is allowed and should always succeed." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L15399> ;
  mf:action [ qt:query <K-SeqExprCast-906.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-922> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-922" ;
  rdfs:comment "Casting from xs:date to xs:dateTime is allowed and should always succeed." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L15543> ;
  mf:action [ qt:query <K-SeqExprCast-922.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-926> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-926" ;
  rdfs:comment "Casting from xs:date to xs:date is allowed and should always succeed." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L15579> ;
  mf:action [ qt:query <K-SeqExprCast-926.rq> ] ;
  mf:result <../true.srj> .
