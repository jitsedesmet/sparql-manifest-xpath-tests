<#casthc30> a mf:QueryEvaluationTest ;
  mf:name "casthc30" ;
  rdfs:comment "Simple test for casting an dateTime as a time" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L276> ;
  mf:action [ qt:query <casthc30.rq> ] ;
  mf:result <../true.srj> .

