# QT3 test case K2-SeqExprCast-441 of test set prod-CastExpr, which tests the XPath expression
#   xs:time("11:11:1b0")
# Expecting:
#   <error code="FORG0001"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L24748
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:time ( "11:11:1b0" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
