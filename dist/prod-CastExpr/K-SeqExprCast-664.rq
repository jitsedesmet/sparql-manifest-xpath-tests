# QT3 test case K-SeqExprCast-664 of test set prod-CastExpr, which tests the XPath expression
#   xs:duration("P1Y2M3DT10H30M") cast as xs:time
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#time> ( <http://www.w3.org/2001/XMLSchema#duration> ( "P1Y2M3DT10H30M" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
