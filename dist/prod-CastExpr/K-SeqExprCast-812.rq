# QT3 test case K-SeqExprCast-812 of test set prod-CastExpr, which tests the XPath expression
#   xs:dateTime("2002-10-10T12:00:00-05:00") cast as xs:duration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#duration> ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2002-10-10T12:00:00-05:00" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
