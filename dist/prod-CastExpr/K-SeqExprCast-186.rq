# QT3 test case K-SeqExprCast-186 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:dayTimeDuration("PT1M1231.432S")) eq "PT21M31.432S"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "PT1M1231.432S" ) ) = "PT21M31.432S" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
