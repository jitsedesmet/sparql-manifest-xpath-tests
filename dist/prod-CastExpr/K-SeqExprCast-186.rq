# QT3 test case K-SeqExprCast-186 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:dayTimeDuration("PT1M1231.432S")) eq "PT21M31.432S"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L8912
# The test needs the constructor function xsd:dayTimeDuration, xsd:string on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "PT1M1231.432S" ) ) = "PT21M31.432S" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
