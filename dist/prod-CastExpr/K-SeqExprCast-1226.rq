# QT3 test case K-SeqExprCast-1226 of test set prod-CastExpr, which tests the XPath expression
#   xs:boolean("true") cast as xs:integer ne xs:integer("6789")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L18286
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:integer ( xsd:boolean ( "true" ) ) != xsd:integer ( "6789" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
