# QT3 test case K-SeqExprCast-429 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("") eq xs:string("")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( "" ) = <http://www.w3.org/2001/XMLSchema#string> ( "" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
