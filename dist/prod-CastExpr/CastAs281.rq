# QT3 test case CastAs281 of test set prod-CastExpr, which tests the XPath expression
#   xs:duration("P1Y2M3DT10H30M23S") cast as xs:decimal
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#decimal> ( <http://www.w3.org/2001/XMLSchema#duration> ( "P1Y2M3DT10H30M23S" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
