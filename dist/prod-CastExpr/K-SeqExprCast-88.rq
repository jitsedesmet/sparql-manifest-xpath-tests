# QT3 test case K-SeqExprCast-88 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer(3) eq 3
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#integer> ( "3"^^<http://www.w3.org/2001/XMLSchema#integer> ) = "3"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
