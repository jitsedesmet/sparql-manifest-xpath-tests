# QT3 test case casthc32 of test set prod-CastExpr, which tests the XPath expression
#   xs:date("1999-05-31") cast as xs:string
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#date> ( "1999-05-31" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1999-05-31" ))
}
