# QT3 test case K-SeqExprCast-544 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("10.01") cast as xs:float ne xs:float("3.4e5")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "10.01" ) ) != <http://www.w3.org/2001/XMLSchema#float> ( "3.4e5" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
