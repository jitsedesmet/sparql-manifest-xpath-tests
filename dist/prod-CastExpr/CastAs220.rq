# QT3 test case CastAs220 of test set prod-CastExpr, which tests the XPath expression
#   xs:double("1e5") cast as xs:yearMonthDuration
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L2421
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:yearMonthDuration ( xsd:double ( "1e5" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
