# QT3 test case CastAs220 of test set prod-CastExpr, which tests the XPath expression
#   xs:double("1e5") cast as xs:yearMonthDuration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( <http://www.w3.org/2001/XMLSchema#double> ( "1e5" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
