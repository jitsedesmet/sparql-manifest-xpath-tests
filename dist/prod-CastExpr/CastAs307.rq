# QT3 test case CastAs307 of test set prod-CastExpr, which tests the XPath expression
#   xs:yearMonthDuration("P1Y2M") cast as xs:decimal
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L3204
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#decimal> ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1Y2M" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
