# QT3 test case K-SeqExprCast-926 of test set prod-CastExpr, which tests the XPath expression
#   xs:date("2004-10-13") cast as xs:date eq xs:date("2004-10-13")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L15579
# The test needs the constructor function xsd:date, xsd:date on xsd:date, = on xsd:date, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( <http://www.w3.org/2001/XMLSchema#date> ( "2004-10-13" ) ) = <http://www.w3.org/2001/XMLSchema#date> ( "2004-10-13" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
