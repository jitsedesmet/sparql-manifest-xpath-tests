# QT3 test case casthc13 of test set prod-CastExpr, which tests the XPath expression
#   xs:double(1267.43233E12) cast as xs:string
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#double> ( "1267.43233E12"^^<http://www.w3.org/2001/XMLSchema#double> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1.26743233E15" ))
}
