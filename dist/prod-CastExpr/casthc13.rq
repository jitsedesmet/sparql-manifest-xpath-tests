# QT3 test case casthc13 of test set prod-CastExpr, which tests the XPath expression
#   xs:double(1267.43233E12) cast as xs:string
# Expecting:
#   <assert-string-value>1.26743233E15</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L123
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( xsd:double ( "1267.43233E12"^^xsd:double ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1.26743233E15" ))
}
