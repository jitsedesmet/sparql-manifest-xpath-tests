# QT3 test case CastAs338 of test set prod-CastExpr, which tests the XPath expression
#   xs:dayTimeDuration("P14D") cast as xs:dayTimeDuration
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L3483
# The test needs the constructor function xsd:dayTimeDuration, xsd:dayTimeDuration on xsd:dayTimeDuration, xsd:string on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:dayTimeDuration ( xsd:dayTimeDuration ( "P14D" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "P14D" ))
}
