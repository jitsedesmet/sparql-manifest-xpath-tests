# QT3 test case CastAs109 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("P1Y2M3DT10H30M23S") cast as xs:duration
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L1374
# The test needs the constructor function xsd:duration, xsd:string on xsd:duration, which SPARQL does not define
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#duration> ( <http://www.w3.org/2001/XMLSchema#string> ( "P1Y2M3DT10H30M23S" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "P1Y2M3DT10H30M23S" ))
}
