# QT3 test case CastAs179 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("1e5") cast as xs:integer
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L2007
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#integer> ( <http://www.w3.org/2001/XMLSchema#float> ( "1e5" ) ) AS ?result)
  FILTER(( ?result = "100000"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
