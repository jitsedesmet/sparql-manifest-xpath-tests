# QT3 test case CastAs357 of test set prod-CastExpr, which tests the XPath expression
#   xs:dateTime("2000-01-16T00:00:00Z") cast as xs:float
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#float> ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2000-01-16T00:00:00Z" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
