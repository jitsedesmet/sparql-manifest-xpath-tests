# QT3 test case K-SeqExprCast-870 of test set prod-CastExpr, which tests the XPath expression
#   xs:time("03:20:00-05:00") cast as xs:dateTime
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dateTime> ( <http://www.w3.org/2001/XMLSchema#time> ( "03:20:00-05:00" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
