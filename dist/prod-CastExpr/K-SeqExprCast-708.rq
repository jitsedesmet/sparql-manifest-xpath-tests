# QT3 test case K-SeqExprCast-708 of test set prod-CastExpr, which tests the XPath expression
#   xs:yearMonthDuration("P1Y12M") cast as xs:duration ne xs:duration("P1Y2M3DT10H30M")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L13613
# The test needs the constructor function xsd:yearMonthDuration, xsd:duration on xsd:yearMonthDuration, the constructor function xsd:duration, != on xsd:duration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:duration ( xsd:yearMonthDuration ( "P1Y12M" ) ) != xsd:duration ( "P1Y2M3DT10H30M" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
