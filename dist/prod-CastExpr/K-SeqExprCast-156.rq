# QT3 test case K-SeqExprCast-156 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:duration("P0Y0M0DT00H00M00.000S")) eq "PT0S"
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L8642
# The test needs the constructor function xsd:duration, xsd:string on xsd:duration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( xsd:duration ( "P0Y0M0DT00H00M00.000S" ) ) = "PT0S" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
