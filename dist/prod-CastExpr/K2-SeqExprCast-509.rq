# QT3 test case K2-SeqExprCast-509 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("inF")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L25377
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#decimal> ( "inF" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
