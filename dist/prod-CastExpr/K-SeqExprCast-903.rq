# QT3 test case K-SeqExprCast-903 of test set prod-CastExpr, which tests the XPath expression
#   boolean(xs:date("2004-10-13"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L15372
ASK {
  BIND(! ! <http://www.w3.org/2001/XMLSchema#date> ( "2004-10-13" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
