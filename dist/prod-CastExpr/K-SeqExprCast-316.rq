# QT3 test case K-SeqExprCast-316 of test set prod-CastExpr, which tests the XPath expression
#   xs:dateTime("2002-02-15T24:01:00")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L10073
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dateTime> ( "2002-02-15T24:01:00" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
