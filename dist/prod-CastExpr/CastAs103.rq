# QT3 test case CastAs103 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("true") cast as xs:decimal
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L1320
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#decimal> ( <http://www.w3.org/2001/XMLSchema#string> ( "true" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
