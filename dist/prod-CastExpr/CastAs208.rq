# QT3 test case CastAs208 of test set prod-CastExpr, which tests the XPath expression
#   xs:double("1e5") cast as xs:double
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L2310
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:double ( xsd:double ( "1e5" ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "100000"^^xsd:integer ) ))
}
