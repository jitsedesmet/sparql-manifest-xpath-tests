# QT3 test case CastAs208 of test set prod-CastExpr, which tests the XPath expression
#   xs:double("1e5") cast as xs:double
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#double> ( <http://www.w3.org/2001/XMLSchema#double> ( "1e5" ) ) AS ?result)
  FILTER(( ?result = "100000"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
