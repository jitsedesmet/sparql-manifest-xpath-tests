# QT3 test case casthc22 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer(12678967543233) cast as xs:string
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#integer> ( "12678967543233"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "12678967543233" ))
}
