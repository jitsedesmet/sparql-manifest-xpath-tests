# QT3 test case casthc22 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer(12678967543233) cast as xs:string
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L204
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( xsd:integer ( "12678967543233"^^xsd:integer ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "12678967543233" ))
}
