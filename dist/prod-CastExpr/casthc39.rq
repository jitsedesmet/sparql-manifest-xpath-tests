# QT3 test case casthc39 of test set prod-CastExpr, which tests the XPath expression
#   fn:true() cast as xs:double
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#double> ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ?result = "1"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
