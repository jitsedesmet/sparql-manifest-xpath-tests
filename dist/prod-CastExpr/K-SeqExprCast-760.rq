# QT3 test case K-SeqExprCast-760 of test set prod-CastExpr, which tests the XPath expression
#   xs:dayTimeDuration("P3DT2H") cast as xs:duration ne xs:duration("P1Y2M3DT10H30M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L14082
# The test needs the constructor function xsd:dayTimeDuration, xsd:duration on xsd:dayTimeDuration, the constructor function xsd:duration, != on xsd:duration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:duration ( xsd:dayTimeDuration ( "P3DT2H" ) ) != xsd:duration ( "P1Y2M3DT10H30M" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
