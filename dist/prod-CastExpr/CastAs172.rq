# QT3 test case CastAs172 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("-0.0E0") cast as xs:double
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#double> ( <http://www.w3.org/2001/XMLSchema#float> ( "-0.0E0" ) ) AS ?result)
  FILTER(( ?result = - "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
