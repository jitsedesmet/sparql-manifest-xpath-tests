# QT3 test case K-SeqExprCast-355 of test set prod-CastExpr, which tests the XPath expression
#   xs:time("21:01:60")
# Expecting:
#   <error code="FORG0001"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L10424
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:time ( "21:01:60" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
