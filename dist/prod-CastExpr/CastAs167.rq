# QT3 test case CastAs167 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("-0.0E0") cast as xs:string
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#float> ( "-0.0E0" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-0" ))
}
