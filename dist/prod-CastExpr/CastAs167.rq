# QT3 test case CastAs167 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("-0.0E0") cast as xs:string
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L1896
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( xsd:float ( "-0.0E0" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-0" ))
}
