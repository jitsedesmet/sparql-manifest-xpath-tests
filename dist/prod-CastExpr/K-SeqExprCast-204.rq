# QT3 test case K-SeqExprCast-204 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:yearMonthDuration("P0Y0M")) eq "P0M"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L9074
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P0Y0M" ) ) = "P0M" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
