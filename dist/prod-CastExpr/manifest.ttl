<#K-SeqExprCast-308> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-308" ;
  rdfs:comment "'+2004-08-01T12:44:05' is an invalid lexical representation, a preceding '+' sign is not allowed for xs:dateTime." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-308.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-309> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-309" ;
  rdfs:comment "'02004-08-01T12:44:05' is an invalid lexical representation for xs:dateTime; if the year part has more than four digits, leading zeros are prohibited." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-309.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-310> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-310" ;
  rdfs:comment "'00004-08-01T12:44:05' is an invalid lexical representation for xs:dateTime; if the year part has more than four digits, leading zeros are prohibited." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-310.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-311> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-311" ;
  rdfs:comment "'2004-32-01T12:44:05' is an invalid lexical representation for xs:dateTime; the month part cannot be larger than 32." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-311.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-312> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-312" ;
  rdfs:comment "'2002-02-30T12:44:05' is a non-existent xs:dateTime date." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-312.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-313> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-313" ;
  rdfs:comment "'2002-002-15T12:44:05' is an invalid lexical representation for xs:dateTime." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-313.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-314> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-314" ;
  rdfs:comment "'2002-02-150T12:44:05' is an invalid lexical representation for xs:dateTime." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-314.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-315> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-315" ;
  rdfs:comment "'2002-02-15T24:00:00.001' is an invalid lexical representation for xs:dateTime; if hour is 24, seconds part must be 00." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
