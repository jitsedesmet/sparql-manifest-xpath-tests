  rdfs:comment "Ensure casting xs:date to xs:string, with timezone '-00:00' is properly handled." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-401.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-402> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-402" ;
  rdfs:comment "Ensure casting xs:date to xs:string, with timezone '+00:00' is properly handled." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-402.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-403> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-403" ;
  rdfs:comment "Ensure when casting xs:date to xs:string that an empty milli seconds part is not serialized." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-403.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-404> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-404" ;
  rdfs:comment "Ensure when casting xs:date to xs:string that milli seconds have no trailing zeros." ;
