<#K-SeqExprCast-316> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-316" ;
  rdfs:comment "'2002-02-15T24:01:00' is an invalid lexical representation for xs:dateTime; if hour is 24, minutes part must be 00." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-316.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-317> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-317" ;
  rdfs:comment "'2002-02-15T25:00:00' is an invalid lexical representation for xs:dateTime; hour part can never be larger than 24." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-317.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-318> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-318" ;
  rdfs:comment "'2002-02-15T21:60:00' is an invalid lexical representation for xs:dateTime; minute part can never be larger than 59." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-318.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-319> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-319" ;
  rdfs:comment "'2002-02-15T21:01:60' is an invalid lexical representation for xs:dateTime; seconds part can never be larger than 59." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-319.rq> ] ;
  mf:result <../true.srj> .

