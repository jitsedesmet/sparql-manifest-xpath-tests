<#K-SeqExprCast-350> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-350" ;
  rdfs:comment "The canonical form of an xs:dateTime containing 24:00:00 is the following day at 00:00:00." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-350.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-351> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-351" ;
  rdfs:comment "'24:00:00.001' is an invalid lexical representation for xs:time; if hour is 24, seconds part must be 00." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-351.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-352> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-352" ;
  rdfs:comment "'24:01:00' is an invalid lexical representation for xs:time; if hour is 24, minutes part must be 00." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <K-SeqExprCast-352.rq> ] ;
  mf:result <../true.srj> .

<#K-SeqExprCast-353> a mf:QueryEvaluationTest ;
  mf:name "K-SeqExprCast-353" ;
