<#casthc1> a mf:QueryEvaluationTest ;
  mf:name "casthc1" ;
  rdfs:comment "Simple test for evaluation of a simple expression casted as xs:integer" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <casthc1.rq> ] ;
  mf:result <../true.srj> .

