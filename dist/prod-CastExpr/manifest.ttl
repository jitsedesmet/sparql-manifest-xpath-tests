<#CastAs688> a mf:QueryEvaluationTest ;
  mf:name "CastAs688" ;
  rdfs:comment "Leading decimal point in duration values. This is contentious:\n         XSD 1.0 clearly requires a digit before and after the decimal\n         point. XSD 1.1 apparently doesn't, but this is believed to\n         be an error in the spec." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml> ;
  mf:action [ qt:query <CastAs688.rq> ] ;
  mf:result <../true.srj> .

