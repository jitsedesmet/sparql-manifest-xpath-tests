# QT3 test case CastAs383 of test set prod-CastExpr, which tests the XPath expression
#   xs:time("13:20:00-05:00") cast as xs:string
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#time> ( "13:20:00-05:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "13:20:00-05:00" ))
}
