# QT3 test case CastAs348 of test set prod-CastExpr, which tests the XPath expression
#   xs:dayTimeDuration("P3DT10H30M") cast as xs:boolean
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L3573
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:boolean ( xsd:dayTimeDuration ( "P3DT10H30M" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
