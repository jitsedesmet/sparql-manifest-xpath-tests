# QT3 test case K2-SeqExprCast-473 of test set prod-CastExpr, which tests the XPath expression
#   xs:date("111 -11-11")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L25036
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#date> ( "111 -11-11" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
