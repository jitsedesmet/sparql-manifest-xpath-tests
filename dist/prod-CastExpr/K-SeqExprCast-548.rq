# QT3 test case K-SeqExprCast-548 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("10.01") cast as xs:decimal eq xs:decimal("10.01")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "10.01" ) ) = <http://www.w3.org/2001/XMLSchema#decimal> ( "10.01" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
