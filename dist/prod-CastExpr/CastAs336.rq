# QT3 test case CastAs336 of test set prod-CastExpr, which tests the XPath expression
#   xs:dayTimeDuration("P3DT10H30M") cast as xs:yearMonthDuration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P3DT10H30M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "P0M" ))
}
