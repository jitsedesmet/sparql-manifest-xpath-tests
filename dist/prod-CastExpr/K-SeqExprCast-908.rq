# QT3 test case K-SeqExprCast-908 of test set prod-CastExpr, which tests the XPath expression
#   xs:date("2004-10-13") cast as xs:float
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L15417
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:float ( xsd:date ( "2004-10-13" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
