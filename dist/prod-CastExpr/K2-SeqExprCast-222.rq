# QT3 test case K2-SeqExprCast-222 of test set prod-CastExpr, which tests the XPath expression
#   xs:double(" NaN ")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L22718
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#double> ( " NaN " ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "NaN" ))
}
