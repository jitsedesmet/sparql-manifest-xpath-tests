# QT3 test case CastAs224 of test set prod-CastExpr, which tests the XPath expression
#   xs:double("1e5") cast as xs:date
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L2457
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#date> ( <http://www.w3.org/2001/XMLSchema#double> ( "1e5" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
