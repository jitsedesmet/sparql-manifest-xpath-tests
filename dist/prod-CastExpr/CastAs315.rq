# QT3 test case CastAs315 of test set prod-CastExpr, which tests the XPath expression
#   xs:yearMonthDuration("P1Y2M") cast as xs:date
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L3276
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:date ( xsd:yearMonthDuration ( "P1Y2M" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
