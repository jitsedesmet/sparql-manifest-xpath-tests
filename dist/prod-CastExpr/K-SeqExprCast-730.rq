# QT3 test case K-SeqExprCast-730 of test set prod-CastExpr, which tests the XPath expression
#   xs:yearMonthDuration("P1Y12M") cast as xs:boolean
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#boolean> ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1Y12M" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
