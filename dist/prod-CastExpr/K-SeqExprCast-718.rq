# QT3 test case K-SeqExprCast-718 of test set prod-CastExpr, which tests the XPath expression
#   xs:yearMonthDuration("P1Y12M") cast as xs:date
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L13703
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:date ( xsd:yearMonthDuration ( "P1Y12M" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
