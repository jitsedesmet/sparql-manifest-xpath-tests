# QT3 test case K-SeqExprCast-797 of test set prod-CastExpr, which tests the XPath expression
#   xs:dateTime("")
# Expecting:
#   <error code="FORG0001"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L14416
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:dateTime ( "" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
