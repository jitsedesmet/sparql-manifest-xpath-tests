# QT3 test case CastAs392 of test set prod-CastExpr, which tests the XPath expression
#   xs:time("13:20:00-05:00") cast as xs:time
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L3969
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#time> ( <http://www.w3.org/2001/XMLSchema#time> ( "13:20:00-05:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "13:20:00-05:00" ))
}
