# QT3 test case K-SeqExprCast-440 of test set prod-CastExpr, which tests the XPath expression
#   xs:float(" 3.4e5 ") eq xs:float(" 3.4e5 ")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( " 3.4e5 " ) = <http://www.w3.org/2001/XMLSchema#float> ( " 3.4e5 " ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
