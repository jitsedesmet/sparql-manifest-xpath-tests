# QT3 test case K-SeqExprCast-440 of test set prod-CastExpr, which tests the XPath expression
#   xs:float(" 3.4e5 ") eq xs:float(" 3.4e5 ")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L11196
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:float ( " 3.4e5 " ) = xsd:float ( " 3.4e5 " ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
