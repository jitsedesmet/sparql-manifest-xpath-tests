# QT3 test case CastAs217 of test set prod-CastExpr, which tests the XPath expression
#   xs:double("INF") cast as xs:integer
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L2394
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:integer ( xsd:double ( "INF" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
