# QT3 test case K2-SeqExprCast-24 of test set prod-CastExpr, which tests the XPath expression
#   xs:unsignedShort("65535")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L20911
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND("65535"^^xsd:unsignedShort AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "65535"^^xsd:integer ) ))
}
