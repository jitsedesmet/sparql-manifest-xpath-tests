# QT3 test case K-SeqExprCast-23 of test set prod-CastExpr, which tests the XPath expression
#   xs:boolean(xs:decimal(3)) eq true()
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "3"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) = "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
