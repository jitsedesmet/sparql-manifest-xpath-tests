# QT3 test case K2-SeqExprCast-5 of test set prod-CastExpr, which tests the XPath expression
#   xs:long("9223372036854775807")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L20733
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND("9223372036854775807"^^xsd:long AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "9223372036854775807"^^xsd:integer ) ))
}
