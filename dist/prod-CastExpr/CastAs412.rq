# QT3 test case CastAs412 of test set prod-CastExpr, which tests the XPath expression
#   xs:date("1999-05-31") cast as xs:integer
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L4157
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:integer ( xsd:date ( "1999-05-31" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
