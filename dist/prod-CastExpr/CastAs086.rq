# QT3 test case CastAs086 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("INF") cast as xs:string
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L1167
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( xsd:string ( "INF" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "INF" ))
}
