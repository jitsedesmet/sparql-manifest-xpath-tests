# QT3 test case CastAs206 of test set prod-CastExpr, which tests the XPath expression
#   xs:double("-1.75e-3") cast as xs:float
# Expecting:
#   <assert-string-value>-0.00175</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L2292
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:float ( xsd:double ( "-1.75e-3" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-0.00175" ))
}
