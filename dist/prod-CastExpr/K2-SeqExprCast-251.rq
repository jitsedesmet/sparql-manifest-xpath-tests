# QT3 test case K2-SeqExprCast-251 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal(xs:double("-INF"))
# Expecting:
#   <error code="FOCA0002"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L23009
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:decimal ( xsd:double ( "-INF" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
