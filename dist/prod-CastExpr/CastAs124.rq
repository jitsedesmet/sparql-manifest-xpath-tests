# QT3 test case CastAs124 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("13:20:00-05:00") cast as xs:time
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L1509
# The test needs the constructor function xsd:time, xsd:string on xsd:time, which SPARQL does not define
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#time> ( <http://www.w3.org/2001/XMLSchema#string> ( "13:20:00-05:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "13:20:00-05:00" ))
}
