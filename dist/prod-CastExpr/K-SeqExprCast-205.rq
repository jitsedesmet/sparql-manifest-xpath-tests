# QT3 test case K-SeqExprCast-205 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:yearMonthDuration("P2Y323M")) eq "P28Y11M"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L9083
# The test needs the constructor function xsd:yearMonthDuration, xsd:string on xsd:yearMonthDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P2Y323M" ) ) = "P28Y11M" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
