# QT3 test case CastAs408 of test set prod-CastExpr, which tests the XPath expression
#   xs:date("-0012-12-03-05:00") cast as xs:string
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#date> ( "-0012-12-03-05:00" ) ) AS ?result)
  FILTER(( ! BOUND( ?result ) || ( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-0012-12-03-05:00" ) ))
}
