# QT3 test case CastAs408 of test set prod-CastExpr, which tests the XPath expression
#   xs:date("-0012-12-03-05:00") cast as xs:string
# Expecting:
#   <any-of>
#      <error code="FODT0001"/>
#      <assert-string-value>-0012-12-03-05:00</assert-string-value>
#   </any-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L4117
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( xsd:date ( "-0012-12-03-05:00" ) ) AS ?result)
  FILTER(( ! BOUND( ?result ) || SAMETERM( xsd:string ( ?result ) , "-0012-12-03-05:00" ) ))
}
