# QT3 test case casthc8 of test set prod-CastExpr, which tests the XPath expression
#   xs:float(2.1E3) cast as xs:float
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L78
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:float ( xsd:float ( "2.1E3"^^xsd:double ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "2100"^^xsd:integer ) ))
}
