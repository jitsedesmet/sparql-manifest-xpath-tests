# QT3 test case CastAs116 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("-P1Y1M1DT1H1M1.123S") cast as xs:dayTimeDuration
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L1437
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( <http://www.w3.org/2001/XMLSchema#string> ( "-P1Y1M1DT1H1M1.123S" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
