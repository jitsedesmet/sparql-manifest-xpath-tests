# QT3 test case CastAs416 of test set prod-CastExpr, which tests the XPath expression
#   xs:date("1999-05-31") cast as xs:dateTime
# Expecting:
#   <assert-string-value>1999-05-31T00:00:00</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L4193
# The test needs the constructor function xsd:date, xsd:dateTime on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:dateTime ( xsd:date ( "1999-05-31" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1999-05-31T00:00:00" ))
}
