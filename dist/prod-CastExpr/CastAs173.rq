# QT3 test case CastAs173 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("-INF") cast as xs:double
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#double> ( <http://www.w3.org/2001/XMLSchema#float> ( "-INF" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-INF" ))
}
