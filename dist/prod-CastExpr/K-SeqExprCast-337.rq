# QT3 test case K-SeqExprCast-337 of test set prod-CastExpr, which tests the XPath expression
#   xs:date(xs:dateTime("2002-11-23T22:12:23.867-13:37")) eq xs:date("2002-11-23-13:37")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2002-11-23T22:12:23.867-13:37" ) ) = <http://www.w3.org/2001/XMLSchema#date> ( "2002-11-23-13:37" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
