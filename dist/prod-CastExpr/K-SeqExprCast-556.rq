# QT3 test case K-SeqExprCast-556 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("10.01") cast as xs:dayTimeDuration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "10.01" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
