# QT3 test case CastAs286 of test set prod-CastExpr, which tests the XPath expression
#   xs:duration("PT10H") cast as xs:yearMonthDuration
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L3015
# The test needs the constructor function xsd:duration, xsd:yearMonthDuration on xsd:duration, the constructor function xsd:yearMonthDuration, xsd:string on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:yearMonthDuration ( xsd:duration ( "PT10H" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "P0M" ))
}
