# QT3 test case K-SeqExprCast-496 of test set prod-CastExpr, which tests the XPath expression
#   xs:double("3.3e3") cast as xs:float ne xs:float("3.4e5")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( <http://www.w3.org/2001/XMLSchema#double> ( "3.3e3" ) ) != <http://www.w3.org/2001/XMLSchema#float> ( "3.4e5" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
