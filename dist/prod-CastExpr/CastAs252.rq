# QT3 test case CastAs252 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("-1.1234") cast as xs:boolean
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#boolean> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "-1.1234" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
