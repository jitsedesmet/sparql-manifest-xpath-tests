# QT3 test case K-SeqExprCast-201 of test set prod-CastExpr, which tests the XPath expression
#   xs:yearMonthDuration("-P3")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L9047
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "-P3" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
