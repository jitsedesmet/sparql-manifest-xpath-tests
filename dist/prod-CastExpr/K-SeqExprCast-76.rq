# QT3 test case K-SeqExprCast-76 of test set prod-CastExpr, which tests the XPath expression
#   xs:double(3.1) eq 3.1
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L7928
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:double ( "3.1"^^xsd:decimal ) = "3.1"^^xsd:decimal ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
