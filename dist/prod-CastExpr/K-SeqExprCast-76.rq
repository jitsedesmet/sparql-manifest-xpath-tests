# QT3 test case K-SeqExprCast-76 of test set prod-CastExpr, which tests the XPath expression
#   xs:double(3.1) eq 3.1
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( "3.1"^^<http://www.w3.org/2001/XMLSchema#decimal> ) = "3.1"^^<http://www.w3.org/2001/XMLSchema#decimal> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
