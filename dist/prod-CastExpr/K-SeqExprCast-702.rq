# QT3 test case K-SeqExprCast-702 of test set prod-CastExpr, which tests the XPath expression
#   xs:yearMonthDuration("P1Y12M") cast as xs:double
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#double> ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1Y12M" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
