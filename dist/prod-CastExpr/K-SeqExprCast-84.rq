# QT3 test case K-SeqExprCast-84 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:float("-INF")) eq "-INF"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#float> ( "-INF" ) ) = "-INF" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
