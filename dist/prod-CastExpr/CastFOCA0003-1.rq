# QT3 test case CastFOCA0003-1 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer(99e100)
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#integer> ( "99e100"^^<http://www.w3.org/2001/XMLSchema#double> ) AS ?result)
  FILTER(( ( ( ?result < "100e100"^^<http://www.w3.org/2001/XMLSchema#double> ) && ( ?result > "98e100"^^<http://www.w3.org/2001/XMLSchema#double> ) ) || ! BOUND( ?result ) ))
}
