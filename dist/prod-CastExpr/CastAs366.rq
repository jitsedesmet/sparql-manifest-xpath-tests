# QT3 test case CastAs366 of test set prod-CastExpr, which tests the XPath expression
#   xs:dateTime("1999-05-31T13:20:00") cast as xs:date
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L3735
# The test needs the constructor function xsd:date, xsd:string on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:date ( xsd:dateTime ( "1999-05-31T13:20:00" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1999-05-31" ))
}
