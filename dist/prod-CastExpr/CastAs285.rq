# QT3 test case CastAs285 of test set prod-CastExpr, which tests the XPath expression
#   xs:duration("P1Y2M3DT10H30M23S") cast as xs:yearMonthDuration
# Expecting:
#   <assert-string-value>P1Y2M</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L3006
# The test needs the constructor function xsd:duration, xsd:yearMonthDuration on xsd:duration, the constructor function xsd:yearMonthDuration, xsd:string on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:yearMonthDuration ( xsd:duration ( "P1Y2M3DT10H30M23S" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "P1Y2M" ))
}
