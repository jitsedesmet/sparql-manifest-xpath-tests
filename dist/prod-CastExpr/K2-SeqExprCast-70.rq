# QT3 test case K2-SeqExprCast-70 of test set prod-CastExpr, which tests the XPath expression
#   xs:nonPositiveInteger("+0")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L21333
ASK {
  BIND("+0"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
