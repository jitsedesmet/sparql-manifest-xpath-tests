# QT3 test case K-SeqExprCast-646 of test set prod-CastExpr, which tests the XPath expression
#   xs:duration("P1Y2M3DT10H30M") cast as xs:string ne xs:string("an arbitrary string")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L13054
# The test needs the constructor function xsd:duration, xsd:string on xsd:duration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( xsd:duration ( "P1Y2M3DT10H30M" ) ) != xsd:string ( "an arbitrary string" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
