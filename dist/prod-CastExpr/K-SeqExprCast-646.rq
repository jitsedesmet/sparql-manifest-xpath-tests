# QT3 test case K-SeqExprCast-646 of test set prod-CastExpr, which tests the XPath expression
#   xs:duration("P1Y2M3DT10H30M") cast as xs:string ne xs:string("an arbitrary string")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#duration> ( "P1Y2M3DT10H30M" ) ) != <http://www.w3.org/2001/XMLSchema#string> ( "an arbitrary string" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
