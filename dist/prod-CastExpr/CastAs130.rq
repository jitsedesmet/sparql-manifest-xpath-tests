# QT3 test case CastAs130 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("1999-05-31Z") cast as xs:date
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L1563
# The test needs the constructor function xsd:date, xsd:string on xsd:date, which SPARQL does not define
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#date> ( <http://www.w3.org/2001/XMLSchema#string> ( "1999-05-31Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1999-05-31Z" ))
}
