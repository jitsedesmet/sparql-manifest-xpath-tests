# QT3 test case K-SeqExprCast-474 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("3.4e5") cast as xs:boolean eq xs:boolean("true")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( <http://www.w3.org/2001/XMLSchema#float> ( "3.4e5" ) ) = <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
