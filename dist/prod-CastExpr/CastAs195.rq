# QT3 test case CastAs195 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("NaN") cast as xs:boolean
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#boolean> ( <http://www.w3.org/2001/XMLSchema#float> ( "NaN" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
