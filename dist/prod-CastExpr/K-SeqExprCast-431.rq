# QT3 test case K-SeqExprCast-431 of test set prod-CastExpr, which tests the XPath expression
#   boolean(xs:string("an arbitrary string"))
ASK {
  BIND(!( ! <http://www.w3.org/2001/XMLSchema#string> ( "an arbitrary string" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
