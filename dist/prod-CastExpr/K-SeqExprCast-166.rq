# QT3 test case K-SeqExprCast-166 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:duration(xs:yearMonthDuration("P543Y456M"))) eq "P581Y"
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L8732
# The test needs the constructor function xsd:yearMonthDuration, xsd:duration on xsd:yearMonthDuration, the constructor function xsd:duration, xsd:string on xsd:duration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( xsd:duration ( xsd:yearMonthDuration ( "P543Y456M" ) ) ) = "P581Y" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
