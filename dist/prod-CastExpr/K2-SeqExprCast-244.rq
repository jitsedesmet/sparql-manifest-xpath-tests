# QT3 test case K2-SeqExprCast-244 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer(xs:float("NaN"))
# Expecting:
#   <error code="FOCA0002"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L22946
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:integer ( xsd:float ( "NaN" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
