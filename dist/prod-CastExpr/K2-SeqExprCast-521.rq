# QT3 test case K2-SeqExprCast-521 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("+InF")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L25485
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#decimal> ( "+InF" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
