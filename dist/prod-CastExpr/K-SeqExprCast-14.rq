# QT3 test case K-SeqExprCast-14 of test set prod-CastExpr, which tests the XPath expression
#   '1' cast as xs:boolean eq true()
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "1" ) = "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
