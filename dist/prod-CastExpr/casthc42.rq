# QT3 test case casthc42 of test set prod-CastExpr, which tests the XPath expression
#   fn:true() cast as xs:boolean
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L384
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#boolean> ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
