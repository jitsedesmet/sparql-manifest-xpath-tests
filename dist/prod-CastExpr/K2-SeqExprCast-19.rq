# QT3 test case K2-SeqExprCast-19 of test set prod-CastExpr, which tests the XPath expression
#   xs:short("32767")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L20863
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND("32767"^^xsd:short AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "32767"^^xsd:integer ) ))
}
