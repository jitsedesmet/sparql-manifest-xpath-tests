# QT3 test case K-SeqExprCast-400 of test set prod-CastExpr, which tests the XPath expression
#   xs:dateTime(xs:date("2002-11-23-13:37")) eq xs:dateTime("2002-11-23T00:00:00.000-13:37")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( <http://www.w3.org/2001/XMLSchema#date> ( "2002-11-23-13:37" ) ) = <http://www.w3.org/2001/XMLSchema#dateTime> ( "2002-11-23T00:00:00.000-13:37" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
