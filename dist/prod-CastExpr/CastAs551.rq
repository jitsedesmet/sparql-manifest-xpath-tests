# QT3 test case CastAs551 of test set prod-CastExpr, which tests the XPath expression
#   xs:boolean("true") cast as xs:string
# Expecting:
#   <assert-string-value>true</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L5424
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( xsd:boolean ( "true" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "true" ))
}
