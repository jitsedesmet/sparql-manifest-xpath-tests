# QT3 test case CastAs551 of test set prod-CastExpr, which tests the XPath expression
#   xs:boolean("true") cast as xs:string
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "true" ))
}
