# QT3 test case CastAs118 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("-PT100M") cast as xs:dayTimeDuration
# Expecting:
#   <assert-string-value>-PT1H40M</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L1455
# The test needs the constructor function xsd:dayTimeDuration, xsd:string on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:dayTimeDuration ( xsd:string ( "-PT100M" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-PT1H40M" ))
}
