# QT3 test case casthc18 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal(12678967.543233) cast as xs:double
# Expecting:
#   <assert-string-value>1.2678967543233E7</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L168
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:double ( xsd:decimal ( "12678967.543233"^^xsd:decimal ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1.2678967543233E7" ))
}
