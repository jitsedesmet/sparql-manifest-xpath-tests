# QT3 test case K-SeqExprCast-574 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("10.01") cast as xs:boolean eq xs:boolean("true")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "10.01" ) ) = <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
