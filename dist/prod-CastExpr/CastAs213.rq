# QT3 test case CastAs213 of test set prod-CastExpr, which tests the XPath expression
#   xs:double("INF") cast as xs:decimal
# Expecting:
#   <any-of>
#      <error code="FOCA0002"/>
#      <error code="FORG0001"/>
#   </any-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L2355
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:decimal ( xsd:double ( "INF" ) ) AS ?result)
  FILTER(( ! BOUND( ?result ) || ! BOUND( ?result ) ))
}
