# QT3 test case K-SeqExprCast-1222 of test set prod-CastExpr, which tests the XPath expression
#   xs:boolean("true") cast as xs:double ne xs:double("3.3e3")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L18250
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:double ( xsd:boolean ( "true" ) ) != xsd:double ( "3.3e3" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
