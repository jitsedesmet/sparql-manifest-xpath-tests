# QT3 test case K2-SeqExprCast-213 of test set prod-CastExpr, which tests the XPath expression
#   xs:double(xs:positiveInteger("52"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L22637
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:double ( "52"^^xsd:positiveInteger ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "52"^^xsd:integer ) ))
}
