# QT3 test case K-SeqExprCast-546 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("10.01") cast as xs:double ne xs:double("3.3e3")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "10.01" ) ) != <http://www.w3.org/2001/XMLSchema#double> ( "3.3e3" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
