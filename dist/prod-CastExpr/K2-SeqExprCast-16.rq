# QT3 test case K2-SeqExprCast-16 of test set prod-CastExpr, which tests the XPath expression
#   xs:negativeInteger("-999999999999999999")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L20832
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND("-999999999999999999"^^xsd:negativeInteger AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-999999999999999999"^^xsd:integer ) ))
}
