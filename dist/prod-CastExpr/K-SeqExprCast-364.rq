# QT3 test case K-SeqExprCast-364 of test set prod-CastExpr, which tests the XPath expression
#   string(xs:time("12:44:05")) eq "12:44:05"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#time> ( "12:44:05" ) ) = "12:44:05" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
