# QT3 test case CastAs129 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("-0012-12-03-05:00") cast as xs:date
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#date> ( <http://www.w3.org/2001/XMLSchema#string> ( "-0012-12-03-05:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-0012-12-03-05:00" ))
}
