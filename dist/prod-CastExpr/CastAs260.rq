# QT3 test case CastAs260 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer("-100") cast as xs:decimal
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#decimal> ( <http://www.w3.org/2001/XMLSchema#integer> ( "-100" ) ) AS ?result)
  FILTER(( ?result = - "100"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
