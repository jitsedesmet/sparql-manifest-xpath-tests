# QT3 test case K-SeqExprCast-19 of test set prod-CastExpr, which tests the XPath expression
#   not(true() cast as xs:boolean eq false())
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#boolean> ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) = "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
