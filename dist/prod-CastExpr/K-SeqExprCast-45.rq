# QT3 test case K-SeqExprCast-45 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:double(3)) eq '3'
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L7623
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#double> ( "3"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) = "3" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
