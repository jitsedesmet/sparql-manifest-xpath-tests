# QT3 test case CastAs362 of test set prod-CastExpr, which tests the XPath expression
#   xs:dateTime("1999-05-31T13:20:00") cast as xs:dayTimeDuration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-05-31T13:20:00" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
