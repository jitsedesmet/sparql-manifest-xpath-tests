# QT3 test case K-SeqExprCast-374 of test set prod-CastExpr, which tests the XPath expression
#   string(xs:time("24:00:00")) eq "00:00:00"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L10595
# The test needs the constructor function xsd:time, xsd:string on xsd:time, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#time> ( "24:00:00" ) ) = "00:00:00" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
