# QT3 test case K-SeqExprCast-195 of test set prod-CastExpr, which tests the XPath expression
#   xs:yearMonthDuration("P20Y15M+08:00")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L8993
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:yearMonthDuration ( "P20Y15M+08:00" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
