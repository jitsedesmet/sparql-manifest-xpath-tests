# QT3 test case K-SeqExprCast-184 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:dayTimeDuration("PT9876H1M")) eq "P411DT12H1M"
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L8894
# The test needs the constructor function xsd:dayTimeDuration, xsd:string on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( xsd:dayTimeDuration ( "PT9876H1M" ) ) = "P411DT12H1M" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
