# QT3 test case K-SeqExprCast-184 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:dayTimeDuration("PT9876H1M")) eq "P411DT12H1M"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "PT9876H1M" ) ) = "P411DT12H1M" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
