# QT3 test case K-SeqExprCast-383 of test set prod-CastExpr, which tests the XPath expression
#   xs:date("2002-02-15T08:12:12")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L10676
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#date> ( "2002-02-15T08:12:12" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
