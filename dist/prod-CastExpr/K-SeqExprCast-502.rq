# QT3 test case K-SeqExprCast-502 of test set prod-CastExpr, which tests the XPath expression
#   xs:double("3.3e3") cast as xs:yearMonthDuration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( <http://www.w3.org/2001/XMLSchema#double> ( "3.3e3" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
