# QT3 test case K2-SeqExprCast-69 of test set prod-CastExpr, which tests the XPath expression
#   xs:nonNegativeInteger("+1")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L21324
ASK {
  BIND("+1"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> AS ?result)
  FILTER(( ?result = "1"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
