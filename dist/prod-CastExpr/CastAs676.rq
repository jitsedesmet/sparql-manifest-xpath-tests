# QT3 test case CastAs676 of test set prod-CastExpr, which tests the XPath expression
#   xs:dateTime("9999-12-31T23:59:59.9999999") cast as xs:string
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "9999-12-31T23:59:59.9999999" ) ) AS ?result)
  FILTER(( ( STRSTARTS( ?result , "9999-12-31T23:59:59.999" ) || ( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "10000-01-01T00:00:00" ) ) || ! BOUND( ?result ) ))
}
