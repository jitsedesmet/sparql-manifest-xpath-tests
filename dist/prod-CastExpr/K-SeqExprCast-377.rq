# QT3 test case K-SeqExprCast-377 of test set prod-CastExpr, which tests the XPath expression
#   xs:date("00004-08-01")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L10622
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:date ( "00004-08-01" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
