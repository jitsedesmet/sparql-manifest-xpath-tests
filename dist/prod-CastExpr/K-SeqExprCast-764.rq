# QT3 test case K-SeqExprCast-764 of test set prod-CastExpr, which tests the XPath expression
#   xs:dayTimeDuration("P3DT2H") cast as xs:dayTimeDuration eq xs:dayTimeDuration("P3DT2H")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L14118
# The test needs the constructor function xsd:dayTimeDuration, xsd:dayTimeDuration on xsd:dayTimeDuration, = on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P3DT2H" ) ) = <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P3DT2H" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
