# QT3 test case K-SeqExprCast-79 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:double("-INF")) eq "-INF"
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L7955
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( xsd:double ( "-INF" ) ) = "-INF" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
