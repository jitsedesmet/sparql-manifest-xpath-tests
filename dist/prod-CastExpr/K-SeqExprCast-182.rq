# QT3 test case K-SeqExprCast-182 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:dayTimeDuration("-P5DT0H0M0.000S")) eq "-P5D"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "-P5DT0H0M0.000S" ) ) = "-P5D" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
