# QT3 test case K-SeqExprCast-182 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:dayTimeDuration("-P5DT0H0M0.000S")) eq "-P5D"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L8876
# The test needs the constructor function xsd:dayTimeDuration, xsd:string on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "-P5DT0H0M0.000S" ) ) = "-P5D" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
