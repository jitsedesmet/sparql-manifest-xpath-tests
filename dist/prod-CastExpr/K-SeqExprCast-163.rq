# QT3 test case K-SeqExprCast-163 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:duration("P31DT3H2M10.001S")) eq "P31DT3H2M10.001S"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L8705
# The test needs the constructor function xsd:duration, xsd:string on xsd:duration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#duration> ( "P31DT3H2M10.001S" ) ) = "P31DT3H2M10.001S" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
