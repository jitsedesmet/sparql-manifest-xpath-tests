# QT3 test case K-SeqExprCast-163 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:duration("P31DT3H2M10.001S")) eq "P31DT3H2M10.001S"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#duration> ( "P31DT3H2M10.001S" ) ) = "P31DT3H2M10.001S" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
