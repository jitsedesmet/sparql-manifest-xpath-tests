# QT3 test case CastAs237 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("-1.1234") cast as xs:double
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#double> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "-1.1234" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-1.1234" ))
}
