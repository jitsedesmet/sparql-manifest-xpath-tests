# QT3 test case K2-SeqExprCast-242 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal(xs:float("NaN"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L22928
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:decimal ( xsd:float ( "NaN" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
