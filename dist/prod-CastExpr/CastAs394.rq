# QT3 test case CastAs394 of test set prod-CastExpr, which tests the XPath expression
#   xs:time("13:20:00Z") cast as xs:time
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#time> ( <http://www.w3.org/2001/XMLSchema#time> ( "13:20:00Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "13:20:00Z" ))
}
