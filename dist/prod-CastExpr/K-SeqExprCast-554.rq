# QT3 test case K-SeqExprCast-554 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("10.01") cast as xs:yearMonthDuration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "10.01" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
