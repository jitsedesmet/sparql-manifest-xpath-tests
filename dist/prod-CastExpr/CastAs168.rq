# QT3 test case CastAs168 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("NaN") cast as xs:string
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#float> ( "NaN" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "NaN" ))
}
