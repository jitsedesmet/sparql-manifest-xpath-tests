# QT3 test case CastAs168 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("NaN") cast as xs:string
# Expecting:
#   <assert-string-value>NaN</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L1905
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( xsd:float ( "NaN" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "NaN" ))
}
