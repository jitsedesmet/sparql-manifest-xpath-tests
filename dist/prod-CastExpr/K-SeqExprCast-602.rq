# QT3 test case K-SeqExprCast-602 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer("6789") cast as xs:integer eq xs:integer("6789")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#integer> ( <http://www.w3.org/2001/XMLSchema#integer> ( "6789" ) ) = <http://www.w3.org/2001/XMLSchema#integer> ( "6789" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
