# QT3 test case CastAs334 of test set prod-CastExpr, which tests the XPath expression
#   xs:dayTimeDuration("PT24H") cast as xs:duration
# Expecting:
#   <assert-string-value>P1D</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L3447
# The test needs the constructor function xsd:dayTimeDuration, xsd:duration on xsd:dayTimeDuration, the constructor function xsd:duration, xsd:string on xsd:duration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:duration ( xsd:dayTimeDuration ( "PT24H" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "P1D" ))
}
