# QT3 test case CastAs334 of test set prod-CastExpr, which tests the XPath expression
#   xs:dayTimeDuration("PT24H") cast as xs:duration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#duration> ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "PT24H" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "P1D" ))
}
