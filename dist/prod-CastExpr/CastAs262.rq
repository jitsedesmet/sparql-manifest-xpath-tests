# QT3 test case CastAs262 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer("-100") cast as xs:duration
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L2799
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#duration> ( <http://www.w3.org/2001/XMLSchema#integer> ( "-100" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
