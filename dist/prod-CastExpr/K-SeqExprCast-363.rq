# QT3 test case K-SeqExprCast-363 of test set prod-CastExpr, which tests the XPath expression
#   xs:dateTime("T23:59:12.999-03")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L10496
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dateTime> ( "T23:59:12.999-03" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
