# QT3 test case CastAs246 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("-1.1234") cast as xs:date
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L2655
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#date> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "-1.1234" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
