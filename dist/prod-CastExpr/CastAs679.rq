# QT3 test case CastAs679 of test set prod-CastExpr, which tests the XPath expression
#   xs:dateTime('2017-07-19T12:00:00-00:30')
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dateTime> ( "2017-07-19T12:00:00-00:30" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2017-07-19T12:00:00-00:30" ))
}
