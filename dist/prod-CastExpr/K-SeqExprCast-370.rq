# QT3 test case K-SeqExprCast-370 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:time("21:01:23.010")) eq "21:01:23.01"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#time> ( "21:01:23.010" ) ) = "21:01:23.01" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
