# QT3 test case K-SeqExprCast-450 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("3.4e5") cast as xs:double ne xs:double("3.3e3")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( <http://www.w3.org/2001/XMLSchema#float> ( "3.4e5" ) ) != <http://www.w3.org/2001/XMLSchema#double> ( "3.3e3" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
