# QT3 test case K-SeqExprCast-874 of test set prod-CastExpr, which tests the XPath expression
#   xs:time("03:20:00-05:00") cast as xs:date
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L15110
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#date> ( <http://www.w3.org/2001/XMLSchema#time> ( "03:20:00-05:00" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
