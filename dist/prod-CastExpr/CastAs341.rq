# QT3 test case CastAs341 of test set prod-CastExpr, which tests the XPath expression
#   xs:dayTimeDuration("P3DT10H30M") cast as xs:time
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#time> ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P3DT10H30M" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
