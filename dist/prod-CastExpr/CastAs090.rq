# QT3 test case CastAs090 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("NaN") cast as xs:float
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#float> ( <http://www.w3.org/2001/XMLSchema#string> ( "NaN" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "NaN" ))
}
