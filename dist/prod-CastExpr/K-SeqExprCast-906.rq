# QT3 test case K-SeqExprCast-906 of test set prod-CastExpr, which tests the XPath expression
#   xs:date("2004-10-13") cast as xs:string ne xs:string("an arbitrary string")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L15399
# The test needs the constructor function xsd:date, xsd:string on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( xsd:date ( "2004-10-13" ) ) != xsd:string ( "an arbitrary string" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
