# QT3 test case K-SeqExprCast-906 of test set prod-CastExpr, which tests the XPath expression
#   xs:date("2004-10-13") cast as xs:string ne xs:string("an arbitrary string")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#date> ( "2004-10-13" ) ) != <http://www.w3.org/2001/XMLSchema#string> ( "an arbitrary string" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
