# QT3 test case CastAs354 of test set prod-CastExpr, which tests the XPath expression
#   xs:dateTime("1999-05-31T13:20:00") cast as xs:string
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L3627
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-05-31T13:20:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1999-05-31T13:20:00" ))
}
