# QT3 test case CastAs257 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer("-100") cast as xs:string
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#integer> ( "-100" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-100" ))
}
