# QT3 test case K-SeqExprCast-762 of test set prod-CastExpr, which tests the XPath expression
#   xs:dayTimeDuration("P3DT2H") cast as xs:yearMonthDuration ne xs:yearMonthDuration("P1Y12M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L14100
# The test needs the constructor function xsd:dayTimeDuration, xsd:yearMonthDuration on xsd:dayTimeDuration, the constructor function xsd:yearMonthDuration, != on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:yearMonthDuration ( xsd:dayTimeDuration ( "P3DT2H" ) ) != xsd:yearMonthDuration ( "P1Y12M" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
