# QT3 test case K2-SeqExprCast-214 of test set prod-CastExpr, which tests the XPath expression
#   xs:double(xs:int("-1873914410"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#double> ( "-1873914410"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-1.87391441E9" ))
}
