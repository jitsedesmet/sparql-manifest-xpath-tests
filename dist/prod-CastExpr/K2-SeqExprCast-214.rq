# QT3 test case K2-SeqExprCast-214 of test set prod-CastExpr, which tests the XPath expression
#   xs:double(xs:int("-1873914410"))
# Expecting:
#   <assert-string-value>-1.87391441E9</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L22646
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:double ( "-1873914410"^^xsd:int ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-1.87391441E9" ))
}
