# QT3 test case casthc26 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer(12678967543233) cast as xs:integer
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#integer> ( <http://www.w3.org/2001/XMLSchema#integer> ( "12678967543233"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ?result = "12678967543233"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
