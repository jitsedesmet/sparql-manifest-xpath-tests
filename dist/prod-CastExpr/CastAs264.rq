# QT3 test case CastAs264 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer("-100") cast as xs:dayTimeDuration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( <http://www.w3.org/2001/XMLSchema#integer> ( "-100" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
