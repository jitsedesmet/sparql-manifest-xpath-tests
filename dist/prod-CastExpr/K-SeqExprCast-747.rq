# QT3 test case K-SeqExprCast-747 of test set prod-CastExpr, which tests the XPath expression
#   boolean(xs:dayTimeDuration("P3DT2H"))
# Expecting:
#   <error code="FORG0006"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L13965
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( ! xsd:dayTimeDuration ( "P3DT2H" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
