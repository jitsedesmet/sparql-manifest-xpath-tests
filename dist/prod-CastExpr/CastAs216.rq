# QT3 test case CastAs216 of test set prod-CastExpr, which tests the XPath expression
#   xs:double("-1.75e-3") cast as xs:integer
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L2385
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:integer ( xsd:double ( "-1.75e-3" ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "0"^^xsd:integer ) ))
}
