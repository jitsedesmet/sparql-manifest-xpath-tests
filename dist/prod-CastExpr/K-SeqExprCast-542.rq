# QT3 test case K-SeqExprCast-542 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("10.01") cast as xs:string ne xs:string("an arbitrary string")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L12116
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( xsd:decimal ( "10.01" ) ) != xsd:string ( "an arbitrary string" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
