# QT3 test case K-SeqExprCast-750 of test set prod-CastExpr, which tests the XPath expression
#   xs:dayTimeDuration("P3DT2H") cast as xs:string ne xs:string("an arbitrary string")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L13992
# The test needs the constructor function xsd:dayTimeDuration, xsd:string on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( xsd:dayTimeDuration ( "P3DT2H" ) ) != xsd:string ( "an arbitrary string" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
