# QT3 test case CastAs169 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("5.4321E-100") cast as xs:float
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#float> ( <http://www.w3.org/2001/XMLSchema#float> ( "5.4321E-100" ) ) AS ?result)
  FILTER(( ( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) || ! BOUND( ?result ) ))
}
