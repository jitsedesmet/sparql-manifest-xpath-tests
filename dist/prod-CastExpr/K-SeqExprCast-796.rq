# QT3 test case K-SeqExprCast-796 of test set prod-CastExpr, which tests the XPath expression
#   xs:dateTime(" 2002-10-10T12:00:00-05:00 ") eq xs:dateTime(" 2002-10-10T12:00:00-05:00 ")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( " 2002-10-10T12:00:00-05:00 " ) = <http://www.w3.org/2001/XMLSchema#dateTime> ( " 2002-10-10T12:00:00-05:00 " ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
