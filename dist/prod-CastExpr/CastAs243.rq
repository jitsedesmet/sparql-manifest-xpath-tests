# QT3 test case CastAs243 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("-1.1234") cast as xs:dayTimeDuration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "-1.1234" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
