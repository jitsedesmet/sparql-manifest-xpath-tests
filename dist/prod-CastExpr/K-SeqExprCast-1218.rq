# QT3 test case K-SeqExprCast-1218 of test set prod-CastExpr, which tests the XPath expression
#   xs:boolean("true") cast as xs:string ne xs:string("an arbitrary string")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L18214
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( xsd:boolean ( "true" ) ) != xsd:string ( "an arbitrary string" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
