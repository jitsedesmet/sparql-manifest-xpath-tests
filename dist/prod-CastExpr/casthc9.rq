# QT3 test case casthc9 of test set prod-CastExpr, which tests the XPath expression
#   xs:float(2.1E3) cast as xs:string
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L87
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#float> ( "2.1E3"^^<http://www.w3.org/2001/XMLSchema#double> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2100" ))
}
