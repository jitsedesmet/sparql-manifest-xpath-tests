# QT3 test case CastAs204 of test set prod-CastExpr, which tests the XPath expression
#   xs:double("5.4321E-1001") cast as xs:float
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L2271
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#float> ( <http://www.w3.org/2001/XMLSchema#double> ( "5.4321E-1001" ) ) AS ?result)
  FILTER(( ( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) || ! BOUND( ?result ) ))
}
