# QT3 test case K2-SeqExprCast-228 of test set prod-CastExpr, which tests the XPath expression
#   xs:float("- INF")
# Expecting:
#   <error code="FORG0001"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L22772
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:float ( "- INF" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
