# QT3 test case K-SeqExprCast-598 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer("6789") cast as xs:double ne xs:double("3.3e3")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L12621
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:double ( xsd:integer ( "6789" ) ) != xsd:double ( "3.3e3" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
