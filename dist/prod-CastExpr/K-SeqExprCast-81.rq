# QT3 test case K-SeqExprCast-81 of test set prod-CastExpr, which tests the XPath expression
#   xs:float(3.1) eq 3.1
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L7973
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "3.1"^^<http://www.w3.org/2001/XMLSchema#decimal> ) = "3.1"^^<http://www.w3.org/2001/XMLSchema#decimal> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
