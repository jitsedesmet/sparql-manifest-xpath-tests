# QT3 test case CastAs093 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("true") cast as xs:float
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L1230
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#float> ( <http://www.w3.org/2001/XMLSchema#string> ( "true" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
