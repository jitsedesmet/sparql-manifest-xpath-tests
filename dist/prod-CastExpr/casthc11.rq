# QT3 test case casthc11 of test set prod-CastExpr, which tests the XPath expression
#   xs:float(2.1E3) cast as xs:boolean
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#boolean> ( <http://www.w3.org/2001/XMLSchema#float> ( "2.1E3"^^<http://www.w3.org/2001/XMLSchema#double> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
