# QT3 test case CastAs291 of test set prod-CastExpr, which tests the XPath expression
#   xs:duration("P1Y2M3DT10H30M23S") cast as xs:dateTime
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dateTime> ( <http://www.w3.org/2001/XMLSchema#duration> ( "P1Y2M3DT10H30M23S" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
