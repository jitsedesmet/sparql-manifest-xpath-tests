# QT3 test case CastAs242 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("-1.1234") cast as xs:yearMonthDuration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "-1.1234" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
