# QT3 test case K-SeqExprCast-560 of test set prod-CastExpr, which tests the XPath expression
#   xs:decimal("10.01") cast as xs:time
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L12278
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#time> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "10.01" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
