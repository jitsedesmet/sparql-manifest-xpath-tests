# QT3 test case K-SeqExprCast-30 of test set prod-CastExpr, which tests the XPath expression
#   xs:boolean(-0) eq false()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L7488
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( - "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) = "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
