# QT3 test case K2-SeqExprCast-133 of test set prod-CastExpr, which tests the XPath expression
#   xs:nonPositiveInteger("-000000000")
ASK {
  BIND("-000000000"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
