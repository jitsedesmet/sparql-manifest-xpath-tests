# QT3 test case K-SeqExprCast-606 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer("6789") cast as xs:yearMonthDuration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( <http://www.w3.org/2001/XMLSchema#integer> ( "6789" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
