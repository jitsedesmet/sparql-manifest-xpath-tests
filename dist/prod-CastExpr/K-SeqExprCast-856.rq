# QT3 test case K-SeqExprCast-856 of test set prod-CastExpr, which tests the XPath expression
#   xs:time("03:20:00-05:00") cast as xs:float
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#float> ( <http://www.w3.org/2001/XMLSchema#time> ( "03:20:00-05:00" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
