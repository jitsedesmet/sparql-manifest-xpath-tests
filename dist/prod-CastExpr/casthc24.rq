# QT3 test case casthc24 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer(12678967543233) cast as xs:double
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#double> ( <http://www.w3.org/2001/XMLSchema#integer> ( "12678967543233"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1.2678967543233E13" ))
}
