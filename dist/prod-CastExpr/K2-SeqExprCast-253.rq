# QT3 test case K2-SeqExprCast-253 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer(xs:double("-INF"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L23027
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#integer> ( <http://www.w3.org/2001/XMLSchema#double> ( "-INF" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
