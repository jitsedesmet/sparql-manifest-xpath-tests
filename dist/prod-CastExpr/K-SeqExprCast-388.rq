# QT3 test case K-SeqExprCast-388 of test set prod-CastExpr, which tests the XPath expression
#   xs:dateTime("1999-12-01-03")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L10721
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-12-01-03" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
