# QT3 test case K-SeqExprCast-600 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer("6789") cast as xs:decimal ne xs:decimal("10.01")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L12639
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( <http://www.w3.org/2001/XMLSchema#integer> ( "6789" ) ) != <http://www.w3.org/2001/XMLSchema#decimal> ( "10.01" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
