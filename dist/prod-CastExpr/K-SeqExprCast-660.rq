# QT3 test case K-SeqExprCast-660 of test set prod-CastExpr, which tests the XPath expression
#   xs:duration("P1Y2M3DT10H30M") cast as xs:dayTimeDuration ne xs:dayTimeDuration("P3DT2H")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L13180
# The test needs the constructor function xsd:duration, xsd:dayTimeDuration on xsd:duration, the constructor function xsd:dayTimeDuration, != on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( <http://www.w3.org/2001/XMLSchema#duration> ( "P1Y2M3DT10H30M" ) ) != <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P3DT2H" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
