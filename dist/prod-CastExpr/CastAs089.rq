# QT3 test case CastAs089 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("-0.0E0") cast as xs:float
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#float> ( <http://www.w3.org/2001/XMLSchema#string> ( "-0.0E0" ) ) AS ?result)
  FILTER(( ?result = - "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
