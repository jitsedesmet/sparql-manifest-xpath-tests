# QT3 test case K-SeqExprCast-1215 of test set prod-CastExpr, which tests the XPath expression
#   boolean(xs:boolean("true"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L18186
ASK {
  BIND(! ( ! <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
