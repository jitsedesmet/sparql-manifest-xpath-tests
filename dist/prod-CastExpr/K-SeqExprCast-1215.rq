# QT3 test case K-SeqExprCast-1215 of test set prod-CastExpr, which tests the XPath expression
#   boolean(xs:boolean("true"))
ASK {
  BIND(!( ! <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
