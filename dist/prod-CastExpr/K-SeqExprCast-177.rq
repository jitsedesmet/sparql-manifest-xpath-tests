# QT3 test case K-SeqExprCast-177 of test set prod-CastExpr, which tests the XPath expression
#   xs:dayTimeDuration("P24M1D")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L8831
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P24M1D" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
