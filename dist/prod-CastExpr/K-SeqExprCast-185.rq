# QT3 test case K-SeqExprCast-185 of test set prod-CastExpr, which tests the XPath expression
#   xs:string(xs:dayTimeDuration("PT6000M")) eq "P4DT4H"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "PT6000M" ) ) = "P4DT4H" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
