# QT3 test case CastAs259 of test set prod-CastExpr, which tests the XPath expression
#   xs:integer("-100") cast as xs:double
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L2772
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#double> ( <http://www.w3.org/2001/XMLSchema#integer> ( "-100" ) ) AS ?result)
  FILTER(( ?result = - "100"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
