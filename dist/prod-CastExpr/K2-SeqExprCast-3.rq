# QT3 test case K2-SeqExprCast-3 of test set prod-CastExpr, which tests the XPath expression
#   xs:nonPositiveInteger("0")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L20715
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND("0"^^xsd:nonPositiveInteger AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "0"^^xsd:integer ) ))
}
