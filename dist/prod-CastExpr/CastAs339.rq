# QT3 test case CastAs339 of test set prod-CastExpr, which tests the XPath expression
#   xs:dayTimeDuration("-PT100M") cast as xs:dayTimeDuration
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L3492
# The test needs the constructor function xsd:dayTimeDuration, xsd:dayTimeDuration on xsd:dayTimeDuration, xsd:string on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "-PT100M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-PT1H40M" ))
}
