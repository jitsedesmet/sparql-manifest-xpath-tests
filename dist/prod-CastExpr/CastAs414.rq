# QT3 test case CastAs414 of test set prod-CastExpr, which tests the XPath expression
#   xs:date("1999-05-31") cast as xs:yearMonthDuration
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( <http://www.w3.org/2001/XMLSchema#date> ( "1999-05-31" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
