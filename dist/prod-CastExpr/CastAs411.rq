# QT3 test case CastAs411 of test set prod-CastExpr, which tests the XPath expression
#   xs:date("1999-05-31Z") cast as xs:double
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L4148
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#double> ( <http://www.w3.org/2001/XMLSchema#date> ( "1999-05-31Z" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
