# QT3 test case CastAs114 of test set prod-CastExpr, which tests the XPath expression
#   xs:string("-P21M") cast as xs:yearMonthDuration
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L1419
# The test needs the constructor function xsd:yearMonthDuration, xsd:string on xsd:yearMonthDuration, which SPARQL does not define
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( <http://www.w3.org/2001/XMLSchema#string> ( "-P21M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-P1Y9M" ))
}
