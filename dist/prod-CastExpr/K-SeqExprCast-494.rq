# QT3 test case K-SeqExprCast-494 of test set prod-CastExpr, which tests the XPath expression
#   xs:double("3.3e3") cast as xs:string ne xs:string("an arbitrary string")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/CastExpr.xml#L11683
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#double> ( "3.3e3" ) ) != <http://www.w3.org/2001/XMLSchema#string> ( "an arbitrary string" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
