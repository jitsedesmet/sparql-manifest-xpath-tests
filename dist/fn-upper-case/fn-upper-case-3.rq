# QT3 test case fn-upper-case-3 of test set fn-upper-case, which tests the XPath expression
#   fn:upper-case("12345")
# Expecting:
#   <assert-string-value>12345</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/upper-case.xml#L52
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(UCASE( "12345" ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "12345" ))
}
