# QT3 test case fn-upper-case1args-3 of test set fn-upper-case, which tests the XPath expression
#   fn:upper-case(xs:string("This is a characte"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/upper-case.xml#L25
ASK {
  BIND(UCASE( <http://www.w3.org/2001/XMLSchema#string> ( "This is a characte" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "THIS IS A CHARACTE" ))
}
