# QT3 test case fn-upper-case-9 of test set fn-upper-case, which tests the XPath expression
#   fn:upper-case(lower-case("AbcDH"))
# Expecting:
#   <assert-string-value>ABCDH</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/upper-case.xml#L106
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(UCASE( LCASE( "AbcDH" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "ABCDH" ))
}
