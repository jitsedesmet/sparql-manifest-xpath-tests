# QT3 test case fn-upper-case-5 of test set fn-upper-case, which tests the XPath expression
#   fn:upper-case("ABCD")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/upper-case.xml#L70
ASK {
  BIND(UCASE( "ABCD" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "ABCD" ))
}
