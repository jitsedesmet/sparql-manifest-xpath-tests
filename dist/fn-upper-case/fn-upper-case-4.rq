# QT3 test case fn-upper-case-4 of test set fn-upper-case, which tests the XPath expression
#   fn:upper-case("12345abcd")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/upper-case.xml#L61
ASK {
  BIND(UCASE( "12345abcd" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "12345ABCD" ))
}
