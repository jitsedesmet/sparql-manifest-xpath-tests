# QT3 test case fn-upper-case-17 of test set fn-upper-case, which tests the XPath expression
#   fn:upper-case("abc") and fn:upper-case("abc")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/upper-case.xml#L178
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( UCASE( "abc" ) && UCASE( "abc" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
