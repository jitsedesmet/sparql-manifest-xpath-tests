# QT3 test case op-numeric-addnni2args-1 of test set op-numeric-add, which tests the XPath expression
#   xs:nonNegativeInteger("0") + xs:nonNegativeInteger("0")
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> + "0"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
