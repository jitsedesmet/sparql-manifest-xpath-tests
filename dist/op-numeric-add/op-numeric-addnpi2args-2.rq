# QT3 test case op-numeric-addnpi2args-2 of test set op-numeric-add, which tests the XPath expression
#   xs:nonPositiveInteger("0") + xs:nonPositiveInteger("-999999999999999999")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L410
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> + "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( ?result = - "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
