# QT3 test case op-numeric-adddec2args-2 of test set op-numeric-add, which tests the XPath expression
#   xs:decimal("999999999999999999") + xs:decimal("-999999999999999999")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L95
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:decimal ( "999999999999999999" ) + xsd:decimal ( "-999999999999999999" ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "0"^^xsd:integer ) ))
}
