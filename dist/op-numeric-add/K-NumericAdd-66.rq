# QT3 test case K-NumericAdd-66 of test set op-numeric-add, which tests the XPath expression
#   1 + "foo"
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L1292
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "1"^^xsd:integer + "foo" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
