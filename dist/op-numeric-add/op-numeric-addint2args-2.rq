# QT3 test case op-numeric-addint2args-2 of test set op-numeric-add, which tests the XPath expression
#   xs:int("2147483647") + xs:int("-2147483648")
ASK {
  BIND(( "2147483647"^^<http://www.w3.org/2001/XMLSchema#int> + "-2147483648"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( ?result = - "1"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
