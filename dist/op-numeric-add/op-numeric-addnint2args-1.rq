# QT3 test case op-numeric-addnint2args-1 of test set op-numeric-add, which tests the XPath expression
#   xs:negativeInteger("-297014075999096793") + xs:negativeInteger("-702985924000903206")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L275
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-297014075999096793"^^xsd:negativeInteger + "-702985924000903206"^^xsd:negativeInteger ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-999999999999999999"^^xsd:integer ) ))
}
