# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L14
ASK {
  BIND(( "-1873914410"^^<http://www.w3.org/2001/XMLSchema#int> + "-273569238"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( ?result = - "2147483648"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
