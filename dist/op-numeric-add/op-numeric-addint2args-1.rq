# QT3 test case op-numeric-addint2args-1 of test set op-numeric-add, which tests the XPath expression
#   xs:int("-1873914410") + xs:int("-273569238")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L14
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-1873914410"^^xsd:int + "-273569238"^^xsd:int ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-2147483648"^^xsd:integer ) ))
}
