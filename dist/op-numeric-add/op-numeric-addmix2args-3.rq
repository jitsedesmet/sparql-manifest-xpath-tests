# QT3 test case op-numeric-addmix2args-3 of test set op-numeric-add, which tests the XPath expression
#   1 + xs:integer('1')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L539
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "1"^^xsd:integer + xsd:integer ( "1" ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "2"^^xsd:integer ) ))
}
