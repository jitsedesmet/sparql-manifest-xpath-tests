# QT3 test case op-numeric-addnint2args-2 of test set op-numeric-add, which tests the XPath expression
#   xs:negativeInteger("-1") + xs:negativeInteger("-999999999999999999")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L284
ASK {
  BIND(( "-1"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> + "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> ) AS ?result)
  FILTER(( ?result = - "1000000000000000000"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
