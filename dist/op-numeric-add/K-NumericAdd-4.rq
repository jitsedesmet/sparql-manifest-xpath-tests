# QT3 test case K-NumericAdd-4 of test set op-numeric-add, which tests the XPath expression
#   1.1 + 2.2 eq 3.3
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L680
ASK {
  BIND(( ( "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> + "2.2"^^<http://www.w3.org/2001/XMLSchema#decimal> ) = "3.3"^^<http://www.w3.org/2001/XMLSchema#decimal> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
