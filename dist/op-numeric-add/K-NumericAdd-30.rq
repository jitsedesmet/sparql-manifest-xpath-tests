# QT3 test case K-NumericAdd-30 of test set op-numeric-add, which tests the XPath expression
#   2 eq 1+1
ASK {
  BIND(( "2"^^<http://www.w3.org/2001/XMLSchema#integer> = ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> + "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
