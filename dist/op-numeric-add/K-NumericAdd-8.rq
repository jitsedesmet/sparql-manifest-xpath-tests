# QT3 test case K-NumericAdd-8 of test set op-numeric-add, which tests the XPath expression
#   xs:float(6) + xs:float(2) eq 8
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L716
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:float ( "6"^^xsd:integer ) + xsd:float ( "2"^^xsd:integer ) ) = "8"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
