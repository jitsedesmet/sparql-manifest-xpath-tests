# QT3 test case op-numeric-adddec2args-3 of test set op-numeric-add, which tests the XPath expression
#   xs:decimal("-999999999999999999") + xs:decimal("617375191608514839")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L104
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:decimal ( "-999999999999999999" ) + xsd:decimal ( "617375191608514839" ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-382624808391485160"^^xsd:integer ) ))
}
