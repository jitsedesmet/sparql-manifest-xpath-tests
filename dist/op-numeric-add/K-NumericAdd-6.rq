# QT3 test case K-NumericAdd-6 of test set op-numeric-add, which tests the XPath expression
#   xs:float(1.1) + xs:float(2.2) ne 3.3
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L698
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#float> ( "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> ) + <http://www.w3.org/2001/XMLSchema#float> ( "2.2"^^<http://www.w3.org/2001/XMLSchema#decimal> ) ) != "3.3"^^<http://www.w3.org/2001/XMLSchema#decimal> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
