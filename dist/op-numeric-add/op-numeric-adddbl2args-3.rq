# QT3 test case op-numeric-adddbl2args-3 of test set op-numeric-add, which tests the XPath expression
#   xs:double("-1.7976931348623157E308") + xs:double("0")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L140
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:double ( "-1.7976931348623157E308" ) + xsd:double ( "0" ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-1.7976931348623157E308"^^xsd:double ) ))
}
