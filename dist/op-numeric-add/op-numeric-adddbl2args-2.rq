# QT3 test case op-numeric-adddbl2args-2 of test set op-numeric-add, which tests the XPath expression
#   xs:double("1.7976931348623157E308") + xs:double("-1.7976931348623157E308")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L131
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:double ( "1.7976931348623157E308" ) + xsd:double ( "-1.7976931348623157E308" ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "0"^^xsd:integer ) ))
}
