# QT3 test case K-NumericAdd-47 of test set op-numeric-add, which tests the XPath expression
#   (2 + 4) * 5 eq 30
ASK {
  BIND(( ( ( "2"^^<http://www.w3.org/2001/XMLSchema#integer> + "4"^^<http://www.w3.org/2001/XMLSchema#integer> ) * "5"^^<http://www.w3.org/2001/XMLSchema#integer> ) = "30"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
