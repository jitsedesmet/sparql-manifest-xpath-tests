# QT3 test case op-numeric-addsht2args-4 of test set op-numeric-add, which tests the XPath expression
#   xs:short("-32768") + xs:short("32767")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L509
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-32768"^^xsd:short + "32767"^^xsd:short ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-1"^^xsd:integer ) ))
}
