# QT3 test case K-NumericAdd-49 of test set op-numeric-add, which tests the XPath expression
#   1 + 2 * 4 + (1 + 2 + 3 * 4) eq 24
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L1106
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( ( "1"^^xsd:integer + ( "2"^^xsd:integer * "4"^^xsd:integer ) ) + ( ( "1"^^xsd:integer + "2"^^xsd:integer ) + ( "3"^^xsd:integer * "4"^^xsd:integer ) ) ) = "24"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
