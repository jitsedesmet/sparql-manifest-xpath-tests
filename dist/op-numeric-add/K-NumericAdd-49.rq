# QT3 test case K-NumericAdd-49 of test set op-numeric-add, which tests the XPath expression
#   1 + 2 * 4 + (1 + 2 + 3 * 4) eq 24
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L1106
ASK {
  BIND(( ( ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> + ( "2"^^<http://www.w3.org/2001/XMLSchema#integer> * "4"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) + ( ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> + "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) + ( "3"^^<http://www.w3.org/2001/XMLSchema#integer> * "4"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) ) = "24"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
