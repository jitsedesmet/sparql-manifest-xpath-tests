<#op-numeric-addint2args-1> a mf:QueryEvaluationTest ;
  mf:name "op-numeric-addint2args-1" ;
  rdfs:comment "Evaluates The \"op:numeric-add\" operator with the arguments set as follows: $arg1 = xs:int(mid range) $arg2 = xs:int(lower bound)" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L14> ;
  mf:action [ qt:query <op-numeric-addint2args-1.rq> ] ;
  mf:result <../true.srj> .

