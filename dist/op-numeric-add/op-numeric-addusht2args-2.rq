# QT3 test case op-numeric-addusht2args-2 of test set op-numeric-add, which tests the XPath expression
#   xs:unsignedShort("44633") + xs:unsignedShort("0")
ASK {
  BIND(( "44633"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> + "0"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) AS ?result)
  FILTER(( ?result = "44633"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
