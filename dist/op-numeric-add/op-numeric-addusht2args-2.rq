# QT3 test case op-numeric-addusht2args-2 of test set op-numeric-add, which tests the XPath expression
#   xs:unsignedShort("44633") + xs:unsignedShort("0")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L239
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "44633"^^xsd:unsignedShort + "0"^^xsd:unsignedShort ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "44633"^^xsd:integer ) ))
}
