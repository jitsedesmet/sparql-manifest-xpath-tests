# QT3 test case op-numeric-addintg2args-1 of test set op-numeric-add, which tests the XPath expression
#   xs:integer("830993497117024304") + xs:integer("-999999999999999999")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L50
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#integer> ( "830993497117024304" ) + <http://www.w3.org/2001/XMLSchema#integer> ( "-999999999999999999" ) ) AS ?result)
  FILTER(( ?result = - "169006502882975695"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
