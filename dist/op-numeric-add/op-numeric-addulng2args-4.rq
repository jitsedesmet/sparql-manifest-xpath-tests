# QT3 test case op-numeric-addulng2args-4 of test set op-numeric-add, which tests the XPath expression
#   xs:unsignedLong("0") + xs:unsignedLong("130747108607674654")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L383
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> + "130747108607674654"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( ?result = "130747108607674654"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
