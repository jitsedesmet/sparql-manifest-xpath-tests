# QT3 test case op-numeric-addnni2args-4 of test set op-numeric-add, which tests the XPath expression
#   xs:nonNegativeInteger("0") + xs:nonNegativeInteger("303884545991464527")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L464
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "0"^^xsd:nonNegativeInteger + "303884545991464527"^^xsd:nonNegativeInteger ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "303884545991464527"^^xsd:integer ) ))
}
