# QT3 test case op-numeric-addint2args-3 of test set op-numeric-add, which tests the XPath expression
#   xs:int("-273569238") + xs:int("-1873914410")
ASK {
  BIND(( "-273569238"^^<http://www.w3.org/2001/XMLSchema#int> + "-1873914410"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( ?result = - "2147483648"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
