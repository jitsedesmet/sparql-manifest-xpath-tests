# QT3 test case op-numeric-addlng2args-3 of test set op-numeric-add, which tests the XPath expression
#   xs:long("-45058158165499290") + xs:long("-47175562203048468")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L212
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-45058158165499290"^^xsd:long + "-47175562203048468"^^xsd:long ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-92233720368547758"^^xsd:integer ) ))
}
