# QT3 test case K-NumericAdd-7 of test set op-numeric-add, which tests the XPath expression
#   xs:integer(6) + xs:integer(2) eq 8
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L707
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#integer> ( "6"^^<http://www.w3.org/2001/XMLSchema#integer> ) + <http://www.w3.org/2001/XMLSchema#integer> ( "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) = "8"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
