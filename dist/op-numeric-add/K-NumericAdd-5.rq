# QT3 test case K-NumericAdd-5 of test set op-numeric-add, which tests the XPath expression
#   xs:double(1.1) + xs:double(2.2) ne 3.3
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L689
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:double ( "1.1"^^xsd:decimal ) + xsd:double ( "2.2"^^xsd:decimal ) ) != "3.3"^^xsd:decimal ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
