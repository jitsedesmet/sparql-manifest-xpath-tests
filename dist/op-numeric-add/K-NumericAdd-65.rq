# QT3 test case K-NumericAdd-65 of test set op-numeric-add, which tests the XPath expression
#   "foo" + 1
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L1283
ASK {
  BIND(( "foo" + "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(! BOUND( ?result ))
}
