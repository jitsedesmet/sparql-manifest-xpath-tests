# QT3 test case op-numeric-addnpi2args-1 of test set op-numeric-add, which tests the XPath expression
#   xs:nonPositiveInteger("-475688437271870490") + xs:nonPositiveInteger("-524311562728129509")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L401
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-475688437271870490"^^xsd:nonPositiveInteger + "-524311562728129509"^^xsd:nonPositiveInteger ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-999999999999999999"^^xsd:integer ) ))
}
