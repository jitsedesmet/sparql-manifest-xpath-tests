@prefix dct: <http://purl.org/dc/terms/> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "QT3 test set op-numeric-add" ;
  dct:license <../LICENSE.txt> ;
  mf:entries (
    <#op-numeric-addmix2args-2>
    <#K-NumericAdd-43>
    <#K-NumericAdd-65>
    <#K-NumericAdd-66>
  ) .

<#op-numeric-addmix2args-2> a mf:QueryEvaluationTest ;
  mf:name "op-numeric-addmix2args-2" ;
  rdfs:comment "Simple addition test pass string for second operator" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L530> ;
  mf:action [ qt:query <op-numeric-addmix2args-2.rq> ] ;
  mf:result <../true.srj> .

<#K-NumericAdd-43> a mf:QueryEvaluationTest ;
  mf:name "K-NumericAdd-43" ;
  rdfs:comment "Invoke the '+' operator with invalid operands." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L1052> ;
  mf:action [ qt:query <K-NumericAdd-43.rq> ] ;
  mf:result <../true.srj> .

<#K-NumericAdd-65> a mf:QueryEvaluationTest ;
  mf:name "K-NumericAdd-65" ;
  rdfs:comment "Invoke operator '+' where one of the operands is a string." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L1283> ;
  mf:action [ qt:query <K-NumericAdd-65.rq> ] ;
  mf:result <../true.srj> .

<#K-NumericAdd-66> a mf:QueryEvaluationTest ;
  mf:name "K-NumericAdd-66" ;
  rdfs:comment "Invoke operator '+' where one of the operands is a string." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L1292> ;
  mf:action [ qt:query <K-NumericAdd-66.rq> ] ;
  mf:result <../true.srj> .
