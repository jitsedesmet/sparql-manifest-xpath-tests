# QT3 test case K-NumericAdd-2 of test set op-numeric-add, which tests the XPath expression
#   xs:decimal(6) + xs:decimal(2) eq 8
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L662
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:decimal ( "6"^^xsd:integer ) + xsd:decimal ( "2"^^xsd:integer ) ) = "8"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
