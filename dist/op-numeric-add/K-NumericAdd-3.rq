# QT3 test case K-NumericAdd-3 of test set op-numeric-add, which tests the XPath expression
#   xs:decimal(6.1) + xs:decimal(2.1) eq 8.2
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L671
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:decimal ( "6.1"^^xsd:decimal ) + xsd:decimal ( "2.1"^^xsd:decimal ) ) = "8.2"^^xsd:decimal ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
