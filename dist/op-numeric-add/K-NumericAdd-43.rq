# QT3 test case K-NumericAdd-43 of test set op-numeric-add, which tests the XPath expression
#   "3" + "3"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-add.xml#L1052
ASK {
  BIND(( "3" + "3" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
