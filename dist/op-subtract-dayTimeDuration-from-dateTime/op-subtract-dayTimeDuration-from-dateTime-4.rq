# QT3 test case op-subtract-dayTimeDuration-from-dateTime-4 of test set op-subtract-dayTimeDuration-from-dateTime, which tests the XPath expression
#   fn:not(fn:string(xs:dateTime("1998-09-12T13:23:23Z") - xs:dayTimeDuration("P02DT07H01M")))
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-dateTime.xml#L145
# The test needs the constructor function xsd:dayTimeDuration, - on xsd:dayTimeDuration, - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! xsd:string ( ( xsd:dateTime ( "1998-09-12T13:23:23Z" ) - xsd:dayTimeDuration ( "P02DT07H01M" ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
