# QT3 test case op-subtract-dayTimeDuration-from-dateTime-9 of test set op-subtract-dayTimeDuration-from-dateTime, which tests the XPath expression
#   fn:string((xs:dateTime("1993-12-09T13:13:13Z") - xs:dayTimeDuration("P03DT01H04M"))) and fn:string((xs:dateTime("1993-12-09T13:13:13Z") - xs:dayTimeDuration("P01DT01H03M")))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-dateTime.xml#L225
# The test needs the constructor function xsd:dayTimeDuration, - on xsd:dayTimeDuration, - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:dateTime ( "1993-12-09T13:13:13Z" ) - xsd:dayTimeDuration ( "P03DT01H04M" ) ) ) && xsd:string ( ( xsd:dateTime ( "1993-12-09T13:13:13Z" ) - xsd:dayTimeDuration ( "P01DT01H03M" ) ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
