# QT3 test case op-subtract-dayTimeDuration-from-dateTime-16 of test set op-subtract-dayTimeDuration-from-dateTime, which tests the XPath expression
#   (xs:dateTime("1977-12-12T13:12:15Z") - xs:dayTimeDuration("P18DT02H02M")) ge xs:dateTime("1977-12-12T15:56:10Z")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-dateTime.xml#L321
# The test needs the constructor function xsd:dayTimeDuration, - on xsd:dayTimeDuration, - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:dateTime ( "1977-12-12T13:12:15Z" ) - xsd:dayTimeDuration ( "P18DT02H02M" ) ) >= xsd:dateTime ( "1977-12-12T15:56:10Z" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
