# QT3 test case op-subtract-dayTimeDuration-from-dateTime-3 of test set op-subtract-dayTimeDuration-from-dateTime, which tests the XPath expression
#   fn:string((xs:dateTime("1999-10-23T03:12:23Z") - xs:dayTimeDuration("P19DT13H10M"))) or fn:false()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-dateTime.xml#L130
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-10-23T03:12:23Z" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P19DT13H10M" ) ) ) || "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
