# QT3 test case op-subtract-dayTimeDuration-from-dateTime-7 of test set op-subtract-dayTimeDuration-from-dateTime, which tests the XPath expression
#   fn:string(xs:dateTime("1989-07-05T10:10:10Z") - xs:dayTimeDuration("P01DT09H02M"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1989-07-05T10:10:10Z" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P01DT09H02M" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1989-07-04T01:08:10Z" ))
}
