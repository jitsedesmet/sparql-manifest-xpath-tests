# QT3 test case op-subtract-dayTimeDuration-from-dateTime-7 of test set op-subtract-dayTimeDuration-from-dateTime, which tests the XPath expression
#   fn:string(xs:dateTime("1989-07-05T10:10:10Z") - xs:dayTimeDuration("P01DT09H02M"))
# Expecting:
#   <assert-string-value>1989-07-04T01:08:10Z</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-dateTime.xml#L193
# The test needs the constructor function xsd:dayTimeDuration, - on xsd:dayTimeDuration, - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( ( xsd:dateTime ( "1989-07-05T10:10:10Z" ) - xsd:dayTimeDuration ( "P01DT09H02M" ) ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1989-07-04T01:08:10Z" ))
}
