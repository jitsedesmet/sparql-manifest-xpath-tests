# QT3 test case op-subtract-dayTimeDuration-from-dateTime-13 of test set op-subtract-dayTimeDuration-from-dateTime, which tests the XPath expression
#   (xs:dateTime("1980-05-05T17:17:17Z") - xs:dayTimeDuration("P23DT11H11M")) eq xs:dateTime("1980-05-05T17:17:17Z")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-dateTime.xml#L273
# The test needs the constructor function xsd:dayTimeDuration, - on xsd:dayTimeDuration, - on xsd:dateTime, which SPARQL does not define
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1980-05-05T17:17:17Z" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P23DT11H11M" ) ) = <http://www.w3.org/2001/XMLSchema#dateTime> ( "1980-05-05T17:17:17Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
