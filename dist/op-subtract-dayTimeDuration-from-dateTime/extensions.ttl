<#op-subtract-dayTimeDuration-from-dateTime2args-1> a mf:QueryEvaluationTest ;
  mf:name "op-subtract-dayTimeDuration-from-dateTime2args-1" ;
  rdfs:comment "*******************************************************\nTest: op-subtract-dayTimeDuration-from-dateTime2args-1  \nWritten By: Carmelo Montanez                            \nDate: Tue Apr 12 16:29:08 GMT-05:00 2005                \nPurpose: Evaluates The \"op:subtract-dayTimeDuration-from-dateTime\" operator\n with the arguments set as follows:                    \n$arg1 = xs:dateTime(lower bound)                       \n$arg2 = xs:dayTimeDuration(lower bound)               \n*******************************************************" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-dateTime.xml> ;
  mf:action [ qt:query <op-subtract-dayTimeDuration-from-dateTime2args-1.rq> ] ;
  mf:result <../true.srj> .

