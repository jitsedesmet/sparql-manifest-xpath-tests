# QT3 test case fn-false-20 of test set fn-false, which tests the XPath expression
#   fn:contains(xs:string(fn:false()),xs:string(fn:false()))
ASK {
  BIND(CONTAINS( <http://www.w3.org/2001/XMLSchema#string> ( "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) , <http://www.w3.org/2001/XMLSchema#string> ( "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
