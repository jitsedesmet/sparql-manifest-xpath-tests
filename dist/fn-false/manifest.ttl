<#fn-false-1> a mf:QueryEvaluationTest ;
  mf:name "fn-false-1" ;
  rdfs:comment "Simple call to an \"fn:false\" function." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/false.xml> ;
  mf:action [ qt:query <fn-false-1.rq> ] ;
  mf:result <../true.srj> .

<#fn-false-2> a mf:QueryEvaluationTest ;
  mf:name "fn-false-2" ;
  rdfs:comment "Evaliation of \"fn:false\" function as argument to fn:not function." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/false.xml> ;
  mf:action [ qt:query <fn-false-2.rq> ] ;
  mf:result <../true.srj> .

