# QT3 test case fn-false-18 of test set fn-false, which tests the XPath expression
#   fn:string(fn:false())
# Expecting:
#   <assert-eq>"false"</assert-eq>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/false.xml#L163
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( "false"^^xsd:boolean ) AS ?result)
  FILTER(SAMETERM( ?result , "false" ))
}
