# QT3 test case fn-false-18 of test set fn-false, which tests the XPath expression
#   fn:string(fn:false())
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/false.xml#L163
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#string> , <http://www.w3.org/2001/XMLSchema#normalizedString> , <http://www.w3.org/2001/XMLSchema#token> , <http://www.w3.org/2001/XMLSchema#language> , <http://www.w3.org/2001/XMLSchema#NMTOKEN> , <http://www.w3.org/2001/XMLSchema#Name> , <http://www.w3.org/2001/XMLSchema#NCName> , <http://www.w3.org/2001/XMLSchema#ID> , <http://www.w3.org/2001/XMLSchema#IDREF> , <http://www.w3.org/2001/XMLSchema#ENTITY> ) ) && SAMETERM( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) , "false" ) ))
}
