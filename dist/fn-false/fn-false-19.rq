# QT3 test case fn-false-19 of test set fn-false, which tests the XPath expression
#   fn:concat(xs:string(fn:false()),xs:string(fn:false()))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/false.xml#L172
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( xsd:string ( "false"^^xsd:boolean ) ) , xsd:string ( xsd:string ( "false"^^xsd:boolean ) ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "falsefalse" ))
}
