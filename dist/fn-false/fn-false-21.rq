# QT3 test case fn-false-21 of test set fn-false, which tests the XPath expression
#   fn:string-length(xs:string(fn:false()))
ASK {
  BIND(STRLEN( <http://www.w3.org/2001/XMLSchema#string> ( "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "5" ))
}
