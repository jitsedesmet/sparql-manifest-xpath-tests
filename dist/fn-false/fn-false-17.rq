# QT3 test case fn-false-17 of test set fn-false, which tests the XPath expression
#   xs:boolean(fn:false())
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/false.xml#L154
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#boolean> ( "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
