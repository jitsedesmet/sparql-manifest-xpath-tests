# QT3 test case K-FalseFunc-2 of test set fn-false, which tests the XPath expression
#   false() eq false()
ASK {
  BIND(( "false"^^<http://www.w3.org/2001/XMLSchema#boolean> = "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
