# QT3 test case fn-false-16 of test set fn-false, which tests the XPath expression
#   fn:false() >= fn:false()
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/false.xml#L145
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "false"^^xsd:boolean >= "false"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
