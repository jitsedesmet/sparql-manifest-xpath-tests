# QT3 test case fn-false-7 of test set fn-false, which tests the XPath expression
#   fn:false() lt fn:false()
ASK {
  BIND(( "false"^^<http://www.w3.org/2001/XMLSchema#boolean> < "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
