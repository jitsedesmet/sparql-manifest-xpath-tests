# QT3 test case op-numeric-less-thannpi2args-5 of test set op-numeric-less-than, which tests the XPath expression
#   xs:nonPositiveInteger("-999999999999999999") lt xs:nonPositiveInteger("0")
ASK {
  BIND(( "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> < "0"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
