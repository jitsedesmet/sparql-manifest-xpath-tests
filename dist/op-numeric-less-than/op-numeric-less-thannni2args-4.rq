# QT3 test case op-numeric-less-thannni2args-4 of test set op-numeric-less-than, which tests the XPath expression
#   xs:nonNegativeInteger("0") lt xs:nonNegativeInteger("303884545991464527")
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> < "303884545991464527"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
