# QT3 test case K-NumericLT-10 of test set op-numeric-less-than, which tests the XPath expression
#   xs:float("-INF") lt 0
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "-INF" ) < "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
