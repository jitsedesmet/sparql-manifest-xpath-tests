# QT3 test case op-numeric-less-thanulng2args-4 of test set op-numeric-less-than, which tests the XPath expression
#   xs:unsignedLong("0") lt xs:unsignedLong("130747108607674654")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L1680
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> < "130747108607674654"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
