<#op-numeric-less-thanint2args-1> a mf:QueryEvaluationTest ;
  mf:name "op-numeric-less-thanint2args-1" ;
  rdfs:comment "*******************************************************\nTest: op-numeric-less-thanint2args-1                    \nWritten By: Carmelo Montanez                            \nDate: Thu Dec 16 10:48:16 GMT-05:00 2004                \nPurpose: Evaluates The \"op:numeric-less-than\" operator \n with the arguments set as follows:                    \n$arg1 = xs:int(lower bound)                            \n$arg2 = xs:int(lower bound)                            \n*******************************************************" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml> ;
  mf:action [ qt:query <op-numeric-less-thanint2args-1.rq> ] ;
  mf:result <../true.srj> .

