# QT3 test case op-numeric-less-thanflt2args-1 of test set op-numeric-less-than, which tests the XPath expression
#   xs:float("-3.4028235E38") lt xs:float("-3.4028235E38")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L726
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:float ( "-3.4028235E38" ) < xsd:float ( "-3.4028235E38" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
