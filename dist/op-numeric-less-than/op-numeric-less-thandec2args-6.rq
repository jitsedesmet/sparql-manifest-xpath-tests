# QT3 test case op-numeric-less-thandec2args-6 of test set op-numeric-less-than, which tests the XPath expression
#   xs:decimal("-999999999999999999") ge xs:decimal("-999999999999999999")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L456
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:decimal ( "-999999999999999999" ) >= xsd:decimal ( "-999999999999999999" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
