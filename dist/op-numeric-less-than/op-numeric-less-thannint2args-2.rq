# QT3 test case op-numeric-less-thannint2args-2 of test set op-numeric-less-than, which tests the XPath expression
#   xs:negativeInteger("-297014075999096793") lt xs:negativeInteger("-999999999999999999")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L1284
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-297014075999096793"^^xsd:negativeInteger < "-999999999999999999"^^xsd:negativeInteger ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
