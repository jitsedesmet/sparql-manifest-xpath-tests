# QT3 test case op-numeric-less-thannpi2args-3 of test set op-numeric-less-than, which tests the XPath expression
#   xs:nonPositiveInteger("0") lt xs:nonPositiveInteger("-999999999999999999")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L1842
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "0"^^xsd:nonPositiveInteger < "-999999999999999999"^^xsd:nonPositiveInteger ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
