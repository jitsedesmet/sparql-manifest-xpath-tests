# QT3 test case op-numeric-less-thannni2args-1 of test set op-numeric-less-than, which tests the XPath expression
#   xs:nonNegativeInteger("0") lt xs:nonNegativeInteger("0")
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> < "0"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
