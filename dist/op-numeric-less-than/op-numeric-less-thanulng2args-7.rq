# QT3 test case op-numeric-less-thanulng2args-7 of test set op-numeric-less-than, which tests the XPath expression
#   xs:unsignedLong("130747108607674654") ge xs:unsignedLong("0")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L1734
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "130747108607674654"^^xsd:unsignedLong >= "0"^^xsd:unsignedLong ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
