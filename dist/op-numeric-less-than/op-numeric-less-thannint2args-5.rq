# QT3 test case op-numeric-less-thannint2args-5 of test set op-numeric-less-than, which tests the XPath expression
#   xs:negativeInteger("-999999999999999999") lt xs:negativeInteger("-1")
ASK {
  BIND(( "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> < "-1"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
