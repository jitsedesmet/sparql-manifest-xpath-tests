# QT3 test case op-numeric-less-thannpi2args-4 of test set op-numeric-less-than, which tests the XPath expression
#   xs:nonPositiveInteger("-999999999999999999") lt xs:nonPositiveInteger("-475688437271870490")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L1860
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-999999999999999999"^^xsd:nonPositiveInteger < "-475688437271870490"^^xsd:nonPositiveInteger ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
