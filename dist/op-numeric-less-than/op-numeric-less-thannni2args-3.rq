# QT3 test case op-numeric-less-thannni2args-3 of test set op-numeric-less-than, which tests the XPath expression
#   xs:nonNegativeInteger("999999999999999999") lt xs:nonNegativeInteger("0")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L2022
ASK {
  BIND(( "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> < "0"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
