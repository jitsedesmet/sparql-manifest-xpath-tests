# QT3 test case op-numeric-less-thanintg2args-9 of test set op-numeric-less-than, which tests the XPath expression
#   xs:integer("-999999999999999999") ge xs:integer("830993497117024304")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L330
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:integer ( "-999999999999999999" ) >= xsd:integer ( "830993497117024304" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
