# QT3 test case op-numeric-less-thanlng2args-7 of test set op-numeric-less-than, which tests the XPath expression
#   xs:long("-47175562203048468") ge xs:long("-92233720368547758")
ASK {
  BIND(( "-47175562203048468"^^<http://www.w3.org/2001/XMLSchema#long> >= "-92233720368547758"^^<http://www.w3.org/2001/XMLSchema#long> ) AS ?result)
