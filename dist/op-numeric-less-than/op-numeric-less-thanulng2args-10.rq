# QT3 test case op-numeric-less-thanulng2args-10 of test set op-numeric-less-than, which tests the XPath expression
#   xs:unsignedLong("0") ge xs:unsignedLong("184467440737095516")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L1788
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "0"^^xsd:unsignedLong >= "184467440737095516"^^xsd:unsignedLong ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
