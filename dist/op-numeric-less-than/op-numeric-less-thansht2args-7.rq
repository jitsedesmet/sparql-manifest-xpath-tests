# QT3 test case op-numeric-less-thansht2args-7 of test set op-numeric-less-than, which tests the XPath expression
#   xs:short("-5324") ge xs:short("-32768")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L2274
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-5324"^^xsd:short >= "-32768"^^xsd:short ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
