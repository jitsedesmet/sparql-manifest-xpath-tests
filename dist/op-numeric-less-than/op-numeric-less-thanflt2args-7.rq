# QT3 test case op-numeric-less-thanflt2args-7 of test set op-numeric-less-than, which tests the XPath expression
#   xs:float("0") ge xs:float("-3.4028235E38")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L834
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:float ( "0" ) >= xsd:float ( "-3.4028235E38" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
