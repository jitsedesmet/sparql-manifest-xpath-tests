# QT3 test case op-numeric-less-thanpint2args-9 of test set op-numeric-less-than, which tests the XPath expression
#   xs:positiveInteger("1") ge xs:positiveInteger("52704602390610033")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L1590
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "1"^^xsd:positiveInteger >= "52704602390610033"^^xsd:positiveInteger ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
