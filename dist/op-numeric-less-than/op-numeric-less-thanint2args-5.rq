# QT3 test case op-numeric-less-thanint2args-5 of test set op-numeric-less-than, which tests the XPath expression
#   xs:int("-2147483648") lt xs:int("2147483647")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L78
ASK {
  BIND(( "-2147483648"^^<http://www.w3.org/2001/XMLSchema#int> < "2147483647"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
