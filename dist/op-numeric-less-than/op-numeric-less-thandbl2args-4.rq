# QT3 test case op-numeric-less-thandbl2args-4 of test set op-numeric-less-than, which tests the XPath expression
#   xs:double("-1.7976931348623157E308") lt xs:double("0")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L600
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( "-1.7976931348623157E308" ) < <http://www.w3.org/2001/XMLSchema#double> ( "0" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
