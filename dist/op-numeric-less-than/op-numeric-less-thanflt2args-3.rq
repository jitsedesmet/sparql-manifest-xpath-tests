# QT3 test case op-numeric-less-thanflt2args-3 of test set op-numeric-less-than, which tests the XPath expression
#   xs:float("3.4028235E38") lt xs:float("-3.4028235E38")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "3.4028235E38" ) < <http://www.w3.org/2001/XMLSchema#float> ( "-3.4028235E38" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
