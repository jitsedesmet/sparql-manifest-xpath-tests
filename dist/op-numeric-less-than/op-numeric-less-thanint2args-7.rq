# QT3 test case op-numeric-less-thanint2args-7 of test set op-numeric-less-than, which tests the XPath expression
#   xs:int("-1873914410") ge xs:int("-2147483648")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L114
ASK {
  BIND(( "-1873914410"^^<http://www.w3.org/2001/XMLSchema#int> >= "-2147483648"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
