# QT3 test case op-numeric-less-thanusht2args-1 of test set op-numeric-less-than, which tests the XPath expression
#   xs:unsignedShort("0") lt xs:unsignedShort("0")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L1086
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "0"^^xsd:unsignedShort < "0"^^xsd:unsignedShort ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
