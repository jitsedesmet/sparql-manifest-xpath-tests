# QT3 test case K-NumericLT-19 of test set op-numeric-less-than, which tests the XPath expression
#   not(1 le xs:double("NaN"))
ASK {
  BIND(! ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> <= <http://www.w3.org/2001/XMLSchema#double> ( "NaN" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
