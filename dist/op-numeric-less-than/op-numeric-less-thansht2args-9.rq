# QT3 test case op-numeric-less-thansht2args-9 of test set op-numeric-less-than, which tests the XPath expression
#   xs:short("-32768") ge xs:short("-5324")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L2310
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-32768"^^xsd:short >= "-5324"^^xsd:short ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
