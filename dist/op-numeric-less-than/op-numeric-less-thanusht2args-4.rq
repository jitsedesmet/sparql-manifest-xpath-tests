# QT3 test case op-numeric-less-thanusht2args-4 of test set op-numeric-less-than, which tests the XPath expression
#   xs:unsignedShort("0") lt xs:unsignedShort("44633")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L1140
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "0"^^xsd:unsignedShort < "44633"^^xsd:unsignedShort ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
