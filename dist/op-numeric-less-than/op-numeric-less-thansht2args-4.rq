# QT3 test case op-numeric-less-thansht2args-4 of test set op-numeric-less-than, which tests the XPath expression
#   xs:short("-32768") lt xs:short("-5324")
ASK {
  BIND(( "-32768"^^<http://www.w3.org/2001/XMLSchema#short> < "-5324"^^<http://www.w3.org/2001/XMLSchema#short> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
