# QT3 test case K-NumericLT-6 of test set op-numeric-less-than, which tests the XPath expression
#   xs:double("-INF") lt 0
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L2421
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( "-INF" ) < "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
