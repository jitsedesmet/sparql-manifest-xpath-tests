# QT3 test case op-numeric-less-thannni2args-10 of test set op-numeric-less-than, which tests the XPath expression
#   xs:nonNegativeInteger("0") ge xs:nonNegativeInteger("999999999999999999")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L2148
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "0"^^xsd:nonNegativeInteger >= "999999999999999999"^^xsd:nonNegativeInteger ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
