# QT3 test case op-numeric-less-thanint2args-1 of test set op-numeric-less-than, which tests the XPath expression
#   xs:int("-2147483648") lt xs:int("-2147483648")
ASK {
  BIND(( "-2147483648"^^<http://www.w3.org/2001/XMLSchema#int> < "-2147483648"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
