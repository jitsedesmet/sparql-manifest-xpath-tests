# QT3 test case op-numeric-less-thannint2args-1 of test set op-numeric-less-than, which tests the XPath expression
#   xs:negativeInteger("-999999999999999999") lt xs:negativeInteger("-999999999999999999")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L1266
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-999999999999999999"^^xsd:negativeInteger < "-999999999999999999"^^xsd:negativeInteger ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
