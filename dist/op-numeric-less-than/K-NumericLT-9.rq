# QT3 test case K-NumericLT-9 of test set op-numeric-less-than, which tests the XPath expression
#   0 lt xs:float("INF")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L2466
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#integer> < <http://www.w3.org/2001/XMLSchema#float> ( "INF" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
