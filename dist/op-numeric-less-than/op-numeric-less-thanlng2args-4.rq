# QT3 test case op-numeric-less-thanlng2args-4 of test set op-numeric-less-than, which tests the XPath expression
#   xs:long("-92233720368547758") lt xs:long("-47175562203048468")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L960
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-92233720368547758"^^xsd:long < "-47175562203048468"^^xsd:long ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
