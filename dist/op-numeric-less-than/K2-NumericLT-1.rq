# QT3 test case K2-NumericLT-1 of test set op-numeric-less-than, which tests the XPath expression
#   xs:unsignedLong("100") lt xs:unsignedLong("18446744073709551615")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L2676
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "100"^^xsd:unsignedLong < "18446744073709551615"^^xsd:unsignedLong ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
