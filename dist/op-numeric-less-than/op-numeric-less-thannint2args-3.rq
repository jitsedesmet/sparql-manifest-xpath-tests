# QT3 test case op-numeric-less-thannint2args-3 of test set op-numeric-less-than, which tests the XPath expression
#   xs:negativeInteger("-1") lt xs:negativeInteger("-999999999999999999")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L1302
ASK {
  BIND(( "-1"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> < "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , <http://www.w3.org/2001/XMLSchema#boolean> ) && SAMETERM( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) , "false" ) ))
}
