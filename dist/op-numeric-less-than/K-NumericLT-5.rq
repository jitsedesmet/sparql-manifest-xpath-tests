# QT3 test case K-NumericLT-5 of test set op-numeric-less-than, which tests the XPath expression
#   0 lt xs:double("INF")
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#integer> < <http://www.w3.org/2001/XMLSchema#double> ( "INF" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
