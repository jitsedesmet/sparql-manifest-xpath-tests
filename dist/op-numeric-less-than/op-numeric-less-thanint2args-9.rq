# QT3 test case op-numeric-less-thanint2args-9 of test set op-numeric-less-than, which tests the XPath expression
#   xs:int("-2147483648") ge xs:int("-1873914410")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-less-than.xml#L150
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-2147483648"^^xsd:int >= "-1873914410"^^xsd:int ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
