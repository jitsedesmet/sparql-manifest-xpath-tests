# QT3 test case op-numeric-less-thanpint2args-3 of test set op-numeric-less-than, which tests the XPath expression
#   xs:positiveInteger("999999999999999999") lt xs:positiveInteger("1")
ASK {
  BIND(( "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> < "1"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
