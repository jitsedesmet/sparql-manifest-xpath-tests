# QT3 test case K-StringGT-3 of test set op-string-greater-than, which tests the XPath expression
#   'abc' ge 'a'
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/string-greater-than.xml#L25
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "abc" >= "a" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
