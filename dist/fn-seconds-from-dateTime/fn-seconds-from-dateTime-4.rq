# QT3 test case fn-seconds-from-dateTime-4 of test set fn-seconds-from-dateTime, which tests the XPath expression
#   fn:seconds-from-dateTime(xs:dateTime("1999-12-31T21:20:20-05:00")) le fn:seconds-from-dateTime(xs:dateTime("1999-12-31T21:20:20-05:00"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/seconds-from-dateTime.xml#L62
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( SECONDS( xsd:dateTime ( "1999-12-31T21:20:20-05:00" ) ) <= SECONDS( xsd:dateTime ( "1999-12-31T21:20:20-05:00" ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
