# QT3 test case fn-seconds-from-dateTime-7 of test set fn-seconds-from-dateTime, which tests the XPath expression
#   fn:seconds-from-dateTime(xs:dateTime("1999-05-31T23:59:59-05:00"))
# Expecting:
#   <assert-string-value>59</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/seconds-from-dateTime.xml#L89
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(SECONDS( xsd:dateTime ( "1999-05-31T23:59:59-05:00" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "59" ))
}
