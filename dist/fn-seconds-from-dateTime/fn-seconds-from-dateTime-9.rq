# QT3 test case fn-seconds-from-dateTime-9 of test set fn-seconds-from-dateTime, which tests the XPath expression
#   fn:seconds-from-dateTime(xs:dateTime("1970-01-01T00:00:10Z")) - fn:seconds-from-dateTime(xs:dateTime("1970-01-01T10:00:00Z"))
# Expecting:
#   <assert-string-value>10</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/seconds-from-dateTime.xml#L107
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( SECONDS( xsd:dateTime ( "1970-01-01T00:00:10Z" ) ) - SECONDS( xsd:dateTime ( "1970-01-01T10:00:00Z" ) ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "10" ))
}
