# QT3 test case fn-seconds-from-dateTime-6 of test set fn-seconds-from-dateTime, which tests the XPath expression
#   fn:seconds-from-dateTime(xs:dateTime("1999-05-31T20:00:00-05:00"))
ASK {
  BIND(SECONDS( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-05-31T20:00:00-05:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0" ))
}
