# QT3 test case fn-seconds-from-dateTime-16 of test set fn-seconds-from-dateTime, which tests the XPath expression
#   fn:seconds-from-dateTime(xs:dateTime("1970-01-01T10:10:10Z")) eq fn:seconds-from-dateTime(xs:dateTime("1970-01-01T10:10:10Z"))
ASK {
  BIND(( SECONDS( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T10:10:10Z" ) ) = SECONDS( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T10:10:10Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
