# QT3 test case fn-seconds-from-dateTime-10 of test set fn-seconds-from-dateTime, which tests the XPath expression
#   fn:seconds-from-dateTime(xs:dateTime("1970-01-01T02:02:02Z")) * fn:seconds-from-dateTime(xs:dateTime("1970-01-01T10:03:03Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/seconds-from-dateTime.xml#L116
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( SECONDS( xsd:dateTime ( "1970-01-01T02:02:02Z" ) ) * SECONDS( xsd:dateTime ( "1970-01-01T10:03:03Z" ) ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "6" ))
}
