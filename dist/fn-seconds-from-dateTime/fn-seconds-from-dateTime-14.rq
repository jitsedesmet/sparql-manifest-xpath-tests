# QT3 test case fn-seconds-from-dateTime-14 of test set fn-seconds-from-dateTime, which tests the XPath expression
#   +fn:seconds-from-dateTime(xs:dateTime("1970-01-01T10:10:10Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/seconds-from-dateTime.xml#L152
ASK {
  BIND(+ SECONDS( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T10:10:10Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "10" ))
}
