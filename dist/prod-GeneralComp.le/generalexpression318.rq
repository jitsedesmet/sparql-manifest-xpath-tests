# QT3 test case generalexpression318 of test set prod-GeneralComp.le, which tests the XPath expression
#   (50000) <= 10000
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/GeneralComp.le.xml#L202
ASK {
  BIND(( "50000"^^<http://www.w3.org/2001/XMLSchema#integer> <= "10000"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
