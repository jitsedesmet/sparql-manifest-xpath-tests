# QT3 test case op-duration-equal-27 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration('P1Y') eq xs:dayTimeDuration('P365D')
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1Y" ) = <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P365D" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
