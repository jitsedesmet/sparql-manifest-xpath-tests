# QT3 test case op-duration-equal-27 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration('P1Y') eq xs:dayTimeDuration('P365D')
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L243
# The test needs the constructor function xsd:yearMonthDuration, the constructor function xsd:dayTimeDuration, = on xsd:yearMonthDuration, = on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:yearMonthDuration ( "P1Y" ) = xsd:dayTimeDuration ( "P365D" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
