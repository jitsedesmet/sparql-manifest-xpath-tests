# QT3 test case K-DayTimeDurationEQ-7 of test set op-duration-equal, which tests the XPath expression
#   xs:dayTimeDuration("-P2DT5H") ne xs:dayTimeDuration("P2DT5H")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L1231
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "-P2DT5H" ) != <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P2DT5H" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
