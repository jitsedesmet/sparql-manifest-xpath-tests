# QT3 test case op-duration-equal-25 of test set op-duration-equal, which tests the XPath expression
#   (xs:duration("P36D") ne xs:duration("P36D")) or fn:false()
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#duration> ( "P36D" ) != <http://www.w3.org/2001/XMLSchema#duration> ( "P36D" ) ) || "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
