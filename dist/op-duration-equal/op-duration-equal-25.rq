# QT3 test case op-duration-equal-25 of test set op-duration-equal, which tests the XPath expression
#   (xs:duration("P36D") ne xs:duration("P36D")) or fn:false()
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L225
# The test needs the constructor function xsd:duration, != on xsd:duration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:duration ( "P36D" ) != xsd:duration ( "P36D" ) ) || "false"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
