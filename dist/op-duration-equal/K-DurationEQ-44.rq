# QT3 test case K-DurationEQ-44 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration("P1999Y10M") le xs:dayTimeDuration("P3DT08H34M12.143S")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1999Y10M" ) <= <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P3DT08H34M12.143S" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
