# QT3 test case K-DurationEQ-60 of test set op-duration-equal, which tests the XPath expression
#   xs:duration("P3DT08H34M12.143S") le xs:yearMonthDuration("P1999Y10M")
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L1167
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:duration ( "P3DT08H34M12.143S" ) <= xsd:yearMonthDuration ( "P1999Y10M" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
