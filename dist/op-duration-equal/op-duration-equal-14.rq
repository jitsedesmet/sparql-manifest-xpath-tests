# QT3 test case op-duration-equal-14 of test set op-duration-equal, which tests the XPath expression
#   fn:not(xs:duration("P36D") eq xs:duration("P36D"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#duration> ( "P36D" ) = <http://www.w3.org/2001/XMLSchema#duration> ( "P36D" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
