# QT3 test case op-yearMonthDuration-equal2args-3 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration("P2030Y12M") eq xs:yearMonthDuration("P0Y0M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P2030Y12M" ) = <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P0Y0M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
