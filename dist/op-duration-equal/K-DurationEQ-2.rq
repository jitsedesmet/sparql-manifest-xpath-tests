# QT3 test case K-DurationEQ-2 of test set op-duration-equal, which tests the XPath expression
#   xs:duration("PT0S") eq xs:duration("PT0S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L645
# The test needs the constructor function xsd:duration, = on xsd:duration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#duration> ( "PT0S" ) = <http://www.w3.org/2001/XMLSchema#duration> ( "PT0S" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
