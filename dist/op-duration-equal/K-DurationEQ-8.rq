# QT3 test case K-DurationEQ-8 of test set op-duration-equal, which tests the XPath expression
#   xs:duration("P1M") ne xs:duration("P31D")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#duration> ( "P1M" ) != <http://www.w3.org/2001/XMLSchema#duration> ( "P31D" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
