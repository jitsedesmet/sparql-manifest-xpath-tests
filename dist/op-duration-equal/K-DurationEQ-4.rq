# QT3 test case K-DurationEQ-4 of test set op-duration-equal, which tests the XPath expression
#   xs:duration("P1999Y01M3DT08H34M12.143S") ne xs:duration("P1999Y10M3DT08H34M12.143S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L663
# The test needs the constructor function xsd:duration, != on xsd:duration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#duration> ( "P1999Y01M3DT08H34M12.143S" ) != <http://www.w3.org/2001/XMLSchema#duration> ( "P1999Y10M3DT08H34M12.143S" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
