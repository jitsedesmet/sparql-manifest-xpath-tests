# QT3 test case K-DurationEQ-51 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration("P1999Y10M") lt xs:duration("P3DT08H34M12.143S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L1086
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1999Y10M" ) < <http://www.w3.org/2001/XMLSchema#duration> ( "P3DT08H34M12.143S" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
