# QT3 test case K-DurationEQ-27 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration("P1Y12M") eq xs:duration("P1Y12M0D")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1Y12M" ) = <http://www.w3.org/2001/XMLSchema#duration> ( "P1Y12M0D" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
