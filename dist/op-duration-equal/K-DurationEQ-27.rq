# QT3 test case K-DurationEQ-27 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration("P1Y12M") eq xs:duration("P1Y12M0D")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L870
# The test needs the constructor function xsd:yearMonthDuration, the constructor function xsd:duration, = on xsd:yearMonthDuration, = on xsd:duration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:yearMonthDuration ( "P1Y12M" ) = xsd:duration ( "P1Y12M0D" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
