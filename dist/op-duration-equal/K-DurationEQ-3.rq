# QT3 test case K-DurationEQ-3 of test set op-duration-equal, which tests the XPath expression
#   not(xs:duration("P1999Y10M3DT08H34M12.043S") eq xs:duration("P1999Y10M3DT08H34M12.143S"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L654
# The test needs the constructor function xsd:duration, = on xsd:duration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( xsd:duration ( "P1999Y10M3DT08H34M12.043S" ) = xsd:duration ( "P1999Y10M3DT08H34M12.143S" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
