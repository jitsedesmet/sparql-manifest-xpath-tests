# QT3 test case K-DurationEQ-3 of test set op-duration-equal, which tests the XPath expression
#   not(xs:duration("P1999Y10M3DT08H34M12.043S") eq xs:duration("P1999Y10M3DT08H34M12.143S"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#duration> ( "P1999Y10M3DT08H34M12.043S" ) = <http://www.w3.org/2001/XMLSchema#duration> ( "P1999Y10M3DT08H34M12.143S" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
