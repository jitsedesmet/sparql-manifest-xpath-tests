# QT3 test case K-DurationEQ-19 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration("P0M") eq xs:dayTimeDuration("PT0S")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P0M" ) = <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "PT0S" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
