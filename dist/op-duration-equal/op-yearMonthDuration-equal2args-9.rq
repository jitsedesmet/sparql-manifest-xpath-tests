# QT3 test case op-yearMonthDuration-equal2args-9 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration("P0Y0M") ne xs:yearMonthDuration("P1000Y6M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P0Y0M" ) != <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1000Y6M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
