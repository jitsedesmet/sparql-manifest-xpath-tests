# QT3 test case K-DurationEQ-38 of test set op-duration-equal, which tests the XPath expression
#   xs:dayTimeDuration("P3DT08H34M12.143S") gt xs:duration("P1999Y10M3DT08H34M12.143S")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P3DT08H34M12.143S" ) > <http://www.w3.org/2001/XMLSchema#duration> ( "P1999Y10M3DT08H34M12.143S" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
