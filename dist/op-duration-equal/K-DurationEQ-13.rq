# QT3 test case K-DurationEQ-13 of test set op-duration-equal, which tests the XPath expression
#   xs:duration("P1999Y10M3DT08H34M12.144S") gt xs:duration("P1999Y10M3DT08H34M12.143S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L744
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#duration> ( "P1999Y10M3DT08H34M12.144S" ) > <http://www.w3.org/2001/XMLSchema#duration> ( "P1999Y10M3DT08H34M12.143S" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
