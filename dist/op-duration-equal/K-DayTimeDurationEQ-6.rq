# QT3 test case K-DayTimeDurationEQ-6 of test set op-duration-equal, which tests the XPath expression
#   xs:dayTimeDuration("-PT0S") eq xs:dayTimeDuration("PT0S")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "-PT0S" ) = <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "PT0S" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
