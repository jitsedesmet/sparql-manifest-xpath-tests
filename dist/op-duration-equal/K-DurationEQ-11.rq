# QT3 test case K-DurationEQ-11 of test set op-duration-equal, which tests the XPath expression
#   xs:duration("P1999Y10M3DT08H34M12.142S") lt xs:duration("P1999Y10M3DT08H34M12.143S")
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L726
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:duration ( "P1999Y10M3DT08H34M12.142S" ) < xsd:duration ( "P1999Y10M3DT08H34M12.143S" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
