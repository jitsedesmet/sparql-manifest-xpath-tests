# QT3 test case K-YearMonthDurationEQ-6 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration("-P3Y8M") ne xs:yearMonthDuration("P3Y8M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L1294
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "-P3Y8M" ) != <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P3Y8M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
