# QT3 test case K-YearMonthDurationEQ-6 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration("-P3Y8M") ne xs:yearMonthDuration("P3Y8M")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L1294
# The test needs the constructor function xsd:yearMonthDuration, != on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:yearMonthDuration ( "-P3Y8M" ) != xsd:yearMonthDuration ( "P3Y8M" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
