# QT3 test case K-DurationEQ-45 of test set op-duration-equal, which tests the XPath expression
#   xs:dayTimeDuration("P3DT08H34M12.143S") ge xs:yearMonthDuration("P1999Y10M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L1032
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P3DT08H34M12.143S" ) >= <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1999Y10M" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
