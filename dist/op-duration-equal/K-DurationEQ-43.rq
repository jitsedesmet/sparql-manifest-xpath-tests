# QT3 test case K-DurationEQ-43 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration("P1999Y10M") lt xs:dayTimeDuration("P3DT08H34M12.143S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L1014
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:yearMonthDuration ( "P1999Y10M" ) < xsd:dayTimeDuration ( "P3DT08H34M12.143S" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
