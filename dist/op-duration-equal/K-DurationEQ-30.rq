# QT3 test case K-DurationEQ-30 of test set op-duration-equal, which tests the XPath expression
#   xs:duration("P31D") ne xs:yearMonthDuration("P1M")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L897
# The test needs the constructor function xsd:duration, the constructor function xsd:yearMonthDuration, != on xsd:duration, != on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:duration ( "P31D" ) != xsd:yearMonthDuration ( "P1M" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
