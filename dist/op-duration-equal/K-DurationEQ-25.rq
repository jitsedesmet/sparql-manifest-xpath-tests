# QT3 test case K-DurationEQ-25 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration("P0M") eq xs:dayTimeDuration("PT0S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L852
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P0M" ) = <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "PT0S" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
