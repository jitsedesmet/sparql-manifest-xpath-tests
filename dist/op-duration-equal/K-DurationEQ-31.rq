# QT3 test case K-DurationEQ-31 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration("P1M") ne xs:dayTimeDuration("P31D")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L906
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1M" ) != <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P31D" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
