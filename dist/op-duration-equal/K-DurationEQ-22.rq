# QT3 test case K-DurationEQ-22 of test set op-duration-equal, which tests the XPath expression
#   xs:dayTimeDuration("P1DT2H") eq xs:duration("P1DT2H")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L825
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P1DT2H" ) = <http://www.w3.org/2001/XMLSchema#duration> ( "P1DT2H" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
