# QT3 test case K-DurationEQ-22 of test set op-duration-equal, which tests the XPath expression
#   xs:dayTimeDuration("P1DT2H") eq xs:duration("P1DT2H")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L825
# The test needs the constructor function xsd:dayTimeDuration, the constructor function xsd:duration, = on xsd:dayTimeDuration, = on xsd:duration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:dayTimeDuration ( "P1DT2H" ) = xsd:duration ( "P1DT2H" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
