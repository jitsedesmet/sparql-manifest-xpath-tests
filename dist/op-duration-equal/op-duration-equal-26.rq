# QT3 test case op-duration-equal-26 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration('P0Y') eq xs:dayTimeDuration('P0D')
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L234
# The test needs the constructor function xsd:yearMonthDuration, the constructor function xsd:dayTimeDuration, = on xsd:yearMonthDuration, = on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:yearMonthDuration ( "P0Y" ) = xsd:dayTimeDuration ( "P0D" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
