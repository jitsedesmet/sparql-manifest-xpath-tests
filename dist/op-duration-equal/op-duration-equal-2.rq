# QT3 test case op-duration-equal-2 of test set op-duration-equal, which tests the XPath expression
#   xs:duration("PT24H") eq xs:duration("P1D")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#duration> ( "PT24H" ) = <http://www.w3.org/2001/XMLSchema#duration> ( "P1D" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
