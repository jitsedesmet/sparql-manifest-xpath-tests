# QT3 test case op-yearMonthDuration-equal2args-4 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration("P0Y0M") eq xs:yearMonthDuration("P1000Y6M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L279
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P0Y0M" ) = <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1000Y6M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
