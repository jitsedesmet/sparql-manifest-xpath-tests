# QT3 test case K-DurationEQ-32 of test set op-duration-equal, which tests the XPath expression
#   xs:dayTimeDuration("P31D") ne xs:yearMonthDuration("P1M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P31D" ) != <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
