# QT3 test case K-DurationEQ-17 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration("P0M") eq xs:duration("PT0S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L780
# The test needs the constructor function xsd:yearMonthDuration, the constructor function xsd:duration, = on xsd:yearMonthDuration, = on xsd:duration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:yearMonthDuration ( "P0M" ) = xsd:duration ( "PT0S" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
