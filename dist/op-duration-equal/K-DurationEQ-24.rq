# QT3 test case K-DurationEQ-24 of test set op-duration-equal, which tests the XPath expression
#   xs:dayTimeDuration("P1DT2H") ne xs:duration("P1M1DT2H")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P1DT2H" ) != <http://www.w3.org/2001/XMLSchema#duration> ( "P1M1DT2H" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
