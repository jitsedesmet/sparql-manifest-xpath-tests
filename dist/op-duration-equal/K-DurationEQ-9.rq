# QT3 test case K-DurationEQ-9 of test set op-duration-equal, which tests the XPath expression
#   xs:duration("-PT0S") eq xs:duration("PT0S")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#duration> ( "-PT0S" ) = <http://www.w3.org/2001/XMLSchema#duration> ( "PT0S" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
