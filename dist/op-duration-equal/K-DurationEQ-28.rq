# QT3 test case K-DurationEQ-28 of test set op-duration-equal, which tests the XPath expression
#   xs:duration("P1Y12M0D") eq xs:yearMonthDuration("P1Y12M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L879
# The test needs the constructor function xsd:duration, the constructor function xsd:yearMonthDuration, = on xsd:duration, = on xsd:yearMonthDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#duration> ( "P1Y12M0D" ) = <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1Y12M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
