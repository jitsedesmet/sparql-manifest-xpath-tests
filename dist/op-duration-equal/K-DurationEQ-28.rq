# QT3 test case K-DurationEQ-28 of test set op-duration-equal, which tests the XPath expression
#   xs:duration("P1Y12M0D") eq xs:yearMonthDuration("P1Y12M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#duration> ( "P1Y12M0D" ) = <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1Y12M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
