# QT3 test case K-YearMonthDurationEQ-5 of test set op-duration-equal, which tests the XPath expression
#   not(xs:yearMonthDuration("P1999Y10M") ne xs:yearMonthDuration("P1999Y10M"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L1285
# The test needs the constructor function xsd:yearMonthDuration, != on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( xsd:yearMonthDuration ( "P1999Y10M" ) != xsd:yearMonthDuration ( "P1999Y10M" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
