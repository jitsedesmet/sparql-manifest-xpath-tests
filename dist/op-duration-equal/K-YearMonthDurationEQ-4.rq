# QT3 test case K-YearMonthDurationEQ-4 of test set op-duration-equal, which tests the XPath expression
#   xs:yearMonthDuration("P1999Y01M") ne xs:yearMonthDuration("P1999Y10M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L1276
# The test needs the constructor function xsd:yearMonthDuration, != on xsd:yearMonthDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1999Y01M" ) != <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1999Y10M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
