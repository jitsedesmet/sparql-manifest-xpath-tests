# QT3 test case op-duration-equal-6 of test set op-duration-equal, which tests the XPath expression
#   xs:duration("PT24H") eq xs:duration("PT24H")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L54
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#duration> ( "PT24H" ) = <http://www.w3.org/2001/XMLSchema#duration> ( "PT24H" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
