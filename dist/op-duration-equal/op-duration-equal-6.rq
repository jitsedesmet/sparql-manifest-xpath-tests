# QT3 test case op-duration-equal-6 of test set op-duration-equal, which tests the XPath expression
#   xs:duration("PT24H") eq xs:duration("PT24H")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/duration-equal.xml#L54
# The test needs the constructor function xsd:duration, = on xsd:duration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:duration ( "PT24H" ) = xsd:duration ( "PT24H" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
