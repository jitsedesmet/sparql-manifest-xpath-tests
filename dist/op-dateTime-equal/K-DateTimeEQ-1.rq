# QT3 test case K-DateTimeEQ-1 of test set op-dateTime-equal, which tests the XPath expression
#   xs:dateTime("2004-08-12T23:01:04.12") eq xs:dateTime("2004-08-12T23:01:04.12")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dateTime-equal.xml#L374
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2004-08-12T23:01:04.12" ) = <http://www.w3.org/2001/XMLSchema#dateTime> ( "2004-08-12T23:01:04.12" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
