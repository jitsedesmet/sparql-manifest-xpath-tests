# QT3 test case K-DateTimeEQ-3 of test set op-dateTime-equal, which tests the XPath expression
#   xs:dateTime("2004-08-12T23:01:05.12") ne xs:dateTime("2004-08-12T23:01:04.12")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2004-08-12T23:01:05.12" ) != <http://www.w3.org/2001/XMLSchema#dateTime> ( "2004-08-12T23:01:04.12" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
