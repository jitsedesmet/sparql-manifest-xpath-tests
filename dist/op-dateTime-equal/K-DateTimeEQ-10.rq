# QT3 test case K-DateTimeEQ-10 of test set op-dateTime-equal, which tests the XPath expression
#   xs:dateTime("1999-12-04T12:12:23") ne xs:date("1999-12-04")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dateTime-equal.xml#L509
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-12-04T12:12:23" ) != <http://www.w3.org/2001/XMLSchema#date> ( "1999-12-04" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
