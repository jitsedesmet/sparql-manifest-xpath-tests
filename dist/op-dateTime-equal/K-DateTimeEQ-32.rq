# QT3 test case K-DateTimeEQ-32 of test set op-dateTime-equal, which tests the XPath expression
#   xs:time("22:12:04") gt xs:dateTime("1999-12-04T12:12:23")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "22:12:04" ) > <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-12-04T12:12:23" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
