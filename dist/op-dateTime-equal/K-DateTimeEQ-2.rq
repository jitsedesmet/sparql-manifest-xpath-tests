# QT3 test case K-DateTimeEQ-2 of test set op-dateTime-equal, which tests the XPath expression
#   not(xs:dateTime("2004-08-12T23:01:04.12") eq xs:dateTime("2004-08-12T23:01:04.13"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2004-08-12T23:01:04.12" ) = <http://www.w3.org/2001/XMLSchema#dateTime> ( "2004-08-12T23:01:04.13" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
