# QT3 test case op-dateTime-equal2args-5 of test set op-dateTime-equal, which tests the XPath expression
#   xs:dateTime("1970-01-01T00:00:00Z") eq xs:dateTime("2030-12-31T23:59:59Z")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T00:00:00Z" ) = <http://www.w3.org/2001/XMLSchema#dateTime> ( "2030-12-31T23:59:59Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
