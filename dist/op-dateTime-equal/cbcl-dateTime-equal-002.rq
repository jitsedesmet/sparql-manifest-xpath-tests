# QT3 test case cbcl-dateTime-equal-002 of test set op-dateTime-equal, which tests the XPath expression
#   xs:dateTime("2008-01-30T00:01:00") eq xs:dateTime("2008-01-31T01:00:00+09:00")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2008-01-30T00:01:00" ) = <http://www.w3.org/2001/XMLSchema#dateTime> ( "2008-01-31T01:00:00+09:00" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
