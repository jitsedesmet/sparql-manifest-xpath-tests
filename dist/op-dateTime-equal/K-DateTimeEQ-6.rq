# QT3 test case K-DateTimeEQ-6 of test set op-dateTime-equal, which tests the XPath expression
#   xs:dateTime("1999-12-04T16:00:12.345+00:00") eq xs:dateTime("1999-12-04T16:00:12.345Z")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-12-04T16:00:12.345+00:00" ) = <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-12-04T16:00:12.345Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
