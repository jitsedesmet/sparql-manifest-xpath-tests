# QT3 test case cbcl-dateTime-equal-017 of test set op-dateTime-equal, which tests the XPath expression
#   xs:dateTime("1972-12-15T00:00:00+12:00") eq xs:dateTime("1972-12-15T00:00:01")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dateTime-equal.xml#L1069
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1972-12-15T00:00:00+12:00" ) = <http://www.w3.org/2001/XMLSchema#dateTime> ( "1972-12-15T00:00:01" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
