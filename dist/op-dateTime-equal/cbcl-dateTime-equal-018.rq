# QT3 test case cbcl-dateTime-equal-018 of test set op-dateTime-equal, which tests the XPath expression
#   xs:dateTime("1972-12-15T00:00:00+12:00") ne xs:dateTime("1972-12-15T00:00:01")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1972-12-15T00:00:00+12:00" ) != <http://www.w3.org/2001/XMLSchema#dateTime> ( "1972-12-15T00:00:01" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
