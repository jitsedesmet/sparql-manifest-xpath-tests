# QT3 test case K-DateTimeEQ-26 of test set op-dateTime-equal, which tests the XPath expression
#   xs:dateTime("1999-12-04T12:12:23") gt xs:time("22:12:04")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dateTime-equal.xml#L749
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:dateTime ( "1999-12-04T12:12:23" ) > xsd:time ( "22:12:04" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
