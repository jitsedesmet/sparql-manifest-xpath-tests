# QT3 test case K-DateTimeEQ-26 of test set op-dateTime-equal, which tests the XPath expression
#   xs:dateTime("1999-12-04T12:12:23") gt xs:time("22:12:04")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-12-04T12:12:23" ) > <http://www.w3.org/2001/XMLSchema#time> ( "22:12:04" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
