# QT3 test case fn-booleannpi1args-1 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:nonPositiveInteger("-999999999999999999"))
ASK {
  BIND(!( ! "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
