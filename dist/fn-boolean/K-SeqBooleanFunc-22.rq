# QT3 test case K-SeqBooleanFunc-22 of test set fn-boolean, which tests the XPath expression
#   not(0.0)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/boolean.xml#L1018
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! "0.0"^^xsd:decimal AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
