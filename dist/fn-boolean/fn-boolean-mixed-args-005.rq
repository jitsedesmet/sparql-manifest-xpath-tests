# QT3 test case fn-boolean-mixed-args-005 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:string(""))
ASK {
  BIND(!( ! <http://www.w3.org/2001/XMLSchema#string> ( "" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
