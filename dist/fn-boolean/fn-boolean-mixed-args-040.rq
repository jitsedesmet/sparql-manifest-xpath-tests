# QT3 test case fn-boolean-mixed-args-040 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:long('-9223372036854775808'))
ASK {
  BIND(!( ! "-9223372036854775808"^^<http://www.w3.org/2001/XMLSchema#long> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
