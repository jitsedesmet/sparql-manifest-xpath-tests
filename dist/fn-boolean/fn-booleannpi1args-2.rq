# QT3 test case fn-booleannpi1args-2 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:nonPositiveInteger("-475688437271870490"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/boolean.xml#L299
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( ! "-475688437271870490"^^xsd:nonPositiveInteger ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
