# QT3 test case fn-booleannpi1args-2 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:nonPositiveInteger("-475688437271870490"))
ASK {
  BIND(!( ! "-475688437271870490"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
