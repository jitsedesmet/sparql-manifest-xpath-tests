# QT3 test case K-SeqBooleanFunc-17 of test set fn-boolean, which tests the XPath expression
#   not(0)
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/boolean.xml#L978
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! "0"^^xsd:integer AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
