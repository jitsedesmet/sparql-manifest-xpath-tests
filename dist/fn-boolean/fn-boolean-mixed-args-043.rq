# QT3 test case fn-boolean-mixed-args-043 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:long('-1'))
ASK {
  BIND(!( ! "-1"^^<http://www.w3.org/2001/XMLSchema#long> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
