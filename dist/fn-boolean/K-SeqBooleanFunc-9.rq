# QT3 test case K-SeqBooleanFunc-9 of test set fn-boolean, which tests the XPath expression
#   boolean("string")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/boolean.xml#L909
ASK {
  BIND(! ( ! "string" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
