# QT3 test case fn-booleannni1args-3 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:nonNegativeInteger("999999999999999999"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/boolean.xml#L339
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( ! "999999999999999999"^^xsd:nonNegativeInteger ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
