# QT3 test case fn-boolean-mixed-args-014 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:float(0))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/boolean.xml#L496
ASK {
  BIND(!( ! <http://www.w3.org/2001/XMLSchema#float> ( "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
