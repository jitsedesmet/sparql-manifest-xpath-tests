# QT3 test case fn-boolean-mixed-args-037 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:positiveInteger('99999999999999999'))
ASK {
  BIND(!( ! "99999999999999999"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
