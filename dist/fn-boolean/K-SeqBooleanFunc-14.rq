# QT3 test case K-SeqBooleanFunc-14 of test set fn-boolean, which tests the XPath expression
#   not(boolean(false()))
ASK {
  BIND(!( !( ! "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
