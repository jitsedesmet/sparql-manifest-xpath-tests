# QT3 test case fn-boolean-mixed-args-035 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:negativeInteger('-99999999999999999'))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/boolean.xml#L685
ASK {
  BIND(! ! "-99999999999999999"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
