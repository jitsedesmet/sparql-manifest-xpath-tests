# QT3 test case fn-boolean-mixed-args-021 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:double(1))
ASK {
  BIND(!( ! <http://www.w3.org/2001/XMLSchema#double> ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
