# QT3 test case fn-booleanulng1args-2 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:unsignedLong("130747108607674654"))
ASK {
  BIND(!( ! "130747108607674654"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
