# QT3 test case fn-boolean-050 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:dateTime("1999-12-31T00:00:00"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/boolean.xml#L820
ASK {
  BIND(!( ! <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-12-31T00:00:00" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
