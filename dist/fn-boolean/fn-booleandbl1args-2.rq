# QT3 test case fn-booleandbl1args-2 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:double("0"))
ASK {
  BIND(!( ! <http://www.w3.org/2001/XMLSchema#double> ( "0" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
