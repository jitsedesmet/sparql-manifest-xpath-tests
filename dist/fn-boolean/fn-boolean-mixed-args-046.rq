# QT3 test case fn-boolean-mixed-args-046 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:int('0'))
ASK {
  BIND(!( ! "0"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
