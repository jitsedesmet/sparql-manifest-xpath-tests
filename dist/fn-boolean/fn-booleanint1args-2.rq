# QT3 test case fn-booleanint1args-2 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:int("-1873914410"))
ASK {
  BIND(!( ! "-1873914410"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
