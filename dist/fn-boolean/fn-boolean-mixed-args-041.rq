# QT3 test case fn-boolean-mixed-args-041 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:long('0'))
ASK {
  BIND(!( ! "0"^^<http://www.w3.org/2001/XMLSchema#long> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
