# QT3 test case fn-booleanintg1args-3 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:integer("999999999999999999"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/boolean.xml#L50
ASK {
  BIND(! ( ! <http://www.w3.org/2001/XMLSchema#integer> ( "999999999999999999" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
