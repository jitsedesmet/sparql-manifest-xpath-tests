# QT3 test case K-SeqBooleanFunc-20 of test set fn-boolean, which tests the XPath expression
#   boolean(1.1e1)
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/boolean.xml#L1002
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( ! "1.1e1"^^xsd:double ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
