# QT3 test case fn-boolean-mixed-args-032 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:nonPositiveInteger('-99999999999999999'))
ASK {
  BIND(!( ! "-99999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
