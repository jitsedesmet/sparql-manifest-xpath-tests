# QT3 test case fn-booleanflt1args-2 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:float("0"))
ASK {
  BIND(!( ! <http://www.w3.org/2001/XMLSchema#float> ( "0" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
