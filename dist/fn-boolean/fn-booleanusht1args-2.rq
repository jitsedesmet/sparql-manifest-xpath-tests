# QT3 test case fn-booleanusht1args-2 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:unsignedShort("44633"))
ASK {
  BIND(!( ! "44633"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
