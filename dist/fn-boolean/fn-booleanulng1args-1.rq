# QT3 test case fn-booleanulng1args-1 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:unsignedLong("0"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/boolean.xml#L259
ASK {
  BIND(!( ! "0"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
