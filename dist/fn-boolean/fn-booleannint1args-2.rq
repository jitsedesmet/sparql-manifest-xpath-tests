# QT3 test case fn-booleannint1args-2 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:negativeInteger("-297014075999096793"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/boolean.xml#L209
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( ! "-297014075999096793"^^xsd:negativeInteger ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
