# QT3 test case fn-booleandbl1args-3 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:double("1.7976931348623157E308"))
ASK {
  BIND(!( ! <http://www.w3.org/2001/XMLSchema#double> ( "1.7976931348623157E308" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
