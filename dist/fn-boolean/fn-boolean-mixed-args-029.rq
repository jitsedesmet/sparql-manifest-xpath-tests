# QT3 test case fn-boolean-mixed-args-029 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:integer('0'))
ASK {
  BIND(!( ! <http://www.w3.org/2001/XMLSchema#integer> ( "0" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
