# QT3 test case fn-boolean-mixed-args-019 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:double('INF'))
ASK {
  BIND(!( ! <http://www.w3.org/2001/XMLSchema#double> ( "INF" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
