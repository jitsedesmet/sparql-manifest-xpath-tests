# QT3 test case fn-booleannni1args-2 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(xs:nonNegativeInteger("303884545991464527"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/boolean.xml#L329
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( ! "303884545991464527"^^xsd:nonNegativeInteger ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
