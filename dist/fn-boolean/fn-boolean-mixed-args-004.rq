# QT3 test case fn-boolean-mixed-args-004 of test set fn-boolean, which tests the XPath expression
#   fn:boolean(true())
ASK {
  BIND(!( ! "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
