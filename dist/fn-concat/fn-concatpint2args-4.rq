# QT3 test case fn-concatpint2args-4 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:positiveInteger("1"),xs:positiveInteger("52704602390610033"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L394
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "1"^^xsd:positiveInteger ) , xsd:string ( "52704602390610033"^^xsd:positiveInteger ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "152704602390610033" ))
}
