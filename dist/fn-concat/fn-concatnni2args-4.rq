# QT3 test case fn-concatnni2args-4 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:nonNegativeInteger("0"),xs:nonNegativeInteger("303884545991464527"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L529
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "0"^^xsd:nonNegativeInteger ) , xsd:string ( "303884545991464527"^^xsd:nonNegativeInteger ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "0303884545991464527" ))
}
