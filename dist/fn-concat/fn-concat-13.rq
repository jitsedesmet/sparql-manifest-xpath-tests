# QT3 test case fn-concat-13 of test set fn-concat, which tests the XPath expression
#   fn:string(fn:concat("abc","de"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L700
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "abc" ) , <http://www.w3.org/2001/XMLSchema#string> ( "de" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "abcde" ))
}
