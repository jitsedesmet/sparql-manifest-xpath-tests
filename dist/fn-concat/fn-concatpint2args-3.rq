# QT3 test case fn-concatpint2args-3 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:positiveInteger("999999999999999999"),xs:positiveInteger("1"))
# Expecting:
#   <assert-string-value>9999999999999999991</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L385
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "999999999999999999"^^xsd:positiveInteger ) , xsd:string ( "1"^^xsd:positiveInteger ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "9999999999999999991" ))
}
