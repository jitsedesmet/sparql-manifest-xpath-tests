# QT3 test case fn-concatdbl2args-3 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:double("1.7976931348623157E308"),xs:double("-1.7976931348623157E308"))
# Expecting:
#   <assert-string-value>1.7976931348623157E308-1.7976931348623157E308</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L160
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( xsd:double ( "1.7976931348623157E308" ) ) , xsd:string ( xsd:double ( "-1.7976931348623157E308" ) ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1.7976931348623157E308-1.7976931348623157E308" ))
}
