# QT3 test case fn-concatint2args-3 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:int("2147483647"),xs:int("-2147483648"))
# Expecting:
#   <assert-string-value>2147483647-2147483648</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L25
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "2147483647"^^xsd:int ) , xsd:string ( "-2147483648"^^xsd:int ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "2147483647-2147483648" ))
}
