# QT3 test case fn-concatdbl2args-2 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:double("0"),xs:double("-1.7976931348623157E308"))
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#double> ( "0" ) ) , <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#double> ( "-1.7976931348623157E308" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0-1.7976931348623157E308" ))
}
