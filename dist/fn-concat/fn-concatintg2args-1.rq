# QT3 test case fn-concatintg2args-1 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:integer("-999999999999999999"),xs:integer("-999999999999999999"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L52
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( xsd:integer ( "-999999999999999999" ) ) , xsd:string ( xsd:integer ( "-999999999999999999" ) ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-999999999999999999-999999999999999999" ))
}
