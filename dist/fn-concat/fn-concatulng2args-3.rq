# QT3 test case fn-concatulng2args-3 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:unsignedLong("184467440737095516"),xs:unsignedLong("0"))
# Expecting:
#   <assert-string-value>1844674407370955160</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L430
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "184467440737095516"^^xsd:unsignedLong ) , xsd:string ( "0"^^xsd:unsignedLong ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1844674407370955160" ))
}
