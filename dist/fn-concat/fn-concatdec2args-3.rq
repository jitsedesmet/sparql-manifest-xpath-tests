# QT3 test case fn-concatdec2args-3 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:decimal("999999999999999999"),xs:decimal("-999999999999999999"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L115
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "999999999999999999" ) ) , <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "-999999999999999999" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "999999999999999999-999999999999999999" ))
}
