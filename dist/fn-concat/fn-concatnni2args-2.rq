# QT3 test case fn-concatnni2args-2 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:nonNegativeInteger("303884545991464527"),xs:nonNegativeInteger("0"))
# Expecting:
#   <assert-string-value>3038845459914645270</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L511
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "303884545991464527"^^xsd:nonNegativeInteger ) , xsd:string ( "0"^^xsd:nonNegativeInteger ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "3038845459914645270" ))
}
