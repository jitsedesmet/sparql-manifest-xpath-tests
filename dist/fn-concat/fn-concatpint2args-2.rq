# QT3 test case fn-concatpint2args-2 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:positiveInteger("52704602390610033"),xs:positiveInteger("1"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L376
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "52704602390610033"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) , <http://www.w3.org/2001/XMLSchema#string> ( "1"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "527046023906100331" ))
}
