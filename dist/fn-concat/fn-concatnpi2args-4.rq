# QT3 test case fn-concatnpi2args-4 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:nonPositiveInteger("-999999999999999999"),xs:nonPositiveInteger("-475688437271870490"))
# Expecting:
#   <assert-string-value>-999999999999999999-475688437271870490</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L484
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "-999999999999999999"^^xsd:nonPositiveInteger ) , xsd:string ( "-475688437271870490"^^xsd:nonPositiveInteger ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-999999999999999999-475688437271870490" ))
}
