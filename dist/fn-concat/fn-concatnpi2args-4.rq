# QT3 test case fn-concatnpi2args-4 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:nonPositiveInteger("-999999999999999999"),xs:nonPositiveInteger("-475688437271870490"))
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) , <http://www.w3.org/2001/XMLSchema#string> ( "-475688437271870490"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-999999999999999999-475688437271870490" ))
}
