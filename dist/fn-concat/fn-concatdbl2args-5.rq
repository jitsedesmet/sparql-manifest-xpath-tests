# QT3 test case fn-concatdbl2args-5 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:double("-1.7976931348623157E308"),xs:double("1.7976931348623157E308"))
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#double> ( "-1.7976931348623157E308" ) ) , <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#double> ( "1.7976931348623157E308" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-1.7976931348623157E3081.7976931348623157E308" ))
}
