# QT3 test case cbcl-concat-001 of test set fn-concat, which tests the XPath expression
#   fn:boolean(fn:concat('', ''))
ASK {
  BIND(!( ! CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "" ) , <http://www.w3.org/2001/XMLSchema#string> ( "" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
