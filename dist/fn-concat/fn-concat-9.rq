# QT3 test case fn-concat-9 of test set fn-concat, which tests the XPath expression
#   fn:concat(fn:upper-case("Abc"),fn:upper-case("DH"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L664
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( UCASE( "Abc" ) ) , <http://www.w3.org/2001/XMLSchema#string> ( UCASE( "DH" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "ABCDH" ))
}
