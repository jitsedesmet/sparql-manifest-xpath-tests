# QT3 test case fn-concatflt2args-1 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:float("-3.4028235E38"),xs:float("-3.4028235E38"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L187
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( xsd:float ( "-3.4028235E38" ) ) , xsd:string ( xsd:float ( "-3.4028235E38" ) ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-3.4028235E38-3.4028235E38" ))
}
