# QT3 test case fn-concatflt2args-1 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:float("-3.4028235E38"),xs:float("-3.4028235E38"))
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#float> ( "-3.4028235E38" ) ) , <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#float> ( "-3.4028235E38" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-3.4028235E38-3.4028235E38" ))
}
