# QT3 test case fn-concatnint2args-2 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:negativeInteger("-297014075999096793"),xs:negativeInteger("-999999999999999999"))
# Expecting:
#   <assert-string-value>-297014075999096793-999999999999999999</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L331
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "-297014075999096793"^^xsd:negativeInteger ) , xsd:string ( "-999999999999999999"^^xsd:negativeInteger ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-297014075999096793-999999999999999999" ))
}
