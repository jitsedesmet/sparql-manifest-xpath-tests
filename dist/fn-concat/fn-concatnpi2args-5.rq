# QT3 test case fn-concatnpi2args-5 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:nonPositiveInteger("-999999999999999999"),xs:nonPositiveInteger("0"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L493
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "-999999999999999999"^^xsd:nonPositiveInteger ) , xsd:string ( "0"^^xsd:nonPositiveInteger ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-9999999999999999990" ))
}
