# QT3 test case fn-concatnint2args-4 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:negativeInteger("-999999999999999999"),xs:negativeInteger("-297014075999096793"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L349
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "-999999999999999999"^^xsd:negativeInteger ) , xsd:string ( "-297014075999096793"^^xsd:negativeInteger ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-999999999999999999-297014075999096793" ))
}
