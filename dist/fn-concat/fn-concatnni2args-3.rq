# QT3 test case fn-concatnni2args-3 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:nonNegativeInteger("999999999999999999"),xs:nonNegativeInteger("0"))
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ) , <http://www.w3.org/2001/XMLSchema#string> ( "0"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "9999999999999999990" ))
}
