# QT3 test case fn-concat-1 of test set fn-concat, which tests the XPath expression
#   fn:concat('un', 'grateful')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L592
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "un" ) , xsd:string ( "grateful" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "ungrateful" ))
}
