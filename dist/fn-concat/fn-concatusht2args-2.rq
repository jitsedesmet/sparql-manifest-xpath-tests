# QT3 test case fn-concatusht2args-2 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:unsignedShort("44633"),xs:unsignedShort("0"))
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "44633"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) , <http://www.w3.org/2001/XMLSchema#string> ( "0"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "446330" ))
}
