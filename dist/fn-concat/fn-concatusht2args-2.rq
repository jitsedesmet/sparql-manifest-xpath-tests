# QT3 test case fn-concatusht2args-2 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:unsignedShort("44633"),xs:unsignedShort("0"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L286
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "44633"^^xsd:unsignedShort ) , xsd:string ( "0"^^xsd:unsignedShort ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "446330" ))
}
