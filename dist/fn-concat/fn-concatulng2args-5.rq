# QT3 test case fn-concatulng2args-5 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:unsignedLong("0"),xs:unsignedLong("184467440737095516"))
# Expecting:
#   <assert-string-value>0184467440737095516</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L448
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "0"^^xsd:unsignedLong ) , xsd:string ( "184467440737095516"^^xsd:unsignedLong ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "0184467440737095516" ))
}
