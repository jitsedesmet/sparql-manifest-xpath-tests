# QT3 test case fn-concatulng2args-5 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:unsignedLong("0"),xs:unsignedLong("184467440737095516"))
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "0"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) , <http://www.w3.org/2001/XMLSchema#string> ( "184467440737095516"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0184467440737095516" ))
}
