# QT3 test case K-ConcatFunc-8 of test set fn-concat, which tests the XPath expression
#   concat(1, 2, 3) eq "123"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L822
ASK {
  BIND(( CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) , <http://www.w3.org/2001/XMLSchema#string> ( "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) , <http://www.w3.org/2001/XMLSchema#string> ( "3"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) = "123" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
