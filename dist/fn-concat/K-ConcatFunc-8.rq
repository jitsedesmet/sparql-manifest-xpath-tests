# QT3 test case K-ConcatFunc-8 of test set fn-concat, which tests the XPath expression
#   concat(1, 2, 3) eq "123"
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L822
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( CONCAT( xsd:string ( "1"^^xsd:integer ) , xsd:string ( "2"^^xsd:integer ) , xsd:string ( "3"^^xsd:integer ) ) = "123" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
