# QT3 test case fn-concat-6 of test set fn-concat, which tests the XPath expression
#   fn:concat("abc","de")
# Expecting:
#   <assert-string-value>abcde</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L637
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "abc" ) , xsd:string ( "de" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "abcde" ))
}
