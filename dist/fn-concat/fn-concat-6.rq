# QT3 test case fn-concat-6 of test set fn-concat, which tests the XPath expression
#   fn:concat("abc","de")
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "abc" ) , <http://www.w3.org/2001/XMLSchema#string> ( "de" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "abcde" ))
}
