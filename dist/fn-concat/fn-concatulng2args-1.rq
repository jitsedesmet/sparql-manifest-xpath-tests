# QT3 test case fn-concatulng2args-1 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:unsignedLong("0"),xs:unsignedLong("0"))
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "0"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) , <http://www.w3.org/2001/XMLSchema#string> ( "0"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "00" ))
}
