# QT3 test case fn-concatnni2args-5 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:nonNegativeInteger("0"),xs:nonNegativeInteger("999999999999999999"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L538
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "0"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ) , <http://www.w3.org/2001/XMLSchema#string> ( "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0999999999999999999" ))
}
