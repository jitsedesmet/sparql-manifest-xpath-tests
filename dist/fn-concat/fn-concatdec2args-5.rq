# QT3 test case fn-concatdec2args-5 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:decimal("-999999999999999999"),xs:decimal("999999999999999999"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L133
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( xsd:decimal ( "-999999999999999999" ) ) , xsd:string ( xsd:decimal ( "999999999999999999" ) ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-999999999999999999999999999999999999" ))
}
