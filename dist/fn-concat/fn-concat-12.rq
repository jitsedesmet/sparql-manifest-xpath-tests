# QT3 test case fn-concat-12 of test set fn-concat, which tests the XPath expression
#   fn:boolean(fn:concat("ab","cde"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L691
ASK {
  BIND(!( ! CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "ab" ) , <http://www.w3.org/2001/XMLSchema#string> ( "cde" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
