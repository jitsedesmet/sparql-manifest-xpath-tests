# QT3 test case fn-concatint2args-2 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:int("-1873914410"),xs:int("-2147483648"))
# Expecting:
#   <assert-string-value>-1873914410-2147483648</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L16
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "-1873914410"^^xsd:int ) , xsd:string ( "-2147483648"^^xsd:int ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-1873914410-2147483648" ))
}
