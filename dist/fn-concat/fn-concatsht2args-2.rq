# QT3 test case fn-concatsht2args-2 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:short("-5324"),xs:short("-32768"))
# Expecting:
#   <assert-string-value>-5324-32768</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L556
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "-5324"^^xsd:short ) , xsd:string ( "-32768"^^xsd:short ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-5324-32768" ))
}
