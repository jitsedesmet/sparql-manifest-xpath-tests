# QT3 test case fn-concatsht2args-2 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:short("-5324"),xs:short("-32768"))
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "-5324"^^<http://www.w3.org/2001/XMLSchema#short> ) , <http://www.w3.org/2001/XMLSchema#string> ( "-32768"^^<http://www.w3.org/2001/XMLSchema#short> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-5324-32768" ))
}
