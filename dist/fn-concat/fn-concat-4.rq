# QT3 test case fn-concat-4 of test set fn-concat, which tests the XPath expression
#   fn:concat('Ingratitude, ', 'thou ', 'marble-hearted', ' fiend!')
# Expecting:
#   <assert-string-value>Ingratitude, thou marble-hearted fiend!</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L619
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "Ingratitude, " ) , xsd:string ( "thou " ) , xsd:string ( "marble-hearted" ) , xsd:string ( " fiend!" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "Ingratitude, thou marble-hearted fiend!" ))
}
