# QT3 test case fn-concatusht2args-4 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:unsignedShort("0"),xs:unsignedShort("44633"))
# Expecting:
#   <assert-string-value>044633</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L304
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "0"^^xsd:unsignedShort ) , xsd:string ( "44633"^^xsd:unsignedShort ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "044633" ))
}
