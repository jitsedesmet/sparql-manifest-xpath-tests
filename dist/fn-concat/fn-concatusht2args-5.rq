# QT3 test case fn-concatusht2args-5 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:unsignedShort("0"),xs:unsignedShort("65535"))
# Expecting:
#   <assert-string-value>065535</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L313
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "0"^^xsd:unsignedShort ) , xsd:string ( "65535"^^xsd:unsignedShort ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "065535" ))
}
