# QT3 test case K-ConcatFunc-3 of test set fn-concat, which tests the XPath expression
#   concat("ab", "c") eq "abc"
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L777
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( CONCAT( xsd:string ( "ab" ) , xsd:string ( "c" ) ) = "abc" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
