# QT3 test case fn-concatintg2args-4 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:integer("-999999999999999999"),xs:integer("830993497117024304"))
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#integer> ( "-999999999999999999" ) ) , <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#integer> ( "830993497117024304" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-999999999999999999830993497117024304" ))
}
