# QT3 test case fn-concatpint2args-5 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:positiveInteger("1"),xs:positiveInteger("999999999999999999"))
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "1"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) , <http://www.w3.org/2001/XMLSchema#string> ( "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1999999999999999999" ))
}
