# QT3 test case fn-concat-5 of test set fn-concat, which tests the XPath expression
#   fn:concat("AB","CD")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L628
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "AB" ) , <http://www.w3.org/2001/XMLSchema#string> ( "CD" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "ABCD" ))
}
