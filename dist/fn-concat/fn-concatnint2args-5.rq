# QT3 test case fn-concatnint2args-5 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:negativeInteger("-999999999999999999"),xs:negativeInteger("-1"))
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> ) , <http://www.w3.org/2001/XMLSchema#string> ( "-1"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-999999999999999999-1" ))
}
