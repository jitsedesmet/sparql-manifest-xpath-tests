# QT3 test case fn-concatlng2args-2 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:long("-47175562203048468"),xs:long("-92233720368547758"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L241
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONCAT( xsd:string ( "-47175562203048468"^^xsd:long ) , xsd:string ( "-92233720368547758"^^xsd:long ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-47175562203048468-92233720368547758" ))
}
