# QT3 test case fn-concatnpi2args-2 of test set fn-concat, which tests the XPath expression
#   fn:concat(xs:nonPositiveInteger("-475688437271870490"),xs:nonPositiveInteger("-999999999999999999"))
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "-475688437271870490"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) , <http://www.w3.org/2001/XMLSchema#string> ( "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-475688437271870490-999999999999999999" ))
}
