# QT3 test case fn-concat-15 of test set fn-concat, which tests the XPath expression
#   fn:concat("%$","#@!")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/concat.xml#L718
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( "%$" ) , <http://www.w3.org/2001/XMLSchema#string> ( "#@!" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "%$#@!" ))
}
