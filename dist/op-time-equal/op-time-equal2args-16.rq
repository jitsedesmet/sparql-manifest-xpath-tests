# QT3 test case op-time-equal2args-16 of test set op-time-equal, which tests the XPath expression
#   xs:time("00:00:00Z") ge xs:time("00:00:00Z")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "00:00:00Z" ) >= <http://www.w3.org/2001/XMLSchema#time> ( "00:00:00Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
