# QT3 test case K-TimeEQ-7 of test set op-time-equal, which tests the XPath expression
#   xs:time("16:00:12.345Z") eq xs:time("16:00:12.345Z")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/time-equal.xml#L456
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "16:00:12.345Z" ) = <http://www.w3.org/2001/XMLSchema#time> ( "16:00:12.345Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
