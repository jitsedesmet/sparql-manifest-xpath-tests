# QT3 test case K-TimeEQ-4 of test set op-time-equal, which tests the XPath expression
#   not(xs:time("23:01:04.12") ne xs:time("23:01:04.12"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#time> ( "23:01:04.12" ) != <http://www.w3.org/2001/XMLSchema#time> ( "23:01:04.12" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
