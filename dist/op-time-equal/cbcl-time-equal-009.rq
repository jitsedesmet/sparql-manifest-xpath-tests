# QT3 test case cbcl-time-equal-009 of test set op-time-equal, which tests the XPath expression
#   xs:time("00:00:01+01:00") ne xs:time("00:00:00")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "00:00:01+01:00" ) != <http://www.w3.org/2001/XMLSchema#time> ( "00:00:00" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
