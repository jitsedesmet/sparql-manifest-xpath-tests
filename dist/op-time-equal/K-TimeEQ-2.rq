# QT3 test case K-TimeEQ-2 of test set op-time-equal, which tests the XPath expression
#   not(xs:time("23:01:04.12") eq xs:time("23:01:04.13"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/time-equal.xml#L381
# The test needs the constructor function xsd:time, = on xsd:time, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( xsd:time ( "23:01:04.12" ) = xsd:time ( "23:01:04.13" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
