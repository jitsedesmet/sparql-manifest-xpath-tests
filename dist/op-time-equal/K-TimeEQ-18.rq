# QT3 test case K-TimeEQ-18 of test set op-time-equal, which tests the XPath expression
#   xs:date("1999-12-04") lt xs:time("12:12:23")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1999-12-04" ) < <http://www.w3.org/2001/XMLSchema#time> ( "12:12:23" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
