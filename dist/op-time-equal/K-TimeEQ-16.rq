# QT3 test case K-TimeEQ-16 of test set op-time-equal, which tests the XPath expression
#   xs:date("1999-12-04") ne xs:time("12:12:23")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/time-equal.xml#L591
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1999-12-04" ) != <http://www.w3.org/2001/XMLSchema#time> ( "12:12:23" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
