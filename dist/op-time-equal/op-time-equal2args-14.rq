# QT3 test case op-time-equal2args-14 of test set op-time-equal, which tests the XPath expression
#   xs:time("00:00:00Z") le xs:time("08:03:35Z")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "00:00:00Z" ) <= <http://www.w3.org/2001/XMLSchema#time> ( "08:03:35Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
