<#K-TimeEQ-9> a mf:QueryEvaluationTest ;
  mf:name "K-TimeEQ-9" ;
  rdfs:comment "*******************************************************\n Test: K-TimeEQ-9                                      \n Written by: Frans Englich                             \n Date: 2007-11-22T11:31:21+01:00                       \n Purpose: The operator 'eq' is not available between xs:dateTime and xs:date . \n*******************************************************" ;
