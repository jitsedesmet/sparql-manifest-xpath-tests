# QT3 test case op-time-equal2args-15 of test set op-time-equal, which tests the XPath expression
#   xs:time("00:00:00Z") le xs:time("23:59:59Z")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/time-equal.xml#L258
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "00:00:00Z" ) <= <http://www.w3.org/2001/XMLSchema#time> ( "23:59:59Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
