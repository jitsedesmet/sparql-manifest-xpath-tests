# QT3 test case K-TimeEQ-8 of test set op-time-equal, which tests the XPath expression
#   xs:time("16:00:12.345-00:00") eq xs:time("16:00:12.345+00:00")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "16:00:12.345-00:00" ) = <http://www.w3.org/2001/XMLSchema#time> ( "16:00:12.345+00:00" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
