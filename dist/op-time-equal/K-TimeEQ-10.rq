# QT3 test case K-TimeEQ-10 of test set op-time-equal, which tests the XPath expression
#   xs:time("12:12:23") ne xs:date("1999-12-04")
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/time-equal.xml#L501
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:time ( "12:12:23" ) != xsd:date ( "1999-12-04" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
