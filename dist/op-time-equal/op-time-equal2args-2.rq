# QT3 test case op-time-equal2args-2 of test set op-time-equal, which tests the XPath expression
#   xs:time("08:03:35Z") eq xs:time("00:00:00Z")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/time-equal.xml#L24
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "08:03:35Z" ) = <http://www.w3.org/2001/XMLSchema#time> ( "00:00:00Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
