# QT3 test case cbcl-time-equal-005 of test set op-time-equal, which tests the XPath expression
#   xs:time("00:00:00") eq xs:time("00:00:01+01:00")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/time-equal.xml#L722
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "00:00:00" ) = <http://www.w3.org/2001/XMLSchema#time> ( "00:00:01+01:00" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
