# QT3 test case fn-notpint1args-3 of test set fn-not, which tests the XPath expression
#   fn:not(xs:positiveInteger("999999999999999999"))
ASK {
  BIND(! "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
