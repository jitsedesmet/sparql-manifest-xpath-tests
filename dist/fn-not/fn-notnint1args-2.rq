# QT3 test case fn-notnint1args-2 of test set fn-not, which tests the XPath expression
#   fn:not(xs:negativeInteger("-297014075999096793"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/not.xml#L205
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! "-297014075999096793"^^xsd:negativeInteger AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
