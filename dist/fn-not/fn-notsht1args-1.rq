# QT3 test case fn-notsht1args-1 of test set fn-not, which tests the XPath expression
#   fn:not(xs:short("-32768"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/not.xml#L331
ASK {
  BIND(! "-32768"^^<http://www.w3.org/2001/XMLSchema#short> AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
