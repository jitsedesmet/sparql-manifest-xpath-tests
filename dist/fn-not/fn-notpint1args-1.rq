# QT3 test case fn-notpint1args-1 of test set fn-not, which tests the XPath expression
#   fn:not(xs:positiveInteger("1"))
ASK {
  BIND(! "1"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
