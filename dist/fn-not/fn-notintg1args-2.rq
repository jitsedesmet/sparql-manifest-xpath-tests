# QT3 test case fn-notintg1args-2 of test set fn-not, which tests the XPath expression
#   fn:not(xs:integer("830993497117024304"))
ASK {
  BIND(! <http://www.w3.org/2001/XMLSchema#integer> ( "830993497117024304" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
