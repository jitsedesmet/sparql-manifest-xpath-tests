# QT3 test case fn-notintg1args-2 of test set fn-not, which tests the XPath expression
#   fn:not(xs:integer("830993497117024304"))
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/not.xml#L43
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! xsd:integer ( "830993497117024304" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
