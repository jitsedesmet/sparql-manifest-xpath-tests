# QT3 test case fn-not-21 of test set fn-not, which tests the XPath expression
#   fn:string-length(xs:string(fn:not("true")))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/not.xml#L538
ASK {
  BIND(STRLEN( <http://www.w3.org/2001/XMLSchema#string> ( ! "true" ) ) AS ?result)
  FILTER(( ?result = "5"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
