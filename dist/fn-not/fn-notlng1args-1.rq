# QT3 test case fn-notlng1args-1 of test set fn-not, which tests the XPath expression
#   fn:not(xs:long("-92233720368547758"))
ASK {
  BIND(! "-92233720368547758"^^<http://www.w3.org/2001/XMLSchema#long> AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
