# QT3 test case K-NotFunc-3 of test set fn-not, which tests the XPath expression
#   not(false() and false())
ASK {
  BIND(! ( "false"^^<http://www.w3.org/2001/XMLSchema#boolean> && "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
