# QT3 test case fn-not-19 of test set fn-not, which tests the XPath expression
#   fn:concat(xs:string(fn:not("true")),xs:string(fn:not("true")))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/not.xml#L520
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#string> ( ! "true" ) ) , <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#string> ( ! "true" ) ) ) AS ?result)
  FILTER(( ?result = "falsefalse" ))
}
