# QT3 test case K-NotFunc-6 of test set fn-not, which tests the XPath expression
#   not(0)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/not.xml#L669
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! "0"^^xsd:integer AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
