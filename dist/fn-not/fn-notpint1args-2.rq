# QT3 test case fn-notpint1args-2 of test set fn-not, which tests the XPath expression
#   fn:not(xs:positiveInteger("52704602390610033"))
ASK {
  BIND(! "52704602390610033"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
