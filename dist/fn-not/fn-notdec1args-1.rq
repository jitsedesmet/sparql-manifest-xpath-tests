# QT3 test case fn-notdec1args-1 of test set fn-not, which tests the XPath expression
#   fn:not(xs:decimal("-999999999999999999"))
ASK {
  BIND(! <http://www.w3.org/2001/XMLSchema#decimal> ( "-999999999999999999" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
