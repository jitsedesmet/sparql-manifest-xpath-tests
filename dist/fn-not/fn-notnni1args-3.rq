# QT3 test case fn-notnni1args-3 of test set fn-not, which tests the XPath expression
#   fn:not(xs:nonNegativeInteger("999999999999999999"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/not.xml#L322
ASK {
  BIND(! "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
