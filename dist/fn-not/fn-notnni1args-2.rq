# QT3 test case fn-notnni1args-2 of test set fn-not, which tests the XPath expression
#   fn:not(xs:nonNegativeInteger("303884545991464527"))
ASK {
  BIND(! "303884545991464527"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
