# QT3 test case fn-notnni1args-2 of test set fn-not, which tests the XPath expression
#   fn:not(xs:nonNegativeInteger("303884545991464527"))
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/not.xml#L313
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! "303884545991464527"^^xsd:nonNegativeInteger AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
