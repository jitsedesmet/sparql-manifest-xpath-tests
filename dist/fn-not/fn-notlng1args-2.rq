# QT3 test case fn-notlng1args-2 of test set fn-not, which tests the XPath expression
#   fn:not(xs:long("-47175562203048468"))
ASK {
  BIND(! "-47175562203048468"^^<http://www.w3.org/2001/XMLSchema#long> AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
