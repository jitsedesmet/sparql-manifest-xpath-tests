# QT3 test case fn-notnint1args-3 of test set fn-not, which tests the XPath expression
#   fn:not(xs:negativeInteger("-1"))
ASK {
  BIND(! "-1"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
