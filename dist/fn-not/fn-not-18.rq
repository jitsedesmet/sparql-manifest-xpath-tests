# QT3 test case fn-not-18 of test set fn-not, which tests the XPath expression
#   fn:string(fn:not("true"))
# Expecting:
#   <assert-eq>'false'</assert-eq>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/not.xml#L511
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( ! "true" ) AS ?result)
  FILTER(SAMETERM( ?result , "false" ))
}
