# QT3 test case fn-notulng1args-1 of test set fn-not, which tests the XPath expression
#   fn:not(xs:unsignedLong("0"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/not.xml#L250
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! "0"^^xsd:unsignedLong AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
