# QT3 test case fn-notnpi1args-2 of test set fn-not, which tests the XPath expression
#   fn:not(xs:nonPositiveInteger("-475688437271870490"))
ASK {
  BIND(! "-475688437271870490"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
