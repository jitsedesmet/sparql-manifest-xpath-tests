# QT3 test case fn-notflt1args-3 of test set fn-not, which tests the XPath expression
#   fn:not(xs:float("3.4028235E38"))
ASK {
  BIND(! <http://www.w3.org/2001/XMLSchema#float> ( "3.4028235E38" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
