# QT3 test case fn-not-20 of test set fn-not, which tests the XPath expression
#   fn:contains(xs:string(fn:not("true")),xs:string(fn:not("true")))
ASK {
  BIND(CONTAINS( <http://www.w3.org/2001/XMLSchema#string> ( ! "true" ) , <http://www.w3.org/2001/XMLSchema#string> ( ! "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
