# QT3 test case fn-not-20 of test set fn-not, which tests the XPath expression
#   fn:contains(xs:string(fn:not("true")),xs:string(fn:not("true")))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/not.xml#L529
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONTAINS( xsd:string ( ! "true" ) , xsd:string ( ! "true" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
