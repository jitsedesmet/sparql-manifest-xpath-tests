# QT3 test case op-subtract-yearMonthDuration-from-dateTime-5 of test set op-subtract-yearMonthDuration-from-dateTime, which tests the XPath expression
#   fn:boolean(fn:string(xs:dateTime("1962-03-12T10:12:34Z") - xs:yearMonthDuration("P10Y01M")))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-dateTime.xml#L163
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( ! xsd:string ( ( xsd:dateTime ( "1962-03-12T10:12:34Z" ) - xsd:yearMonthDuration ( "P10Y01M" ) ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
