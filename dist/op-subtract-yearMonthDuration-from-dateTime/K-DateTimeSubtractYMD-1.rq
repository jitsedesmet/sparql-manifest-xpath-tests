# QT3 test case K-DateTimeSubtractYMD-1 of test set op-subtract-yearMonthDuration-from-dateTime, which tests the XPath expression
#   xs:dateTime("1999-07-19T08:23:01.765") - xs:yearMonthDuration("P3Y35M") eq xs:dateTime("1993-08-19T08:23:01.765")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-dateTime.xml#L339
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:dateTime ( "1999-07-19T08:23:01.765" ) - xsd:yearMonthDuration ( "P3Y35M" ) ) = xsd:dateTime ( "1993-08-19T08:23:01.765" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
