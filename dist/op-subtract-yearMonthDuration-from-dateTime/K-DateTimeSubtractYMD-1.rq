# QT3 test case K-DateTimeSubtractYMD-1 of test set op-subtract-yearMonthDuration-from-dateTime, which tests the XPath expression
#   xs:dateTime("1999-07-19T08:23:01.765") - xs:yearMonthDuration("P3Y35M") eq xs:dateTime("1993-08-19T08:23:01.765")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-dateTime.xml#L339
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-07-19T08:23:01.765" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P3Y35M" ) ) = <http://www.w3.org/2001/XMLSchema#dateTime> ( "1993-08-19T08:23:01.765" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
