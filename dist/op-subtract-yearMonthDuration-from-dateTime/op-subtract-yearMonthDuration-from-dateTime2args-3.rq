# QT3 test case op-subtract-yearMonthDuration-from-dateTime2args-3 of test set op-subtract-yearMonthDuration-from-dateTime, which tests the XPath expression
#   xs:dateTime("2030-12-31T23:59:59Z") - xs:yearMonthDuration("P0Y0M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-dateTime.xml#L43
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:dateTime ( "2030-12-31T23:59:59Z" ) - xsd:yearMonthDuration ( "P0Y0M" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "2030-12-31T23:59:59Z" ))
}
