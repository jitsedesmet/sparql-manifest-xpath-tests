<#op-subtract-yearMonthDuration-from-dateTime2args-1> a mf:QueryEvaluationTest ;
  mf:name "op-subtract-yearMonthDuration-from-dateTime2args-1" ;
  rdfs:comment "*******************************************************\nTest: op-subtract-yearMonthDuration-from-dateTime2args-1\nWritten By: Carmelo Montanez                            \nDate: Tue Apr 12 16:29:08 GMT-05:00 2005                \nPurpose: Evaluates The \"op:subtract-yearMonthDuration-from-dateTime\" operator\n with the arguments set as follows:                    \narg1 = xs:dateTime(lower bound)                        \n$arg2 = xs:yearMonthDuration(lower bound)             \n*******************************************************" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-dateTime.xml#L7> ;
  mf:action [ qt:query <op-subtract-yearMonthDuration-from-dateTime2args-1.rq> ] ;
  mf:result <../true.srj> .

