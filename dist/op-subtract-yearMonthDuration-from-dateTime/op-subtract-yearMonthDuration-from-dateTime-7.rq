# QT3 test case op-subtract-yearMonthDuration-from-dateTime-7 of test set op-subtract-yearMonthDuration-from-dateTime, which tests the XPath expression
#   fn:string(xs:dateTime("1989-07-05T14:34:36Z") - xs:yearMonthDuration("P08Y04M"))
# Expecting:
#   <assert-string-value>1981-03-05T14:34:36Z</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-dateTime.xml#L195
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( ( xsd:dateTime ( "1989-07-05T14:34:36Z" ) - xsd:yearMonthDuration ( "P08Y04M" ) ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1981-03-05T14:34:36Z" ))
}
