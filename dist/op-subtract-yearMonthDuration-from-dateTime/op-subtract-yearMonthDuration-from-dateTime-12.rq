# QT3 test case op-subtract-yearMonthDuration-from-dateTime-12 of test set op-subtract-yearMonthDuration-from-dateTime, which tests the XPath expression
#   fn:string((xs:dateTime("1980-03-02T02:02:02Z") - xs:yearMonthDuration("P05Y05M"))) and (fn:true())
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-dateTime.xml#L259
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:dateTime ( "1980-03-02T02:02:02Z" ) - xsd:yearMonthDuration ( "P05Y05M" ) ) ) && "true"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
