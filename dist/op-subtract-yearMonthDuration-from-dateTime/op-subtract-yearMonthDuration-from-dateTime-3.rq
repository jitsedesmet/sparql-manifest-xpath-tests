# QT3 test case op-subtract-yearMonthDuration-from-dateTime-3 of test set op-subtract-yearMonthDuration-from-dateTime, which tests the XPath expression
#   fn:string((xs:dateTime("1999-10-23T13:45:45Z") - xs:yearMonthDuration("P19Y12M"))) or fn:false()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-dateTime.xml#L132
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-10-23T13:45:45Z" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P19Y12M" ) ) ) || "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
