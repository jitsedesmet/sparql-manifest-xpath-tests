# QT3 test case op-subtract-yearMonthDuration-from-dateTime-10 of test set op-subtract-yearMonthDuration-from-dateTime, which tests the XPath expression
#   fn:string((xs:dateTime("1985-07-05T09:09:09Z") - xs:yearMonthDuration("P02Y02M"))) or fn:string((xs:dateTime("1985-07-05T09:09:09Z") - xs:yearMonthDuration("P02Y02M")))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-dateTime.xml#L243
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:dateTime ( "1985-07-05T09:09:09Z" ) - xsd:yearMonthDuration ( "P02Y02M" ) ) ) || xsd:string ( ( xsd:dateTime ( "1985-07-05T09:09:09Z" ) - xsd:yearMonthDuration ( "P02Y02M" ) ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
