# QT3 test case op-subtract-yearMonthDuration-from-dateTime-15 of test set op-subtract-yearMonthDuration-from-dateTime, which tests the XPath expression
#   (xs:dateTime("1978-12-12T07:07:07Z") - xs:yearMonthDuration("P17Y12M")) le xs:dateTime("1978-12-12T07:07:07Z")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-dateTime.xml#L307
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:dateTime ( "1978-12-12T07:07:07Z" ) - xsd:yearMonthDuration ( "P17Y12M" ) ) <= xsd:dateTime ( "1978-12-12T07:07:07Z" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
