# QT3 test case op-subtract-yearMonthDuration-from-dateTime-14 of test set op-subtract-yearMonthDuration-from-dateTime, which tests the XPath expression
#   (xs:dateTime("1979-12-12T09:09:09Z") - xs:yearMonthDuration("P08Y08M")) ne xs:dateTime("1979-12-12T09:09:09Z")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-dateTime.xml#L291
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:dateTime ( "1979-12-12T09:09:09Z" ) - xsd:yearMonthDuration ( "P08Y08M" ) ) != xsd:dateTime ( "1979-12-12T09:09:09Z" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
