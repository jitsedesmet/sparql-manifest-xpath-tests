# QT3 test case op-subtract-yearMonthDuration-from-dateTime-1 of test set op-subtract-yearMonthDuration-from-dateTime, which tests the XPath expression
#   xs:dateTime("2000-10-30T11:12:00") - xs:yearMonthDuration("P1Y2M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-dateTime.xml#L100
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, - on xsd:dateTime, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2000-10-30T11:12:00" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1Y2M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1999-08-30T11:12:00" ))
}
