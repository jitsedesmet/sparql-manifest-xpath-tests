# QT3 test case op-subtract-yearMonthDuration-from-dateTime-2 of test set op-subtract-yearMonthDuration-from-dateTime, which tests the XPath expression
#   fn:string(xs:dateTime("2000-12-12T12:12:12Z") - xs:dayTimeDuration("P12DT10H07M")) and fn:false()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-dateTime.xml#L116
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2000-12-12T12:12:12Z" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P12DT10H07M" ) ) ) && "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
