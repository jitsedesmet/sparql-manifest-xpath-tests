# QT3 test case op-subtract-yearMonthDuration-from-dateTime-4 of test set op-subtract-yearMonthDuration-from-dateTime, which tests the XPath expression
#   fn:not(fn:string(xs:dateTime("1998-09-12T13:56:12Z") - xs:yearMonthDuration("P20Y03M")))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-dateTime.xml#L147
# The test needs the constructor function xsd:yearMonthDuration, - on xsd:yearMonthDuration, - on xsd:dateTime, which SPARQL does not define
ASK {
  BIND(! <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1998-09-12T13:56:12Z" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P20Y03M" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
