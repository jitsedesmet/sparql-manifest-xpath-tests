# QT3 test case fn-year-from-dateTime-6 of test set fn-year-from-dateTime, which tests the XPath expression
#   fn:year-from-dateTime(xs:dateTime("-1999-05-31T00:20:00-05:00"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/year-from-dateTime.xml#L79
ASK {
  BIND(YEAR( <http://www.w3.org/2001/XMLSchema#dateTime> ( "-1999-05-31T00:20:00-05:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-1999" ))
}
