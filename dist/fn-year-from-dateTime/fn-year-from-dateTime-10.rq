# QT3 test case fn-year-from-dateTime-10 of test set fn-year-from-dateTime, which tests the XPath expression
#   fn:year-from-dateTime(xs:dateTime("1970-01-01T02:00:00Z")) * fn:year-from-dateTime(xs:dateTime("0002-01-01T10:00:00Z"))
ASK {
  BIND(( YEAR( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T02:00:00Z" ) ) * YEAR( <http://www.w3.org/2001/XMLSchema#dateTime> ( "0002-01-01T10:00:00Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "3940" ))
}
