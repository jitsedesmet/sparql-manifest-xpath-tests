# QT3 test case fn-year-from-dateTime-10 of test set fn-year-from-dateTime, which tests the XPath expression
#   fn:year-from-dateTime(xs:dateTime("1970-01-01T02:00:00Z")) * fn:year-from-dateTime(xs:dateTime("0002-01-01T10:00:00Z"))
# Expecting:
#   <assert-string-value>3940</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/year-from-dateTime.xml#L115
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( YEAR( xsd:dateTime ( "1970-01-01T02:00:00Z" ) ) * YEAR( xsd:dateTime ( "0002-01-01T10:00:00Z" ) ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "3940" ))
}
