# QT3 test case fn-year-from-dateTime-3 of test set fn-year-from-dateTime, which tests the XPath expression
#   fn:year-from-dateTime(xs:dateTime("1999-12-31T19:20:00"))
ASK {
  BIND(YEAR( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-12-31T19:20:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1999" ))
}
