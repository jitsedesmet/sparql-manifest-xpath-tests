# QT3 test case fn-year-from-dateTime1args-3 of test set fn-year-from-dateTime, which tests the XPath expression
#   fn:year-from-dateTime(xs:dateTime("2030-12-31T23:59:59Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/year-from-dateTime.xml#L25
ASK {
  BIND(YEAR( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2030-12-31T23:59:59Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2030" ))
}
