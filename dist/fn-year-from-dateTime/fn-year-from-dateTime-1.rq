# QT3 test case fn-year-from-dateTime-1 of test set fn-year-from-dateTime, which tests the XPath expression
#   fn:year-from-dateTime(xs:dateTime("1999-05-31T13:20:00-05:00"))
# Expecting:
#   <assert-string-value>1999</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/year-from-dateTime.xml#L34
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(YEAR( xsd:dateTime ( "1999-05-31T13:20:00-05:00" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1999" ))
}
