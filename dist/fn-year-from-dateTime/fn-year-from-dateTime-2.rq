# QT3 test case fn-year-from-dateTime-2 of test set fn-year-from-dateTime, which tests the XPath expression
#   fn:year-from-dateTime(xs:dateTime("1999-05-31T21:30:00-05:00"))
ASK {
  BIND(YEAR( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-05-31T21:30:00-05:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1999" ))
}
