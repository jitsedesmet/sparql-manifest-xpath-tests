# QT3 test case fn-year-from-dateTime-7 of test set fn-year-from-dateTime, which tests the XPath expression
#   fn:year-from-dateTime(xs:dateTime("0001-05-31T23:20:00-05:00"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/year-from-dateTime.xml#L88
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(YEAR( xsd:dateTime ( "0001-05-31T23:20:00-05:00" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1" ))
}
