# QT3 test case fn-year-from-dateTime-11 of test set fn-year-from-dateTime, which tests the XPath expression
#   fn:year-from-dateTime(xs:dateTime("1000-01-01T02:00:00Z")) div fn:year-from-dateTime(xs:dateTime("0050-01-01T10:00:00Z"))
ASK {
  BIND(( YEAR( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1000-01-01T02:00:00Z" ) ) / YEAR( <http://www.w3.org/2001/XMLSchema#dateTime> ( "0050-01-01T10:00:00Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "20" ))
}
