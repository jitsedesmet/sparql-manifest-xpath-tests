# QT3 test case K-NumericMultiply-2 of test set op-numeric-multiply, which tests the XPath expression
#   xs:decimal(6) * xs:decimal(2) eq 12
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L463
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#decimal> ( "6"^^<http://www.w3.org/2001/XMLSchema#integer> ) * <http://www.w3.org/2001/XMLSchema#decimal> ( "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) = "12"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
