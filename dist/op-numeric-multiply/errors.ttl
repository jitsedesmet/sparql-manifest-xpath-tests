@prefix dct: <http://purl.org/dc/terms/> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "QT3 test set op-numeric-multiply" ;
  dct:license <../LICENSE.txt> ;
  mf:entries (
    <#op-numeric-multiplymix2args-2>
    <#K-NumericMultiply-28>
    <#K-NumericMultiply-29>
  ) .

<#op-numeric-multiplymix2args-2> a mf:QueryEvaluationTest ;
  mf:name "op-numeric-multiplymix2args-2" ;
  rdfs:comment "Simple multiplication test pass string for second operator" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L352> ;
  mf:action [ qt:query <op-numeric-multiplymix2args-2.rq> ] ;
  mf:result <../true.srj> .

<#K-NumericMultiply-28> a mf:QueryEvaluationTest ;
  mf:name "K-NumericMultiply-28" ;
  rdfs:comment "Invoke the '*' operator with invalid operands." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L697> ;
  mf:action [ qt:query <K-NumericMultiply-28.rq> ] ;
  mf:result <../true.srj> .

<#K-NumericMultiply-29> a mf:QueryEvaluationTest ;
  mf:name "K-NumericMultiply-29" ;
  rdfs:comment "Invoke the '*' operator with invalid operands." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L706> ;
  mf:action [ qt:query <K-NumericMultiply-29.rq> ] ;
  mf:result <../true.srj> .
