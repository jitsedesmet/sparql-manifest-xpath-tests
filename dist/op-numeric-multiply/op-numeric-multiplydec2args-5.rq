# QT3 test case op-numeric-multiplydec2args-5 of test set op-numeric-multiply, which tests the XPath expression
#   xs:decimal("-1.0000000000") * xs:decimal("999999999999999999")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( "-1.0000000000" ) * <http://www.w3.org/2001/XMLSchema#decimal> ( "999999999999999999" ) ) AS ?result)
  FILTER(( ?result = - "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
