# QT3 test case op-numeric-multiplydbl2args-5 of test set op-numeric-multiply, which tests the XPath expression
#   xs:double("-1.0000000000") * xs:double("1.7976931348623157E308")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L88
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:double ( "-1.0000000000" ) * xsd:double ( "1.7976931348623157E308" ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-1.7976931348623157E308"^^xsd:double ) ))
}
