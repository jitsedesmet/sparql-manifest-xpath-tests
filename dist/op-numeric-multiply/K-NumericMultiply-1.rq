# QT3 test case K-NumericMultiply-1 of test set op-numeric-multiply, which tests the XPath expression
#   xs:double(6) * xs:double(2) eq 12
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L454
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:double ( "6"^^xsd:integer ) * xsd:double ( "2"^^xsd:integer ) ) = "12"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
