# QT3 test case op-numeric-multiplyflt2args-2 of test set op-numeric-multiply, which tests the XPath expression
#   xs:float("0") * xs:float("-3.4028235E38")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L106
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:float ( "0" ) * xsd:float ( "-3.4028235E38" ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-0"^^xsd:integer ) ))
}
