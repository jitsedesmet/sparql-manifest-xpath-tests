# QT3 test case op-numeric-multiplydec2args-4 of test set op-numeric-multiply, which tests the XPath expression
#   xs:decimal("0") * xs:decimal("617375191608514839")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L34
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( "0" ) * <http://www.w3.org/2001/XMLSchema#decimal> ( "617375191608514839" ) ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
