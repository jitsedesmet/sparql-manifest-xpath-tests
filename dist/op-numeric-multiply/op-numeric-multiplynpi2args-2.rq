# QT3 test case op-numeric-multiplynpi2args-2 of test set op-numeric-multiply, which tests the XPath expression
#   xs:nonPositiveInteger("-999999999999999999") * xs:nonPositiveInteger("0")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L286
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-999999999999999999"^^xsd:nonPositiveInteger * "0"^^xsd:nonPositiveInteger ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "0"^^xsd:integer ) ))
}
