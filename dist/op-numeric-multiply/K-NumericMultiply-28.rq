# QT3 test case K-NumericMultiply-28 of test set op-numeric-multiply, which tests the XPath expression
#   "3" * "3"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L697
ASK {
  BIND(( "3" * "3" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
