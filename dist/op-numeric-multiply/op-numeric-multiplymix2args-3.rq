# QT3 test case op-numeric-multiplymix2args-3 of test set op-numeric-multiply, which tests the XPath expression
#   1 * xs:integer('1')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L361
ASK {
  BIND(( "1"^^<http://www.w3.org/2001/XMLSchema#integer> * <http://www.w3.org/2001/XMLSchema#integer> ( "1" ) ) AS ?result)
  FILTER(( ?result = "1"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
