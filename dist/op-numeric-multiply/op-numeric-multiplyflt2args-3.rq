# QT3 test case op-numeric-multiplyflt2args-3 of test set op-numeric-multiply, which tests the XPath expression
#   xs:float("3.4028235E38") * xs:float("-1.0000000000")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L115
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "3.4028235E38" ) * <http://www.w3.org/2001/XMLSchema#float> ( "-1.0000000000" ) ) AS ?result)
  FILTER(( ?result = <http://www.w3.org/2001/XMLSchema#float> ( - "3.4028235E38"^^<http://www.w3.org/2001/XMLSchema#double> ) ))
