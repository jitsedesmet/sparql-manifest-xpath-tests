# QT3 test case K-NumericMultiply-24 of test set op-numeric-multiply, which tests the XPath expression
#   string(3 * xs:double("NaN")) eq "NaN"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L661
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( "3"^^xsd:integer * xsd:double ( "NaN" ) ) ) = "NaN" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
