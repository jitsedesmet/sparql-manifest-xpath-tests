# QT3 test case K-NumericMultiply-4 of test set op-numeric-multiply, which tests the XPath expression
#   xs:float(6) * xs:float(2) eq 12
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L481
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:float ( "6"^^xsd:integer ) * xsd:float ( "2"^^xsd:integer ) ) = "12"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
