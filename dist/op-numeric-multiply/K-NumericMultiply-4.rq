# QT3 test case K-NumericMultiply-4 of test set op-numeric-multiply, which tests the XPath expression
#   xs:float(6) * xs:float(2) eq 12
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#float> ( "6"^^<http://www.w3.org/2001/XMLSchema#integer> ) * <http://www.w3.org/2001/XMLSchema#float> ( "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) = "12"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
