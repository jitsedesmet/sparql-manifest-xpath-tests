# QT3 test case op-numeric-multiplypint2args-5 of test set op-numeric-multiply, which tests the XPath expression
#   xs:positiveInteger("1") * xs:positiveInteger("999999999999999999")
ASK {
  BIND(( "1"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> * "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) AS ?result)
  FILTER(( ?result = "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
