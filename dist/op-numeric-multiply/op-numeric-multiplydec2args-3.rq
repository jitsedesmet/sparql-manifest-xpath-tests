# QT3 test case op-numeric-multiplydec2args-3 of test set op-numeric-multiply, which tests the XPath expression
#   xs:decimal("999999999999999999") * xs:decimal("-1.0000000000")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L25
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( "999999999999999999" ) * <http://www.w3.org/2001/XMLSchema#decimal> ( "-1.0000000000" ) ) AS ?result)
  FILTER(( ?result = - "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
