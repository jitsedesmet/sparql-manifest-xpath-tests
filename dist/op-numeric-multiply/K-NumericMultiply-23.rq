# QT3 test case K-NumericMultiply-23 of test set op-numeric-multiply, which tests the XPath expression
#   string(3 * xs:float("NaN")) eq "NaN"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L652
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( "3"^^<http://www.w3.org/2001/XMLSchema#integer> * <http://www.w3.org/2001/XMLSchema#float> ( "NaN" ) ) ) = "NaN" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
