# QT3 test case op-numeric-multiplyulng2args-5 of test set op-numeric-multiply, which tests the XPath expression
#   xs:unsignedLong("0") * xs:unsignedLong("184467440737095516")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L268
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "0"^^xsd:unsignedLong * "184467440737095516"^^xsd:unsignedLong ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "0"^^xsd:integer ) ))
}
