# QT3 test case op-numeric-multiplyusht2args-1 of test set op-numeric-multiply, which tests the XPath expression
#   xs:unsignedShort("0") * xs:unsignedShort("0")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L142
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> * "0"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
