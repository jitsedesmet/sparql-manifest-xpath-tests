# QT3 test case op-numeric-multiplyflt2args-4 of test set op-numeric-multiply, which tests the XPath expression
#   xs:float("-3.4028235E38") * xs:float("0")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "-3.4028235E38" ) * <http://www.w3.org/2001/XMLSchema#float> ( "0" ) ) AS ?result)
  FILTER(( ?result = - "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
