# QT3 test case K-NumericMultiply-29 of test set op-numeric-multiply, which tests the XPath expression
#   1 * "3"
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-multiply.xml#L706
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "1"^^xsd:integer * "3" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
