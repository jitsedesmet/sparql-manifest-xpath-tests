<#K-SubstringFunc-7> a mf:QueryEvaluationTest ;
  mf:name "K-SubstringFunc-7" ;
  rdfs:comment "A test whose essence is: `substring(\"motor car\", 6) eq \" car\"`." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml> ;
  mf:action [ qt:query <K-SubstringFunc-7.rq> ] ;
  mf:result <../true.srj> .

<#K-SubstringFunc-8> a mf:QueryEvaluationTest ;
  mf:name "K-SubstringFunc-8" ;
  rdfs:comment "A test whose essence is: `substring(\"12345\", 0, 3) eq \"12\"`." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml> ;
  mf:action [ qt:query <K-SubstringFunc-8.rq> ] ;
