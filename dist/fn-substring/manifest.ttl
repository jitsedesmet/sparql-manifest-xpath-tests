  ) .

<#fn-substring-1> a mf:QueryEvaluationTest ;
  mf:name "fn-substring-1" ;
  rdfs:comment "Evaluation of substring function as per example 1 (for this function) from the F&O specs." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml> ;
  mf:action [ qt:query <fn-substring-1.rq> ] ;
  mf:result <../true.srj> .

<#fn-substring-2> a mf:QueryEvaluationTest ;
  mf:name "fn-substring-2" ;
  rdfs:comment "Evaluation of substring function as per example 2 (for this function) from the F&O specs." ;
