# QT3 test case fn-substring-4 of test set fn-substring, which tests the XPath expression
#   fn:substring("12345", 0, 3)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml#L43
ASK {
  BIND(SUBSTR( "12345" , "0"^^<http://www.w3.org/2001/XMLSchema#integer> , "3"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "12" ))
}
