# QT3 test case cbcl-substring-001 of test set fn-substring, which tests the XPath expression
#   fn:boolean(fn:substring('', 1, 1))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml#L432
ASK {
  BIND(! ( ! SUBSTR( "" , "1"^^<http://www.w3.org/2001/XMLSchema#integer> , "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
