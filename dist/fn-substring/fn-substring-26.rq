# QT3 test case fn-substring-26 of test set fn-substring, which tests the XPath expression
#   substring("𐀁", 2, 1)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml#L242
ASK {
  BIND(SUBSTR( "𐀁" , "2"^^<http://www.w3.org/2001/XMLSchema#integer> , "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ?result = "" ))
}
