# QT3 test case K-SubstringFunc-13 of test set fn-substring, which tests the XPath expression
#   substring("12345", -42, 1 div 0E0) eq "12345"
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml#L404
# The test needs SUBSTR with a position or length that is not an xsd:integer, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( SUBSTR( "12345" , - "42"^^xsd:integer , ( "1"^^xsd:integer / "0E0"^^xsd:double ) ) = "12345" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
