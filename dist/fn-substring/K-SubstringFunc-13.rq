# QT3 test case K-SubstringFunc-13 of test set fn-substring, which tests the XPath expression
#   substring("12345", -42, 1 div 0E0) eq "12345"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml#L404
ASK {
  BIND(( SUBSTR( "12345" , - "42"^^<http://www.w3.org/2001/XMLSchema#integer> , ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> / "0E0"^^<http://www.w3.org/2001/XMLSchema#double> ) ) = "12345" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
