# QT3 test case fn-substring-2 of test set fn-substring, which tests the XPath expression
#   fn:substring("metadata", 4, 3)
ASK {
  BIND(SUBSTR( "metadata" , "4"^^<http://www.w3.org/2001/XMLSchema#integer> , "3"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "ada" ))
}
