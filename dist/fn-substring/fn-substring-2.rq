# QT3 test case fn-substring-2 of test set fn-substring, which tests the XPath expression
#   fn:substring("metadata", 4, 3)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml#L25
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(SUBSTR( "metadata" , "4"^^xsd:integer , "3"^^xsd:integer ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "ada" ))
}
