# QT3 test case fn-substring-23 of test set fn-substring, which tests the XPath expression
#   substring("abcd𐀁efgh", 6)
# Expecting:
#   <assert-eq>"efgh"</assert-eq>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml#L215
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(SUBSTR( "abcd𐀁efgh" , "6"^^xsd:integer ) AS ?result)
  FILTER(SAMETERM( ?result , "efgh" ))
}
