# QT3 test case K-SubstringFunc-10 of test set fn-substring, which tests the XPath expression
#   substring("12345", 0 div 0E0, 3) eq ""
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml#L377
# The test needs SUBSTR with a position or length that is not an xsd:integer, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( SUBSTR( "12345" , ( "0"^^xsd:integer / "0E0"^^xsd:double ) , "3"^^xsd:integer ) = "" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
