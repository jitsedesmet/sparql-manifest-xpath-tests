# QT3 test case K-SubstringFunc-10 of test set fn-substring, which tests the XPath expression
#   substring("12345", 0 div 0E0, 3) eq ""
ASK {
  BIND(( SUBSTR( "12345" , ( "0"^^<http://www.w3.org/2001/XMLSchema#integer> / "0E0"^^<http://www.w3.org/2001/XMLSchema#double> ) , "3"^^<http://www.w3.org/2001/XMLSchema#integer> ) = "" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
