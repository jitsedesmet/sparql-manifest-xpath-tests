# QT3 test case K-SubstringFunc-15 of test set fn-substring, which tests the XPath expression
#   substring("12345", 5, -3) eq ""
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml#L422
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( SUBSTR( "12345" , "5"^^xsd:integer , - "3"^^xsd:integer ) = "" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
