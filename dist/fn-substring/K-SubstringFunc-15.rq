# QT3 test case K-SubstringFunc-15 of test set fn-substring, which tests the XPath expression
#   substring("12345", 5, -3) eq ""
ASK {
  BIND(( SUBSTR( "12345" , "5"^^<http://www.w3.org/2001/XMLSchema#integer> , - "3"^^<http://www.w3.org/2001/XMLSchema#integer> ) = "" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
