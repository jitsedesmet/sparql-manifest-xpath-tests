# QT3 test case fn-substring-18 of test set fn-substring, which tests the XPath expression
#   fn:contains(fn:substring("ABCDEF",1),"DEF")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml#L169
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CONTAINS( SUBSTR( "ABCDEF" , "1"^^xsd:integer ) , "DEF" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
