# QT3 test case fn-substring-31 of test set fn-substring, which tests the XPath expression
#   substring("12345", -3.1e0, 5.2e0) eq "1"
ASK {
  BIND(( SUBSTR( "12345" , - "3.1e0"^^<http://www.w3.org/2001/XMLSchema#double> , "5.2e0"^^<http://www.w3.org/2001/XMLSchema#double> ) = "1" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
