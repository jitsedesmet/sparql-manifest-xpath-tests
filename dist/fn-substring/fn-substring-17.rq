# QT3 test case fn-substring-17 of test set fn-substring, which tests the XPath expression
#   fn:concat(fn:substring("ABC",1),"DEF")
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( SUBSTR( "ABC" , "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) , <http://www.w3.org/2001/XMLSchema#string> ( "DEF" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "ABCDEF" ))
}
