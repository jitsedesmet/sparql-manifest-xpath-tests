# QT3 test case K-SubstringFunc-8 of test set fn-substring, which tests the XPath expression
#   substring("12345", 0, 3) eq "12"
ASK {
  BIND(( SUBSTR( "12345" , "0"^^<http://www.w3.org/2001/XMLSchema#integer> , "3"^^<http://www.w3.org/2001/XMLSchema#integer> ) = "12" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
