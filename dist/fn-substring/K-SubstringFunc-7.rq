# QT3 test case K-SubstringFunc-7 of test set fn-substring, which tests the XPath expression
#   substring("motor car", 6) eq " car"
ASK {
  BIND(( SUBSTR( "motor car" , "6"^^<http://www.w3.org/2001/XMLSchema#integer> ) = " car" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
