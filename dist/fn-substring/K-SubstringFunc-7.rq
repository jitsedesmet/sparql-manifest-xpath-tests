# QT3 test case K-SubstringFunc-7 of test set fn-substring, which tests the XPath expression
#   substring("motor car", 6) eq " car"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml#L350
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( SUBSTR( "motor car" , "6"^^xsd:integer ) = " car" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
