# QT3 test case fn-substring-24 of test set fn-substring, which tests the XPath expression
#   substring("abcd𐀁efgh", 5, 2)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml#L224
ASK {
  BIND(SUBSTR( "abcd𐀁efgh" , "5"^^<http://www.w3.org/2001/XMLSchema#integer> , "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ?result = "𐀁e" ))
}
