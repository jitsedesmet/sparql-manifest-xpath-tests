# QT3 test case fn-substring-20 of test set fn-substring, which tests the XPath expression
#   fn:substring("ABCD",xs:double(1))
ASK {
  BIND(SUBSTR( "ABCD" , <http://www.w3.org/2001/XMLSchema#double> ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "ABCD" ))
}
