# QT3 test case K-SubstringFunc-12 of test set fn-substring, which tests the XPath expression
#   substring("12345", -3, 5) eq "1"
ASK {
  BIND(( SUBSTR( "12345" , - "3"^^<http://www.w3.org/2001/XMLSchema#integer> , "5"^^<http://www.w3.org/2001/XMLSchema#integer> ) = "1" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
