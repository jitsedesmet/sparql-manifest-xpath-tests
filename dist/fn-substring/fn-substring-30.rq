# QT3 test case fn-substring-30 of test set fn-substring, which tests the XPath expression
#   substring("𐀁𐀁", 0)
# Expecting:
#   <assert-eq>"𐀁𐀁"</assert-eq>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml#L278
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(SUBSTR( "𐀁𐀁" , "0"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "𐀁𐀁" ) && ( SAMETERM( DATATYPE( ?result ) , xsd:string ) || SAMETERM( DATATYPE( ?result ) , xsd:normalizedString ) || SAMETERM( DATATYPE( ?result ) , xsd:token ) || SAMETERM( DATATYPE( ?result ) , xsd:language ) || SAMETERM( DATATYPE( ?result ) , xsd:NMTOKEN ) || SAMETERM( DATATYPE( ?result ) , xsd:Name ) || SAMETERM( DATATYPE( ?result ) , xsd:NCName ) || SAMETERM( DATATYPE( ?result ) , xsd:ID ) || SAMETERM( DATATYPE( ?result ) , xsd:IDREF ) || SAMETERM( DATATYPE( ?result ) , xsd:ENTITY ) ) ))
}
