# QT3 test case cbcl-substring-002 of test set fn-substring, which tests the XPath expression
#   fn:boolean(fn:substring('five', 5, 1))
ASK {
  BIND(!( ! SUBSTR( "five" , "5"^^<http://www.w3.org/2001/XMLSchema#integer> , "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
