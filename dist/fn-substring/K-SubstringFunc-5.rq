# QT3 test case K-SubstringFunc-5 of test set fn-substring, which tests the XPath expression
#   substring("12345", 1.5, 2.6) eq "234"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml#L332
# The test needs SUBSTR with a position or length that is not an xsd:integer, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( SUBSTR( "12345" , "1.5"^^xsd:decimal , "2.6"^^xsd:decimal ) = "234" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
