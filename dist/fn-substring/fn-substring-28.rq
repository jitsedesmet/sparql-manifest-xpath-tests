# QT3 test case fn-substring-28 of test set fn-substring, which tests the XPath expression
#   substring("𐀁", 0, 3)
# Expecting:
#   <assert-eq>"𐀁"</assert-eq>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml#L260
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(SUBSTR( "𐀁" , "0"^^xsd:integer , "3"^^xsd:integer ) AS ?result)
  FILTER(SAMETERM( ?result , "𐀁" ))
}
