# QT3 test case fn-substring-6 of test set fn-substring, which tests the XPath expression
#   fn:substring("12345", -3, 5)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/substring.xml#L61
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(SUBSTR( "12345" , - "3"^^xsd:integer , "5"^^xsd:integer ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1" ))
}
