# QT3 test case fn-substring-16 of test set fn-substring, which tests the XPath expression
#   fn:substring("substring",1)
ASK {
  BIND(SUBSTR( "substring" , "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "substring" ))
}
