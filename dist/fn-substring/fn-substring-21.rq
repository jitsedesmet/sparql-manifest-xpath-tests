# QT3 test case fn-substring-21 of test set fn-substring, which tests the XPath expression
#   fn:substring("ABCDE",1+1)
ASK {
  BIND(SUBSTR( "ABCDE" , ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> + "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "BCDE" ))
}
