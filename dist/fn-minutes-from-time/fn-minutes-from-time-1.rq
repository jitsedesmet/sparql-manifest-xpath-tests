# QT3 test case fn-minutes-from-time-1 of test set fn-minutes-from-time, which tests the XPath expression
#   fn:minutes-from-time(xs:time("13:00:00Z"))
ASK {
  BIND(MINUTES( <http://www.w3.org/2001/XMLSchema#time> ( "13:00:00Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0" ))
}
