# QT3 test case K-MinutesFromTimeFunc-5 of test set fn-minutes-from-time, which tests the XPath expression
#   minutes-from-time(xs:time("23:11:12.43")) eq 11
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/minutes-from-time.xml#L241
# The test needs the constructor function xsd:time, MINUTES on xsd:time, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( MINUTES( xsd:time ( "23:11:12.43" ) ) = "11"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
