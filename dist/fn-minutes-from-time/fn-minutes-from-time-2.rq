# QT3 test case fn-minutes-from-time-2 of test set fn-minutes-from-time, which tests the XPath expression
#   fn:minutes-from-time(xs:time("21:23:00Z")) lt fn:minutes-from-time(xs:time("21:24:00Z"))
ASK {
  BIND(( MINUTES( <http://www.w3.org/2001/XMLSchema#time> ( "21:23:00Z" ) ) < MINUTES( <http://www.w3.org/2001/XMLSchema#time> ( "21:24:00Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
