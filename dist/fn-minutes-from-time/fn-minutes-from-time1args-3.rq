# QT3 test case fn-minutes-from-time1args-3 of test set fn-minutes-from-time, which tests the XPath expression
#   fn:minutes-from-time(xs:time("23:59:59Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/minutes-from-time.xml#L25
ASK {
  BIND(MINUTES( <http://www.w3.org/2001/XMLSchema#time> ( "23:59:59Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "59" ))
}
