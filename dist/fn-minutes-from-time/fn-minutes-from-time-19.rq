# QT3 test case fn-minutes-from-time-19 of test set fn-minutes-from-time, which tests the XPath expression
#   fn:minutes-from-time(xs:time("10:03:00Z")) ge fn:minutes-from-time(xs:time("10:04:00Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/minutes-from-time.xml#L196
ASK {
  BIND(( MINUTES( <http://www.w3.org/2001/XMLSchema#time> ( "10:03:00Z" ) ) >= MINUTES( <http://www.w3.org/2001/XMLSchema#time> ( "10:04:00Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
