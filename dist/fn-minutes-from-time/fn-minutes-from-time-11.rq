# QT3 test case fn-minutes-from-time-11 of test set fn-minutes-from-time, which tests the XPath expression
#   fn:minutes-from-time(xs:time("22:33:00Z")) div fn:minutes-from-time(xs:time("02:11:00Z"))
ASK {
  BIND(( MINUTES( <http://www.w3.org/2001/XMLSchema#time> ( "22:33:00Z" ) ) / MINUTES( <http://www.w3.org/2001/XMLSchema#time> ( "02:11:00Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "3" ))
}
