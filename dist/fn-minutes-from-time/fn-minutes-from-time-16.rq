# QT3 test case fn-minutes-from-time-16 of test set fn-minutes-from-time, which tests the XPath expression
#   fn:minutes-from-time(xs:time("10:02:00Z")) eq fn:minutes-from-time(xs:time("10:02:00Z"))
ASK {
  BIND(( MINUTES( <http://www.w3.org/2001/XMLSchema#time> ( "10:02:00Z" ) ) = MINUTES( <http://www.w3.org/2001/XMLSchema#time> ( "10:02:00Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
