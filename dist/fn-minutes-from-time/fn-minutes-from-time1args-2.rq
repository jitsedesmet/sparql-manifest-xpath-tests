# QT3 test case fn-minutes-from-time1args-2 of test set fn-minutes-from-time, which tests the XPath expression
#   fn:minutes-from-time(xs:time("08:03:35Z"))
ASK {
  BIND(MINUTES( <http://www.w3.org/2001/XMLSchema#time> ( "08:03:35Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "3" ))
}
