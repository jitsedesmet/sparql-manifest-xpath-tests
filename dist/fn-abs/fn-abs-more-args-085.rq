# QT3 test case fn-abs-more-args-085 of test set fn-abs, which tests the XPath expression
#   fn:abs(xs:dateTime("2002-10-10T12:00:00-05:00"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/abs.xml#L1535
ASK {
  BIND(ABS( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2002-10-10T12:00:00-05:00" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
