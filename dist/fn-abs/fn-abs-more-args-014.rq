# QT3 test case fn-abs-more-args-014 of test set fn-abs, which tests the XPath expression
#   fn:abs(xs:int("-0"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/abs.xml#L792
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ABS( "-0"^^xsd:int ) AS ?result)
  FILTER(( ( ISNUMERIC( ?result ) && ( ?result = "0"^^xsd:integer ) ) && ( ( ( ( ( ( ( ( ( ( ( ( SAMETERM( DATATYPE( ?result ) , xsd:integer ) || SAMETERM( DATATYPE( ?result ) , xsd:nonPositiveInteger ) ) || SAMETERM( DATATYPE( ?result ) , xsd:negativeInteger ) ) || SAMETERM( DATATYPE( ?result ) , xsd:long ) ) || SAMETERM( DATATYPE( ?result ) , xsd:int ) ) || SAMETERM( DATATYPE( ?result ) , xsd:short ) ) || SAMETERM( DATATYPE( ?result ) , xsd:byte ) ) || SAMETERM( DATATYPE( ?result ) , xsd:nonNegativeInteger ) ) || SAMETERM( DATATYPE( ?result ) , xsd:unsignedLong ) ) || SAMETERM( DATATYPE( ?result ) , xsd:unsignedInt ) ) || SAMETERM( DATATYPE( ?result ) , xsd:unsignedShort ) ) || SAMETERM( DATATYPE( ?result ) , xsd:unsignedByte ) ) || SAMETERM( DATATYPE( ?result ) , xsd:positiveInteger ) ) ))
}
