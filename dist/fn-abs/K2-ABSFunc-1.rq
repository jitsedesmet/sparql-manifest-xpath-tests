# QT3 test case K2-ABSFunc-1 of test set fn-abs, which tests the XPath expression
#   fn:abs(xs:integer(-4))
ASK {
  BIND(ABS( <http://www.w3.org/2001/XMLSchema#integer> ( - "4"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "4" ))
}
