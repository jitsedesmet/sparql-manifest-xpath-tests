# QT3 test case fn-abs-more-args-001 of test set fn-abs, which tests the XPath expression
#   fn:abs(xs:double("-0"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/abs.xml#L609
ASK {
  BIND(ABS( <http://www.w3.org/2001/XMLSchema#double> ( "-0" ) ) AS ?result)
  FILTER(( ( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#double> ) ) ))
}
