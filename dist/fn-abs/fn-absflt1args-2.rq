# QT3 test case fn-absflt1args-2 of test set fn-abs, which tests the XPath expression
#   fn:abs(xs:float("0"))
ASK {
  BIND(ABS( <http://www.w3.org/2001/XMLSchema#float> ( "0" ) ) AS ?result)
  FILTER(( ( ?result = "0.0e0"^^<http://www.w3.org/2001/XMLSchema#double> ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#float> ) ) ))
}
