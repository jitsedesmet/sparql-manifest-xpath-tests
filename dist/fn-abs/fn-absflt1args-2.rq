# QT3 test case fn-absflt1args-2 of test set fn-abs, which tests the XPath expression
#   fn:abs(xs:float("0"))
# Expecting:
#   <all-of>
#      <assert-eq>0.0e0</assert-eq>
#      <assert-type>xs:float</assert-type>
#   </all-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/abs.xml#L271
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ABS( xsd:float ( "0" ) ) AS ?result)
  FILTER(( ( ?result = "0.0e0"^^xsd:double ) && SAMETERM( DATATYPE( ?result ) , xsd:float ) ))
}
