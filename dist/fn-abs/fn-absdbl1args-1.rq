# QT3 test case fn-absdbl1args-1 of test set fn-abs, which tests the XPath expression
#   fn:abs(xs:double("-1.7976931348623157E308"))
# Expecting:
#   <all-of>
#      <assert-eq>1.7976931348623157E308</assert-eq>
#      <assert-type>xs:double</assert-type>
#   </all-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/abs.xml#L191
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ABS( xsd:double ( "-1.7976931348623157E308" ) ) AS ?result)
  FILTER(( ( ?result = "1.7976931348623157E308"^^xsd:double ) && SAMETERM( DATATYPE( ?result ) , xsd:double ) ))
}
