# QT3 test case K2-ABSFunc-50 of test set fn-abs, which tests the XPath expression
#   fn:abs(xs:double("INF"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/abs.xml#L2143
ASK {
  BIND(ABS( <http://www.w3.org/2001/XMLSchema#double> ( "INF" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "INF" ))
}
