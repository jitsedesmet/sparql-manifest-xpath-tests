# QT3 test case K-ABSFunc-6 of test set fn-abs, which tests the XPath expression
#   abs("a string")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/abs.xml#L1605
ASK {
  BIND(ABS( "a string" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
