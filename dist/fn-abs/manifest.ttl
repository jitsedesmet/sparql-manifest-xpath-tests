<#fn-absint1args-1> a mf:QueryEvaluationTest ;
  mf:name "fn-absint1args-1" ;
  rdfs:comment "Test: absint1args-1 The \"abs\" function with the arguments set as follows: $arg = xs:int(lower bound)" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/abs.xml> ;
  mf:action [ qt:query <fn-absint1args-1.rq> ] ;
  mf:result <../true.srj> .

