# QT3 test case fn-abs-more-args-083 of test set fn-abs, which tests the XPath expression
#   fn:abs(xs:date("2002-10-09"))
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/abs.xml#L1515
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ABS( xsd:date ( "2002-10-09" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
