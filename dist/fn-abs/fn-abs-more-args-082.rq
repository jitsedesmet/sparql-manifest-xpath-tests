# QT3 test case fn-abs-more-args-082 of test set fn-abs, which tests the XPath expression
#   fn:abs(xs:boolean(fn:false()))
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/abs.xml#L1505
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ABS( xsd:boolean ( "false"^^xsd:boolean ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
