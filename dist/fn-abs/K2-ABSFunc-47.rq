# QT3 test case K2-ABSFunc-47 of test set fn-abs, which tests the XPath expression
#   fn:abs(xs:float("-INF"))
# Expecting:
#   <assert-string-value>INF</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/abs.xml#L2113
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ABS( xsd:float ( "-INF" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "INF" ))
}
