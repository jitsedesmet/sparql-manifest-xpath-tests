# QT3 test case fn-abs-more-args-005 of test set fn-abs, which tests the XPath expression
#   fn:abs(xs:double("NaN"))
ASK {
  BIND(ABS( <http://www.w3.org/2001/XMLSchema#double> ( "NaN" ) ) AS ?result)
  FILTER(( ( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "NaN" ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#double> ) ) ))
}
