# QT3 test case fn-abs-more-args-005 of test set fn-abs, which tests the XPath expression
#   fn:abs(xs:double("NaN"))
# Expecting:
#   <all-of>
#      <assert-string-value>NaN</assert-string-value>
#      <assert-type>xs:double</assert-type>
#   </all-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/abs.xml#L675
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ABS( xsd:double ( "NaN" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "NaN" ) && SAMETERM( DATATYPE( ?result ) , xsd:double ) ))
}
