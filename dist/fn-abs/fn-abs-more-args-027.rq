# QT3 test case fn-abs-more-args-027 of test set fn-abs, which tests the XPath expression
#   fn:abs(xs:decimal("-NaN"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/abs.xml#L955
ASK {
  BIND(ABS( <http://www.w3.org/2001/XMLSchema#decimal> ( "-NaN" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
