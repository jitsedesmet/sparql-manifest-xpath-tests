# QT3 test case K-EndsWithFunc-7 of test set fn-ends-with, which tests the XPath expression
#   not(ends-with("tattoo", "atto"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ends-with.xml#L434
ASK {
  BIND(! STRENDS( "tattoo" , "atto" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
