# QT3 test case fn-ends-with2args-5 of test set fn-ends-with, which tests the XPath expression
#   fn:ends-with(xs:string("This is a characte"),xs:string("This is a characte"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ends-with.xml#L43
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(STRENDS( xsd:string ( "This is a characte" ) , xsd:string ( "This is a characte" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
