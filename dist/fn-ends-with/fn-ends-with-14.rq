# QT3 test case fn-ends-with-14 of test set fn-ends-with, which tests the XPath expression
#   fn:ends-with("A",xs:string("A"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ends-with.xml#L169
ASK {
  BIND(STRENDS( "A" , <http://www.w3.org/2001/XMLSchema#string> ( "A" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , <http://www.w3.org/2001/XMLSchema#boolean> ) && SAMETERM( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) , "true" ) ))
}
