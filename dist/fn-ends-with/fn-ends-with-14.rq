# QT3 test case fn-ends-with-14 of test set fn-ends-with, which tests the XPath expression
#   fn:ends-with("A",xs:string("A"))
ASK {
  BIND(STRENDS( "A" , <http://www.w3.org/2001/XMLSchema#string> ( "A" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
