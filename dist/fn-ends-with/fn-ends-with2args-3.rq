# QT3 test case fn-ends-with2args-3 of test set fn-ends-with, which tests the XPath expression
#   fn:ends-with(xs:string("This is a characte"),xs:string("This is a characte"))
ASK {
  BIND(STRENDS( <http://www.w3.org/2001/XMLSchema#string> ( "This is a characte" ) , <http://www.w3.org/2001/XMLSchema#string> ( "This is a characte" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
