# QT3 test case fn-ends-with-8 of test set fn-ends-with, which tests the XPath expression
#   fn:ends-with("AAAAABBBBBCCCCC","BBBBB")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ends-with.xml#L115
ASK {
  BIND(STRENDS( "AAAAABBBBBCCCCC" , "BBBBB" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
