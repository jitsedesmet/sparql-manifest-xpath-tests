# QT3 test case K-EndsWithFunc-6 of test set fn-ends-with, which tests the XPath expression
#   ends-with("tattoo", "tattoo")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ends-with.xml#L425
ASK {
  BIND(STRENDS( "tattoo" , "tattoo" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
