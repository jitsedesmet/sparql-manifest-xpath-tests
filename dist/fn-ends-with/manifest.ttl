<#fn-ends-with2args-1> a mf:QueryEvaluationTest ;
  mf:name "fn-ends-with2args-1" ;
  rdfs:comment "Evaluates The \"ends-with\" function with the arguments set as follows: $arg1 = xs:string(lower bound) $arg2 = xs:string(lower bound)" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ends-with.xml> ;
  mf:action [ qt:query <fn-ends-with2args-1.rq> ] ;
  mf:result <../true.srj> .

