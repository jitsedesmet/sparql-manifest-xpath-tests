# QT3 test case fn-ends-with-15 of test set fn-ends-with, which tests the XPath expression
#   fn:ends-with("A","a")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ends-with.xml#L178
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(STRENDS( "A" , "a" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
