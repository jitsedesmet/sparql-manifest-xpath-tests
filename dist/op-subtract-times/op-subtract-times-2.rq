# QT3 test case op-subtract-times-2 of test set op-subtract-times, which tests the XPath expression
#   xs:time("11:00:00-05:00") - xs:time("21:30:00+05:30")
# Expecting:
#   <assert-string-value>PT0S</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-times.xml#L112
# The test needs the constructor function xsd:time, - on xsd:time, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:time ( "11:00:00-05:00" ) - xsd:time ( "21:30:00+05:30" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "PT0S" ))
}
