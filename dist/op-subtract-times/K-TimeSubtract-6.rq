# QT3 test case K-TimeSubtract-6 of test set op-subtract-times, which tests the XPath expression
#   xs:time("08:01:23") * xs:time("08:01:23")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "08:01:23" ) * <http://www.w3.org/2001/XMLSchema#time> ( "08:01:23" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
