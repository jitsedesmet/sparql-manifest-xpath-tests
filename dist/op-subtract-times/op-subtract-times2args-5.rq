# QT3 test case op-subtract-times2args-5 of test set op-subtract-times, which tests the XPath expression
#   xs:time("00:00:00Z") - xs:time("23:59:59Z")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "00:00:00Z" ) - <http://www.w3.org/2001/XMLSchema#time> ( "23:59:59Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-PT23H59M59S" ))
}
