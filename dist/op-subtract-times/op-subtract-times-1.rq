# QT3 test case op-subtract-times-1 of test set op-subtract-times, which tests the XPath expression
#   xs:time("11:12:00Z") - xs:time("04:00:00Z")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-times.xml#L96
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "11:12:00Z" ) - <http://www.w3.org/2001/XMLSchema#time> ( "04:00:00Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "PT7H12M" ))
}
