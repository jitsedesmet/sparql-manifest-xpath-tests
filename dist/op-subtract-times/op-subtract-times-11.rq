# QT3 test case op-subtract-times-11 of test set op-subtract-times, which tests the XPath expression
#   (xs:time("23:00:00Z") - xs:time("17:00:00Z")) div (xs:time("13:00:00Z") - xs:time("10:00:00Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-times.xml#L260
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#time> ( "23:00:00Z" ) - <http://www.w3.org/2001/XMLSchema#time> ( "17:00:00Z" ) ) / ( <http://www.w3.org/2001/XMLSchema#time> ( "13:00:00Z" ) - <http://www.w3.org/2001/XMLSchema#time> ( "10:00:00Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2" ))
}
