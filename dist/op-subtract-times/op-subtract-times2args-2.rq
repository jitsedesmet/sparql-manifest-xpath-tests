# QT3 test case op-subtract-times2args-2 of test set op-subtract-times, which tests the XPath expression
#   xs:time("08:03:35Z") - xs:time("00:00:00Z")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "08:03:35Z" ) - <http://www.w3.org/2001/XMLSchema#time> ( "00:00:00Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "PT8H3M35S" ))
}
