  ) .

<#K-TimeSubtract-3> a mf:QueryEvaluationTest ;
  mf:name "K-TimeSubtract-3" ;
  rdfs:comment "*******************************************************\n Test: K-TimeSubtract-3                                \n Written by: Frans Englich                             \n Date: 2007-11-22T11:31:21+01:00                       \n Purpose: The '-' operator is not available between xs:yearMonthDuration and xs:time. \n*******************************************************" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-times.xml> ;
  mf:action [ qt:query <K-TimeSubtract-3.rq> ] ;
  mf:result <../true.srj> .

