# QT3 test case op-subtract-times-5 of test set op-subtract-times, which tests the XPath expression
#   fn:boolean(fn:string(xs:time("13:00:00Z") - xs:time("10:00:00Z")))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-times.xml#L161
# The test needs the constructor function xsd:time, - on xsd:time, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( ! xsd:string ( ( xsd:time ( "13:00:00Z" ) - xsd:time ( "10:00:00Z" ) ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
