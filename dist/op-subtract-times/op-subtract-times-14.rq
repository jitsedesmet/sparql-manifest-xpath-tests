# QT3 test case op-subtract-times-14 of test set op-subtract-times, which tests the XPath expression
#   (xs:time("13:00:00Z") - xs:time("17:00:00Z")) ne xs:dayTimeDuration("P10DT01H01M")
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#time> ( "13:00:00Z" ) - <http://www.w3.org/2001/XMLSchema#time> ( "17:00:00Z" ) ) != <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P10DT01H01M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
