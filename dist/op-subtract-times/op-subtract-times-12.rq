# QT3 test case op-subtract-times-12 of test set op-subtract-times, which tests the XPath expression
#   fn:string((xs:time("17:00:00Z") - xs:time("13:00:00Z"))) and (fn:true())
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#time> ( "17:00:00Z" ) - <http://www.w3.org/2001/XMLSchema#time> ( "13:00:00Z" ) ) ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
