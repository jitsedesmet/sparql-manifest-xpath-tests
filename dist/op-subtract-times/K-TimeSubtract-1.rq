# QT3 test case K-TimeSubtract-1 of test set op-subtract-times, which tests the XPath expression
#   xs:time("08:12:32") - xs:time("18:12:32") eq xs:dayTimeDuration("-PT10H")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-times.xml#L357
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#time> ( "08:12:32" ) - <http://www.w3.org/2001/XMLSchema#time> ( "18:12:32" ) ) = <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "-PT10H" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
