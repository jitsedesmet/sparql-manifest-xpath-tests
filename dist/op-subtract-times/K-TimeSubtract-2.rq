# QT3 test case K-TimeSubtract-2 of test set op-subtract-times, which tests the XPath expression
#   xs:time("08:12:32") - xs:time("08:12:32") eq xs:dayTimeDuration("PT0S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-times.xml#L372
# The test needs the constructor function xsd:time, - on xsd:time, the constructor function xsd:dayTimeDuration, = on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#time> ( "08:12:32" ) - <http://www.w3.org/2001/XMLSchema#time> ( "08:12:32" ) ) = <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "PT0S" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
