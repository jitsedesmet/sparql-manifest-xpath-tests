# QT3 test case Parenexpr-3 of test set prod-ParenthesizedExpr, which tests the XPath expression
#   -(2 + 5)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/ParenthesizedExpr.xml#L42
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(- ( "2"^^xsd:integer + "5"^^xsd:integer ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-7"^^xsd:integer ) ))
}
