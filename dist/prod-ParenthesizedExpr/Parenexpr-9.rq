# QT3 test case Parenexpr-9 of test set prod-ParenthesizedExpr, which tests the XPath expression
#   (fn:true() or fn:true()) and fn:false()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/ParenthesizedExpr.xml#L96
ASK {
  BIND(( ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> || "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) && "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
