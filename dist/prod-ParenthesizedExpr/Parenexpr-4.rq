# QT3 test case Parenexpr-4 of test set prod-ParenthesizedExpr, which tests the XPath expression
#   (-2) + 5
ASK {
  BIND(( - "2"^^<http://www.w3.org/2001/XMLSchema#integer> + "5"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ?result = "3"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
