# QT3 test case Parenexpr-13 of test set prod-ParenthesizedExpr, which tests the XPath expression
#   (1)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/ParenthesizedExpr.xml#L133
ASK {
  BIND("1"^^<http://www.w3.org/2001/XMLSchema#integer> AS ?result)
  FILTER(( ?result = "1"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
