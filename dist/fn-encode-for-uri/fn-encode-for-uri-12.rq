# QT3 test case fn-encode-for-uri-12 of test set fn-encode-for-uri, which tests the XPath expression
#   (fn:encode-for-uri("examples0123456789example"))
ASK {
  BIND(ENCODE_FOR_URI( "examples0123456789example" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "examples0123456789example" ))
}
