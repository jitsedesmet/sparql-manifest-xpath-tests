# QT3 test case fn-encode-for-uri1args-3 of test set fn-encode-for-uri, which tests the XPath expression
#   encode-for-uri("100% organic")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/encode-for-uri.xml#L25
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ENCODE_FOR_URI( "100% organic" ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "100%25%20organic" ))
}
