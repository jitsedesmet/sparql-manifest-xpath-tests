# QT3 test case fn-encode-for-uri1args-4 of test set fn-encode-for-uri, which tests the XPath expression
#   encode-for-uri('')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/encode-for-uri.xml#L34
ASK {
  BIND(ENCODE_FOR_URI( "" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "" ))
}
