# QT3 test case fn-encode-for-uri-16 of test set fn-encode-for-uri, which tests the XPath expression
#   (fn:encode-for-uri("http%20examples"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/encode-for-uri.xml#L205
ASK {
  BIND(ENCODE_FOR_URI( "http%20examples" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "http%2520examples" ))
}
