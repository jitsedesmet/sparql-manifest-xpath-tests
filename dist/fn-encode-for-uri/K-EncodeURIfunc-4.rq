# QT3 test case K-EncodeURIfunc-4 of test set fn-encode-for-uri, which tests the XPath expression
#   concat("http://www.example.com/", encode-for-uri("~bébé")) eq "http://www.example.com/~b%C3%A9b%C3%A9"
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/encode-for-uri.xml#L241
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( CONCAT( xsd:string ( "http://www.example.com/" ) , xsd:string ( ENCODE_FOR_URI( "~bébé" ) ) ) = "http://www.example.com/~b%C3%A9b%C3%A9" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
