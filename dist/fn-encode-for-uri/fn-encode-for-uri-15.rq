# QT3 test case fn-encode-for-uri-15 of test set fn-encode-for-uri, which tests the XPath expression
#   (fn:encode-for-uri("http:examples"))
# Expecting:
#   <assert-string-value>http%3Aexamples</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/encode-for-uri.xml#L196
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ENCODE_FOR_URI( "http:examples" ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "http%3Aexamples" ))
}
