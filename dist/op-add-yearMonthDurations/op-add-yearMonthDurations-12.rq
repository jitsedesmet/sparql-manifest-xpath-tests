# QT3 test case op-add-yearMonthDurations-12 of test set op-add-yearMonthDurations, which tests the XPath expression
#   fn:string((xs:yearMonthDuration("P10Y11M") + xs:yearMonthDuration("P05Y07M"))) and (fn:true())
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDurations.xml#L279
# The test needs the constructor function xsd:yearMonthDuration, + on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:yearMonthDuration ( "P10Y11M" ) + xsd:yearMonthDuration ( "P05Y07M" ) ) ) && "true"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
