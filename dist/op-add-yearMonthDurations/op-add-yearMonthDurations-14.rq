# QT3 test case op-add-yearMonthDurations-14 of test set op-add-yearMonthDurations, which tests the XPath expression
#   (xs:yearMonthDuration("P21Y12M") + xs:yearMonthDuration("P08Y05M")) ne xs:yearMonthDuration("P08Y05M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDurations.xml#L312
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P21Y12M" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P08Y05M" ) ) != <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P08Y05M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
