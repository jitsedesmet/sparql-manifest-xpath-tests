# QT3 test case op-add-yearMonthDurations-11 of test set op-add-yearMonthDurations, which tests the XPath expression
#   (xs:yearMonthDuration("P42Y10M") + xs:yearMonthDuration("P28Y10M")) div (xs:yearMonthDuration("P10Y10M") + xs:yearMonthDuration("P60Y10M"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDurations.xml#L263
# The test needs the constructor function xsd:yearMonthDuration, + on xsd:yearMonthDuration, which SPARQL does not define
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P42Y10M" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P28Y10M" ) ) / ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P10Y10M" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P60Y10M" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1" ))
}
