# QT3 test case op-add-yearMonthDurations-1 of test set op-add-yearMonthDurations, which tests the XPath expression
#   xs:yearMonthDuration("P2Y11M") + xs:yearMonthDuration("P3Y3M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P2Y11M" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P3Y3M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "P6Y2M" ))
}
