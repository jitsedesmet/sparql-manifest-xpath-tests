# QT3 test case op-add-yearMonthDurations-16 of test set op-add-yearMonthDurations, which tests the XPath expression
#   (xs:yearMonthDuration("P13Y09M") + xs:yearMonthDuration("P18Y02M")) ge xs:yearMonthDuration("P18Y02M")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDurations.xml#L344
# The test needs the constructor function xsd:yearMonthDuration, + on xsd:yearMonthDuration, >= on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:yearMonthDuration ( "P13Y09M" ) + xsd:yearMonthDuration ( "P18Y02M" ) ) >= xsd:yearMonthDuration ( "P18Y02M" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
