# QT3 test case K-YearMonthDurationAdd-3 of test set op-add-yearMonthDurations, which tests the XPath expression
#   xs:yearMonthDuration("P32Y43M") + xs:yearMonthDuration("P12Y13M") eq xs:yearMonthDuration("P48Y8M")
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P32Y43M" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P12Y13M" ) ) = <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P48Y8M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
