# QT3 test case op-add-yearMonthDurations-9 of test set op-add-yearMonthDurations, which tests the XPath expression
#   fn:string((xs:yearMonthDuration("P01Y01M") + xs:yearMonthDuration("P02Y02M"))) and fn:string((xs:yearMonthDuration("P02Y03M") + xs:yearMonthDuration("P04Y04M")))
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P01Y01M" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P02Y02M" ) ) ) && <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P02Y03M" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P04Y04M" ) ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
