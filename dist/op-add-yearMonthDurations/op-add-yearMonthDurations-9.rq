# QT3 test case op-add-yearMonthDurations-9 of test set op-add-yearMonthDurations, which tests the XPath expression
#   fn:string((xs:yearMonthDuration("P01Y01M") + xs:yearMonthDuration("P02Y02M"))) and fn:string((xs:yearMonthDuration("P02Y03M") + xs:yearMonthDuration("P04Y04M")))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDurations.xml#L229
# The test needs the constructor function xsd:yearMonthDuration, + on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:yearMonthDuration ( "P01Y01M" ) + xsd:yearMonthDuration ( "P02Y02M" ) ) ) && xsd:string ( ( xsd:yearMonthDuration ( "P02Y03M" ) + xsd:yearMonthDuration ( "P04Y04M" ) ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
