# QT3 test case op-add-yearMonthDurations-13 of test set op-add-yearMonthDurations, which tests the XPath expression
#   (xs:yearMonthDuration("P23Y11M") + xs:yearMonthDuration("P23Y11M")) eq xs:yearMonthDuration("P23Y11M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDurations.xml#L296
# The test needs the constructor function xsd:yearMonthDuration, + on xsd:yearMonthDuration, = on xsd:yearMonthDuration, which SPARQL does not define
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P23Y11M" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P23Y11M" ) ) = <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P23Y11M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
