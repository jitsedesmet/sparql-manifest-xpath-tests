# QT3 test case op-add-yearMonthDurations-4 of test set op-add-yearMonthDurations, which tests the XPath expression
#   fn:not(fn:string(xs:yearMonthDuration("P11Y04M") + xs:yearMonthDuration("P02Y11M")))
ASK {
  BIND(! <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P11Y04M" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P02Y11M" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
