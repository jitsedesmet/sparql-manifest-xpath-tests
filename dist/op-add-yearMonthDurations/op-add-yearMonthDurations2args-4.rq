# QT3 test case op-add-yearMonthDurations2args-4 of test set op-add-yearMonthDurations, which tests the XPath expression
#   xs:yearMonthDuration("P0Y0M") + xs:yearMonthDuration("P1000Y6M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDurations.xml#L61
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P0Y0M" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1000Y6M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "P1000Y6M" ))
}
