# QT3 test case op-add-yearMonthDurations-15 of test set op-add-yearMonthDurations, which tests the XPath expression
#   (xs:yearMonthDuration("P10Y01M") + xs:yearMonthDuration("P17Y02M")) le xs:yearMonthDuration("P17Y02M")
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P10Y01M" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P17Y02M" ) ) <= <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P17Y02M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
