# QT3 test case op-add-yearMonthDurations2args-5 of test set op-add-yearMonthDurations, which tests the XPath expression
#   xs:yearMonthDuration("P0Y0M") + xs:yearMonthDuration("P2030Y12M")
# Expecting:
#   <assert-string-value>P2031Y</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDurations.xml#L79
# The test needs the constructor function xsd:yearMonthDuration, + on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:yearMonthDuration ( "P0Y0M" ) + xsd:yearMonthDuration ( "P2030Y12M" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "P2031Y" ))
}
