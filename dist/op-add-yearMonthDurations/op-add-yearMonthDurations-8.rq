# QT3 test case op-add-yearMonthDurations-8 of test set op-add-yearMonthDurations, which tests the XPath expression
#   (xs:yearMonthDuration("P10Y01M") + xs:yearMonthDuration("-P11Y02M"))
# Expecting:
#   <assert-string-value>-P1Y1M</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDurations.xml#L213
# The test needs the constructor function xsd:yearMonthDuration, + on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:yearMonthDuration ( "P10Y01M" ) + xsd:yearMonthDuration ( "-P11Y02M" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-P1Y1M" ))
}
