# QT3 test case K-YearMonthDurationAdd-1 of test set op-add-yearMonthDurations, which tests the XPath expression
#   xs:yearMonthDuration("P3Y3M") + xs:yearMonthDuration("P0M") eq xs:yearMonthDuration("P3Y3M")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDurations.xml#L360
# The test needs the constructor function xsd:yearMonthDuration, + on xsd:yearMonthDuration, = on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:yearMonthDuration ( "P3Y3M" ) + xsd:yearMonthDuration ( "P0M" ) ) = xsd:yearMonthDuration ( "P3Y3M" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
