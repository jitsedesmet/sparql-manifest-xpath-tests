# QT3 test case K-DayTimeDurationLT-3 of test set op-dayTimeDuration-less-than, which tests the XPath expression
#   not(xs:dayTimeDuration("P3DT08H34M12.144S") lt xs:dayTimeDuration("P3DT08H34M12.143S"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P3DT08H34M12.144S" ) < <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P3DT08H34M12.143S" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
