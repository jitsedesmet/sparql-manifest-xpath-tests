# QT3 test case K-DayTimeDurationLT-3 of test set op-dayTimeDuration-less-than, which tests the XPath expression
#   not(xs:dayTimeDuration("P3DT08H34M12.144S") lt xs:dayTimeDuration("P3DT08H34M12.143S"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dayTimeDuration-less-than.xml#L409
# The test needs the constructor function xsd:dayTimeDuration, < on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( xsd:dayTimeDuration ( "P3DT08H34M12.144S" ) < xsd:dayTimeDuration ( "P3DT08H34M12.143S" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
