# QT3 test case op-dayTimeDuration-less-than2args-10 of test set op-dayTimeDuration-less-than, which tests the XPath expression
#   xs:dayTimeDuration("P0DT0H0M0S") ge xs:dayTimeDuration("P31DT23H59M59S")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dayTimeDuration-less-than.xml#L169
# The test needs the constructor function xsd:dayTimeDuration, >= on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:dayTimeDuration ( "P0DT0H0M0S" ) >= xsd:dayTimeDuration ( "P31DT23H59M59S" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
