# QT3 test case op-dayTimeDuration-less-than-11 of test set op-dayTimeDuration-less-than, which tests the XPath expression
#   (xs:dayTimeDuration("P10DT02H") lt xs:dayTimeDuration("P01DT10H")) or (fn:true())
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dayTimeDuration-less-than.xml#L315
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P10DT02H" ) < <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P01DT10H" ) ) || "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
