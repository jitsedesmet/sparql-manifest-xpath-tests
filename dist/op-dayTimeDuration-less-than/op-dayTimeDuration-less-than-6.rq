# QT3 test case op-dayTimeDuration-less-than-6 of test set op-dayTimeDuration-less-than, which tests the XPath expression
#   fn:not(xs:dayTimeDuration("P10DT09H") le xs:dayTimeDuration("P09DT09H"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P10DT09H" ) <= <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P09DT09H" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
