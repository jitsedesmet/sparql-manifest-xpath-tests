# QT3 test case op-dayTimeDuration-less-than2args-2 of test set op-dayTimeDuration-less-than, which tests the XPath expression
#   xs:dayTimeDuration("P15DT11H59M59S") lt xs:dayTimeDuration("P0DT0H0M0S")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P15DT11H59M59S" ) < <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P0DT0H0M0S" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
