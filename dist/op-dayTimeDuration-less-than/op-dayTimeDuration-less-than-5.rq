# QT3 test case op-dayTimeDuration-less-than-5 of test set op-dayTimeDuration-less-than, which tests the XPath expression
#   fn:not(xs:dayTimeDuration("P10DT10H") lt xs:dayTimeDuration("P9DT09H"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dayTimeDuration-less-than.xml#L219
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P10DT10H" ) < <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P9DT09H" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
