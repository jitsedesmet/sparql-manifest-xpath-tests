# QT3 test case op-dayTimeDuration-less-than-7 of test set op-dayTimeDuration-less-than, which tests the XPath expression
#   (xs:dayTimeDuration("P10DT09H") lt xs:dayTimeDuration("P09DT10H")) and (xs:dayTimeDuration("P10DT01H") lt xs:dayTimeDuration("P08DT06H"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dayTimeDuration-less-than.xml#L251
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P10DT09H" ) < <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P09DT10H" ) ) && ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P10DT01H" ) < <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P08DT06H" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
