# QT3 test case op-boolean-less-than-more-args-007 of test set op-boolean-less-than, which tests the XPath expression
#   xs:boolean("false") lt xs:boolean("true")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) < <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
