# QT3 test case op-boolean-less-than-10 of test set op-boolean-less-than, which tests the XPath expression
#   (7 eq 7) ge xs:boolean("true")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-less-than.xml#L339
ASK {
  BIND(( ( "7"^^<http://www.w3.org/2001/XMLSchema#integer> = "7"^^<http://www.w3.org/2001/XMLSchema#integer> ) >= <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
