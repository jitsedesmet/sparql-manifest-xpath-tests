# QT3 test case op-boolean-less-than-more-args-014 of test set op-boolean-less-than, which tests the XPath expression
#   xs:boolean("false") ge xs:boolean("true")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) >= <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
