# QT3 test case K-BooleanLT-2 of test set op-boolean-less-than, which tests the XPath expression
#   false() le true()
ASK {
  BIND(( "false"^^<http://www.w3.org/2001/XMLSchema#boolean> <= "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
