# QT3 test case op-boolean-less-than2args-5 of test set op-boolean-less-than, which tests the XPath expression
#   xs:boolean("false") lt xs:boolean("0")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-less-than.xml#L78
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:boolean ( "false" ) < xsd:boolean ( "0" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
