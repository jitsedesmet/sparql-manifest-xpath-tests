# QT3 test case op-boolean-less-than-3 of test set op-boolean-less-than, which tests the XPath expression
#   fn:not(xs:boolean("true")) lt xs:boolean("false")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-less-than.xml#L220
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ! xsd:boolean ( "true" ) < xsd:boolean ( "false" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
