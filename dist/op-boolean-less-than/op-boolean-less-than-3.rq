# QT3 test case op-boolean-less-than-3 of test set op-boolean-less-than, which tests the XPath expression
#   fn:not(xs:boolean("true")) lt xs:boolean("false")
ASK {
  BIND(( ! <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) < <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
