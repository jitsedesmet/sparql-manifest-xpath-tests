# QT3 test case op-boolean-less-than-2 of test set op-boolean-less-than, which tests the XPath expression
#   fn:not(xs:boolean("true")) ge xs:boolean("true")
ASK {
  BIND(( ! <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) >= <http://www.w3.org/2001/XMLSchema#boolean> ( "true" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
