# QT3 test case K-BooleanLT-3 of test set op-boolean-less-than, which tests the XPath expression
#   true() le true()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-less-than.xml#L630
ASK {
  BIND(( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> <= "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
