# QT3 test case op-boolean-less-than2args-4 of test set op-boolean-less-than, which tests the XPath expression
#   xs:boolean("false") lt xs:boolean("1")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-less-than.xml#L60
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#boolean> ( "false" ) < <http://www.w3.org/2001/XMLSchema#boolean> ( "1" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
