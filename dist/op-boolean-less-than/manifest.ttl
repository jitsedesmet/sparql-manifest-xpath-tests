<#op-boolean-less-than2args-1> a mf:QueryEvaluationTest ;
  mf:name "op-boolean-less-than2args-1" ;
  rdfs:comment "*******************************************************\nTest: op-boolean-less-than2args-1                       \nWritten By: Carmelo Montanez                            \nDate: Thu Dec 16 10:48:17 GMT-05:00 2004                \nPurpose: Evaluates The \"op:boolean-less-than\" operator \n with the arguments set as follows:                    \n$arg1 = xs:boolean(lower bound)                        \n$arg2 = xs:boolean(lower bound)                        \n*******************************************************" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/boolean-less-than.xml> ;
  mf:action [ qt:query <op-boolean-less-than2args-1.rq> ] ;
  mf:result <../true.srj> .

