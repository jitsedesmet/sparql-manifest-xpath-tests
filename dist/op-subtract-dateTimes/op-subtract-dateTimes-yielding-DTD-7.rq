# QT3 test case op-subtract-dateTimes-yielding-DTD-7 of test set op-subtract-dateTimes, which tests the XPath expression
#   fn:string(xs:dateTime("1989-07-05T02:02:02Z") - xs:dateTime("1988-01-28T03:03:03Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dateTimes.xml#L101
# The test needs - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( ( xsd:dateTime ( "1989-07-05T02:02:02Z" ) - xsd:dateTime ( "1988-01-28T03:03:03Z" ) ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "P523DT22H58M59S" ))
}
