# QT3 test case K-dateTimesSubtract-2 of test set op-subtract-dateTimes, which tests the XPath expression
#   xs:dateTime("1999-10-12T08:01:23") + xs:dateTime("1999-10-12T08:01:23")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dateTimes.xml#L337
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-10-12T08:01:23" ) + <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-10-12T08:01:23" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
