# QT3 test case K-dateTimesSubtract-1 of test set op-subtract-dateTimes, which tests the XPath expression
#   xs:dateTime("1999-07-19T08:23:12.765") - xs:dateTime("1999-07-19T08:23:12.765") eq xs:dayTimeDuration("PT0S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dateTimes.xml#L322
# The test needs - on xsd:dateTime, the constructor function xsd:dayTimeDuration, = on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-07-19T08:23:12.765" ) - <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-07-19T08:23:12.765" ) ) = <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "PT0S" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
