# QT3 test case op-subtract-dateTimes-yielding-DTD-12 of test set op-subtract-dateTimes, which tests the XPath expression
#   fn:string((xs:dateTime("1980-03-02T11:11:11Z") - xs:dateTime("1981-12-12T12:12:12Z"))) and (fn:true())
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1980-03-02T11:11:11Z" ) - <http://www.w3.org/2001/XMLSchema#dateTime> ( "1981-12-12T12:12:12Z" ) ) ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
