# QT3 test case op-subtract-dateTimes-yielding-DTD-12 of test set op-subtract-dateTimes, which tests the XPath expression
#   fn:string((xs:dateTime("1980-03-02T11:11:11Z") - xs:dateTime("1981-12-12T12:12:12Z"))) and (fn:true())
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dateTimes.xml#L181
# The test needs - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:dateTime ( "1980-03-02T11:11:11Z" ) - xsd:dateTime ( "1981-12-12T12:12:12Z" ) ) ) && "true"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
