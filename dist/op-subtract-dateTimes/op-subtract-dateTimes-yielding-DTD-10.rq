# QT3 test case op-subtract-dateTimes-yielding-DTD-10 of test set op-subtract-dateTimes, which tests the XPath expression
#   fn:string((xs:dateTime("1985-07-05T07:07:07Z") - xs:dateTime("1984-07-05T08:08:08Z"))) or fn:string((xs:dateTime("1985-07-05T09:09:09Z") - xs:dateTime("1984-07-05T10:10:10Z")))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dateTimes.xml#L149
# The test needs - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:dateTime ( "1985-07-05T07:07:07Z" ) - xsd:dateTime ( "1984-07-05T08:08:08Z" ) ) ) || xsd:string ( ( xsd:dateTime ( "1985-07-05T09:09:09Z" ) - xsd:dateTime ( "1984-07-05T10:10:10Z" ) ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
