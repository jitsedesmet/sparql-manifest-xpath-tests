<#op-subtract-dateTimes-yielding-DTD-1> a mf:QueryEvaluationTest ;
  mf:name "op-subtract-dateTimes-yielding-DTD-1" ;
  rdfs:comment "*******************************************************\nTest: op-subtract-dateTimes-yielding-DTD-1             \nWritten By: Carmelo Montanez                           \nDate: July 6, 2005                                     \nPurpose: Evaluates The \"subtract-dateTimes-yielding-DTD\" operator \nAs per example 1 (for this function)of the F&O specs.  \n*******************************************************" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dateTimes.xml> ;
  mf:action [ qt:query <op-subtract-dateTimes-yielding-DTD-1.rq> ] ;
  mf:result <../true.srj> .

