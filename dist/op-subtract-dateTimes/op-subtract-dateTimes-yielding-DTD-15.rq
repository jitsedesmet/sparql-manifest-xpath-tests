# QT3 test case op-subtract-dateTimes-yielding-DTD-15 of test set op-subtract-dateTimes, which tests the XPath expression
#   fn:string((xs:dateTime("1978-12-12T10:09:08Z") - xs:dateTime("1977-12-12T09:08:07Z"))) le xs:string(xs:dayTimeDuration("P17DT10H02M"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dateTimes.xml#L229
# The test needs - on xsd:dateTime, the constructor function xsd:dayTimeDuration, xsd:string on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:dateTime ( "1978-12-12T10:09:08Z" ) - xsd:dateTime ( "1977-12-12T09:08:07Z" ) ) ) <= xsd:string ( xsd:dayTimeDuration ( "P17DT10H02M" ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
