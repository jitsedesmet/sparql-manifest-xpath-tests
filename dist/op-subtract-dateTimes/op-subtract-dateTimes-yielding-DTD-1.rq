# QT3 test case op-subtract-dateTimes-yielding-DTD-1 of test set op-subtract-dateTimes, which tests the XPath expression
#   xs:dateTime("2000-10-30T06:12:00-05:00") - xs:dateTime("1999-11-28T09:00:00Z")
# Expecting:
#   <assert-string-value>P337DT2H12M</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dateTimes.xml#L6
# The test needs - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:dateTime ( "2000-10-30T06:12:00-05:00" ) - xsd:dateTime ( "1999-11-28T09:00:00Z" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "P337DT2H12M" ))
}
