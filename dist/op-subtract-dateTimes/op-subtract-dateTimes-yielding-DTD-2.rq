# QT3 test case op-subtract-dateTimes-yielding-DTD-2 of test set op-subtract-dateTimes, which tests the XPath expression
#   xs:dateTime("2000-12-12T09:08:07+05:00") - xs:dateTime("1999-12-12T09:08:07+05:00")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2000-12-12T09:08:07+05:00" ) - <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-12-12T09:08:07+05:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "P366D" ))
}
