# QT3 test case op-subtract-dateTimes-yielding-DTD-2 of test set op-subtract-dateTimes, which tests the XPath expression
#   xs:dateTime("2000-12-12T09:08:07+05:00") - xs:dateTime("1999-12-12T09:08:07+05:00")
# Expecting:
#   <assert-string-value>P366D</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dateTimes.xml#L22
# The test needs - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:dateTime ( "2000-12-12T09:08:07+05:00" ) - xsd:dateTime ( "1999-12-12T09:08:07+05:00" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "P366D" ))
}
