# QT3 test case op-subtract-dateTimes-yielding-DTD-18 of test set op-subtract-dateTimes, which tests the XPath expression
#   fn:string((xs:dateTime("1999-10-23T03:02:01Z") - xs:dateTime("1998-09-09T04:04:05Z"))) or fn:false()
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-10-23T03:02:01Z" ) - <http://www.w3.org/2001/XMLSchema#dateTime> ( "1998-09-09T04:04:05Z" ) ) ) || "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
