# QT3 test case op-subtract-dateTimes-yielding-DTD-17 of test set op-subtract-dateTimes, which tests the XPath expression
#   fn:string(xs:dateTime("2000-12-12T12:07:08Z") - xs:dateTime("1999-12-12T13:08:09Z")) and fn:false()
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2000-12-12T12:07:08Z" ) - <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-12-12T13:08:09Z" ) ) ) && "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
