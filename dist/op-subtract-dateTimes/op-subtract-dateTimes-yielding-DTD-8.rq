# QT3 test case op-subtract-dateTimes-yielding-DTD-8 of test set op-subtract-dateTimes, which tests the XPath expression
#   xs:dateTime("0001-01-01T01:01:01Z") - xs:dateTime("2005-07-06T12:12:12Z")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "0001-01-01T01:01:01Z" ) - <http://www.w3.org/2001/XMLSchema#dateTime> ( "2005-07-06T12:12:12Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-P732132DT11H11M11S" ))
}
