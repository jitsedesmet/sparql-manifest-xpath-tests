# QT3 test case op-subtract-dateTimes-yielding-DTD-8 of test set op-subtract-dateTimes, which tests the XPath expression
#   xs:dateTime("0001-01-01T01:01:01Z") - xs:dateTime("2005-07-06T12:12:12Z")
# Expecting:
#   <assert-string-value>-P732132DT11H11M11S</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dateTimes.xml#L117
# The test needs - on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:dateTime ( "0001-01-01T01:01:01Z" ) - xsd:dateTime ( "2005-07-06T12:12:12Z" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-P732132DT11H11M11S" ))
}
