  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-time.xml> ;
  mf:action [ qt:query <K2-TimeAddDTD-1.rq> ] ;
  mf:result <../true.srj> .
