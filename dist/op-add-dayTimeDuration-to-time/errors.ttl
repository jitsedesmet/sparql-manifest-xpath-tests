<> a mf:Manifest ;
  rdfs:label "QT3 test set op-add-dayTimeDuration-to-time" ;
  mf:entries (
    <#K2-TimeAddDTD-1>
  ) .

<#K2-TimeAddDTD-1> a mf:QueryEvaluationTest ;
  mf:name "K2-TimeAddDTD-1" ;
