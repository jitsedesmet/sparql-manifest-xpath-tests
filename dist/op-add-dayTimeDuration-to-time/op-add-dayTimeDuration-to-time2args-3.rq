# QT3 test case op-add-dayTimeDuration-to-time2args-3 of test set op-add-dayTimeDuration-to-time, which tests the XPath expression
#   xs:time("23:59:59Z") + xs:dayTimeDuration("P0DT0H0M0S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-time.xml#L43
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "23:59:59Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P0DT0H0M0S" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "23:59:59Z" ))
}
