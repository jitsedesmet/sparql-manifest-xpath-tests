# QT3 test case K2-TimeAddDTD-1 of test set op-add-dayTimeDuration-to-time, which tests the XPath expression
#   xs:time("10:10:10") + xs:time("23:10:10")
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-time.xml#L389
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:time ( "10:10:10" ) + xsd:time ( "23:10:10" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
