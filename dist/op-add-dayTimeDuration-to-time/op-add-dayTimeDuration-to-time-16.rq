# QT3 test case op-add-dayTimeDuration-to-time-16 of test set op-add-dayTimeDuration-to-time, which tests the XPath expression
#   (xs:time("09:06:07Z") + xs:dayTimeDuration("P18DT02H02M")) ge xs:time("01:01:01Z")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-time.xml#L326
# The test needs the constructor function xsd:time, the constructor function xsd:dayTimeDuration, + on xsd:time, + on xsd:dayTimeDuration, >= on xsd:time, which SPARQL does not define
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#time> ( "09:06:07Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P18DT02H02M" ) ) >= <http://www.w3.org/2001/XMLSchema#time> ( "01:01:01Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
