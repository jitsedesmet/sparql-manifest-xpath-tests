# QT3 test case op-add-dayTimeDuration-to-time2args-4 of test set op-add-dayTimeDuration-to-time, which tests the XPath expression
#   xs:time("00:00:00Z") + xs:dayTimeDuration("P15DT11H59M59S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-time.xml#L61
# The test needs the constructor function xsd:time, the constructor function xsd:dayTimeDuration, + on xsd:time, + on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "00:00:00Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P15DT11H59M59S" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "11:59:59Z" ))
}
