# QT3 test case op-add-dayTimeDuration-to-time2args-2 of test set op-add-dayTimeDuration-to-time, which tests the XPath expression
#   xs:time("08:03:35Z") + xs:dayTimeDuration("P0DT0H0M0S")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "08:03:35Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P0DT0H0M0S" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "08:03:35Z" ))
}
