# QT3 test case op-add-dayTimeDuration-to-time2args-5 of test set op-add-dayTimeDuration-to-time, which tests the XPath expression
#   xs:time("00:00:00Z") + xs:dayTimeDuration("P31DT23H59M59S")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "00:00:00Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P31DT23H59M59S" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "23:59:59Z" ))
}
