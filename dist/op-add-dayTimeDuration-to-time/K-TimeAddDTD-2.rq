# QT3 test case K-TimeAddDTD-2 of test set op-add-dayTimeDuration-to-time, which tests the XPath expression
#   xs:dayTimeDuration("P23DT09H32M59S") + xs:time("08:12:32") eq xs:time("17:45:31")
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P23DT09H32M59S" ) + <http://www.w3.org/2001/XMLSchema#time> ( "08:12:32" ) ) = <http://www.w3.org/2001/XMLSchema#time> ( "17:45:31" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
