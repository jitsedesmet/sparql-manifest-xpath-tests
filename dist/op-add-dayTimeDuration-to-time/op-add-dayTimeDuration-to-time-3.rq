# QT3 test case op-add-dayTimeDuration-to-time-3 of test set op-add-dayTimeDuration-to-time, which tests the XPath expression
#   fn:string((xs:time("12:12:01Z") + xs:dayTimeDuration("P19DT13H10M"))) or fn:false()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-time.xml#L129
# The test needs the constructor function xsd:time, the constructor function xsd:dayTimeDuration, + on xsd:time, + on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#time> ( "12:12:01Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P19DT13H10M" ) ) ) || "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
