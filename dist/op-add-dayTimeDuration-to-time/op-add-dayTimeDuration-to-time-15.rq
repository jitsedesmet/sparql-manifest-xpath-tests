# QT3 test case op-add-dayTimeDuration-to-time-15 of test set op-add-dayTimeDuration-to-time, which tests the XPath expression
#   (xs:time("08:09:09Z") + xs:dayTimeDuration("P17DT10H02M")) le xs:time("09:08:10Z")
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#time> ( "08:09:09Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P17DT10H02M" ) ) <= <http://www.w3.org/2001/XMLSchema#time> ( "09:08:10Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
