# QT3 test case op-add-dayTimeDuration-to-time-5 of test set op-add-dayTimeDuration-to-time, which tests the XPath expression
#   fn:boolean(fn:string(xs:time("02:02:02Z") + xs:dayTimeDuration("P03DT08H06M")))
ASK {
  BIND(!( ! <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#time> ( "02:02:02Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P03DT08H06M" ) ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
