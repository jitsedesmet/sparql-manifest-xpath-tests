# QT3 test case K-TimeAddDTD-1 of test set op-add-dayTimeDuration-to-time, which tests the XPath expression
#   xs:time("08:12:32") + xs:dayTimeDuration("P23DT09H32M59S") eq xs:time("17:45:31")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-time.xml#L359
# The test needs the constructor function xsd:time, the constructor function xsd:dayTimeDuration, + on xsd:time, + on xsd:dayTimeDuration, = on xsd:time, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:time ( "08:12:32" ) + xsd:dayTimeDuration ( "P23DT09H32M59S" ) ) = xsd:time ( "17:45:31" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
