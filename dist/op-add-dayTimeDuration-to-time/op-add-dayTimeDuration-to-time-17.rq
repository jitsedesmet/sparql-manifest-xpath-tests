# QT3 test case op-add-dayTimeDuration-to-time-17 of test set op-add-dayTimeDuration-to-time, which tests the XPath expression
#   fn:string(xs:time("12:07:08Z") + xs:dayTimeDuration("P12DT10H07M")) and fn:false()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-time.xml#L342
# The test needs the constructor function xsd:time, the constructor function xsd:dayTimeDuration, + on xsd:time, + on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:time ( "12:07:08Z" ) + xsd:dayTimeDuration ( "P12DT10H07M" ) ) ) && "false"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
