# QT3 test case op-add-dayTimeDuration-to-time-4 of test set op-add-dayTimeDuration-to-time, which tests the XPath expression
#   fn:not(fn:string(xs:time("13:12:00Z") + xs:dayTimeDuration("P02DT07H01M")))
ASK {
  BIND(! <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#time> ( "13:12:00Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P02DT07H01M" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
