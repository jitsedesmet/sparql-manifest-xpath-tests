# QT3 test case fn-hours-from-time-11 of test set fn-hours-from-time, which tests the XPath expression
#   fn:hours-from-time(xs:time("22:00:00Z")) div fn:hours-from-time(xs:time("02:00:00Z"))
# Expecting:
#   <assert-string-value>11</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/hours-from-time.xml#L124
# The test needs the constructor function xsd:time, HOURS on xsd:time, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( HOURS( xsd:time ( "22:00:00Z" ) ) / HOURS( xsd:time ( "02:00:00Z" ) ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "11" ))
}
