# QT3 test case K-HoursFromTimeFunc-5 of test set fn-hours-from-time, which tests the XPath expression
#   hours-from-time(xs:time("23:11:12.43")) eq 23
ASK {
  BIND(( HOURS( <http://www.w3.org/2001/XMLSchema#time> ( "23:11:12.43" ) ) = "23"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
