# QT3 test case fn-hours-from-time-3 of test set fn-hours-from-time, which tests the XPath expression
#   fn:hours-from-time(xs:time("01:23:00+05:00"))
ASK {
  BIND(HOURS( <http://www.w3.org/2001/XMLSchema#time> ( "01:23:00+05:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1" ))
}
