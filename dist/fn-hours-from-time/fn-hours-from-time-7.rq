# QT3 test case fn-hours-from-time-7 of test set fn-hours-from-time, which tests the XPath expression
#   fn:hours-from-time(xs:time("23:20:00Z"))
ASK {
  BIND(HOURS( <http://www.w3.org/2001/XMLSchema#time> ( "23:20:00Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "23" ))
}
