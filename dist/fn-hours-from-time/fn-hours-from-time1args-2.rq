# QT3 test case fn-hours-from-time1args-2 of test set fn-hours-from-time, which tests the XPath expression
#   fn:hours-from-time(xs:time("08:03:35Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/hours-from-time.xml#L16
# The test needs the constructor function xsd:time, HOURS on xsd:time, which SPARQL does not define
ASK {
  BIND(HOURS( <http://www.w3.org/2001/XMLSchema#time> ( "08:03:35Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "8" ))
}
