# QT3 test case fn-hours-from-time-6 of test set fn-hours-from-time, which tests the XPath expression
#   fn:hours-from-time(xs:time("00:20:00Z"))
ASK {
  BIND(HOURS( <http://www.w3.org/2001/XMLSchema#time> ( "00:20:00Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0" ))
}
