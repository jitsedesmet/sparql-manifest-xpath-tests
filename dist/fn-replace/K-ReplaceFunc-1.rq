# QT3 test case K-ReplaceFunc-1 of test set fn-replace, which tests the XPath expression
#   replace("input", "pattern", "replacement", " ")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L646
ASK {
  BIND(REPLACE( "input" , "pattern" , "replacement" , " " ) AS ?result)
  FILTER(! BOUND( ?result ))
}
