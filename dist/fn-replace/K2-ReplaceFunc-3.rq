# QT3 test case K2-ReplaceFunc-3 of test set fn-replace, which tests the XPath expression
#   replace("abcd", "(a)\2(b)", "")
# Expecting:
#   <error code="FORX0002"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L745
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(REPLACE( "abcd" , "(a)\\2(b)" , "" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
