# QT3 test case fn-replace-4 of test set fn-replace, which tests the XPath expression
#   replace("abracadabra", "a", "")
# Expecting:
#   <assert-string-value>brcdbr</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L124
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(REPLACE( "abracadabra" , "a" , "" ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "brcdbr" ))
}
