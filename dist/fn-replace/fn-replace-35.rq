# QT3 test case fn-replace-35 of test set fn-replace, which tests the XPath expression
#   fn:replace("a?bracadabra?", "a?", "\$1", "q")
ASK {
  BIND(REPLACE( "a?bracadabra?" , "a?" , "\\$1" , "q" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "\\$1bracadabr\\$1" ))
}
