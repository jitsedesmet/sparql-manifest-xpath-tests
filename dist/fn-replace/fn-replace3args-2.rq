# QT3 test case fn-replace3args-2 of test set fn-replace, which tests the XPath expression
#   fn:replace("This is a characte","This is a characte","This is a characte")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L16
ASK {
  BIND(REPLACE( "This is a characte" , "This is a characte" , "This is a characte" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "This is a characte" ))
}
