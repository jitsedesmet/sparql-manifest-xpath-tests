# QT3 test case fn-replace-51 of test set fn-replace, which tests the XPath expression
#   fn:replace("a/b/c", "/", "$", "q")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L554
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(REPLACE( "a/b/c" , "/" , "$" , "q" ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "a$b$c" ))
}
