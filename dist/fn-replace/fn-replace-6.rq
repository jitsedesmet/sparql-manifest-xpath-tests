# QT3 test case fn-replace-6 of test set fn-replace, which tests the XPath expression
#   replace("abracadabra", ".*?", "$1")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L142
ASK {
  BIND(REPLACE( "abracadabra" , ".*?" , "$1" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
