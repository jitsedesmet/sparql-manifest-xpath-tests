# QT3 test case fn-replace-26 of test set fn-replace, which tests the XPath expression
#   fn:replace("abracadabra	abracadabra", "\t","with")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L322
ASK {
  BIND(REPLACE( "abracadabra\tabracadabra" , "\\t" , "with" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "abracadabrawithabracadabra" ))
}
