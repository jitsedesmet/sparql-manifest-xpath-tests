# QT3 test case fn-replaceErr-1 of test set fn-replace, which tests the XPath expression
#   fn:replace("abracadabra", "bra", "*", "p")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L70
ASK {
  BIND(REPLACE( "abracadabra" , "bra" , "*" , "p" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
