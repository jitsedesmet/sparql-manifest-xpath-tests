<#fn-replace3args-1> a mf:QueryEvaluationTest ;
  mf:name "fn-replace3args-1" ;
  rdfs:comment "Evaluates The \"replace\" function with the arguments set as follows: $input = xs:string(lower bound) $pattern = xs:string(lower bound) $replacement = xs:string(lower bound)" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml> ;
  mf:action [ qt:query <fn-replace3args-1.rq> ] ;
  mf:result <../true.srj> .

