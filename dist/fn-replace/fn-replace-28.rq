# QT3 test case fn-replace-28 of test set fn-replace, which tests the XPath expression
#   fn:replace("abracadabraabracadabra", "aa{1}","with")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L341
ASK {
  BIND(REPLACE( "abracadabraabracadabra" , "aa{1}" , "with" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "abracadabrwithbracadabra" ))
}
