# QT3 test case fn-replace-40 of test set fn-replace, which tests the XPath expression
#   fn:replace("abracadabra", "((((( ((((( (((((a))))) ))))) )))))", "|$1$15|", "x")
ASK {
  BIND(REPLACE( "abracadabra" , "((((( ((((( (((((a))))) ))))) )))))" , "|$1$15|" , "x" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "|aa|br|aa|c|aa|d|aa|br|aa|" ))
}
