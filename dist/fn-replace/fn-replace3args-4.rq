# QT3 test case fn-replace3args-4 of test set fn-replace, which tests the XPath expression
#   fn:replace("This is a characte","This is a characte","This is a characte")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L34
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(REPLACE( "This is a characte" , "This is a characte" , "This is a characte" ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "This is a characte" ))
}
