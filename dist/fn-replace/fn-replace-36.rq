# QT3 test case fn-replace-36 of test set fn-replace, which tests the XPath expression
#   fn:replace("abracadabra", "([aA])(?:br)([aA])", "$1**$2")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L415
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(REPLACE( "abracadabra" , "([aA])(?:br)([aA])" , "$1**$2" ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "a**acada**a" ))
}
