# QT3 test case K2-ReplaceFunc-2 of test set fn-replace, which tests the XPath expression
#   replace("a a a ", "(a )", "replacment: \1")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L736
ASK {
  BIND(REPLACE( "a a a " , "(a )" , "replacment: \\1" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
