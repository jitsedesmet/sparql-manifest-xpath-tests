# QT3 test case fn-replace-55 of test set fn-replace, which tests the XPath expression
#   replace('abcdefghijk', '(a)|(b)|(c)|(d)|(e)|(f)|(g)|(h)|(i)|(j)', '$1')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L594
ASK {
  BIND(REPLACE( "abcdefghijk" , "(a)|(b)|(c)|(d)|(e)|(f)|(g)|(h)|(i)|(j)" , "$1" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "ak" ))
}
