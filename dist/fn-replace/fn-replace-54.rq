# QT3 test case fn-replace-54 of test set fn-replace, which tests the XPath expression
#   fn:replace("abracadabra", "((((( ((((( (((((a))))) ))))) )))))", "$1$1", "x")
ASK {
  BIND(REPLACE( "abracadabra" , "((((( ((((( (((((a))))) ))))) )))))" , "$1$1" , "x" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "aabraacaadaabraa" ))
}
