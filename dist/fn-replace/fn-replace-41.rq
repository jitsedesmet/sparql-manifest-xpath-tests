# QT3 test case fn-replace-41 of test set fn-replace, which tests the XPath expression
#   fn:replace("abracadabra", "((((( ((((( (((((a))))) ))))) )))))", "$1520", "x")
ASK {
  BIND(REPLACE( "abracadabra" , "((((( ((((( (((((a))))) ))))) )))))" , "$1520" , "x" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "a20bra20ca20da20bra20" ))
}
