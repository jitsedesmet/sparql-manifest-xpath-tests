# QT3 test case fn-replace3args-7 of test set fn-replace, which tests the XPath expression
#   fn:replace(xs:string("This is a characte"),xs:string("This is a characte"),xs:string("This is a characte"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L61
ASK {
  BIND(REPLACE( <http://www.w3.org/2001/XMLSchema#string> ( "This is a characte" ) , <http://www.w3.org/2001/XMLSchema#string> ( "This is a characte" ) , <http://www.w3.org/2001/XMLSchema#string> ( "This is a characte" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "This is a characte" ))
}
