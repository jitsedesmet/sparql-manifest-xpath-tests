# QT3 test case fn-replace-47 of test set fn-replace, which tests the XPath expression
#   replace('abc', '^.+?(b+)?$', '$1')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L515
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(REPLACE( "abc" , "^.+?(b+)?$" , "$1" ) AS ?result)
  FILTER(( ( ( ( ( ( ( ( ( ( SAMETERM( DATATYPE( ?result ) , xsd:string ) || SAMETERM( DATATYPE( ?result ) , xsd:normalizedString ) ) || SAMETERM( DATATYPE( ?result ) , xsd:token ) ) || SAMETERM( DATATYPE( ?result ) , xsd:language ) ) || SAMETERM( DATATYPE( ?result ) , xsd:NMTOKEN ) ) || SAMETERM( DATATYPE( ?result ) , xsd:Name ) ) || SAMETERM( DATATYPE( ?result ) , xsd:NCName ) ) || SAMETERM( DATATYPE( ?result ) , xsd:ID ) ) || SAMETERM( DATATYPE( ?result ) , xsd:IDREF ) ) || SAMETERM( DATATYPE( ?result ) , xsd:ENTITY ) ) && SAMETERM( xsd:string ( ?result ) , "" ) ))
}
