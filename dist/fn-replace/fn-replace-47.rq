# QT3 test case fn-replace-47 of test set fn-replace, which tests the XPath expression
#   replace('abc', '^.+?(b+)?$', '$1')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L515
ASK {
  BIND(REPLACE( "abc" , "^.+?(b+)?$" , "$1" ) AS ?result)
  FILTER(( ?result = "" ))
}
