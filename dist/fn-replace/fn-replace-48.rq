# QT3 test case fn-replace-48 of test set fn-replace, which tests the XPath expression
#   replace('abcd', '^a(.).$|^a...$', '$1')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L524
ASK {
  BIND(REPLACE( "abcd" , "^a(.).$|^a...$" , "$1" ) AS ?result)
  FILTER(( ?result = "" ))
}
