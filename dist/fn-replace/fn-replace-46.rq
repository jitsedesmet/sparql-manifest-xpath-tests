# QT3 test case fn-replace-46 of test set fn-replace, which tests the XPath expression
#   replace("12-34", "^\d+(-(\d+))?$", "$2")
# Expecting:
#   <assert-eq>"34"</assert-eq>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L506
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(REPLACE( "12-34" , "^\\d+(-(\\d+))?$" , "$2" ) AS ?result)
  FILTER(SAMETERM( ?result , "34" ))
}
