# QT3 test case K-ReplaceFunc-6 of test set fn-replace, which tests the XPath expression
#   replace("input", "in", "thisIsInvalid\")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L691
ASK {
  BIND(REPLACE( "input" , "in" , "thisIsInvalid\\" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
