# QT3 test case fn-replace-52 of test set fn-replace, which tests the XPath expression
#   fn:replace("a/b/c", "/", "$'", "q")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L565
ASK {
  BIND(REPLACE( "a/b/c" , "/" , "$'" , "q" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "a$'b$'c" ))
}
