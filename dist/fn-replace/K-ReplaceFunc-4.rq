# QT3 test case K-ReplaceFunc-4 of test set fn-replace, which tests the XPath expression
#   replace("input", "pattern", "replacement", "X")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L673
ASK {
  BIND(REPLACE( "input" , "pattern" , "replacement" , "X" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
