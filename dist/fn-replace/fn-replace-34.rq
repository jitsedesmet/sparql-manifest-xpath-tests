# QT3 test case fn-replace-34 of test set fn-replace, which tests the XPath expression
#   fn:replace("abracadabra", "a", "$1", "q")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/replace.xml#L395
ASK {
  BIND(REPLACE( "abracadabra" , "a" , "$1" , "q" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "$1br$1c$1d$1br$1" ))
}
