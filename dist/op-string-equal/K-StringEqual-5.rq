# QT3 test case K-StringEqual-5 of test set op-string-equal, which tests the XPath expression
#   not('equal' ne 'equal')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/string-equal.xml#L43
ASK {
  BIND(! ( "equal" != "equal" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
