@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "QT3 test set op-string-equal" ;
  mf:entries (
    <#K-StringEqual-1>
    <#K-StringEqual-2>
    <#K-StringEqual-3>
    <#K-StringEqual-4>
    <#K-StringEqual-5>
  ) .

<#K-StringEqual-1> a mf:QueryEvaluationTest ;
  mf:name "K-StringEqual-1" ;
  rdfs:comment "A test whose essence is: `'equals' eq 'equals'`." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/string-equal.xml> ;
  mf:action [ qt:query <K-StringEqual-1.rq> ] ;
  mf:result <../true.srj> .

<#K-StringEqual-2> a mf:QueryEvaluationTest ;
  mf:name "K-StringEqual-2" ;
  rdfs:comment "A test whose essence is: `'' eq ''`." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/string-equal.xml> ;
  mf:action [ qt:query <K-StringEqual-2.rq> ] ;
  mf:result <../true.srj> .

<#K-StringEqual-3> a mf:QueryEvaluationTest ;
  mf:name "K-StringEqual-3" ;
  rdfs:comment "A test whose essence is: `not('nada' eq 'equalness')`." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/string-equal.xml> ;
  mf:action [ qt:query <K-StringEqual-3.rq> ] ;
  mf:result <../true.srj> .

<#K-StringEqual-4> a mf:QueryEvaluationTest ;
  mf:name "K-StringEqual-4" ;
  rdfs:comment "A test whose essence is: `'not' ne 'equal'`." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/string-equal.xml> ;
  mf:action [ qt:query <K-StringEqual-4.rq> ] ;
  mf:result <../true.srj> .

<#K-StringEqual-5> a mf:QueryEvaluationTest ;
  mf:name "K-StringEqual-5" ;
  rdfs:comment "A test whose essence is: `not('equal' ne 'equal')`." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/string-equal.xml> ;
  mf:action [ qt:query <K-StringEqual-5.rq> ] ;
  mf:result <../true.srj> .
