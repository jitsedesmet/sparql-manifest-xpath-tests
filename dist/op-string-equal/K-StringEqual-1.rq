# QT3 test case K-StringEqual-1 of test set op-string-equal, which tests the XPath expression
#   'equals' eq 'equals'
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/string-equal.xml#L7
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "equals" = "equals" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
