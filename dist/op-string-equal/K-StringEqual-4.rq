# QT3 test case K-StringEqual-4 of test set op-string-equal, which tests the XPath expression
#   'not' ne 'equal'
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/string-equal.xml#L34
ASK {
  BIND(( "not" != "equal" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
