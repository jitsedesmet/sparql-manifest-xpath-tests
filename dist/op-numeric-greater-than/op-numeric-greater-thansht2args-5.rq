# QT3 test case op-numeric-greater-thansht2args-5 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:short("-32768") gt xs:short("32767")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L1158
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-32768"^^xsd:short > "32767"^^xsd:short ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
