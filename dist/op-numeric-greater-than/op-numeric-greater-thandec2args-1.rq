# QT3 test case op-numeric-greater-thandec2args-1 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:decimal("-999999999999999999") gt xs:decimal("-999999999999999999")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( "-999999999999999999" ) > <http://www.w3.org/2001/XMLSchema#decimal> ( "-999999999999999999" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
