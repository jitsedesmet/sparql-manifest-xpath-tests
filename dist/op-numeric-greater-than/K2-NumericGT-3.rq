# QT3 test case K2-NumericGT-3 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:double("3") gt xs:double("NaN")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( "3" ) > <http://www.w3.org/2001/XMLSchema#double> ( "NaN" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
