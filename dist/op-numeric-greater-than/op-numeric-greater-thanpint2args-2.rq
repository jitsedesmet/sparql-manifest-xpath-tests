# QT3 test case op-numeric-greater-thanpint2args-2 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:positiveInteger("52704602390610033") gt xs:positiveInteger("1")
ASK {
  BIND(( "52704602390610033"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> > "1"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
