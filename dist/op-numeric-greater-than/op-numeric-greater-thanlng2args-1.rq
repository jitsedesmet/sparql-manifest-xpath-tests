# QT3 test case op-numeric-greater-thanlng2args-1 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:long("-92233720368547758") gt xs:long("-92233720368547758")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L456
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-92233720368547758"^^xsd:long > "-92233720368547758"^^xsd:long ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
