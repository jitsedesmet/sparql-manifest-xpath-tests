# QT3 test case op-numeric-greater-thannpi2args-4 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:nonPositiveInteger("-999999999999999999") gt xs:nonPositiveInteger("-475688437271870490")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L960
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-999999999999999999"^^xsd:nonPositiveInteger > "-475688437271870490"^^xsd:nonPositiveInteger ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
