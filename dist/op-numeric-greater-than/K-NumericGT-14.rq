# QT3 test case K-NumericGT-14 of test set op-numeric-greater-than, which tests the XPath expression
#   not(xs:float("NaN") gt 1)
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#float> ( "NaN" ) > "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
