# QT3 test case K-NumericGT-11 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:float(1) gt xs:float(-1)
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) > <http://www.w3.org/2001/XMLSchema#float> ( - "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
