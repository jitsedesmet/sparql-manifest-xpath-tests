# QT3 test case op-numeric-greater-thansht2args-2 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:short("-5324") gt xs:short("-32768")
ASK {
  BIND(( "-5324"^^<http://www.w3.org/2001/XMLSchema#short> > "-32768"^^<http://www.w3.org/2001/XMLSchema#short> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
