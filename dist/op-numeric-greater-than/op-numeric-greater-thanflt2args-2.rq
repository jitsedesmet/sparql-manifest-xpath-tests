# QT3 test case op-numeric-greater-thanflt2args-2 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:float("0") gt xs:float("-3.4028235E38")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L384
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "0" ) > <http://www.w3.org/2001/XMLSchema#float> ( "-3.4028235E38" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
