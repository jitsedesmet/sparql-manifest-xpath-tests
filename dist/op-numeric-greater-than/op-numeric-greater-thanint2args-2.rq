# QT3 test case op-numeric-greater-thanint2args-2 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:int("-1873914410") gt xs:int("-2147483648")
ASK {
  BIND(( "-1873914410"^^<http://www.w3.org/2001/XMLSchema#int> > "-2147483648"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
