# QT3 test case op-numeric-greater-thanulng2args-1 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:unsignedLong("0") gt xs:unsignedLong("0")
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> > "0"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
