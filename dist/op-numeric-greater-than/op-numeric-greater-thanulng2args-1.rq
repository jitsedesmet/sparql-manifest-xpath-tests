# QT3 test case op-numeric-greater-thanulng2args-1 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:unsignedLong("0") gt xs:unsignedLong("0")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L816
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "0"^^xsd:unsignedLong > "0"^^xsd:unsignedLong ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
