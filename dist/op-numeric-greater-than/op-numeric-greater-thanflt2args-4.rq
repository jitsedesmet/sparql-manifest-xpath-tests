# QT3 test case op-numeric-greater-thanflt2args-4 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:float("-3.4028235E38") gt xs:float("0")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L420
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:float ( "-3.4028235E38" ) > xsd:float ( "0" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
