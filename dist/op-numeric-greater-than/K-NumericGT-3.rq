# QT3 test case K-NumericGT-3 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:decimal(1) gt xs:decimal(-1)
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) > <http://www.w3.org/2001/XMLSchema#decimal> ( - "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
