# QT3 test case K-NumericGT-3 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:decimal(1) gt xs:decimal(-1)
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L1206
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:decimal ( "1"^^xsd:integer ) > xsd:decimal ( - "1"^^xsd:integer ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
