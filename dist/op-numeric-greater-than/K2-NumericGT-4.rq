# QT3 test case K2-NumericGT-4 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:float("3") lt xs:float("NaN")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L1561
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "3" ) < <http://www.w3.org/2001/XMLSchema#float> ( "NaN" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
