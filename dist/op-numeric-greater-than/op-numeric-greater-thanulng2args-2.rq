# QT3 test case op-numeric-greater-thanulng2args-2 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:unsignedLong("130747108607674654") gt xs:unsignedLong("0")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L834
ASK {
  BIND(( "130747108607674654"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> > "0"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
