# QT3 test case op-numeric-greater-thannpi2args-1 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:nonPositiveInteger("-999999999999999999") gt xs:nonPositiveInteger("-999999999999999999")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L906
ASK {
  BIND(( "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> > "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
