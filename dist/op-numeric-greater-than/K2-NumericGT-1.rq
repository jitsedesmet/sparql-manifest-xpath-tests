# QT3 test case K2-NumericGT-1 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:unsignedLong("100") gt xs:unsignedLong("18446744073709551615")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L1521
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "100"^^xsd:unsignedLong > "18446744073709551615"^^xsd:unsignedLong ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
