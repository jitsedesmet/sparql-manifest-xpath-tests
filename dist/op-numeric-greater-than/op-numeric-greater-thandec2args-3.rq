# QT3 test case op-numeric-greater-thandec2args-3 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:decimal("999999999999999999") gt xs:decimal("-999999999999999999")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L222
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( "999999999999999999" ) > <http://www.w3.org/2001/XMLSchema#decimal> ( "-999999999999999999" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
