# QT3 test case op-numeric-greater-thanpint2args-3 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:positiveInteger("999999999999999999") gt xs:positiveInteger("1")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L762
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "999999999999999999"^^xsd:positiveInteger > "1"^^xsd:positiveInteger ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
