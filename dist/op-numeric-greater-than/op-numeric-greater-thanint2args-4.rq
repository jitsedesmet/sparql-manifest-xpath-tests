# QT3 test case op-numeric-greater-thanint2args-4 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:int("-2147483648") gt xs:int("-1873914410")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L60
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-2147483648"^^xsd:int > "-1873914410"^^xsd:int ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
