# QT3 test case op-numeric-greater-thannpi2args-2 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:nonPositiveInteger("-475688437271870490") gt xs:nonPositiveInteger("-999999999999999999")
ASK {
  BIND(( "-475688437271870490"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> > "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
