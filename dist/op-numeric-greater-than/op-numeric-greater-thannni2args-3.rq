# QT3 test case op-numeric-greater-thannni2args-3 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:nonNegativeInteger("999999999999999999") gt xs:nonNegativeInteger("0")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L1032
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "999999999999999999"^^xsd:nonNegativeInteger > "0"^^xsd:nonNegativeInteger ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
