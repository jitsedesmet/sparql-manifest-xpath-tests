  rdfs:comment "*******************************************************\n Test: K2-NumericGT-1                                  \n Written by: Frans Englich                             \n Date: 2007-11-22T11:31:21+01:00                       \n Purpose: Compare two xs:unsignedLong values.          \n*******************************************************" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml> ;
  mf:action [ qt:query <K2-NumericGT-1.rq> ] ;
  mf:result <../true.srj> .

