# QT3 test case op-numeric-greater-thannni2args-2 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:nonNegativeInteger("303884545991464527") gt xs:nonNegativeInteger("0")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L1014
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "303884545991464527"^^xsd:nonNegativeInteger > "0"^^xsd:nonNegativeInteger ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
