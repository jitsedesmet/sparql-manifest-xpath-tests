# QT3 test case op-numeric-greater-thandec2args-4 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:decimal("-999999999999999999") gt xs:decimal("617375191608514839")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L240
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:decimal ( "-999999999999999999" ) > xsd:decimal ( "617375191608514839" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
