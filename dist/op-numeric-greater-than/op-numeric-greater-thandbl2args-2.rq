# QT3 test case op-numeric-greater-thandbl2args-2 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:double("0") gt xs:double("-1.7976931348623157E308")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( "0" ) > <http://www.w3.org/2001/XMLSchema#double> ( "-1.7976931348623157E308" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
