# QT3 test case K-NumericGT-9 of test set op-numeric-greater-than, which tests the XPath expression
#   0 gt xs:float("-INF")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L1296
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#integer> > <http://www.w3.org/2001/XMLSchema#float> ( "-INF" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
