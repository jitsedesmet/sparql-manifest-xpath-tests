# QT3 test case op-numeric-greater-thanintg2args-3 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:integer("999999999999999999") gt xs:integer("-999999999999999999")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L132
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:integer ( "999999999999999999" ) > xsd:integer ( "-999999999999999999" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
