# QT3 test case op-numeric-greater-thanpint2args-1 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:positiveInteger("1") gt xs:positiveInteger("1")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L726
ASK {
  BIND(( "1"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> > "1"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
