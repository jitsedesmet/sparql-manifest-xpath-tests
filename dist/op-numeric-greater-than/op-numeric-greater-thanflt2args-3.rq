# QT3 test case op-numeric-greater-thanflt2args-3 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:float("3.4028235E38") gt xs:float("-3.4028235E38")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L402
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:float ( "3.4028235E38" ) > xsd:float ( "-3.4028235E38" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
