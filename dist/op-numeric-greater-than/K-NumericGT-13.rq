# QT3 test case K-NumericGT-13 of test set op-numeric-greater-than, which tests the XPath expression
#   not(xs:double("NaN") gt 1)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-greater-than.xml#L1356
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#double> ( "NaN" ) > "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
