# QT3 test case op-numeric-greater-thanintg2args-2 of test set op-numeric-greater-than, which tests the XPath expression
#   xs:integer("830993497117024304") gt xs:integer("-999999999999999999")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#integer> ( "830993497117024304" ) > <http://www.w3.org/2001/XMLSchema#integer> ( "-999999999999999999" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
