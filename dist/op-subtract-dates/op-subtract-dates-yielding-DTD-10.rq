# QT3 test case op-subtract-dates-yielding-DTD-10 of test set op-subtract-dates, which tests the XPath expression
#   fn:string((xs:date("1985-07-05Z") - xs:date("1977-12-02Z"))) or fn:string((xs:date("1985-07-05Z") - xs:date("1960-11-07Z")))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml#L149
# The test needs the constructor function xsd:date, - on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:date ( "1985-07-05Z" ) - xsd:date ( "1977-12-02Z" ) ) ) || xsd:string ( ( xsd:date ( "1985-07-05Z" ) - xsd:date ( "1960-11-07Z" ) ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
