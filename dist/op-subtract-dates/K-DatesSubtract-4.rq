# QT3 test case K-DatesSubtract-4 of test set op-subtract-dates, which tests the XPath expression
#   xs:date("1999-10-12") div xs:date("1999-10-12")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1999-10-12" ) / <http://www.w3.org/2001/XMLSchema#date> ( "1999-10-12" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
