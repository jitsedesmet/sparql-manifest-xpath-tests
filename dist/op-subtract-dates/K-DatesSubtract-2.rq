# QT3 test case K-DatesSubtract-2 of test set op-subtract-dates, which tests the XPath expression
#   xs:date("1999-07-19") - xs:date("1999-07-19") eq xs:dayTimeDuration("PT0S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml#L337
# The test needs the constructor function xsd:date, - on xsd:date, the constructor function xsd:dayTimeDuration, = on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "1999-07-19" ) - <http://www.w3.org/2001/XMLSchema#date> ( "1999-07-19" ) ) = <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "PT0S" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
