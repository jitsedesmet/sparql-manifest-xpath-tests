# QT3 test case cbcl-subtract-dates-001 of test set op-subtract-dates, which tests the XPath expression
#   xs:date("-25252734927766554-12-31") - xs:date("25252734927766554-12-31")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "-25252734927766554-12-31" ) - <http://www.w3.org/2001/XMLSchema#date> ( "25252734927766554-12-31" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
