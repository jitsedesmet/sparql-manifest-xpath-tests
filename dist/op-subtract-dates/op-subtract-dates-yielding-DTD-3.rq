# QT3 test case op-subtract-dates-yielding-DTD-3 of test set op-subtract-dates, which tests the XPath expression
#   xs:date("2000-10-15-05:00") - xs:date("2000-10-10+02:00")
# Expecting:
#   <assert-string-value>P5DT7H</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml#L38
# The test needs the constructor function xsd:date, - on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:date ( "2000-10-15-05:00" ) - xsd:date ( "2000-10-10+02:00" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "P5DT7H" ))
}
