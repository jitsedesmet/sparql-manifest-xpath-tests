@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "QT3 test set op-subtract-dates" ;
  mf:entries (
    <#K-DatesSubtract-3>
    <#K-DatesSubtract-4>
    <#K-DatesSubtract-5>
    <#cbcl-subtract-dates-001>
    <#cbcl-subtract-dates-002>
  ) .

<#K-DatesSubtract-3> a mf:QueryEvaluationTest ;
  mf:name "K-DatesSubtract-3" ;
  rdfs:comment "*******************************************************\n Test: K-DatesSubtract-3                               \n Written by: Frans Englich                             \n Date: 2007-11-22T11:31:21+01:00                       \n Purpose: The '+' operator is not available between xs:date and xs:date. \n*******************************************************" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml> ;
  mf:action [ qt:query <K-DatesSubtract-3.rq> ] ;
  mf:result <../true.srj> .

<#K-DatesSubtract-4> a mf:QueryEvaluationTest ;
  mf:name "K-DatesSubtract-4" ;
  rdfs:comment "*******************************************************\n Test: K-DatesSubtract-4                               \n Written by: Frans Englich                             \n Date: 2007-11-22T11:31:21+01:00                       \n Purpose: The 'div' operator is not available between xs:date and xs:date. \n*******************************************************" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml> ;
  mf:action [ qt:query <K-DatesSubtract-4.rq> ] ;
  mf:result <../true.srj> .

<#K-DatesSubtract-5> a mf:QueryEvaluationTest ;
  mf:name "K-DatesSubtract-5" ;
  rdfs:comment "*******************************************************\n Test: K-DatesSubtract-5                               \n Written by: Frans Englich                             \n Date: 2007-11-22T11:31:21+01:00                       \n Purpose: The '*' operator is not available between xs:date and xs:date. \n*******************************************************" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml> ;
  mf:action [ qt:query <K-DatesSubtract-5.rq> ] ;
  mf:result <../true.srj> .

<#cbcl-subtract-dates-001> a mf:QueryEvaluationTest ;
  mf:name "cbcl-subtract-dates-001" ;
  rdfs:comment "test subtraction of large dates" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml> ;
  mf:action [ qt:query <cbcl-subtract-dates-001.rq> ] ;
  mf:result <../true.srj> .

<#cbcl-subtract-dates-002> a mf:QueryEvaluationTest ;
  mf:name "cbcl-subtract-dates-002" ;
  rdfs:comment "test subtraction of large dates" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml> ;
  mf:action [ qt:query <cbcl-subtract-dates-002.rq> ] ;
  mf:result <../true.srj> .
