# QT3 test case op-subtract-dates-yielding-DTD-7 of test set op-subtract-dates, which tests the XPath expression
#   fn:string(xs:date("1989-07-05Z") - xs:date("1962-09-04Z"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#date> ( "1989-07-05Z" ) - <http://www.w3.org/2001/XMLSchema#date> ( "1962-09-04Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "P9801D" ))
}
