# QT3 test case op-subtract-dates-yielding-DTD-19 of test set op-subtract-dates, which tests the XPath expression
#   (xs:date("1999-10-23Z") - xs:date("1998-09-09Z")) * xs:decimal(2.0)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml#L292
# The test needs the constructor function xsd:date, - on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:date ( "1999-10-23Z" ) - xsd:date ( "1998-09-09Z" ) ) * xsd:decimal ( "2.0"^^xsd:decimal ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "P818D" ))
}
