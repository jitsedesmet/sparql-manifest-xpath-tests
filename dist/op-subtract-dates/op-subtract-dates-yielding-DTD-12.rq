# QT3 test case op-subtract-dates-yielding-DTD-12 of test set op-subtract-dates, which tests the XPath expression
#   fn:string((xs:date("1980-03-02Z") - xs:date("2001-09-11Z"))) and (fn:true())
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml#L181
# The test needs the constructor function xsd:date, - on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:date ( "1980-03-02Z" ) - xsd:date ( "2001-09-11Z" ) ) ) && "true"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
