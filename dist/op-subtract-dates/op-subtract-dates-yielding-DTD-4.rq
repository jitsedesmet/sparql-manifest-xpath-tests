# QT3 test case op-subtract-dates-yielding-DTD-4 of test set op-subtract-dates, which tests the XPath expression
#   fn:not(fn:string(xs:date("1998-09-12Z") - xs:date("1998-09-21Z")))
ASK {
  BIND(! <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#date> ( "1998-09-12Z" ) - <http://www.w3.org/2001/XMLSchema#date> ( "1998-09-21Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
