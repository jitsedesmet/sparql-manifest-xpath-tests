# QT3 test case op-subtract-dates-yielding-DTD-20 of test set op-subtract-dates, which tests the XPath expression
#   (xs:date("1999-10-23Z") - xs:date("1998-09-09Z")) + xs:dayTimeDuration("P17DT10H02M")
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "1999-10-23Z" ) - <http://www.w3.org/2001/XMLSchema#date> ( "1998-09-09Z" ) ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P17DT10H02M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "P426DT10H2M" ))
}
