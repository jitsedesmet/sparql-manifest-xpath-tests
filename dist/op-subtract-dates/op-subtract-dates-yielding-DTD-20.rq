# QT3 test case op-subtract-dates-yielding-DTD-20 of test set op-subtract-dates, which tests the XPath expression
#   (xs:date("1999-10-23Z") - xs:date("1998-09-09Z")) + xs:dayTimeDuration("P17DT10H02M")
# Expecting:
#   <assert-string-value>P426DT10H2M</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml#L307
# The test needs the constructor function xsd:date, - on xsd:date, the constructor function xsd:dayTimeDuration, + on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:date ( "1999-10-23Z" ) - xsd:date ( "1998-09-09Z" ) ) + xsd:dayTimeDuration ( "P17DT10H02M" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "P426DT10H2M" ))
}
