# QT3 test case K-DatesSubtract-1 of test set op-subtract-dates, which tests the XPath expression
#   xs:date("1999-07-19") - xs:date("1969-11-30") eq xs:dayTimeDuration("P10823D")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml#L322
# The test needs the constructor function xsd:date, - on xsd:date, the constructor function xsd:dayTimeDuration, = on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:date ( "1999-07-19" ) - xsd:date ( "1969-11-30" ) ) = xsd:dayTimeDuration ( "P10823D" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
