# QT3 test case op-subtract-dates-yielding-DTD-13 of test set op-subtract-dates, which tests the XPath expression
#   fn:string((xs:date("1980-05-05Z") - xs:date("1981-12-03Z"))) eq xs:string(xs:dayTimeDuration("P17DT10H02M"))
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml#L197
# The test needs the constructor function xsd:date, - on xsd:date, the constructor function xsd:dayTimeDuration, xsd:string on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:date ( "1980-05-05Z" ) - xsd:date ( "1981-12-03Z" ) ) ) = xsd:string ( xsd:dayTimeDuration ( "P17DT10H02M" ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
