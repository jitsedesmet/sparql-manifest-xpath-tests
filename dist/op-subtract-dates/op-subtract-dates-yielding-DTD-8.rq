# QT3 test case op-subtract-dates-yielding-DTD-8 of test set op-subtract-dates, which tests the XPath expression
#   xs:date("0001-01-01Z") - xs:date("2005-07-06Z")
# Expecting:
#   <assert-string-value>-P732132D</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml#L117
# The test needs the constructor function xsd:date, - on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:date ( "0001-01-01Z" ) - xsd:date ( "2005-07-06Z" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-P732132D" ))
}
