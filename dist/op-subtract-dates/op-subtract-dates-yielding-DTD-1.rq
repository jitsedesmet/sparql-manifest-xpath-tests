# QT3 test case op-subtract-dates-yielding-DTD-1 of test set op-subtract-dates, which tests the XPath expression
#   xs:date("2000-10-30") - xs:date("1999-11-28")
# Expecting:
#   <assert-string-value>P337D</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml#L6
# The test needs the constructor function xsd:date, - on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:date ( "2000-10-30" ) - xsd:date ( "1999-11-28" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "P337D" ))
}
