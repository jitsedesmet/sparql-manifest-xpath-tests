# QT3 test case op-subtract-dates-yielding-DTD-2 of test set op-subtract-dates, which tests the XPath expression
#   xs:date("2000-10-30+05:00") - xs:date("1999-11-28Z")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml#L22
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "2000-10-30+05:00" ) - <http://www.w3.org/2001/XMLSchema#date> ( "1999-11-28Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "P336DT19H" ))
}
