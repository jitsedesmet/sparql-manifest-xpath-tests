# QT3 test case op-subtract-dates-yielding-DTD-9 of test set op-subtract-dates, which tests the XPath expression
#   fn:string((xs:date("1993-12-09Z") - xs:date("1992-10-02Z"))) and fn:string((xs:date("1993-12-09Z") - xs:date("1980-10-20Z")))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml#L133
# The test needs the constructor function xsd:date, - on xsd:date, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#date> ( "1993-12-09Z" ) - <http://www.w3.org/2001/XMLSchema#date> ( "1992-10-02Z" ) ) ) && <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#date> ( "1993-12-09Z" ) - <http://www.w3.org/2001/XMLSchema#date> ( "1980-10-20Z" ) ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
