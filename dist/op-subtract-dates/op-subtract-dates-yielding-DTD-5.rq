# QT3 test case op-subtract-dates-yielding-DTD-5 of test set op-subtract-dates, which tests the XPath expression
#   fn:boolean(fn:string(xs:date("1962-03-12Z") - xs:date("1962-03-12Z")))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dates.xml#L69
ASK {
  BIND(!( ! <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#date> ( "1962-03-12Z" ) - <http://www.w3.org/2001/XMLSchema#date> ( "1962-03-12Z" ) ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
