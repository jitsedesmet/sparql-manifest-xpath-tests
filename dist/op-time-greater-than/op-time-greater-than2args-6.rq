# QT3 test case op-time-greater-than2args-6 of test set op-time-greater-than, which tests the XPath expression
#   xs:time("00:00:00Z") le xs:time("00:00:00Z")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "00:00:00Z" ) <= <http://www.w3.org/2001/XMLSchema#time> ( "00:00:00Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
