# QT3 test case K-TimeGT-4 of test set op-time-greater-than, which tests the XPath expression
#   xs:time("23:01:04.12") le xs:time("23:01:04.12")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/time-greater-than.xml#L457
# The test needs the constructor function xsd:time, <= on xsd:time, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "23:01:04.12" ) <= <http://www.w3.org/2001/XMLSchema#time> ( "23:01:04.12" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
