# QT3 test case K-TimeGT-4 of test set op-time-greater-than, which tests the XPath expression
#   xs:time("23:01:04.12") le xs:time("23:01:04.12")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "23:01:04.12" ) <= <http://www.w3.org/2001/XMLSchema#time> ( "23:01:04.12" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
