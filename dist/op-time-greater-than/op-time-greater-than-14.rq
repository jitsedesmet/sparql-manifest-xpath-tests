# QT3 test case op-time-greater-than-14 of test set op-time-greater-than, which tests the XPath expression
#   (xs:time("13:00:00Z") ge xs:time("17:00:00Z")) or (fn:false())
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/time-greater-than.xml#L396
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#time> ( "13:00:00Z" ) >= <http://www.w3.org/2001/XMLSchema#time> ( "17:00:00Z" ) ) || "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
