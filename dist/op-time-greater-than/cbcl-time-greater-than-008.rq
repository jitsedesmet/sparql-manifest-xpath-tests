# QT3 test case cbcl-time-greater-than-008 of test set op-time-greater-than, which tests the XPath expression
#   xs:time("02:00:00") le xs:time("14:00:00-12:00")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/time-greater-than.xml#L580
# The test needs the constructor function xsd:time, <= on xsd:time, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "02:00:00" ) <= <http://www.w3.org/2001/XMLSchema#time> ( "14:00:00-12:00" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
