# QT3 test case op-time-greater-than-7 of test set op-time-greater-than, which tests the XPath expression
#   (xs:time("13:00:00Z") gt xs:time("17:00:00Z")) and (xs:time("13:00:00Z") gt xs:time("17:00:00Z"))
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/time-greater-than.xml#L284
# The test needs the constructor function xsd:time, > on xsd:time, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:time ( "13:00:00Z" ) > xsd:time ( "17:00:00Z" ) ) && ( xsd:time ( "13:00:00Z" ) > xsd:time ( "17:00:00Z" ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
