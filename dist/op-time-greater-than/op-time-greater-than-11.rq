# QT3 test case op-time-greater-than-11 of test set op-time-greater-than, which tests the XPath expression
#   (xs:time("13:00:00Z") gt xs:time("17:00:00Z")) or (fn:true())
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#time> ( "13:00:00Z" ) > <http://www.w3.org/2001/XMLSchema#time> ( "17:00:00Z" ) ) || "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
