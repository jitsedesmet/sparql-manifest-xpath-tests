# QT3 test case op-time-greater-than-8 of test set op-time-greater-than, which tests the XPath expression
#   (xs:time("13:00:00Z") ge xs:time("17:00:00Z")) and (xs:time("13:00:00Z") ge xs:time("17:00:00Z"))
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#time> ( "13:00:00Z" ) >= <http://www.w3.org/2001/XMLSchema#time> ( "17:00:00Z" ) ) && ( <http://www.w3.org/2001/XMLSchema#time> ( "13:00:00Z" ) >= <http://www.w3.org/2001/XMLSchema#time> ( "17:00:00Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
