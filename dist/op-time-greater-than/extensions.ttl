<#op-time-greater-than2args-1> a mf:QueryEvaluationTest ;
  mf:name "op-time-greater-than2args-1" ;
  rdfs:comment "*******************************************************\nTest: op-time-greater-than2args-1                       \nWritten By: Carmelo Montanez                            \nDate: Tue Apr 12 16:29:07 GMT-05:00 2005                \nPurpose: Evaluates The \"op:time-greater-than\" operator \n with the arguments set as follows:                    \n$arg1 = xs:time(lower bound)                           \n$arg2 = xs:time(lower bound)                           \n*******************************************************" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/time-greater-than.xml> ;
  mf:action [ qt:query <op-time-greater-than2args-1.rq> ] ;
  mf:result <../true.srj> .

