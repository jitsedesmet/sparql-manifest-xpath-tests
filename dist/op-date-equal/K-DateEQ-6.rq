# QT3 test case K-DateEQ-6 of test set op-date-equal, which tests the XPath expression
#   xs:date("1999-12-04+00:00") eq xs:date("1999-12-04Z")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-equal.xml#L441
# The test needs the constructor function xsd:date, = on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:date ( "1999-12-04+00:00" ) = xsd:date ( "1999-12-04Z" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
