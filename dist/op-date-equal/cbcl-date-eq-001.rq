# QT3 test case cbcl-date-eq-001 of test set op-date-equal, which tests the XPath expression
#   xs:date("-25252734927766555-06-07+02:00") = xs:date("25252734927766555-07-28")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-equal.xml#L502
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "-25252734927766555-06-07+02:00" ) = <http://www.w3.org/2001/XMLSchema#date> ( "25252734927766555-07-28" ) ) AS ?result)
  FILTER(( ! BOUND( ?result ) || ( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ) ))
}
