# QT3 test case cbcl-date-equal-009 of test set op-date-equal, which tests the XPath expression
#   xs:date("2008-01-31") ne xs:date("2008-01-31+09:00")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-equal.xml#L612
# The test needs the constructor function xsd:date, != on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:date ( "2008-01-31" ) != xsd:date ( "2008-01-31+09:00" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
