# QT3 test case K-DateEQ-7 of test set op-date-equal, which tests the XPath expression
#   xs:date("1999-12-04Z") eq xs:date("1999-12-04Z")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1999-12-04Z" ) = <http://www.w3.org/2001/XMLSchema#date> ( "1999-12-04Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
