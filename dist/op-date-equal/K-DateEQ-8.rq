# QT3 test case K-DateEQ-8 of test set op-date-equal, which tests the XPath expression
#   xs:date("1999-12-04-00:00") eq xs:date("1999-12-04+00:00")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-equal.xml#L471
# The test needs the constructor function xsd:date, = on xsd:date, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1999-12-04-00:00" ) = <http://www.w3.org/2001/XMLSchema#date> ( "1999-12-04+00:00" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
