# QT3 test case op-date-equal2args-1 of test set op-date-equal, which tests the XPath expression
#   xs:date("1970-01-01Z") eq xs:date("1970-01-01Z")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-equal.xml#L6
# The test needs the constructor function xsd:date, = on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:date ( "1970-01-01Z" ) = xsd:date ( "1970-01-01Z" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
