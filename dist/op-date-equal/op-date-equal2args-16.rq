# QT3 test case op-date-equal2args-16 of test set op-date-equal, which tests the XPath expression
#   xs:date("1970-01-01Z") ge xs:date("1970-01-01Z")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-equal.xml#L276
# The test needs the constructor function xsd:date, >= on xsd:date, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) >= <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
