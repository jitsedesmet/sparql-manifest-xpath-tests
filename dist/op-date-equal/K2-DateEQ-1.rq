# QT3 test case K2-DateEQ-1 of test set op-date-equal, which tests the XPath expression
#   xs:time("01:01:01-03:00") ne xs:time("01:01:01+03:00")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-equal.xml#L486
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "01:01:01-03:00" ) != <http://www.w3.org/2001/XMLSchema#time> ( "01:01:01+03:00" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
