# QT3 test case cbcl-date-ne-001 of test set op-date-equal, which tests the XPath expression
#   xs:date("25252734927766555-07-28") != xs:date("-25252734927766555-06-07+02:00")
# Expecting:
#   <any-of>
#     <error code="FODT0001"/>
#     <assert-true/>
#   </any-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-equal.xml#L516
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:date ( "25252734927766555-07-28" ) != xsd:date ( "-25252734927766555-06-07+02:00" ) ) AS ?result)
  FILTER(( ! BOUND( ?result ) || ( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ) ))
}
