# QT3 test case cbcl-date-equal-008 of test set op-date-equal, which tests the XPath expression
#   xs:date("2008-01-31+09:00") ne xs:date("2008-01-30")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-equal.xml#L602
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "2008-01-31+09:00" ) != <http://www.w3.org/2001/XMLSchema#date> ( "2008-01-30" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
