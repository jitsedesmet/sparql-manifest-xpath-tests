# QT3 test case cbcl-date-equal-005 of test set op-date-equal, which tests the XPath expression
#   xs:date("2008-01-31+09:00") eq xs:date("2008-01-31")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-equal.xml#L571
# The test needs the constructor function xsd:date, = on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:date ( "2008-01-31+09:00" ) = xsd:date ( "2008-01-31" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
