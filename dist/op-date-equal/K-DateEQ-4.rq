# QT3 test case K-DateEQ-4 of test set op-date-equal, which tests the XPath expression
#   not(xs:date("2004-07-12") ne xs:date("2004-07-12"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#date> ( "2004-07-12" ) != <http://www.w3.org/2001/XMLSchema#date> ( "2004-07-12" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
