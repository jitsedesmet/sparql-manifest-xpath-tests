# QT3 test case K-DateEQ-4 of test set op-date-equal, which tests the XPath expression
#   not(xs:date("2004-07-12") ne xs:date("2004-07-12"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-equal.xml#L411
# The test needs the constructor function xsd:date, != on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( xsd:date ( "2004-07-12" ) != xsd:date ( "2004-07-12" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
