# QT3 test case op-date-equal2args-18 of test set op-date-equal, which tests the XPath expression
#   xs:date("2030-12-31Z") ge xs:date("1970-01-01Z")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "2030-12-31Z" ) >= <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
