# QT3 test case generalexpression219 of test set prod-GeneralComp.lt, which tests the XPath expression
#   (50000) < 10000
ASK {
  BIND(( "50000"^^<http://www.w3.org/2001/XMLSchema#integer> < "10000"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
