# QT3 test case value-comp-eq-double-1 of test set prod-ValueComp, which tests the XPath expression
#   13e0 eq 12e0+1
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/ValueComp.xml#L961
ASK {
  BIND(( "13e0"^^<http://www.w3.org/2001/XMLSchema#double> = ( "12e0"^^<http://www.w3.org/2001/XMLSchema#double> + "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
