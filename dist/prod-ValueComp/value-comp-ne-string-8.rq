# QT3 test case value-comp-ne-string-8 of test set prod-ValueComp, which tests the XPath expression
#   not("abc" ne concat("a", "bc"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/ValueComp.xml#L803
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( "abc" != CONCAT( xsd:string ( "a" ) , xsd:string ( "bc" ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
