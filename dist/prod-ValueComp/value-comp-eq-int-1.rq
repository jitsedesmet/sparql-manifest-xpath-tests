# QT3 test case value-comp-eq-int-1 of test set prod-ValueComp, which tests the XPath expression
#   13 eq 12+1
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/ValueComp.xml#L882
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "13"^^xsd:integer = ( "12"^^xsd:integer + "1"^^xsd:integer ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
