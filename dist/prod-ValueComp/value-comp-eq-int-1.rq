# QT3 test case value-comp-eq-int-1 of test set prod-ValueComp, which tests the XPath expression
#   13 eq 12+1
ASK {
  BIND(( "13"^^<http://www.w3.org/2001/XMLSchema#integer> = ( "12"^^<http://www.w3.org/2001/XMLSchema#integer> + "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
