  mf:name "value-comp-ne-string-1" ;
  rdfs:comment "Value comparison on strings." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/ValueComp.xml> ;
  mf:action [ qt:query <value-comp-ne-string-1.rq> ] ;
  mf:result <../true.srj> .

<#value-comp-ne-string-8> a mf:QueryEvaluationTest ;
  mf:name "value-comp-ne-string-8" ;
  rdfs:comment "Value comparison on strings." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/ValueComp.xml> ;
  mf:action [ qt:query <value-comp-ne-string-8.rq> ] ;
  mf:result <../true.srj> .

<#value-comp-eq-int-1> a mf:QueryEvaluationTest ;
  mf:name "value-comp-eq-int-1" ;
  rdfs:comment "Value comparison on integers." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/prod/ValueComp.xml> ;
  mf:action [ qt:query <value-comp-eq-int-1.rq> ] ;
