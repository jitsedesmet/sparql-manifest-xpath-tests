  mf:name "value-comp-eq-string-8" ;
  rdfs:comment "Value comparison on strings." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/ValueComp.xml#L655> ;
