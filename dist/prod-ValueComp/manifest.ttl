<#value-comp-eq-int-1> a mf:QueryEvaluationTest ;
  mf:name "value-comp-eq-int-1" ;
  rdfs:comment "Value comparison on integers." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/ValueComp.xml#L882> ;
