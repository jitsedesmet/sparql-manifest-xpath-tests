@prefix dct: <http://purl.org/dc/terms/> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "QT3 test set prod-ValueComp" ;
  dct:license <../LICENSE.txt> ;
  mf:entries (
    <#value-comp-eq-string-1>
    <#value-comp-eq-string-8>
    <#value-comp-ne-string-1>
    <#value-comp-ne-string-8>
    <#value-comp-eq-int-1>
    <#value-comp-eq-double-1>
  ) .

<#value-comp-eq-string-1> a mf:QueryEvaluationTest ;
  mf:name "value-comp-eq-string-1" ;
  rdfs:comment "Value comparison on strings." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/ValueComp.xml#L586> ;
  mf:action [ qt:query <value-comp-eq-string-1.rq> ] ;
  mf:result <../true.srj> .

