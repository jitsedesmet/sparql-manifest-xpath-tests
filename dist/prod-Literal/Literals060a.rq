# QT3 test case Literals060a of test set prod-Literal, which tests the XPath expression
#   "&gt;"
# Expecting:
#   <assert-string-value>&amp;gt;</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L598
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND("&gt;" AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "&gt;" ))
}
