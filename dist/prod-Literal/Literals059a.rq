# QT3 test case Literals059a of test set prod-Literal, which tests the XPath expression
#   "&lt;"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L578
ASK {
  BIND("&lt;" AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "&lt;" ))
}
