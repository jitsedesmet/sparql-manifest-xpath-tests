# QT3 test case Literals065 of test set prod-Literal, which tests the XPath expression
#   'He said, "I don''t like it."'
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L655
ASK {
  BIND("He said, \"I don't like it.\"" AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "He said, \"I don't like it.\"" ))
}
