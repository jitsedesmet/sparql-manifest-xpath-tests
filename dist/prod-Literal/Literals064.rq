# QT3 test case Literals064 of test set prod-Literal, which tests the XPath expression
#   "He said, ""I don't like it."""
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L646
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND("He said, \"I don't like it.\"" AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "He said, \"I don't like it.\"" ))
}
