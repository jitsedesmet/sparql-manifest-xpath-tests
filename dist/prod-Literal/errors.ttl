@prefix dct: <http://purl.org/dc/terms/> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "QT3 test set prod-Literal" ;
  dct:license <../LICENSE.txt> ;
  mf:entries (
    <#K2-Literals-4>
    <#K2-Literals-5>
    <#K2-Literals-6>
    <#K2-Literals-7>
    <#K2-Literals-8>
    <#K2-Literals-9>
    <#K2-Literals-10>
  ) .

<#K2-Literals-4> a mf:QueryEvaluationTest ;
  mf:name "K2-Literals-4" ;
  rdfs:comment "Use a relatively large xs:integer literal." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L1224> ;
  mf:action [ qt:query <K2-Literals-4.rq> ] ;
  mf:result <../true.srj> .

<#K2-Literals-5> a mf:QueryEvaluationTest ;
  mf:name "K2-Literals-5" ;
  rdfs:comment "Use a relatively small xs:integer literal." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L1236> ;
  mf:action [ qt:query <K2-Literals-5.rq> ] ;
  mf:result <../true.srj> .

<#K2-Literals-6> a mf:QueryEvaluationTest ;
  mf:name "K2-Literals-6" ;
  rdfs:comment "Use a relatively large xs:decimal literal." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L1248> ;
  mf:action [ qt:query <K2-Literals-6.rq> ] ;
  mf:result <../true.srj> .

<#K2-Literals-7> a mf:QueryEvaluationTest ;
  mf:name "K2-Literals-7" ;
  rdfs:comment "Use a relatively small xs:decimal literal, that might result in an underflow." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L1261> ;
  mf:action [ qt:query <K2-Literals-7.rq> ] ;
  mf:result <../true.srj> .

<#K2-Literals-8> a mf:QueryEvaluationTest ;
  mf:name "K2-Literals-8" ;
  rdfs:comment "An xs:double literal with a large significand." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L1274> ;
  mf:action [ qt:query <K2-Literals-8.rq> ] ;
  mf:result <../true.srj> .

<#K2-Literals-9> a mf:QueryEvaluationTest ;
  mf:name "K2-Literals-9" ;
  rdfs:comment "An xs:double literal with a small significand." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L1287> ;
  mf:action [ qt:query <K2-Literals-9.rq> ] ;
  mf:result <../true.srj> .

<#K2-Literals-10> a mf:QueryEvaluationTest ;
  mf:name "K2-Literals-10" ;
  rdfs:comment "Attempt to trigger underflow in an xs:double literal." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L1300> ;
  mf:action [ qt:query <K2-Literals-10.rq> ] ;
  mf:result <../true.srj> .
