# QT3 test case K2-Literals-32 of test set prod-Literal, which tests the XPath expression
#   465.
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L1531
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND("465."^^xsd:decimal AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "465"^^xsd:integer ) ))
}
