# QT3 test case K-Literals-6 of test set prod-Literal, which tests the XPath expression
#   "fo""o" eq concat("fo", """", "o")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L750
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "fo\"o" = CONCAT( xsd:string ( "fo" ) , xsd:string ( "\"" ) , xsd:string ( "o" ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
