# QT3 test case K2-Literals-8 of test set prod-Literal, which tests the XPath expression
#   999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999E100000000000000000000000000000000000000000000000000000000
# Expecting:
#   <any-of>
#       <assert-string-value>INF</assert-string-value>
#       <error code="FOAR0002"/>
#       <!-- largest finite xs:double is also permissible -->
#   </any-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L1274
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND("999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999E100000000000000000000000000000000000000000000000000000000"^^xsd:double AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "INF" ) || ! BOUND( ?result ) ))
}
