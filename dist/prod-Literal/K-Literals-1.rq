# QT3 test case K-Literals-1 of test set prod-Literal, which tests the XPath expression
#   'fo''o' eq 'fo''o'
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L705
ASK {
  BIND(( "fo'o" = "fo'o" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
