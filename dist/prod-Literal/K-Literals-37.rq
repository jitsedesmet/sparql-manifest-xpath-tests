# QT3 test case K-Literals-37 of test set prod-Literal, which tests the XPath expression
#   "t" eq "t"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L1046
ASK {
  BIND(( "t" = "t" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
