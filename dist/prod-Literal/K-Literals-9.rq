# QT3 test case K-Literals-9 of test set prod-Literal, which tests the XPath expression
#   .3 eq .3
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L777
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ".3"^^xsd:decimal = ".3"^^xsd:decimal ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
