# QT3 test case K-Literals-47a of test set prod-Literal, which tests the XPath expression
#   "t" eq "&#x74;"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L1155
ASK {
  BIND(( "t" = "&#x74;" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
