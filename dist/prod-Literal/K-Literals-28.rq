# QT3 test case K-Literals-28 of test set prod-Literal, which tests the XPath expression
#   0.3 eq .3
ASK {
  BIND(( "0.3"^^<http://www.w3.org/2001/XMLSchema#decimal> = ".3"^^<http://www.w3.org/2001/XMLSchema#decimal> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
