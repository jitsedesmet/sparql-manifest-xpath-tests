# QT3 test case K-Literals-2 of test set prod-Literal, which tests the XPath expression
#   'foo' eq "foo"
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L714
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "foo" = "foo" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
