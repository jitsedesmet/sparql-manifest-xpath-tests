# QT3 test case Literals025 of test set prod-Literal, which tests the XPath expression
#   -65535.032e2
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L229
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(- "65535.032e2"^^xsd:double AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-6.5535032E6" ))
}
