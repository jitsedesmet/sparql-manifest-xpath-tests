# QT3 test case K2-Literals-10 of test set prod-Literal, which tests the XPath expression
#   0.
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L1300
ASK {
  BIND("0."^^<http://www.w3.org/2001/XMLSchema#double> AS ?result)
  FILTER(( ( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0" ) || ! BOUND( ?result ) ))
}
