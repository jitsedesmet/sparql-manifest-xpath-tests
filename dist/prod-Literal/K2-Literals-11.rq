# QT3 test case K2-Literals-11 of test set prod-Literal, which tests the XPath expression
#   -0e0
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L1313
ASK {
  BIND(- "0e0"^^<http://www.w3.org/2001/XMLSchema#double> AS ?result)
  FILTER(( ( ?result = - "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) && ( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-0" ) ))
}
