# QT3 test case Literals056a of test set prod-Literal, which tests the XPath expression
#   "&amp;"
# Expecting:
#   <assert-string-value>&amp;amp;</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L518
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND("&amp;" AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "&amp;" ))
}
