# QT3 test case Literals014 of test set prod-Literal, which tests the XPath expression
#   -.65535032
# Expecting:
#   <assert-string-value>-0.65535032</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L130
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(- ".65535032"^^xsd:decimal AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-0.65535032" ))
}
