# QT3 test case Literals001 of test set prod-Literal, which tests the XPath expression
#   "test"
# Expecting:
#   <assert-string-value>test</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L8
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND("test" AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "test" ))
}
