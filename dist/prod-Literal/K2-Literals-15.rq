# QT3 test case K2-Literals-15 of test set prod-Literal, which tests the XPath expression
#   -0
ASK {
  BIND(- "0"^^<http://www.w3.org/2001/XMLSchema#integer> AS ?result)
  FILTER(( ( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) && ( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0" ) ))
}
