# QT3 test case Literals003 of test set prod-Literal, which tests the XPath expression
#   "line1
#   line2"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L26
ASK {
  BIND("line1\nline2" AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "line1\nline2" ))
}
