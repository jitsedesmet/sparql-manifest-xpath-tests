# QT3 test case K-Literals-21 of test set prod-Literal, which tests the XPath expression
#   not(xs:float("NaN"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L885
ASK {
  BIND(! <http://www.w3.org/2001/XMLSchema#float> ( "NaN" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
