# QT3 test case Literals058a of test set prod-Literal, which tests the XPath expression
#   "&apos;"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/Literal.xml#L558
ASK {
  BIND("&apos;" AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "&apos;" ))
}
