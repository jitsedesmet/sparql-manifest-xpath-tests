# QT3 test case op-add-yearMonthDuration-to-dateTime-14 of test set op-add-yearMonthDuration-to-dateTime, which tests the XPath expression
#   (xs:dateTime("1979-12-12T09:09:09Z") + xs:yearMonthDuration("P08Y08M")) ne xs:dateTime("1979-12-12T09:09:09Z")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDuration-to-dateTime.xml#L166
# The test needs the constructor function xsd:yearMonthDuration, + on xsd:yearMonthDuration, + on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:dateTime ( "1979-12-12T09:09:09Z" ) + xsd:yearMonthDuration ( "P08Y08M" ) ) != xsd:dateTime ( "1979-12-12T09:09:09Z" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
