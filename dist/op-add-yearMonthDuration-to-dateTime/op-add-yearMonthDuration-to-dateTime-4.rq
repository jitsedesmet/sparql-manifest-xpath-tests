# QT3 test case op-add-yearMonthDuration-to-dateTime-4 of test set op-add-yearMonthDuration-to-dateTime, which tests the XPath expression
#   fn:not(fn:string(xs:dateTime("1998-09-12T13:56:12Z") + xs:yearMonthDuration("P20Y03M")))
ASK {
  BIND(! <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1998-09-12T13:56:12Z" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P20Y03M" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
