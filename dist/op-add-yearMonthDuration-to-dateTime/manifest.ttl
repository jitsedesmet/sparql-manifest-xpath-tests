<#op-add-yearMonthDuration-to-dateTime2args-1> a mf:QueryEvaluationTest ;
  mf:name "op-add-yearMonthDuration-to-dateTime2args-1" ;
  rdfs:comment "Evaluates The \"op:add-yearMonthDuration-to-dateTime\" operator with the arguments set as follows: $arg1 = xs:dateTime(lower bound) $arg2 = xs:yearMonthDuration(lower bound)" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDuration-to-dateTime.xml> ;
