# QT3 test case K-YearMonthDurationAddDT-5 of test set op-add-yearMonthDuration-to-dateTime, which tests the XPath expression
#   xs:date("1999-10-12") + xs:time("08:12:12")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1999-10-12" ) + <http://www.w3.org/2001/XMLSchema#time> ( "08:12:12" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
