# QT3 test case op-add-yearMonthDuration-to-dateTime-1 of test set op-add-yearMonthDuration-to-dateTime, which tests the XPath expression
#   xs:dateTime("2000-10-30T11:12:00") + xs:yearMonthDuration("P1Y2M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2000-10-30T11:12:00" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1Y2M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2001-12-30T11:12:00" ))
}
