# QT3 test case op-add-yearMonthDuration-to-dateTime2args-2 of test set op-add-yearMonthDuration-to-dateTime, which tests the XPath expression
#   xs:dateTime("1996-04-07T01:40:52Z") + xs:yearMonthDuration("P0Y0M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDuration-to-dateTime.xml#L19
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1996-04-07T01:40:52Z" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P0Y0M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1996-04-07T01:40:52Z" ))
}
