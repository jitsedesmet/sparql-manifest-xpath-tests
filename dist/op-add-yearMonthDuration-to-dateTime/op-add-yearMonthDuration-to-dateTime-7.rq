# QT3 test case op-add-yearMonthDuration-to-dateTime-7 of test set op-add-yearMonthDuration-to-dateTime, which tests the XPath expression
#   fn:string(xs:dateTime("1989-07-05T14:34:36Z") + xs:yearMonthDuration("P08Y04M"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDuration-to-dateTime.xml#L109
# The test needs the constructor function xsd:yearMonthDuration, + on xsd:yearMonthDuration, + on xsd:dateTime, which SPARQL does not define
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1989-07-05T14:34:36Z" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P08Y04M" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1997-11-05T14:34:36Z" ))
}
