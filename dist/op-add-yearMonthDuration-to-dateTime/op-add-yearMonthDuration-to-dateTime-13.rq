# QT3 test case op-add-yearMonthDuration-to-dateTime-13 of test set op-add-yearMonthDuration-to-dateTime, which tests the XPath expression
#   (xs:dateTime("1980-05-05T05:05:05Z") + xs:yearMonthDuration("P23Y11M")) eq xs:dateTime("1980-05-05T05:05:05Z")
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1980-05-05T05:05:05Z" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P23Y11M" ) ) = <http://www.w3.org/2001/XMLSchema#dateTime> ( "1980-05-05T05:05:05Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
