# QT3 test case op-add-yearMonthDuration-to-dateTime2args-5 of test set op-add-yearMonthDuration-to-dateTime, which tests the XPath expression
#   xs:dateTime("1970-01-01T00:00:00Z") + xs:yearMonthDuration("P2030Y12M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T00:00:00Z" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P2030Y12M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "4001-01-01T00:00:00Z" ))
}
