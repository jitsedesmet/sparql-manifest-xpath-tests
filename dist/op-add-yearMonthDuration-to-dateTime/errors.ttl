@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "QT3 test set op-add-yearMonthDuration-to-dateTime" ;
  dct:license <../LICENSE.txt> ;
  mf:entries (
    <#K-YearMonthDurationAddDT-3>
    <#K-YearMonthDurationAddDT-4>
    <#K-YearMonthDurationAddDT-5>
    <#K-YearMonthDurationAddDT-6>
  ) .

<#K-YearMonthDurationAddDT-3> a mf:QueryEvaluationTest ;
  mf:name "K-YearMonthDurationAddDT-3" ;
  rdfs:comment "The '+' operator is not available between xs:date and xs:time." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDuration-to-dateTime.xml#L211> ;
  mf:action [ qt:query <K-YearMonthDurationAddDT-3.rq> ] ;
  mf:result <../true.srj> .

<#K-YearMonthDurationAddDT-4> a mf:QueryEvaluationTest ;
  mf:name "K-YearMonthDurationAddDT-4" ;
  rdfs:comment "The '+' operator is not available between xs:time and xs:date." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDuration-to-dateTime.xml#L220> ;
  mf:action [ qt:query <K-YearMonthDurationAddDT-4.rq> ] ;
  mf:result <../true.srj> .

