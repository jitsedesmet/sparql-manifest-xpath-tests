# QT3 test case generalexpression507 of test set prod-GeneralComp.ge, which tests the XPath expression
#   10000 >= (50000)
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/GeneralComp.ge.xml#L115
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "10000"^^xsd:integer >= "50000"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
