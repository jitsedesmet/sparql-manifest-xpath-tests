# QT3 test case fn-floor-float-1 of test set fn-floor, which tests the XPath expression
#   floor(xs:float(12.5e0))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L837
ASK {
  BIND(FLOOR( <http://www.w3.org/2001/XMLSchema#float> ( "12.5e0"^^<http://www.w3.org/2001/XMLSchema#double> ) ) AS ?result)
  FILTER(( ( ?result = "12.0e0"^^<http://www.w3.org/2001/XMLSchema#double> ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#float> ) ) ))
}
