# QT3 test case fn-floor-float-11 of test set fn-floor, which tests the XPath expression
#   floor(xs:float(xs:float('-0')))
# Expecting:
#   <all-of>
#      <assert-string-value>-0</assert-string-value>
#      <assert-type>xs:float</assert-type>
#   </all-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L957
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( xsd:float ( xsd:float ( "-0" ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "-0" ) && SAMETERM( DATATYPE( ?result ) , xsd:float ) ))
}
