# QT3 test case fn-floorlng1args-3 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:long("92233720368547758"))
ASK {
  BIND(FLOOR( "92233720368547758"^^<http://www.w3.org/2001/XMLSchema#long> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "92233720368547758" ))
}
