# QT3 test case fn-floorlng1args-2 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:long("-47175562203048468"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L186
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( "-47175562203048468"^^xsd:long ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-47175562203048468" ))
}
