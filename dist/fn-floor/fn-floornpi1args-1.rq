# QT3 test case fn-floornpi1args-1 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:nonPositiveInteger("-999999999999999999"))
ASK {
  BIND(FLOOR( "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-999999999999999999" ))
}
