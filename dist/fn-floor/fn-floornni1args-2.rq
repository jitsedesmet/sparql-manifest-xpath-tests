# QT3 test case fn-floornni1args-2 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:nonNegativeInteger("303884545991464527"))
ASK {
  BIND(FLOOR( "303884545991464527"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "303884545991464527" ))
}
