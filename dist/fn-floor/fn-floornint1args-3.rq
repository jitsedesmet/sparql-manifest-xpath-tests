# QT3 test case fn-floornint1args-3 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:negativeInteger("-1"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L256
ASK {
  BIND(FLOOR( "-1"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-1" ))
}
