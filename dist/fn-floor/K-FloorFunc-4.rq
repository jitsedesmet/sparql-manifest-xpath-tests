# QT3 test case K-FloorFunc-4 of test set fn-floor, which tests the XPath expression
#   floor(10.5) eq 10
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L446
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( FLOOR( "10.5"^^xsd:decimal ) = "10"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
