# QT3 test case fn-floorflt1args-2 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:float("0"))
# Expecting:
#   <assert-string-value>0</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L156
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( xsd:float ( "0" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "0" ))
}
