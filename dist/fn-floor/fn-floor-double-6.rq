# QT3 test case fn-floor-double-6 of test set fn-floor, which tests the XPath expression
#   floor(-12345678.567890e0)
# Expecting:
#   <all-of>
#      <assert-eq>-12345679e0</assert-eq>
#      <assert-type>xs:double</assert-type>
#   </all-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L765
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( - "12345678.567890e0"^^xsd:double ) AS ?result)
  FILTER(( ( ?result = "-12345679e0"^^xsd:double ) && SAMETERM( DATATYPE( ?result ) , xsd:double ) ))
}
