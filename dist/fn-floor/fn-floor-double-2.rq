# QT3 test case fn-floor-double-2 of test set fn-floor, which tests the XPath expression
#   floor(12.9e0)
ASK {
  BIND(FLOOR( "12.9e0"^^<http://www.w3.org/2001/XMLSchema#double> ) AS ?result)
  FILTER(( ( ?result = "12.0e0"^^<http://www.w3.org/2001/XMLSchema#double> ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#double> ) ) ))
}
