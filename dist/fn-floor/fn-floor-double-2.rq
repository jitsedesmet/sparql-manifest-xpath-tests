# QT3 test case fn-floor-double-2 of test set fn-floor, which tests the XPath expression
#   floor(12.9e0)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L717
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( "12.9e0"^^xsd:double ) AS ?result)
  FILTER(( ( ?result = "12.0e0"^^xsd:double ) && SAMETERM( DATATYPE( ?result ) , xsd:double ) ))
}
