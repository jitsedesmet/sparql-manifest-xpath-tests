# QT3 test case fn-floorintg1args-3 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:integer("999999999999999999"))
ASK {
  BIND(FLOOR( <http://www.w3.org/2001/XMLSchema#integer> ( "999999999999999999" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "999999999999999999" ))
}
