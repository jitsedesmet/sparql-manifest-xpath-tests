# QT3 test case fn-floorflt1args-1 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:float("-3.4028235E38"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L146
ASK {
  BIND(FLOOR( <http://www.w3.org/2001/XMLSchema#float> ( "-3.4028235E38" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-3.4028235E38" ))
}
