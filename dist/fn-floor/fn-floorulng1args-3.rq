# QT3 test case fn-floorulng1args-3 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:unsignedLong("184467440737095516"))
ASK {
  BIND(FLOOR( "184467440737095516"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "184467440737095516" ))
}
