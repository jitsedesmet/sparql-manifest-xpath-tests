# QT3 test case fn-floorulng1args-3 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:unsignedLong("184467440737095516"))
# Expecting:
#   <assert-string-value>184467440737095516</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L316
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( "184467440737095516"^^xsd:unsignedLong ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "184467440737095516" ))
}
