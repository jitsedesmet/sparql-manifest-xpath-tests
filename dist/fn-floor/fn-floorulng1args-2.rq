# QT3 test case fn-floorulng1args-2 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:unsignedLong("130747108607674654"))
ASK {
  BIND(FLOOR( "130747108607674654"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "130747108607674654" ))
}
