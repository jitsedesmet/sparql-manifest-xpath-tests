# QT3 test case fn-floorusht1args-3 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:unsignedShort("65535"))
ASK {
  BIND(FLOOR( "65535"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "65535" ))
}
