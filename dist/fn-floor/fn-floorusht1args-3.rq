# QT3 test case fn-floorusht1args-3 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:unsignedShort("65535"))
# Expecting:
#   <assert-string-value>65535</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L226
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( "65535"^^xsd:unsignedShort ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "65535" ))
}
