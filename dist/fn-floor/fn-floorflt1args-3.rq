# QT3 test case fn-floorflt1args-3 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:float("3.4028235E38"))
ASK {
  BIND(FLOOR( <http://www.w3.org/2001/XMLSchema#float> ( "3.4028235E38" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "3.4028235E38" ))
}
