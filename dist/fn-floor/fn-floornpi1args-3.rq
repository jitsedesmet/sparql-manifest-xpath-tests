# QT3 test case fn-floornpi1args-3 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:nonPositiveInteger("0"))
ASK {
  BIND(FLOOR( "0"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0" ))
}
