# QT3 test case fn-floor-double-4 of test set fn-floor, which tests the XPath expression
#   floor(0.0e0)
ASK {
  BIND(FLOOR( "0.0e0"^^<http://www.w3.org/2001/XMLSchema#double> ) AS ?result)
  FILTER(( ( ?result = "0.0e0"^^<http://www.w3.org/2001/XMLSchema#double> ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#double> ) ) ))
}
