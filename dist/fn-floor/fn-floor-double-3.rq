# QT3 test case fn-floor-double-3 of test set fn-floor, which tests the XPath expression
#   floor(0.000000001e0)
# Expecting:
#   <all-of>
#      <assert-eq>0.0e0</assert-eq>
#      <assert-type>xs:double</assert-type>
#   </all-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L729
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( "0.000000001e0"^^xsd:double ) AS ?result)
  FILTER(( ( ?result = "0.0e0"^^xsd:double ) && SAMETERM( DATATYPE( ?result ) , xsd:double ) ))
}
