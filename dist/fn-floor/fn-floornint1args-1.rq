# QT3 test case fn-floornint1args-1 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:negativeInteger("-999999999999999999"))
# Expecting:
#   <assert-string-value>-999999999999999999</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L236
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( "-999999999999999999"^^xsd:negativeInteger ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-999999999999999999" ))
}
