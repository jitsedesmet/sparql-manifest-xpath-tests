# QT3 test case fn-floornint1args-1 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:negativeInteger("-999999999999999999"))
ASK {
  BIND(FLOOR( "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-999999999999999999" ))
}
