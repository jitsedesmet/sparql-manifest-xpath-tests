# QT3 test case fn-floor-double-9 of test set fn-floor, which tests the XPath expression
#   floor(xs:double('INF'))
# Expecting:
#   <all-of>
#      <assert-string-value>INF</assert-string-value>
#      <assert-type>xs:double</assert-type>
#   </all-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L801
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( xsd:double ( "INF" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "INF" ) && SAMETERM( DATATYPE( ?result ) , xsd:double ) ))
}
