# QT3 test case fn-floor-double-9 of test set fn-floor, which tests the XPath expression
#   floor(xs:double('INF'))
ASK {
  BIND(FLOOR( <http://www.w3.org/2001/XMLSchema#double> ( "INF" ) ) AS ?result)
  FILTER(( ( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "INF" ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#double> ) ) ))
}
