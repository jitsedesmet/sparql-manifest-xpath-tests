# QT3 test case fn-floordbl1args-1 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:double("-1.7976931348623157E308"))
ASK {
  BIND(FLOOR( <http://www.w3.org/2001/XMLSchema#double> ( "-1.7976931348623157E308" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-1.7976931348623157E308" ))
}
