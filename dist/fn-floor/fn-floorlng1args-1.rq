# QT3 test case fn-floorlng1args-1 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:long("-92233720368547758"))
# Expecting:
#   <assert-string-value>-92233720368547758</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L176
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( "-92233720368547758"^^xsd:long ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-92233720368547758" ))
}
