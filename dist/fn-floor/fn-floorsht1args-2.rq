# QT3 test case fn-floorsht1args-2 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:short("-5324"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L396
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( "-5324"^^xsd:short ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-5324" ))
}
