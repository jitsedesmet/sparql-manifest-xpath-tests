# QT3 test case fn-floordec1args-2 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:decimal("617375191608514839"))
# Expecting:
#   <assert-string-value>617375191608514839</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L96
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( xsd:decimal ( "617375191608514839" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "617375191608514839" ))
}
