# QT3 test case fn-floor-float-7 of test set fn-floor, which tests the XPath expression
#   floor(xs:float(-1234567.2e0))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L909
ASK {
  BIND(FLOOR( <http://www.w3.org/2001/XMLSchema#float> ( - "1234567.2e0"^^<http://www.w3.org/2001/XMLSchema#double> ) ) AS ?result)
  FILTER(( ( ?result = - "1234568e0"^^<http://www.w3.org/2001/XMLSchema#double> ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#float> ) ) ))
}
