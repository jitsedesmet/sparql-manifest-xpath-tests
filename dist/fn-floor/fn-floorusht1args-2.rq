# QT3 test case fn-floorusht1args-2 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:unsignedShort("44633"))
ASK {
  BIND(FLOOR( "44633"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "44633" ))
}
