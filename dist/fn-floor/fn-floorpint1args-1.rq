# QT3 test case fn-floorpint1args-1 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:positiveInteger("1"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L266
ASK {
  BIND(FLOOR( "1"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1" ))
}
