# QT3 test case fn-floordec1args-1 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:decimal("-999999999999999999"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L86
ASK {
  BIND(FLOOR( <http://www.w3.org/2001/XMLSchema#decimal> ( "-999999999999999999" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-999999999999999999" ))
}
