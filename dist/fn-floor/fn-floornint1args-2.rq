# QT3 test case fn-floornint1args-2 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:negativeInteger("-297014075999096793"))
# Expecting:
#   <assert-string-value>-297014075999096793</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L246
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( "-297014075999096793"^^xsd:negativeInteger ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-297014075999096793" ))
}
