# QT3 test case fn-floor-double-7 of test set fn-floor, which tests the XPath expression
#   floor(-1234567891234567.2e0)
ASK {
  BIND(FLOOR( - "1234567891234567.2e0"^^<http://www.w3.org/2001/XMLSchema#double> ) AS ?result)
  FILTER(( ( ?result = - "1234567891234568.0e0"^^<http://www.w3.org/2001/XMLSchema#double> ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#double> ) ) ))
}
