# QT3 test case fn-floor-float-2 of test set fn-floor, which tests the XPath expression
#   floor(xs:float(12.9e0))
# Expecting:
#   <all-of>
#      <assert-eq>12.0e0</assert-eq>
#      <assert-type>xs:float</assert-type>
#   </all-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L849
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( xsd:float ( "12.9e0"^^xsd:double ) ) AS ?result)
  FILTER(( ( ?result = "12.0e0"^^xsd:double ) && SAMETERM( DATATYPE( ?result ) , xsd:float ) ))
}
