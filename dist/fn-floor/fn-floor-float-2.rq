# QT3 test case fn-floor-float-2 of test set fn-floor, which tests the XPath expression
#   floor(xs:float(12.9e0))
ASK {
  BIND(FLOOR( <http://www.w3.org/2001/XMLSchema#float> ( "12.9e0"^^<http://www.w3.org/2001/XMLSchema#double> ) ) AS ?result)
  FILTER(( ( ?result = "12.0e0"^^<http://www.w3.org/2001/XMLSchema#double> ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#float> ) ) ))
}
