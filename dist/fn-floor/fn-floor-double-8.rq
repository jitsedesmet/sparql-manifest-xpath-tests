# QT3 test case fn-floor-double-8 of test set fn-floor, which tests the XPath expression
#   floor(xs:double('NaN'))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L789
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( xsd:double ( "NaN" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "NaN" ) && SAMETERM( DATATYPE( ?result ) , xsd:double ) ))
}
