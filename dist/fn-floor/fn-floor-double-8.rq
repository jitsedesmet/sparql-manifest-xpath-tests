# QT3 test case fn-floor-double-8 of test set fn-floor, which tests the XPath expression
#   floor(xs:double('NaN'))
ASK {
  BIND(FLOOR( <http://www.w3.org/2001/XMLSchema#double> ( "NaN" ) ) AS ?result)
  FILTER(( ( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "NaN" ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#double> ) ) ))
}
