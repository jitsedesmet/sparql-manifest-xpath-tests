# QT3 test case fn-floornpi1args-2 of test set fn-floor, which tests the XPath expression
#   fn:floor(xs:nonPositiveInteger("-475688437271870490"))
ASK {
  BIND(FLOOR( "-475688437271870490"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-475688437271870490" ))
}
