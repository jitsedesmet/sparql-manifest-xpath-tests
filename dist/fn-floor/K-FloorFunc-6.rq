# QT3 test case K-FloorFunc-6 of test set fn-floor, which tests the XPath expression
#   floor("a string")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L466
ASK {
  BIND(FLOOR( "a string" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
