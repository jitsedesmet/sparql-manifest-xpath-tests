# QT3 test case fn-floor-float-5 of test set fn-floor, which tests the XPath expression
#   floor(xs:float(-0.1e0))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/floor.xml#L885
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(FLOOR( xsd:float ( - "0.1e0"^^xsd:double ) ) AS ?result)
  FILTER(( ( ISNUMERIC( ?result ) && ( ?result = "-1.0e0"^^xsd:double ) ) && SAMETERM( DATATYPE( ?result ) , xsd:float ) ))
}
