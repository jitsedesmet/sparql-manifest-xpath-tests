# QT3 test case fn-floor-float-5 of test set fn-floor, which tests the XPath expression
#   floor(xs:float(-0.1e0))
ASK {
  BIND(FLOOR( <http://www.w3.org/2001/XMLSchema#float> ( - "0.1e0"^^<http://www.w3.org/2001/XMLSchema#double> ) ) AS ?result)
  FILTER(( ( ?result = - "1.0e0"^^<http://www.w3.org/2001/XMLSchema#double> ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#float> ) ) ))
}
