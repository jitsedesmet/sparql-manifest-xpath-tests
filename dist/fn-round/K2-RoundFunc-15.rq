# QT3 test case K2-RoundFunc-15 of test set fn-round, which tests the XPath expression
#   round(xs:double("0"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L658
ASK {
  BIND(ROUND( <http://www.w3.org/2001/XMLSchema#double> ( "0" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0" ))
}
