# QT3 test case fn-rounddbl1args-2 of test set fn-round, which tests the XPath expression
#   fn:round(xs:double("0"))
# Expecting:
#   <all-of>
#      <assert-eq>0</assert-eq>
#      <assert-type>xs:double</assert-type>
#   </all-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L121
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ROUND( xsd:double ( "0" ) ) AS ?result)
  FILTER(( ( ?result = "0"^^xsd:integer ) && SAMETERM( DATATYPE( ?result ) , xsd:double ) ))
}
