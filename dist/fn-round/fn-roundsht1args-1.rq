# QT3 test case fn-roundsht1args-1 of test set fn-round, which tests the XPath expression
#   fn:round(xs:short("-32768"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L361
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ROUND( "-32768"^^xsd:short ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-32768"^^xsd:integer ) ))
}
