# QT3 test case fn-roundulng1args-3 of test set fn-round, which tests the XPath expression
#   fn:round(xs:unsignedLong("184467440737095516"))
ASK {
  BIND(ROUND( "184467440737095516"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( ?result = "184467440737095516"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
