# QT3 test case fn-roundlng1args-2 of test set fn-round, which tests the XPath expression
#   fn:round(xs:long("-47175562203048468"))
ASK {
  BIND(ROUND( "-47175562203048468"^^<http://www.w3.org/2001/XMLSchema#long> ) AS ?result)
  FILTER(( ?result = - "47175562203048468"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
