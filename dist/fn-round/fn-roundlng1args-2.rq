# QT3 test case fn-roundlng1args-2 of test set fn-round, which tests the XPath expression
#   fn:round(xs:long("-47175562203048468"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L181
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ROUND( "-47175562203048468"^^xsd:long ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-47175562203048468"^^xsd:integer ) ))
}
