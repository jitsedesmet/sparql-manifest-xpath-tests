# QT3 test case fn-roundint1args-2 of test set fn-round, which tests the XPath expression
#   fn:round(xs:int("-1873914410"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L37
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ROUND( "-1873914410"^^xsd:int ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-1873914410"^^xsd:integer ) ))
}
