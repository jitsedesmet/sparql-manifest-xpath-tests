# QT3 test case fn-rounddbl1args-3 of test set fn-round, which tests the XPath expression
#   fn:round(xs:double("1.7976931348623157E308"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L133
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ROUND( xsd:double ( "1.7976931348623157E308" ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "1.7976931348623157E308"^^xsd:double ) ))
}
