# QT3 test case fn-roundflt1args-1 of test set fn-round, which tests the XPath expression
#   fn:round(xs:float("-3.4028235E38"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L142
ASK {
  BIND(ROUND( <http://www.w3.org/2001/XMLSchema#float> ( "-3.4028235E38" ) ) AS ?result)
  FILTER(( ?result = <http://www.w3.org/2001/XMLSchema#float> ( "-3.4028235E38" ) ))
}
