# QT3 test case fn-roundintg1args-2 of test set fn-round, which tests the XPath expression
#   fn:round(xs:integer("830993497117024304"))
ASK {
  BIND(ROUND( <http://www.w3.org/2001/XMLSchema#integer> ( "830993497117024304" ) ) AS ?result)
  FILTER(( ?result = "830993497117024304"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
