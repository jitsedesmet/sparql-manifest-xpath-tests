# QT3 test case K2-RoundFunc-62 of test set fn-round, which tests the XPath expression
#   fn:round(xs:double("-0.16"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L1084
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ROUND( xsd:double ( "-0.16" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-0" ))
}
