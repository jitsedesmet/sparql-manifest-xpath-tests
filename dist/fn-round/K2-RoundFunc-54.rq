# QT3 test case K2-RoundFunc-54 of test set fn-round, which tests the XPath expression
#   fn:round(xs:double("-0.14"))
# Expecting:
#   <all-of>
#      <assert-type>xs:double</assert-type>
#      <assert-string-value>-0</assert-string-value>
#   </all-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L1009
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ROUND( xsd:double ( "-0.14" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:double ) && SAMETERM( xsd:string ( ?result ) , "-0" ) ))
}
