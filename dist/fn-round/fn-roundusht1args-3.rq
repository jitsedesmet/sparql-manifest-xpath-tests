# QT3 test case fn-roundusht1args-3 of test set fn-round, which tests the XPath expression
#   fn:round(xs:unsignedShort("65535"))
ASK {
  BIND(ROUND( "65535"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) AS ?result)
  FILTER(( ?result = "65535"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
