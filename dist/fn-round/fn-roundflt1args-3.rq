# QT3 test case fn-roundflt1args-3 of test set fn-round, which tests the XPath expression
#   fn:round(xs:float("3.4028235E38"))
ASK {
  BIND(ROUND( <http://www.w3.org/2001/XMLSchema#float> ( "3.4028235E38" ) ) AS ?result)
  FILTER(( ?result = <http://www.w3.org/2001/XMLSchema#float> ( "3.4028235E38" ) ))
}
