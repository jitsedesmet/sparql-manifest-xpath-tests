# QT3 test case fn-roundflt1args-3 of test set fn-round, which tests the XPath expression
#   fn:round(xs:float("3.4028235E38"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L163
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ROUND( xsd:float ( "3.4028235E38" ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "3.4028235E38"^^xsd:float ) ))
}
