# QT3 test case fn-roundusht1args-2 of test set fn-round, which tests the XPath expression
#   fn:round(xs:unsignedShort("44633"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L208
ASK {
  BIND(ROUND( "44633"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) AS ?result)
  FILTER(( ?result = "44633"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
