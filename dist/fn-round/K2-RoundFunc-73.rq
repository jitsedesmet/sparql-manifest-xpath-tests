# QT3 test case K2-RoundFunc-73 of test set fn-round, which tests the XPath expression
#   fn:round(xs:float("-0.41"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L1183
ASK {
  BIND(ROUND( <http://www.w3.org/2001/XMLSchema#float> ( "-0.41" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-0" ))
}
