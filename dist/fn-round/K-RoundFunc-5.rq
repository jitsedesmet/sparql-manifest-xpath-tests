# QT3 test case K-RoundFunc-5 of test set fn-round, which tests the XPath expression
#   round(1.1) eq 1
ASK {
  BIND(( ROUND( "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> ) = "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
