# QT3 test case K-RoundFunc-5 of test set fn-round, which tests the XPath expression
#   round(1.1) eq 1
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L436
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ROUND( "1.1"^^xsd:decimal ) = "1"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
