# QT3 test case fn-roundnni1args-2 of test set fn-round, which tests the XPath expression
#   fn:round(xs:nonNegativeInteger("303884545991464527"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L343
ASK {
  BIND(ROUND( "303884545991464527"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ) AS ?result)
  FILTER(( ?result = "303884545991464527"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
