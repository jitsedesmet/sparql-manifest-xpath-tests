# QT3 test case fn-roundulng1args-2 of test set fn-round, which tests the XPath expression
#   fn:round(xs:unsignedLong("130747108607674654"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L289
ASK {
  BIND(ROUND( "130747108607674654"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( ?result = "130747108607674654"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
