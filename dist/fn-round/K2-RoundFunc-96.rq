# QT3 test case K2-RoundFunc-96 of test set fn-round, which tests the XPath expression
#   fn:round(xs:double("0.51"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L1390
ASK {
  BIND(ROUND( <http://www.w3.org/2001/XMLSchema#double> ( "0.51" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1" ))
}
