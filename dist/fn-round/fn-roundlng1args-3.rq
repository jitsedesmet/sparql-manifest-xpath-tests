# QT3 test case fn-roundlng1args-3 of test set fn-round, which tests the XPath expression
#   fn:round(xs:long("92233720368547758"))
ASK {
  BIND(ROUND( "92233720368547758"^^<http://www.w3.org/2001/XMLSchema#long> ) AS ?result)
  FILTER(( ?result = "92233720368547758"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
