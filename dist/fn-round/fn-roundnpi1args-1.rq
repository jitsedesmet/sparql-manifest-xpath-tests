# QT3 test case fn-roundnpi1args-1 of test set fn-round, which tests the XPath expression
#   fn:round(xs:nonPositiveInteger("-999999999999999999"))
ASK {
  BIND(ROUND( "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( ?result = - "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
