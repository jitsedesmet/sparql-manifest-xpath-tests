# QT3 test case K-RoundFunc-4 of test set fn-round, which tests the XPath expression
#   round(1) eq 1
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L427
ASK {
  BIND(( ROUND( "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) = "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
