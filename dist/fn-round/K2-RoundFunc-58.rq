# QT3 test case K2-RoundFunc-58 of test set fn-round, which tests the XPath expression
#   fn:round(xs:double("-0.15"))
# Expecting:
#   <assert-string-value>-0</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L1048
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ROUND( xsd:double ( "-0.15" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-0" ))
}
