# QT3 test case K2-RoundFunc-25 of test set fn-round, which tests the XPath expression
#   fn:round(xs:float("-0.01"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L748
ASK {
  BIND(ROUND( <http://www.w3.org/2001/XMLSchema#float> ( "-0.01" ) ) AS ?result)
  FILTER(( ?result = - "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
