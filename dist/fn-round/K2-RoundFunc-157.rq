# QT3 test case K2-RoundFunc-157 of test set fn-round, which tests the XPath expression
#   fn:round(xs:float("-0.96"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L1939
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ROUND( xsd:float ( "-0.96" ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-1"^^xsd:integer ) ))
}
