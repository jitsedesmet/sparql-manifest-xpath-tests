# QT3 test case fn-roundusht1args-1 of test set fn-round, which tests the XPath expression
#   fn:round(xs:unsignedShort("0"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L199
ASK {
  BIND(ROUND( "0"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
