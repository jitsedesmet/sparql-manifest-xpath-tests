# QT3 test case fn-roundpint1args-2 of test set fn-round, which tests the XPath expression
#   fn:round(xs:positiveInteger("52704602390610033"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L262
ASK {
  BIND(ROUND( "52704602390610033"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) AS ?result)
  FILTER(( ?result = "52704602390610033"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
