# QT3 test case fn-roundintg1args-3 of test set fn-round, which tests the XPath expression
#   fn:round(xs:integer("999999999999999999"))
ASK {
  BIND(ROUND( <http://www.w3.org/2001/XMLSchema#integer> ( "999999999999999999" ) ) AS ?result)
  FILTER(( ?result = "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
