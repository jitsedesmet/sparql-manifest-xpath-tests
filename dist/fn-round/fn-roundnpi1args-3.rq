# QT3 test case fn-roundnpi1args-3 of test set fn-round, which tests the XPath expression
#   fn:round(xs:nonPositiveInteger("0"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L325
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ROUND( "0"^^xsd:nonPositiveInteger ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "0"^^xsd:integer ) ))
}
