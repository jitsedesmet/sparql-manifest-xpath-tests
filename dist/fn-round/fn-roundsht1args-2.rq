# QT3 test case fn-roundsht1args-2 of test set fn-round, which tests the XPath expression
#   fn:round(xs:short("-5324"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L370
ASK {
  BIND(ROUND( "-5324"^^<http://www.w3.org/2001/XMLSchema#short> ) AS ?result)
  FILTER(( ?result = - "5324"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
