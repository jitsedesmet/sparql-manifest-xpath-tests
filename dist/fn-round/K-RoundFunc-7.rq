# QT3 test case K-RoundFunc-7 of test set fn-round, which tests the XPath expression
#   round(xs:float(1)) eq 1
ASK {
  BIND(( ROUND( <http://www.w3.org/2001/XMLSchema#float> ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) = "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
