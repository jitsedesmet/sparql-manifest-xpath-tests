# QT3 test case fn-roundflt1args-2 of test set fn-round, which tests the XPath expression
#   fn:round(xs:float("0"))
# Expecting:
#   <all-of>
#      <assert-type>xs:float</assert-type>
#      <assert-eq>0</assert-eq>
#   </all-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L151
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ROUND( xsd:float ( "0" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:float ) && ( ?result = "0"^^xsd:integer ) ))
}
