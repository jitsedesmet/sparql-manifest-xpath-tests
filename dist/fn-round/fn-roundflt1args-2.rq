# QT3 test case fn-roundflt1args-2 of test set fn-round, which tests the XPath expression
#   fn:round(xs:float("0"))
ASK {
  BIND(ROUND( <http://www.w3.org/2001/XMLSchema#float> ( "0" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#float> ) ) && ( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) ))
}
