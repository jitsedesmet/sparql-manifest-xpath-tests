# QT3 test case fn-rounddbl1args-1 of test set fn-round, which tests the XPath expression
#   fn:round(xs:double("-1.7976931348623157E308"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L112
ASK {
  BIND(ROUND( <http://www.w3.org/2001/XMLSchema#double> ( "-1.7976931348623157E308" ) ) AS ?result)
  FILTER(( ?result = - "1.7976931348623157E308"^^<http://www.w3.org/2001/XMLSchema#double> ))
}
