# QT3 test case K-RoundFunc-9 of test set fn-round, which tests the XPath expression
#   round(-2.5) eq -2
ASK {
  BIND(( ROUND( - "2.5"^^<http://www.w3.org/2001/XMLSchema#decimal> ) = - "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
