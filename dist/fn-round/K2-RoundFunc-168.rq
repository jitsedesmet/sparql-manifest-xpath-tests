# QT3 test case K2-RoundFunc-168 of test set fn-round, which tests the XPath expression
#   fn:round(xs:double("0.101"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L2038
ASK {
  BIND(ROUND( <http://www.w3.org/2001/XMLSchema#double> ( "0.101" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0" ))
}
