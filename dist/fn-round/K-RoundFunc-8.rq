# QT3 test case K-RoundFunc-8 of test set fn-round, which tests the XPath expression
#   round(2.4999) eq 2
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L463
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ROUND( "2.4999"^^xsd:decimal ) = "2"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
