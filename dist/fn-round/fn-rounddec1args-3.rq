# QT3 test case fn-rounddec1args-3 of test set fn-round, which tests the XPath expression
#   fn:round(xs:decimal("999999999999999999"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L103
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(ROUND( xsd:decimal ( "999999999999999999" ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "999999999999999999"^^xsd:integer ) ))
}
