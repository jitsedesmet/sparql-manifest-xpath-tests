# QT3 test case fn-roundnint1args-2 of test set fn-round, which tests the XPath expression
#   fn:round(xs:negativeInteger("-297014075999096793"))
ASK {
  BIND(ROUND( "-297014075999096793"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> ) AS ?result)
  FILTER(( ?result = - "297014075999096793"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
