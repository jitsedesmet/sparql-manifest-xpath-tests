# QT3 test case fn-roundnpi1args-2 of test set fn-round, which tests the XPath expression
#   fn:round(xs:nonPositiveInteger("-475688437271870490"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/round.xml#L316
ASK {
  BIND(ROUND( "-475688437271870490"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( ?result = - "475688437271870490"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
