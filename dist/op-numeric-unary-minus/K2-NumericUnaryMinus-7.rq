# QT3 test case K2-NumericUnaryMinus-7 of test set op-numeric-unary-minus, which tests the XPath expression
#   xs:double(-0.0)
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#double> ( - "0.0"^^<http://www.w3.org/2001/XMLSchema#decimal> ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
