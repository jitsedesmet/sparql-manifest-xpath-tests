# QT3 test case op-numeric-unary-minuspint1args-1 of test set op-numeric-unary-minus, which tests the XPath expression
#   -(xs:positiveInteger("1"))
ASK {
  BIND(- "1"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> AS ?result)
  FILTER(( ?result = - "1"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
