  rdfs:comment "Evaluates The \"op:numeric-unary-minus\" operator with the arguments set as follows: $arg = xs:nonNegativeInteger(upper bound)" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-minus.xml> ;
  mf:action [ qt:query <op-numeric-unary-minusnni1args-3.rq> ] ;
  mf:result <../true.srj> .

