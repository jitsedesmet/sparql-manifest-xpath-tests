# QT3 test case op-numeric-unary-minusnint1args-1 of test set op-numeric-unary-minus, which tests the XPath expression
#   -(xs:negativeInteger("-999999999999999999"))
ASK {
  BIND(- "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> AS ?result)
  FILTER(( ?result = "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
