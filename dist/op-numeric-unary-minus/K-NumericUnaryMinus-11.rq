# QT3 test case K-NumericUnaryMinus-11 of test set op-numeric-unary-minus, which tests the XPath expression
#   +-+-+-+-+-+-+-+3 eq -3
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-minus.xml#L448
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( + ( - ( + ( - ( + ( - ( + ( - ( + ( - ( + ( - ( + ( - ( + "3"^^xsd:integer ) ) ) ) ) ) ) ) ) ) ) ) ) ) = - "3"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
