# QT3 test case K2-NumericUnaryMinus-4 of test set op-numeric-unary-minus, which tests the XPath expression
#   -xs:integer(0)
ASK {
  BIND(- <http://www.w3.org/2001/XMLSchema#integer> ( "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
