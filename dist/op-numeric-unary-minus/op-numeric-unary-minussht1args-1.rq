# QT3 test case op-numeric-unary-minussht1args-1 of test set op-numeric-unary-minus, which tests the XPath expression
#   -(xs:short("-32768"))
ASK {
  BIND(- "-32768"^^<http://www.w3.org/2001/XMLSchema#short> AS ?result)
  FILTER(( ?result = "32768"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
