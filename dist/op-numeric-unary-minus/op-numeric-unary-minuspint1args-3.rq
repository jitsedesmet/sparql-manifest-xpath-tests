# QT3 test case op-numeric-unary-minuspint1args-3 of test set op-numeric-unary-minus, which tests the XPath expression
#   -(xs:positiveInteger("999999999999999999"))
ASK {
  BIND(- "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> AS ?result)
  FILTER(( ?result = - "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
