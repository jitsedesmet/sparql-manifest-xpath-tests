@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "QT3 test set op-numeric-unary-minus" ;
  mf:entries (
    <#K-NumericUnaryMinus-1>
  ) .

<#K-NumericUnaryMinus-1> a mf:QueryEvaluationTest ;
  mf:name "K-NumericUnaryMinus-1" ;
  rdfs:comment "No unary operator is available for xs:string." ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-minus.xml> ;
  mf:action [ qt:query <K-NumericUnaryMinus-1.rq> ] ;
  mf:result <../true.srj> .
