# QT3 test case K2-NumericUnaryMinus-5 of test set op-numeric-unary-minus, which tests the XPath expression
#   -0.0
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-minus.xml#L530
ASK {
  BIND(- "0.0"^^<http://www.w3.org/2001/XMLSchema#decimal> AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
