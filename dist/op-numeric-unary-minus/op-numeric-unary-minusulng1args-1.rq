# QT3 test case op-numeric-unary-minusulng1args-1 of test set op-numeric-unary-minus, which tests the XPath expression
#   -(xs:unsignedLong("0"))
ASK {
  BIND(- "0"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
