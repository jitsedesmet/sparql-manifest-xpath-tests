# QT3 test case op-numeric-unary-minususht1args-1 of test set op-numeric-unary-minus, which tests the XPath expression
#   -(xs:unsignedShort("0"))
ASK {
  BIND(- "0"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
