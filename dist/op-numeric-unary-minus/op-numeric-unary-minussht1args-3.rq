# QT3 test case op-numeric-unary-minussht1args-3 of test set op-numeric-unary-minus, which tests the XPath expression
#   -(xs:short("32767"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-minus.xml#L349
ASK {
  BIND(- "32767"^^<http://www.w3.org/2001/XMLSchema#short> AS ?result)
  FILTER(( ?result = - "32767"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
