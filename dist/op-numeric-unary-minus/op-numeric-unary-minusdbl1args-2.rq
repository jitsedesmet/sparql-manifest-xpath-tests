# QT3 test case op-numeric-unary-minusdbl1args-2 of test set op-numeric-unary-minus, which tests the XPath expression
#   -(xs:double("0"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-minus.xml#L97
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(- xsd:double ( "0" ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-0"^^xsd:integer ) ))
}
