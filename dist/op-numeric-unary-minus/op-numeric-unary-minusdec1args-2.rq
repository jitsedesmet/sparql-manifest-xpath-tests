# QT3 test case op-numeric-unary-minusdec1args-2 of test set op-numeric-unary-minus, which tests the XPath expression
#   -(xs:decimal("617375191608514839"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-minus.xml#L70
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(- xsd:decimal ( "617375191608514839" ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-617375191608514839"^^xsd:integer ) ))
}
