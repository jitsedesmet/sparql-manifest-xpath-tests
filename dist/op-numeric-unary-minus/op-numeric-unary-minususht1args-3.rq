# QT3 test case op-numeric-unary-minususht1args-3 of test set op-numeric-unary-minus, which tests the XPath expression
#   -(xs:unsignedShort("65535"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-minus.xml#L187
ASK {
  BIND(- "65535"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> AS ?result)
  FILTER(( ?result = - "65535"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
