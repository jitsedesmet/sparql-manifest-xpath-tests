# QT3 test case op-numeric-unary-minusnpi1args-1 of test set op-numeric-unary-minus, which tests the XPath expression
#   -(xs:nonPositiveInteger("-999999999999999999"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-minus.xml#L277
ASK {
  BIND(- "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> AS ?result)
  FILTER(( ?result = "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
