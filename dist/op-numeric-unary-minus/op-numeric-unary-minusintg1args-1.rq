# QT3 test case op-numeric-unary-minusintg1args-1 of test set op-numeric-unary-minus, which tests the XPath expression
#   -(xs:integer("-999999999999999999"))
ASK {
  BIND(- <http://www.w3.org/2001/XMLSchema#integer> ( "-999999999999999999" ) AS ?result)
  FILTER(( ?result = "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
