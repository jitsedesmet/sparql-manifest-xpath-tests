# QT3 test case op-numeric-unary-minususht1args-2 of test set op-numeric-unary-minus, which tests the XPath expression
#   -(xs:unsignedShort("44633"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-minus.xml#L178
ASK {
  BIND(- "44633"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> AS ?result)
  FILTER(( ?result = - "44633"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
