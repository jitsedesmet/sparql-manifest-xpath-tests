# QT3 test case K-NumericUnaryMinus-1 of test set op-numeric-unary-minus, which tests the XPath expression
#   -"a string"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-unary-minus.xml#L358
ASK {
  BIND(- "a string" AS ?result)
  FILTER(! BOUND( ?result ))
}
