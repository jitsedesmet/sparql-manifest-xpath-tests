# QT3 test case op-subtract-dayTimeDuration-from-time-15 of test set op-subtract-dayTimeDuration-from-time, which tests the XPath expression
#   fn:string((xs:time("08:09:09Z") - xs:dayTimeDuration("P17DT10H02M"))) le fn:string(xs:time("09:08:10Z"))
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#time> ( "08:09:09Z" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P17DT10H02M" ) ) ) <= <http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#time> ( "09:08:10Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
