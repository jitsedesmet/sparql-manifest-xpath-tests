# QT3 test case op-subtract-dayTimeDuration-from-time-5 of test set op-subtract-dayTimeDuration-from-time, which tests the XPath expression
#   fn:boolean(fn:string(xs:time("23:55:55Z") - xs:dayTimeDuration("P03DT08H06M")))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-time.xml#L160
# The test needs the constructor function xsd:time, the constructor function xsd:dayTimeDuration, - on xsd:time, - on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(! ( ! <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#time> ( "23:55:55Z" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P03DT08H06M" ) ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
