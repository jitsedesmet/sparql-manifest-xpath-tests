# QT3 test case op-subtract-dayTimeDuration-from-time-12 of test set op-subtract-dayTimeDuration-from-time, which tests the XPath expression
#   fn:string((xs:time("02:02:02Z") - xs:dayTimeDuration("P05DT08H11M"))) and (fn:true())
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#time> ( "02:02:02Z" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P05DT08H11M" ) ) ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
