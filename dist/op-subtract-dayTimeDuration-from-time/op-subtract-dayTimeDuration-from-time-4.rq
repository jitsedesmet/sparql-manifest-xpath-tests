# QT3 test case op-subtract-dayTimeDuration-from-time-4 of test set op-subtract-dayTimeDuration-from-time, which tests the XPath expression
#   fn:not(fn:string(xs:time("20:50:50Z") - xs:dayTimeDuration("P02DT07H01M")))
ASK {
  BIND(! <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#time> ( "20:50:50Z" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P02DT07H01M" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
