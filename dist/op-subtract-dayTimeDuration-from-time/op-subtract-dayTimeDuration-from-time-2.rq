# QT3 test case op-subtract-dayTimeDuration-from-time-2 of test set op-subtract-dayTimeDuration-from-time, which tests the XPath expression
#   xs:time("08:20:00-05:00") - xs:dayTimeDuration("P23DT10H10M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-time.xml#L113
# The test needs the constructor function xsd:time, the constructor function xsd:dayTimeDuration, - on xsd:time, - on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "08:20:00-05:00" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P23DT10H10M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "22:10:00-05:00" ))
}
