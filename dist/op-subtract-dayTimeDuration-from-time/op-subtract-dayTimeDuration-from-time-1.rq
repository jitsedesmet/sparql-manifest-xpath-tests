# QT3 test case op-subtract-dayTimeDuration-from-time-1 of test set op-subtract-dayTimeDuration-from-time, which tests the XPath expression
#   xs:time("11:12:00") - xs:dayTimeDuration("P3DT1H15M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-time.xml#L97
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "11:12:00" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P3DT1H15M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "09:57:00" ))
}
