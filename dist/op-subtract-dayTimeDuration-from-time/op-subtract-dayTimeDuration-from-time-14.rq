# QT3 test case op-subtract-dayTimeDuration-from-time-14 of test set op-subtract-dayTimeDuration-from-time, which tests the XPath expression
#   (xs:time("04:04:05Z") - xs:dayTimeDuration("P08DT08H05M")) ne xs:time("05:08:02Z")
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#time> ( "04:04:05Z" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P08DT08H05M" ) ) != <http://www.w3.org/2001/XMLSchema#time> ( "05:08:02Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
