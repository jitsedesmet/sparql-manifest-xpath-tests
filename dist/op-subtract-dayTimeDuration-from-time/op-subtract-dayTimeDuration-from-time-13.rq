# QT3 test case op-subtract-dayTimeDuration-from-time-13 of test set op-subtract-dayTimeDuration-from-time, which tests the XPath expression
#   (xs:time("01:03:03Z") - xs:dayTimeDuration("P23DT11H11M")) eq xs:time("04:03:05Z")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-time.xml#L272
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#time> ( "01:03:03Z" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P23DT11H11M" ) ) = <http://www.w3.org/2001/XMLSchema#time> ( "04:03:05Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
