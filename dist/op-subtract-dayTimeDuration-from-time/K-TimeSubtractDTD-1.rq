# QT3 test case K-TimeSubtractDTD-1 of test set op-subtract-dayTimeDuration-from-time, which tests the XPath expression
#   xs:time("08:12:32") - xs:dayTimeDuration("P23DT09H32M59S") eq xs:time("22:39:33")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-time.xml#L353
# The test needs the constructor function xsd:time, the constructor function xsd:dayTimeDuration, - on xsd:time, - on xsd:dayTimeDuration, = on xsd:time, which SPARQL does not define
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#time> ( "08:12:32" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P23DT09H32M59S" ) ) = <http://www.w3.org/2001/XMLSchema#time> ( "22:39:33" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
