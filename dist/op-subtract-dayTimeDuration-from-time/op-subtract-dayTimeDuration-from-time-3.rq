# QT3 test case op-subtract-dayTimeDuration-from-time-3 of test set op-subtract-dayTimeDuration-from-time, which tests the XPath expression
#   fn:string((xs:time("12:12:01Z") - xs:dayTimeDuration("P19DT13H10M"))) or fn:false()
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#time> ( "12:12:01Z" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P19DT13H10M" ) ) ) || "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
