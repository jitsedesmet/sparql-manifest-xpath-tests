# QT3 test case K-TimeSubtractDTD-2 of test set op-subtract-dayTimeDuration-from-time, which tests the XPath expression
#   xs:yearMonthDuration("P1Y") + xs:time("08:01:23")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1Y" ) + <http://www.w3.org/2001/XMLSchema#time> ( "08:01:23" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
