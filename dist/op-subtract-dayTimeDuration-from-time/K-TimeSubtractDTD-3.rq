# QT3 test case K-TimeSubtractDTD-3 of test set op-subtract-dayTimeDuration-from-time, which tests the XPath expression
#   xs:time("08:01:23") + xs:yearMonthDuration("P1Y")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-time.xml#L383
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "08:01:23" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1Y" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
