# QT3 test case op-subtract-dayTimeDuration-from-time2args-3 of test set op-subtract-dayTimeDuration-from-time, which tests the XPath expression
#   xs:time("23:59:59Z") - xs:dayTimeDuration("P0DT0H0M0S")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "23:59:59Z" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P0DT0H0M0S" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "23:59:59Z" ))
}
