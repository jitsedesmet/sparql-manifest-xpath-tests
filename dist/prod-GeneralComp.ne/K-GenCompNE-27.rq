# QT3 test case K-GenCompNE-27 of test set prod-GeneralComp.ne, which tests the XPath expression
#   1 != 2
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/GeneralComp.ne.xml#L1238
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "1"^^xsd:integer != "2"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
