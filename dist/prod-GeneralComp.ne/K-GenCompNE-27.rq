# QT3 test case K-GenCompNE-27 of test set prod-GeneralComp.ne, which tests the XPath expression
#   1 != 2
ASK {
  BIND(( "1"^^<http://www.w3.org/2001/XMLSchema#integer> != "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
