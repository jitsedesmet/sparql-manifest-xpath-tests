# QT3 test case K-GenCompNE-37 of test set prod-GeneralComp.ne, which tests the XPath expression
#   xs:string("false") != false()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/GeneralComp.ne.xml#L1328
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( "false" ) != "false"^^xsd:boolean ) AS ?result)
  FILTER(! BOUND( ?result ))
}
