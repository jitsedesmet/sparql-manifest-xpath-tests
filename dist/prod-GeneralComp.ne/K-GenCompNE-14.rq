# QT3 test case K-GenCompNE-14 of test set prod-GeneralComp.ne, which tests the XPath expression
#   "a string" != "a stringDIFF"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/GeneralComp.ne.xml#L1121
ASK {
  BIND(( "a string" != "a stringDIFF" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
