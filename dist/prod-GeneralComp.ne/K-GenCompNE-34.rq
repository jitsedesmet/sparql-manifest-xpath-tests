# QT3 test case K-GenCompNE-34 of test set prod-GeneralComp.ne, which tests the XPath expression
#   1 != "2"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/GeneralComp.ne.xml#L1301
ASK {
  BIND(( "1"^^<http://www.w3.org/2001/XMLSchema#integer> != "2" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
