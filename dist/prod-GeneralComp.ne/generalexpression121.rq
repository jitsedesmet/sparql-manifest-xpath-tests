# QT3 test case generalexpression121 of test set prod-GeneralComp.ne, which tests the XPath expression
#   (50000) != (50000)
ASK {
  BIND(( "50000"^^<http://www.w3.org/2001/XMLSchema#integer> != "50000"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
