# QT3 test case re00210 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:\P{Cf}*)$')) and (every $s in tokenize('܏󠁸', ',') satisfies not(matches($s, '^(?:\P{Cf}*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1810
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( REGEX( "" , "^(?:\\P{Cf}*)$" ) && ! REGEX( "܏󠁸" , "^(?:\\P{Cf}*)$" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
