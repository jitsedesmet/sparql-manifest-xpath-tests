# QT3 test case re00182 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('ً', ',') satisfies matches($s, '^(?:\P{Lo}*)$')) and (every $s in tokenize('א𪘀', ',') satisfies not(matches($s, '^(?:\P{Lo}*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1586
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( REGEX( "ً" , "^(?:\\P{Lo}*)$" ) && ! REGEX( "א𪘀" , "^(?:\\P{Lo}*)$" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
