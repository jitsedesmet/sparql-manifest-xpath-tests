# QT3 test case re00927 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','\1a(\d*){0,2}')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L7597
ASK {
  BIND(REGEX( "qwerty" , "\\1a(\\d*){0,2}" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
