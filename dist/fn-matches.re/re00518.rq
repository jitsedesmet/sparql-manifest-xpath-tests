# QT3 test case re00518 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('2001-06-06T12:12:00', ',') satisfies matches($s, '^(?:\p{Nd}{4}-\d\d-\d\dT\d\d:\d\d:\d\d)$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:\p{Nd}{4}-\d\d-\d\dT\d\d:\d\d:\d\d)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4324
ASK {
  BIND(( REGEX( "2001-06-06T12:12:00" , "^(?:\\p{Nd}{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d)$" ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
