# QT3 test case re00008 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('ac,abc', ',') satisfies matches($s, '^(?:ab?c)$')) and (every $s in tokenize('a,ab,bc,', ',') satisfies not(matches($s, '^(?:ab?c)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L72
ASK {
  BIND(( ( REGEX( "ac" , "^(?:ab?c)$" ) && REGEX( "abc" , "^(?:ab?c)$" ) ) && ( ( ( ! REGEX( "a" , "^(?:ab?c)$" ) && ! REGEX( "ab" , "^(?:ab?c)$" ) ) && ! REGEX( "bc" , "^(?:ab?c)$" ) ) && ! REGEX( "" , "^(?:ab?c)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
