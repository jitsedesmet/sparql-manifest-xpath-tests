# QT3 test case re00879 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','\1\d(ab)')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L7213
ASK {
  BIND(REGEX( "qwerty" , "\\1\\d(ab)" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
