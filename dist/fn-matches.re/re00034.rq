# QT3 test case re00034 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:(ab){0,0})$')) and (every $s in tokenize('a,ab', ',') satisfies not(matches($s, '^(?:(ab){0,0})$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L280
ASK {
  BIND(( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> && ( ! REGEX( "a" , "^(?:(ab){0,0})$" ) && ! REGEX( "ab" , "^(?:(ab){0,0})$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
