# QT3 test case re00775 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('hellofoo barworld', ',') satisfies matches($s, '^(?:(hello)foo\s+bar(world))$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:(hello)foo\s+bar(world))$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L6381
ASK {
  BIND(( REGEX( "hellofoo barworld" , "^(?:(hello)foo\\s+bar(world))$" ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
