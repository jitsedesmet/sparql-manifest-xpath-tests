# QT3 test case re00015 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('abc?,abbbc??,abca??,abbbbca?', ',') satisfies matches($s, '^(?:(ab+c)a?\?\??)$')) and (every $s in tokenize('ac??,bc??,abc,abc???', ',') satisfies not(matches($s, '^(?:(ab+c)a?\?\??)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L128
ASK {
  BIND(( ( ( ( REGEX( "abc?" , "^(?:(ab+c)a?\\?\\??)$" ) && REGEX( "abbbc??" , "^(?:(ab+c)a?\\?\\??)$" ) ) && REGEX( "abca??" , "^(?:(ab+c)a?\\?\\??)$" ) ) && REGEX( "abbbbca?" , "^(?:(ab+c)a?\\?\\??)$" ) ) && ( ( ( ! REGEX( "ac??" , "^(?:(ab+c)a?\\?\\??)$" ) && ! REGEX( "bc??" , "^(?:(ab+c)a?\\?\\??)$" ) ) && ! REGEX( "abc" , "^(?:(ab+c)a?\\?\\??)$" ) ) && ! REGEX( "abc???" , "^(?:(ab+c)a?\\?\\??)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
