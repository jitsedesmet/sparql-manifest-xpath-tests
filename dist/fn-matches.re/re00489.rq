# QT3 test case re00489 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('a b	, a
#   ', ',') satisfies matches($s, '^(?:\S?\s?\S?\s+)$')) and (every $s in tokenize('a  b, a b,ab', ',') satisfies not(matches($s, '^(?:\S?\s?\S?\s+)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4083
ASK {
  BIND(( ( REGEX( "a b\t" , "^(?:\\S?\\s?\\S?\\s+)$" ) && REGEX( " a  \n" , "^(?:\\S?\\s?\\S?\\s+)$" ) ) && ( ( ! REGEX( "a  b" , "^(?:\\S?\\s?\\S?\\s+)$" ) && ! REGEX( " a b" , "^(?:\\S?\\s?\\S?\\s+)$" ) ) && ! REGEX( "ab" , "^(?:\\S?\\s?\\S?\\s+)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
