# QT3 test case re00082 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('?a?,?b?,?c?', ',') satisfies matches($s, '^(?:[\C\?a-c\?]+)$')) and (every $s in tokenize('?d?', ',') satisfies not(matches($s, '^(?:[\C\?a-c\?]+)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L678
ASK {
  BIND(( ( ( REGEX( "?a?" , "^(?:[\\C\\?a-c\\?]+)$" ) && REGEX( "?b?" , "^(?:[\\C\\?a-c\\?]+)$" ) ) && REGEX( "?c?" , "^(?:[\\C\\?a-c\\?]+)$" ) ) && ! REGEX( "?d?" , "^(?:[\\C\\?a-c\\?]+)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
