# QT3 test case re00793 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('ab.cc', ',') satisfies matches($s, '^(?:a+\.?b*\.+c{2})$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:a+\.?b*\.+c{2})$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L6525
ASK {
  BIND(( REGEX( "ab.cc" , "^(?:a+\\.?b*\\.+c{2})$" ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
