# QT3 test case re00786 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','(\x30\x31\x32)')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L6469
ASK {
  BIND(REGEX( "qwerty" , "(\\x30\\x31\\x32)" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
