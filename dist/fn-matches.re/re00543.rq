# QT3 test case re00543 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('-11111,-9', ',') satisfies matches($s, '^(?:\-[0-9]*)$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:\-[0-9]*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4524
ASK {
  BIND(( ( REGEX( "-11111" , "^(?:\\-[0-9]*)$" ) && REGEX( "-9" , "^(?:\\-[0-9]*)$" ) ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
