# QT3 test case re00599 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:(foo)([\r]*)(bar))$')) and (every $s in tokenize('foo   bar', ',') satisfies not(matches($s, '^(?:(foo)([\r]*)(bar))$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4972
ASK {
  BIND(( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> && ! REGEX( "foo   bar" , "^(?:(foo)([\\r]*)(bar))$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
