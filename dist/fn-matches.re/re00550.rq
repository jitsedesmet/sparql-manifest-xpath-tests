# QT3 test case re00550 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('Hello World', ',') satisfies matches($s, '^(?:(\P{Ll}\p{Ll}*)\s(\P{Ll}\p{Ll}*))$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:(\P{Ll}\p{Ll}*)\s(\P{Ll}\p{Ll}*))$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4580
ASK {
  BIND(( REGEX( "Hello World" , "^(?:(\\P{Ll}\\p{Ll}*)\\s(\\P{Ll}\\p{Ll}*))$" ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
