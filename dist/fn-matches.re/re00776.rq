# QT3 test case re00776 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:(hello)\s+(world))$')) and (every $s in tokenize('What the hello world goodby,What the hello world goodby,START hello    world END,START hello    world END', ',') satisfies not(matches($s, '^(?:(hello)\s+(world))$')))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L6389
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "true"^^xsd:boolean && ( ( ( ! REGEX( "What the hello world goodby" , "^(?:(hello)\\s+(world))$" ) && ! REGEX( "What the hello world goodby" , "^(?:(hello)\\s+(world))$" ) ) && ! REGEX( "START hello    world END" , "^(?:(hello)\\s+(world))$" ) ) && ! REGEX( "START hello    world END" , "^(?:(hello)\\s+(world))$" ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
