# QT3 test case re00501 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize(' ,
#   ,
#   ,	', ',') satisfies matches($s, '^(?:\C)$')) and (every $s in tokenize('_,:,a', ',') satisfies not(matches($s, '^(?:\C)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4184
ASK {
  BIND(( ( ( ( REGEX( " " , "^(?:\\C)$" ) && REGEX( "\n" , "^(?:\\C)$" ) ) && REGEX( "\n" , "^(?:\\C)$" ) ) && REGEX( "\t" , "^(?:\\C)$" ) ) && ( ( ! REGEX( "_" , "^(?:\\C)$" ) && ! REGEX( ":" , "^(?:\\C)$" ) ) && ! REGEX( "a" , "^(?:\\C)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
