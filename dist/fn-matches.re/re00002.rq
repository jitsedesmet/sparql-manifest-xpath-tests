# QT3 test case re00002 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('a', ',') satisfies matches($s, '^(?:a)$')) and (every $s in tokenize('aa,b,', ',') satisfies not(matches($s, '^(?:a)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L23
ASK {
  BIND(( REGEX( "a" , "^(?:a)$" ) && ( ( ! REGEX( "aa" , "^(?:a)$" ) && ! REGEX( "b" , "^(?:a)$" ) ) && ! REGEX( "" , "^(?:a)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
