# QT3 test case re00537 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('1111', ',') satisfies matches($s, '^(?:\p{Nd}\d+)$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:\p{Nd}\d+)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4476
ASK {
  BIND(( REGEX( "1111" , "^(?:\\p{Nd}\\d+)$" ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
