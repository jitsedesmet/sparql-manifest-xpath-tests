# QT3 test case re00178 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('a', ',') satisfies matches($s, '^(?:\P{Lu}*)$')) and (every $s in tokenize('A𝞨', ',') satisfies not(matches($s, '^(?:\P{Lu}*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1554
ASK {
  BIND(( REGEX( "a" , "^(?:\\P{Lu}*)$" ) && ! REGEX( "A𝞨" , "^(?:\\P{Lu}*)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
