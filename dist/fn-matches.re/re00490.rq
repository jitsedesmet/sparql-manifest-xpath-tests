# QT3 test case re00490 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('_,:,a', ',') satisfies matches($s, '^(?:\i)$')) and (every $s in tokenize(' ,
#   ,
#   ,	', ',') satisfies not(matches($s, '^(?:\i)$')))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4091
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( ( REGEX( "_" , "^(?:\\i)$" ) && REGEX( ":" , "^(?:\\i)$" ) ) && REGEX( "a" , "^(?:\\i)$" ) ) && ( ( ( ! REGEX( " " , "^(?:\\i)$" ) && ! REGEX( "\n" , "^(?:\\i)$" ) ) && ! REGEX( "\n" , "^(?:\\i)$" ) ) && ! REGEX( "\t" , "^(?:\\i)$" ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
