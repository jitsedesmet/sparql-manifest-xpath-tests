# QT3 test case re00938 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','((\3|b)\2(a)){2,}')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L7685
ASK {
  BIND(REGEX( "qwerty" , "((\\3|b)\\2(a)){2,}" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
