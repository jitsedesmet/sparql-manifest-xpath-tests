# QT3 test case re00613 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','(foo) (?#foo) \s+ (?#followed by 1 or more whitespace) (bar)  (?#followed by bar)')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L5084
ASK {
  BIND(REGEX( "qwerty" , "(foo) (?#foo) \\s+ (?#followed by 1 or more whitespace) (bar)  (?#followed by bar)" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
