# QT3 test case re00141 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('a𝟉', ',') satisfies matches($s, '^(?:\p{Ll}*)$')) and (every $s in tokenize('ǅ', ',') satisfies not(matches($s, '^(?:\p{Ll}*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1258
ASK {
  BIND(( REGEX( "a𝟉" , "^(?:\\p{Ll}*)$" ) && ! REGEX( "ǅ" , "^(?:\\p{Ll}*)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
