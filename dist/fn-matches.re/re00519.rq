# QT3 test case re00519 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('11:00:00,13:20:00-05:00', ',') satisfies matches($s, '^(?:\p{Nd}{2}:\d\d:\d\d(\-\d\d:\d\d)?)$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:\p{Nd}{2}:\d\d:\d\d(\-\d\d:\d\d)?)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4332
ASK {
  BIND(( ( REGEX( "11:00:00" , "^(?:\\p{Nd}{2}:\\d\\d:\\d\\d(\\-\\d\\d:\\d\\d)?)$" ) && REGEX( "13:20:00-05:00" , "^(?:\\p{Nd}{2}:\\d\\d:\\d\\d(\\-\\d\\d:\\d\\d)?)$" ) ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
