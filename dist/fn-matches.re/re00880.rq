# QT3 test case re00880 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','x(~~)*(?:(?:F)?)?')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L7221
ASK {
  BIND(REGEX( "qwerty" , "x(~~)*(?:(?:F)?)?" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
