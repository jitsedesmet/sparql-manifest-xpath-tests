# QT3 test case re00171 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('	', ',') satisfies matches($s, '^(?:\p{Cc}*)$')) and (every $s in tokenize('܏', ',') satisfies not(matches($s, '^(?:\p{Cc}*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1498
ASK {
  BIND(( REGEX( "\t" , "^(?:\\p{Cc}*)$" ) && ! REGEX( "܏" , "^(?:\\p{Cc}*)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
