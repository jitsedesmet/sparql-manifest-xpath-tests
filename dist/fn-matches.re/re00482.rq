# QT3 test case re00482 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize(' ,
#   ,
#   ,	', ',') satisfies matches($s, '^(?:\s)$')) and (every $s in tokenize('a,', ',') satisfies not(matches($s, '^(?:\s)$')))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4020
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( ( ( REGEX( " " , "^(?:\\s)$" ) && REGEX( "\n" , "^(?:\\s)$" ) ) && REGEX( "\n" , "^(?:\\s)$" ) ) && REGEX( "\t" , "^(?:\\s)$" ) ) && ( ! REGEX( "a" , "^(?:\\s)$" ) && ! REGEX( "" , "^(?:\\s)$" ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
