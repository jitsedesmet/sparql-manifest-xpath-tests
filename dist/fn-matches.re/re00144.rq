# QT3 test case re00144 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('א𪘀', ',') satisfies matches($s, '^(?:\p{Lo}*)$')) and (every $s in tokenize('ً', ',') satisfies not(matches($s, '^(?:\p{Lo}*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1282
ASK {
  BIND(( REGEX( "א𪘀" , "^(?:\\p{Lo}*)$" ) && ! REGEX( "ً" , "^(?:\\p{Lo}*)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
