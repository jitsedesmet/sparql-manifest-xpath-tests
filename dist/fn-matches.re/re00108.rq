# QT3 test case re00108 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('\r', ',') satisfies matches($s, '^(?:\\r)$')) and (every $s in tokenize('r,\\r,
#   ', ',') satisfies not(matches($s, '^(?:\\r)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L917
ASK {
  BIND(( REGEX( "\\r" , "^(?:\\\\r)$" ) && ( ( ! REGEX( "r" , "^(?:\\\\r)$" ) && ! REGEX( "\\\\r" , "^(?:\\\\r)$" ) ) && ! REGEX( "\n" , "^(?:\\\\r)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
