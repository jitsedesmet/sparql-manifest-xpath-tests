# QT3 test case re00778 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:(d)(o)(g)(\s)(c)(a)(t)(\s)(h)(a)(s))$')) and (every $s in tokenize('My dog cat has fleas.,My dog cat has fleas.', ',') satisfies not(matches($s, '^(?:(d)(o)(g)(\s)(c)(a)(t)(\s)(h)(a)(s))$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L6405
ASK {
  BIND(( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> && ( ! REGEX( "My dog cat has fleas." , "^(?:(d)(o)(g)(\\s)(c)(a)(t)(\\s)(h)(a)(s))$" ) && ! REGEX( "My dog cat has fleas." , "^(?:(d)(o)(g)(\\s)(c)(a)(t)(\\s)(h)(a)(s))$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
