# QT3 test case re00694 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:[\d-[357]]+)$')) and (every $s in tokenize('33312468955,51246897,3312468977', ',') satisfies not(matches($s, '^(?:[\d-[357]]+)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L5732
ASK {
  BIND(( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> && ( ( ! REGEX( "33312468955" , "^(?:[\\d-[357]]+)$" ) && ! REGEX( "51246897" , "^(?:[\\d-[357]]+)$" ) ) && ! REGEX( "3312468977" , "^(?:[\\d-[357]]+)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
