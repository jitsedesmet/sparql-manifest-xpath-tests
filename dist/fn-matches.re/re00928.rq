# QT3 test case re00928 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','\1a(\d*){2,}')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L7605
ASK {
  BIND(REGEX( "qwerty" , "\\1a(\\d*){2,}" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
