# QT3 test case re00957 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('ab9ab', ',') satisfies matches($s, '^(?:(ab)\d\1)$')) and (every $s in tokenize('ab9aa', ',') satisfies not(matches($s, '^(?:(ab)\d\1)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L7837
ASK {
  BIND(( REGEX( "ab9ab" , "^(?:(ab)\\d\\1)$" ) && ! REGEX( "ab9aa" , "^(?:(ab)\\d\\1)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
