# QT3 test case re00185 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('⃝', ',') satisfies matches($s, '^(?:\P{Mc}*)$')) and (every $s in tokenize('ः𝅲', ',') satisfies not(matches($s, '^(?:\P{Mc}*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1610
ASK {
  BIND(( REGEX( "⃝" , "^(?:\\P{Mc}*)$" ) && ! REGEX( "ः𝅲" , "^(?:\\P{Mc}*)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
