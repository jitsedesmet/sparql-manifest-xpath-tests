# QT3 test case re00056a of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:[^a-d-b-c])$')) and (every $s in tokenize('a-b,c-c,ab,cc', ',') satisfies not(matches($s, '^(?:[^a-d-b-c])$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L466
ASK {
  BIND(( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> && ( ( ( ! REGEX( "a-b" , "^(?:[^a-d-b-c])$" ) && ! REGEX( "c-c" , "^(?:[^a-d-b-c])$" ) ) && ! REGEX( "ab" , "^(?:[^a-d-b-c])$" ) ) && ! REGEX( "cc" , "^(?:[^a-d-b-c])$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
