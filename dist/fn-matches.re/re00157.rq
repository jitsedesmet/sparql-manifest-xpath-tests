# QT3 test case re00157 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('〞｣', ',') satisfies matches($s, '^(?:\p{Pe}*)$')) and (every $s in tokenize('«', ',') satisfies not(matches($s, '^(?:\p{Pe}*)$')))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1386
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( REGEX( "〞｣" , "^(?:\\p{Pe}*)$" ) && ! REGEX( "«" , "^(?:\\p{Pe}*)$" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
