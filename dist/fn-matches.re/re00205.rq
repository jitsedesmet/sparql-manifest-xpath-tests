# QT3 test case re00205 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('゛', ',') satisfies matches($s, '^(?:\P{Sc}*)$')) and (every $s in tokenize('₠￦', ',') satisfies not(matches($s, '^(?:\P{Sc}*)$')))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1770
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( REGEX( "゛" , "^(?:\\P{Sc}*)$" ) && ! REGEX( "₠￦" , "^(?:\\P{Sc}*)$" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
