# QT3 test case re01003 of test set fn-matches.re, which tests the XPath expression
#   matches('alpha', 'alpha$+') and not(matches('alphax', 'alpha$+'))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L8271
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( REGEX( "alpha" , "alpha$+" ) && ! REGEX( "alphax" , "alpha$+" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
