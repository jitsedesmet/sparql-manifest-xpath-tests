# QT3 test case re00515 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('http://www.foo.com', ',') satisfies matches($s, '^(?:http://\c*)$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:http://\c*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4300
ASK {
  BIND(( REGEX( "http://www.foo.com" , "^(?:http://\\c*)$" ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
