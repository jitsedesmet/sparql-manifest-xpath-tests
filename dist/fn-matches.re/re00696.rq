# QT3 test case re00696 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:[\w-[\d]]+)$')) and (every $s in tokenize('0AZaz9', ',') satisfies not(matches($s, '^(?:[\w-[\d]]+)$')))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L5748
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "true"^^xsd:boolean && ! REGEX( "0AZaz9" , "^(?:[\\w-[\\d]]+)$" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
