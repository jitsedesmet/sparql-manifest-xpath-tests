# QT3 test case re00530 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('a1b,ab,ab,name1', ',') satisfies matches($s, '^(?:\c[\c\d]*)$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:\c[\c\d]*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4420
ASK {
  BIND(( ( ( ( REGEX( "a1b" , "^(?:\\c[\\c\\d]*)$" ) && REGEX( "ab" , "^(?:\\c[\\c\\d]*)$" ) ) && REGEX( "ab" , "^(?:\\c[\\c\\d]*)$" ) ) && REGEX( "name1" , "^(?:\\c[\\c\\d]*)$" ) ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
