# QT3 test case re00536 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('-128', ',') satisfies matches($s, '^(?:((\-|\+)?[1-127])|(\-?128))$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:((\-|\+)?[1-127])|(\-?128))$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4468
ASK {
  BIND(( REGEX( "-128" , "^(?:((\\-|\\+)?[1-127])|(\\-?128))$" ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
