# QT3 test case re00676 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','^[abcd]{1}*$')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L5588
ASK {
  BIND(REGEX( "qwerty" , "^[abcd]{1}*$" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
