# QT3 test case re00692 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('foo', ',') satisfies matches($s, '^(?:([a-z]*)([\w]))$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:([a-z]*)([\w]))$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L5716
ASK {
  BIND(( REGEX( "foo" , "^(?:([a-z]*)([\\w]))$" ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
