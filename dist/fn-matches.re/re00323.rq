# QT3 test case re00323 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:\p{IsMyanmar}?)$')) and (every $s in tokenize('Ⴀ', ',') satisfies not(matches($s, '^(?:\p{IsMyanmar}?)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L2741
ASK {
  BIND(( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> && ! REGEX( "Ⴀ" , "^(?:\\p{IsMyanmar}?)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
