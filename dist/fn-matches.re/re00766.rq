# QT3 test case re00766 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','(a+)(?:b*)(ccc)')
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L6309
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(REGEX( "qwerty" , "(a+)(?:b*)(ccc)" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
