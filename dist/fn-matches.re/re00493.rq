# QT3 test case re00493 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('zabcsdea', ',') satisfies matches($s, '^(?:\c\i*a)$')) and (every $s in tokenize('ab', ',') satisfies not(matches($s, '^(?:\c\i*a)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4116
ASK {
  BIND(( REGEX( "zabcsdea" , "^(?:\\c\\i*a)$" ) && ! REGEX( "ab" , "^(?:\\c\\i*a)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
