# QT3 test case re00544 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('1,3', ',') satisfies matches($s, '^(?:[13])$')) and (every $s in tokenize('2', ',') satisfies not(matches($s, '^(?:[13])$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4532
ASK {
  BIND(( ( REGEX( "1" , "^(?:[13])$" ) && REGEX( "3" , "^(?:[13])$" ) ) && ! REGEX( "2" , "^(?:[13])$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
