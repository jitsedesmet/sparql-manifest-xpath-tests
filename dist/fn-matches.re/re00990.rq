# QT3 test case re00990 of test set fn-matches.re, which tests the XPath expression
#   matches('$', '^\$$') and not(matches('\$', '^\$$'))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L8167
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( REGEX( "$" , "^\\$$" ) && ! REGEX( "\\$" , "^\\$$" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
