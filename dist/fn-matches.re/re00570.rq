# QT3 test case re00570 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','(?r:foo)')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4740
ASK {
  BIND(REGEX( "qwerty" , "(?r:foo)" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
