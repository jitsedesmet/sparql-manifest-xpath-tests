# QT3 test case re00216 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','\p{IsaA0-a9}')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1858
ASK {
  BIND(REGEX( "qwerty" , "\\p{IsaA0-a9}" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
