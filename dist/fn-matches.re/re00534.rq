# QT3 test case re00534 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('123,12', ',') satisfies matches($s, '^(?:\d+)$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:\d+)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4452
ASK {
  BIND(( ( REGEX( "123" , "^(?:\\d+)$" ) && REGEX( "12" , "^(?:\\d+)$" ) ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
