# QT3 test case re00765 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','(?<first_name>\\S+)\\s(?<last_name>\\S+)')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L6301
ASK {
  BIND(REGEX( "qwerty" , "(?<first_name>\\\\S+)\\\\s(?<last_name>\\\\S+)" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
