# QT3 test case re00207 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('	', ',') satisfies matches($s, '^(?:\P{So}*)$')) and (every $s in tokenize('㆐𝇝', ',') satisfies not(matches($s, '^(?:\P{So}*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1786
ASK {
  BIND(( REGEX( "\t" , "^(?:\\P{So}*)$" ) && ! REGEX( "㆐𝇝" , "^(?:\\P{So}*)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
