# QT3 test case re00189 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('²', ',') satisfies matches($s, '^(?:\P{Nl}*)$')) and (every $s in tokenize('𐍊〥', ',') satisfies not(matches($s, '^(?:\P{Nl}*)$')))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1642
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( REGEX( "²" , "^(?:\\P{Nl}*)$" ) && ! REGEX( "𐍊〥" , "^(?:\\P{Nl}*)$" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
