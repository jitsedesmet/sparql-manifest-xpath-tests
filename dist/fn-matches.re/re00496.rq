# QT3 test case re00496 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('1234', ',') satisfies matches($s, '^(?:\I*)$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:\I*)$')))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4142
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( REGEX( "1234" , "^(?:\\I*)$" ) && "true"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
