# QT3 test case re00183 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('ǅ', ',') satisfies matches($s, '^(?:\P{M}*)$')) and (every $s in tokenize('ً𝆭ः𝅲ः𝅲⃝⃝⃠', ',') satisfies not(matches($s, '^(?:\P{M}*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1594
ASK {
  BIND(( REGEX( "ǅ" , "^(?:\\P{M}*)$" ) && ! REGEX( "ً𝆭ः𝅲ः𝅲⃝⃝⃠" , "^(?:\\P{M}*)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
