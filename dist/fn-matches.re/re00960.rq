# QT3 test case re00960 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','(x)?(?(1)b|a)')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L7862
ASK {
  BIND(REGEX( "qwerty" , "(x)?(?(1)b|a)" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
