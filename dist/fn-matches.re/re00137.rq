# QT3 test case re00137 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('aX', ',') satisfies matches($s, '^(?:[\p{L}*]{0,2})$')) and (every $s in tokenize('aBC', ',') satisfies not(matches($s, '^(?:[\p{L}*]{0,2})$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1226
ASK {
  BIND(( REGEX( "aX" , "^(?:[\\p{L}*]{0,2})$" ) && ! REGEX( "aBC" , "^(?:[\\p{L}*]{0,2})$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
