# QT3 test case re00486 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('a', ',') satisfies matches($s, '^(?:\S)$')) and (every $s in tokenize(' ,
#   ,
#   ,	,aa', ',') satisfies not(matches($s, '^(?:\S)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4058
ASK {
  BIND(( REGEX( "a" , "^(?:\\S)$" ) && ( ( ( ( ! REGEX( " " , "^(?:\\S)$" ) && ! REGEX( "\n" , "^(?:\\S)$" ) ) && ! REGEX( "\n" , "^(?:\\S)$" ) ) && ! REGEX( "\t" , "^(?:\\S)$" ) ) && ! REGEX( "aa" , "^(?:\\S)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
