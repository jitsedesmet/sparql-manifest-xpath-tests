# QT3 test case re00796 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('209.25.0.111', ',') satisfies matches($s, '^(?:([0-9]+(\.[0-9]+){3}))$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:([0-9]+(\.[0-9]+){3}))$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L6549
ASK {
  BIND(( REGEX( "209.25.0.111" , "^(?:([0-9]+(\\.[0-9]+){3}))$" ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
