# QT3 test case re00564 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','[\u013B\u013D\u013F]+')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4692
ASK {
  BIND(REGEX( "qwerty" , "[\\u013B\\u013D\\u013F]+" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
