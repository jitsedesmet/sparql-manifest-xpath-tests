# QT3 test case re00091 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('1]', ',') satisfies matches($s, '^(?:[1-\]]+)$')) and (every $s in tokenize('0,^', ',') satisfies not(matches($s, '^(?:[1-\]]+)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L762
ASK {
  BIND(( REGEX( "1]" , "^(?:[1-\\]]+)$" ) && ( ! REGEX( "0" , "^(?:[1-\\]]+)$" ) && ! REGEX( "^" , "^(?:[1-\\]]+)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
