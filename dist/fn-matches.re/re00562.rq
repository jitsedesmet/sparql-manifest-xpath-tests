# QT3 test case re00562 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','[\u0100\u0102\u0104]+')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4676
ASK {
  BIND(REGEX( "qwerty" , "[\\u0100\\u0102\\u0104]+" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
