# QT3 test case re00607 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('Hello World', ',') satisfies matches($s, '^(?:\p{Lu}(\w*)\s\p{Lu}(\w*))$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:\p{Lu}(\w*)\s\p{Lu}(\w*))$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L5036
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( REGEX( "Hello World" , "^(?:\\p{Lu}(\\w*)\\s\\p{Lu}(\\w*))$" ) && "true"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
