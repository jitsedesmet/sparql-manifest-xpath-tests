# QT3 test case re00535 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('-300', ',') satisfies matches($s, '^(?:\-?[0-3]{3})$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:\-?[0-3]{3})$')))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4460
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( REGEX( "-300" , "^(?:\\-?[0-3]{3})$" ) && "true"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
