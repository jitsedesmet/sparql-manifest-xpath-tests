# QT3 test case re00494 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('a b  c  Z  :_   d
#   y 	b
#   ', ',') satisfies matches($s, '^(?:[\s\i]*)$')) and (every $s in tokenize('1', ',') satisfies not(matches($s, '^(?:[\s\i]*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4124
ASK {
  BIND(( REGEX( "a b  c  Z  :_   d\ny \tb \n   " , "^(?:[\\s\\i]*)$" ) && ! REGEX( "1" , "^(?:[\\s\\i]*)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
