# QT3 test case re00051 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('1z', ',') satisfies matches($s, '^(?:[^2-9a-x]{2})$')) and (every $s in tokenize('1x', ',') satisfies not(matches($s, '^(?:[^2-9a-x]{2})$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L416
ASK {
  BIND(( REGEX( "1z" , "^(?:[^2-9a-x]{2})$" ) && ! REGEX( "1x" , "^(?:[^2-9a-x]{2})$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
