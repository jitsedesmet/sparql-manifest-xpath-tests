# QT3 test case re00514 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('1.001,1.001', ',') satisfies matches($s, '^(?:\d*\.\d+)$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:\d*\.\d+)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4292
ASK {
  BIND(( ( REGEX( "1.001" , "^(?:\\d*\\.\\d+)$" ) && REGEX( "1.001" , "^(?:\\d*\\.\\d+)$" ) ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
