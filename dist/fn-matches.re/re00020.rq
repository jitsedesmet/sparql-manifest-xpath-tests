# QT3 test case re00020 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize(',', ',') satisfies matches($s, '^(?:a{0})$')) and (every $s in tokenize('a', ',') satisfies not(matches($s, '^(?:a{0})$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L168
ASK {
  BIND(( ( REGEX( "" , "^(?:a{0})$" ) && REGEX( "" , "^(?:a{0})$" ) ) && ! REGEX( "a" , "^(?:a{0})$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
