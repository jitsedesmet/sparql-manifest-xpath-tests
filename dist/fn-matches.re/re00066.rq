# QT3 test case re00066 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('a*a', ',') satisfies matches($s, '^(?:\c[^\d]\c)$')) and (every $s in tokenize('aa', ',') satisfies not(matches($s, '^(?:\c[^\d]\c)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L548
ASK {
  BIND(( REGEX( "a*a" , "^(?:\\c[^\\d]\\c)$" ) && ! REGEX( "aa" , "^(?:\\c[^\\d]\\c)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
