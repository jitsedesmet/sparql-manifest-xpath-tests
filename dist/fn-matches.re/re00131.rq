# QT3 test case re00131 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('	a	b	c	', ',') satisfies matches($s, '^(?:\ta\tb\tc\t)$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:\ta\tb\tc\t)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1170
ASK {
  BIND(( REGEX( "\ta\tb\tc\t" , "^(?:\\ta\\tb\\tc\\t)$" ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
