# QT3 test case re00024 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('aa,aaaa,aaaaaaaaaaaaaaaaaaaa', ',') satisfies matches($s, '^(?:(a{2})+)$')) and (every $s in tokenize(',a,a2,aaa', ',') satisfies not(matches($s, '^(?:(a{2})+)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L200
ASK {
  BIND(( ( ( REGEX( "aa" , "^(?:(a{2})+)$" ) && REGEX( "aaaa" , "^(?:(a{2})+)$" ) ) && REGEX( "aaaaaaaaaaaaaaaaaaaa" , "^(?:(a{2})+)$" ) ) && ( ( ( ! REGEX( "" , "^(?:(a{2})+)$" ) && ! REGEX( "a" , "^(?:(a{2})+)$" ) ) && ! REGEX( "a2" , "^(?:(a{2})+)$" ) ) && ! REGEX( "aaa" , "^(?:(a{2})+)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
