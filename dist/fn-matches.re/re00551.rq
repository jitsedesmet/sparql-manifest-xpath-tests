# QT3 test case re00551 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('hellO worlD', ',') satisfies matches($s, '^(?:(\P{Lu}+\p{Lu})\s(\P{Lu}+\p{Lu}))$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:(\P{Lu}+\p{Lu})\s(\P{Lu}+\p{Lu}))$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4588
ASK {
  BIND(( REGEX( "hellO worlD" , "^(?:(\\P{Lu}+\\p{Lu})\\s(\\P{Lu}+\\p{Lu}))$" ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
