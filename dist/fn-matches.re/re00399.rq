# QT3 test case re00399 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:\p{IsSyriac})$')) and (every $s in tokenize('ۿ', ',') satisfies not(matches($s, '^(?:\p{IsSyriac})$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L3353
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "true"^^xsd:boolean && ! REGEX( "ۿ" , "^(?:\\p{IsSyriac})$" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
