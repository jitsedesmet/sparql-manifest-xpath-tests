# QT3 test case re00999 of test set fn-matches.re, which tests the XPath expression
#   matches('alpha', 'alp^+ha')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L8239
ASK {
  BIND(REGEX( "alpha" , "alp^+ha" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
