# QT3 test case re00767 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','abc(?=XXX)\w+')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L6317
ASK {
  BIND(REGEX( "qwerty" , "abc(?=XXX)\\w+" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
