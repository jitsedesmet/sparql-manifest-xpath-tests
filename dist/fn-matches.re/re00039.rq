# QT3 test case re00039 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','ab|(d))')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L320
ASK {
  BIND(REGEX( "qwerty" , "ab|(d))" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
