# QT3 test case re00512 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('1111,11001010', ',') satisfies matches($s, '^(?:([0-1]{4}|(0|1){8}))$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:([0-1]{4}|(0|1){8}))$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4276
ASK {
  BIND(( ( REGEX( "1111" , "^(?:([0-1]{4}|(0|1){8}))$" ) && REGEX( "11001010" , "^(?:([0-1]{4}|(0|1){8}))$" ) ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
