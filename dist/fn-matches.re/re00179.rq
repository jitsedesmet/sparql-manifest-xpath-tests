# QT3 test case re00179 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('ǅ', ',') satisfies matches($s, '^(?:\P{Ll}*)$')) and (every $s in tokenize('a𝟉', ',') satisfies not(matches($s, '^(?:\P{Ll}*)$')))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1562
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( REGEX( "ǅ" , "^(?:\\P{Ll}*)$" ) && ! REGEX( "a𝟉" , "^(?:\\P{Ll}*)$" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
