# QT3 test case re00181 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('א', ',') satisfies matches($s, '^(?:\P{Lm}*)$')) and (every $s in tokenize('ʰﾟ', ',') satisfies not(matches($s, '^(?:\P{Lm}*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1578
ASK {
  BIND(( REGEX( "א" , "^(?:\\P{Lm}*)$" ) && ! REGEX( "ʰﾟ" , "^(?:\\P{Lm}*)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
