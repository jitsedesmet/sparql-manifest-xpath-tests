# QT3 test case re00484 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('aa,a a,a   a', ',') satisfies matches($s, '^(?:a\s{0,3}a)$')) and (every $s in tokenize('a    a,aa a', ',') satisfies not(matches($s, '^(?:a\s{0,3}a)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4041
ASK {
  BIND(( ( ( REGEX( "aa" , "^(?:a\\s{0,3}a)$" ) && REGEX( "a a" , "^(?:a\\s{0,3}a)$" ) ) && REGEX( "a   a" , "^(?:a\\s{0,3}a)$" ) ) && ( ! REGEX( "a    a" , "^(?:a\\s{0,3}a)$" ) && ! REGEX( "aa a" , "^(?:a\\s{0,3}a)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
