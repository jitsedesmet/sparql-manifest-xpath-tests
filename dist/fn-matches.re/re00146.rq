# QT3 test case re00146 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('ً𝆭', ',') satisfies matches($s, '^(?:\p{Mn}*)$')) and (every $s in tokenize('ः', ',') satisfies not(matches($s, '^(?:\p{Mn}*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1298
ASK {
  BIND(( REGEX( "ً𝆭" , "^(?:\\p{Mn}*)$" ) && ! REGEX( "ः" , "^(?:\\p{Mn}*)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
