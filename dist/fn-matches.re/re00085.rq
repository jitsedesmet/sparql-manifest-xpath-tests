# QT3 test case re00085 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:[\S\?a-c\?]+)$')) and (every $s in tokenize('? ?,?	?', ',') satisfies not(matches($s, '^(?:[\S\?a-c\?]+)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L702
ASK {
  BIND(( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> && ( ! REGEX( "? ?" , "^(?:[\\S\\?a-c\\?]+)$" ) && ! REGEX( "?\t?" , "^(?:[\\S\\?a-c\\?]+)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
