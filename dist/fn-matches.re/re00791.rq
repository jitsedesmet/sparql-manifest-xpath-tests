# QT3 test case re00791 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','(abbc)(?(1)111|222)')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L6509
ASK {
  BIND(REGEX( "qwerty" , "(abbc)(?(1)111|222)" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
