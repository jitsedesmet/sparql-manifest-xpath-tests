# QT3 test case re00903 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','(ba\2)(?=(a+?))')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L7405
ASK {
  BIND(REGEX( "qwerty" , "(ba\\2)(?=(a+?))" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
