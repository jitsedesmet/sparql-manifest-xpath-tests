# QT3 test case re00910 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','[a[:xyz:]')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L7461
ASK {
  BIND(REGEX( "qwerty" , "[a[:xyz:]" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
