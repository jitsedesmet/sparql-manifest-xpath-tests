# QT3 test case re00895 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','(?(1)b|a)(x)?')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L7341
ASK {
  BIND(REGEX( "qwerty" , "(?(1)b|a)(x)?" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
