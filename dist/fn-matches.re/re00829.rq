# QT3 test case re00829 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','(x(a)\3(\2|b))+')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L6813
ASK {
  BIND(REGEX( "qwerty" , "(x(a)\\3(\\2|b))+" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
