# QT3 test case re00063 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('a', ',') satisfies matches($s, '^(?:[^\P{IsBasicLatin}])$')) and (every $s in tokenize('Ā', ',') satisfies not(matches($s, '^(?:[^\P{IsBasicLatin}])$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L524
ASK {
  BIND(( REGEX( "a" , "^(?:[^\\P{IsBasicLatin}])$" ) && ! REGEX( "Ā" , "^(?:[^\\P{IsBasicLatin}])$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
