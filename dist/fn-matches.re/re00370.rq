# QT3 test case re00370 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:\p{IsPrivateUseArea}?)$')) and (every $s in tokenize('豈,', ',') satisfies not(matches($s, '^(?:\p{IsPrivateUseArea}?)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L3118
ASK {
  BIND(( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> && ( ! REGEX( "豈" , "^(?:\\p{IsPrivateUseArea}?)$" ) && ! REGEX( "" , "^(?:\\p{IsPrivateUseArea}?)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
