# QT3 test case re00777 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:(foo)\s+(bar))$')) and (every $s in tokenize('before textfoo barafter text,before textfoo barafter text,before textfoo barafter text', ',') satisfies not(matches($s, '^(?:(foo)\s+(bar))$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L6397
ASK {
  BIND(( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> && ( ( ! REGEX( "before textfoo barafter text" , "^(?:(foo)\\s+(bar))$" ) && ! REGEX( "before textfoo barafter text" , "^(?:(foo)\\s+(bar))$" ) ) && ! REGEX( "before textfoo barafter text" , "^(?:(foo)\\s+(bar))$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
