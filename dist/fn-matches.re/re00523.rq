# QT3 test case re00523 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:\p{Nd}{2})$')) and (every $s in tokenize('1999', ',') satisfies not(matches($s, '^(?:\p{Nd}{2})$')))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4364
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "true"^^xsd:boolean && ! REGEX( "1999" , "^(?:\\p{Nd}{2})$" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
