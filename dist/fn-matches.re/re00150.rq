# QT3 test case re00150 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('０𝟿', ',') satisfies matches($s, '^(?:\p{Nd}*)$')) and (every $s in tokenize('𐍊', ',') satisfies not(matches($s, '^(?:\p{Nd}*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1330
ASK {
  BIND(( REGEX( "０𝟿" , "^(?:\\p{Nd}*)$" ) && ! REGEX( "𐍊" , "^(?:\\p{Nd}*)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
