# QT3 test case re00976 of test set fn-matches.re, which tests the XPath expression
#   matches('22a22z', '^(\d*){2,}?a\1z$')
# Expecting:
#   <assert-type>xs:boolean</assert-type>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L8000
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(REGEX( "22a22z" , "^(\\d*){2,}?a\\1z$" ) AS ?result)
  FILTER(SAMETERM( DATATYPE( ?result ) , xsd:boolean ))
}
