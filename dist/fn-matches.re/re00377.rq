# QT3 test case re00377 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:\p{IsSpecials}?)$')) and (every $s in tokenize('＀,𐌀', ',') satisfies not(matches($s, '^(?:\p{IsSpecials}?)$')))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L3176
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "true"^^xsd:boolean && ( ! REGEX( "＀" , "^(?:\\p{IsSpecials}?)$" ) && ! REGEX( "𐌀" , "^(?:\\p{IsSpecials}?)$" ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
