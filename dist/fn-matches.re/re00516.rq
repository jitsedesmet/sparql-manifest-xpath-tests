# QT3 test case re00516 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('a:b', ',') satisfies matches($s, '^(?:[\i\c]+:[\i\c]+)$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:[\i\c]+:[\i\c]+)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4308
ASK {
  BIND(( REGEX( "a:b" , "^(?:[\\i\\c]+:[\\i\\c]+)$" ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
