# QT3 test case re00510 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('1', ',') satisfies matches($s, '^(?:(1|true))$')) and (every $s in tokenize('0', ',') satisfies not(matches($s, '^(?:(1|true))$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4260
ASK {
  BIND(( REGEX( "1" , "^(?:(1|true))$" ) && ! REGEX( "0" , "^(?:(1|true))$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
