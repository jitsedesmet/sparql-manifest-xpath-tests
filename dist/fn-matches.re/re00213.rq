# QT3 test case re00213 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('\a', ',') satisfies matches($s, '^(?:\\\p{L}*)$')) and (every $s in tokenize('a', ',') satisfies not(matches($s, '^(?:\\\p{L}*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1834
ASK {
  BIND(( REGEX( "\\a" , "^(?:\\\\\\p{L}*)$" ) && ! REGEX( "a" , "^(?:\\\\\\p{L}*)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
