# QT3 test case re00106 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('\t', ',') satisfies matches($s, '^(?:\\t)$')) and (every $s in tokenize('t,\\t,	', ',') satisfies not(matches($s, '^(?:\\t)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L900
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( REGEX( "\\t" , "^(?:\\\\t)$" ) && ( ( ! REGEX( "t" , "^(?:\\\\t)$" ) && ! REGEX( "\\\\t" , "^(?:\\\\t)$" ) ) && ! REGEX( "\t" , "^(?:\\\\t)$" ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
