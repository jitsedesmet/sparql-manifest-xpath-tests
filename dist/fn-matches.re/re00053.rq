# QT3 test case re00053 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize(',a,ab, a', ',') satisfies matches($s, '^(?:[^@]{0,2})$')) and (every $s in tokenize('@', ',') satisfies not(matches($s, '^(?:[^@]{0,2})$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L432
ASK {
  BIND(( ( ( ( REGEX( "" , "^(?:[^@]{0,2})$" ) && REGEX( "a" , "^(?:[^@]{0,2})$" ) ) && REGEX( "ab" , "^(?:[^@]{0,2})$" ) ) && REGEX( " a" , "^(?:[^@]{0,2})$" ) ) && ! REGEX( "@" , "^(?:[^@]{0,2})$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
