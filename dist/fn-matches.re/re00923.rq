# QT3 test case re00923 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','(a\1|(?(1)\1)){2,}')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L7565
ASK {
  BIND(REGEX( "qwerty" , "(a\\1|(?(1)\\1)){2,}" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
