# QT3 test case re00741 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','[^a-f-[\x00-\x60\u007B-\uFFFF]]+')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L6109
ASK {
  BIND(REGEX( "qwerty" , "[^a-f-[\\x00-\\x60\\u007B-\\uFFFF]]+" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
