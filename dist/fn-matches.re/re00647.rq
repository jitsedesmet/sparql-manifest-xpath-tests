# QT3 test case re00647 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','(foo)\s+(bar)\Z')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L5356
ASK {
  BIND(REGEX( "qwerty" , "(foo)\\s+(bar)\\Z" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
