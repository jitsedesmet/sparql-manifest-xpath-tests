# QT3 test case re00067 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:\c[^\s]\c)$')) and (every $s in tokenize('a c,a
#   z,a
#   c,a	r', ',') satisfies not(matches($s, '^(?:\c[^\s]\c)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L556
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "true"^^xsd:boolean && ( ( ( ! REGEX( "a c" , "^(?:\\c[^\\s]\\c)$" ) && ! REGEX( "a\nz" , "^(?:\\c[^\\s]\\c)$" ) ) && ! REGEX( "a\nc" , "^(?:\\c[^\\s]\\c)$" ) ) && ! REGEX( "a\tr" , "^(?:\\c[^\\s]\\c)$" ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
