# QT3 test case re00148 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('⃝⃠', ',') satisfies matches($s, '^(?:\p{Me}*)$')) and (every $s in tokenize('０', ',') satisfies not(matches($s, '^(?:\p{Me}*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1314
ASK {
  BIND(( REGEX( "⃝⃠" , "^(?:\\p{Me}*)$" ) && ! REGEX( "０" , "^(?:\\p{Me}*)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
