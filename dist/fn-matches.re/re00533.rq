# QT3 test case re00533 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('', ',') satisfies matches($s, '^(?:\-?\d)$')) and (every $s in tokenize('+1', ',') satisfies not(matches($s, '^(?:\-?\d)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4444
ASK {
  BIND(( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> && ! REGEX( "+1" , "^(?:\\-?\\d)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
