# QT3 test case re00075 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('a', ',') satisfies matches($s, '^(?:[a-a])$')) and (every $s in tokenize('b', ',') satisfies not(matches($s, '^(?:[a-a])$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L621
ASK {
  BIND(( REGEX( "a" , "^(?:[a-a])$" ) && ! REGEX( "b" , "^(?:[a-a])$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
