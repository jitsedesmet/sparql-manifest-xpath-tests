# QT3 test case re00846 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','(?:(?:(?:(?:(?:(?:(?:(?:(?:(a|b|c))))))))))')
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L6949
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(REGEX( "qwerty" , "(?:(?:(?:(?:(?:(?:(?:(?:(?:(a|b|c))))))))))" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
