# QT3 test case re00023 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('abab,', ',') satisfies matches($s, '^(?:((ab){2})?)$')) and (every $s in tokenize('a,ab,ababa,abababab', ',') satisfies not(matches($s, '^(?:((ab){2})?)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L192
ASK {
  BIND(( ( REGEX( "abab" , "^(?:((ab){2})?)$" ) && REGEX( "" , "^(?:((ab){2})?)$" ) ) && ( ( ( ! REGEX( "a" , "^(?:((ab){2})?)$" ) && ! REGEX( "ab" , "^(?:((ab){2})?)$" ) ) && ! REGEX( "ababa" , "^(?:((ab){2})?)$" ) ) && ! REGEX( "abababab" , "^(?:((ab){2})?)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
