# QT3 test case re00800 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('Price: 5 dollars', ',') satisfies matches($s, '^(?:(\S+):\W(\d+)\s(\D+))$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:(\S+):\W(\d+)\s(\D+))$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L6581
ASK {
  BIND(( REGEX( "Price: 5 dollars" , "^(?:(\\S+):\\W(\\d+)\\s(\\D+))$" ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
