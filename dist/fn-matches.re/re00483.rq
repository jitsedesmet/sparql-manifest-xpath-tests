# QT3 test case re00483 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('
#   
#   a c
#   
#   a
#   
#   
#   ,aa a', ',') satisfies matches($s, '^(?:\s*\c\s?\c\s+\c\s*)$')) and (every $s in tokenize(' a  a a,aaa, a aa ', ',') satisfies not(matches($s, '^(?:\s*\c\s?\c\s+\c\s*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4029
ASK {
  BIND(( ( REGEX( "  \t\n\na c\n\t\n a \n\n\t   \n" , "^(?:\\s*\\c\\s?\\c\\s+\\c\\s*)$" ) && REGEX( "aa a" , "^(?:\\s*\\c\\s?\\c\\s+\\c\\s*)$" ) ) && ( ( ! REGEX( " a  a a" , "^(?:\\s*\\c\\s?\\c\\s+\\c\\s*)$" ) && ! REGEX( "aaa" , "^(?:\\s*\\c\\s?\\c\\s+\\c\\s*)$" ) ) && ! REGEX( " a aa " , "^(?:\\s*\\c\\s?\\c\\s+\\c\\s*)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
