# QT3 test case re00866 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','(?:..)*?a')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L7109
ASK {
  BIND(REGEX( "qwerty" , "(?:..)*?a" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
