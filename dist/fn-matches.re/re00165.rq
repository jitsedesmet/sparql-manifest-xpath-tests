# QT3 test case re00165 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('⁄￢₠₠￦゛゛￣㆐㆐𝇝', ',') satisfies matches($s, '^(?:\p{S}*)$')) and (every $s in tokenize(' ', ',') satisfies not(matches($s, '^(?:\p{S}*)$')))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1450
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( REGEX( "⁄￢₠₠￦゛゛￣㆐㆐𝇝" , "^(?:\\p{S}*)$" ) && ! REGEX( " " , "^(?:\\p{S}*)$" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
