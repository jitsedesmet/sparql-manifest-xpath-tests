# QT3 test case re00176 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('_,⃝', ',') satisfies matches($s, '^(?:\P{L}*)$')) and (every $s in tokenize('aAbB,A𝞨aa𝟉ǅǅῼʰʰﾟאא𪘀', ',') satisfies not(matches($s, '^(?:\P{L}*)$')))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1538
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( REGEX( "_" , "^(?:\\P{L}*)$" ) && REGEX( "⃝" , "^(?:\\P{L}*)$" ) ) && ( ! REGEX( "aAbB" , "^(?:\\P{L}*)$" ) && ! REGEX( "A𝞨aa𝟉ǅǅῼʰʰﾟאא𪘀" , "^(?:\\P{L}*)$" ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
