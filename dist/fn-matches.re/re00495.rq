# QT3 test case re00495 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize(' ,
#   ,
#   ,	', ',') satisfies matches($s, '^(?:\I)$')) and (every $s in tokenize('_,:,a', ',') satisfies not(matches($s, '^(?:\I)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4133
ASK {
  BIND(( ( ( ( REGEX( " " , "^(?:\\I)$" ) && REGEX( "\n" , "^(?:\\I)$" ) ) && REGEX( "\n" , "^(?:\\I)$" ) ) && REGEX( "\t" , "^(?:\\I)$" ) ) && ( ( ! REGEX( "_" , "^(?:\\I)$" ) && ! REGEX( ":" , "^(?:\\I)$" ) ) && ! REGEX( "a" , "^(?:\\I)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
