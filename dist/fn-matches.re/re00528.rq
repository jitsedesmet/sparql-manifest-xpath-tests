# QT3 test case re00528 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('ch-a', ',') satisfies matches($s, '^(?:\c{2,4})$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:\c{2,4})$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4404
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( REGEX( "ch-a" , "^(?:\\c{2,4})$" ) && "true"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
