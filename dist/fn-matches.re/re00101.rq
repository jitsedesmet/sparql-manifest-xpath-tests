# QT3 test case re00101 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('a--aa---', ',') satisfies matches($s, '^(?:[a-]*)$')) and (every $s in tokenize('', ',') satisfies not(matches($s, '^(?:[a-]*)$')))
# Expecting:
#   <any-of>
#     <!-- rules for hyphens between [] are clarified in XSD 1.1 -->
#     <assert-true/>
#     <error code="FORX0002"/>
#   </any-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L842
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( REGEX( "a--aa---" , "^(?:[a-]*)$" ) && "true"^^xsd:boolean ) AS ?result)
  FILTER(( ( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ) || ! BOUND( ?result ) ))
}
