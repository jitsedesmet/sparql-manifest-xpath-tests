# QT3 test case re00027 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('abcc', ',') satisfies matches($s, '^(?:abc{2})$')) and (every $s in tokenize('abc,abccc,', ',') satisfies not(matches($s, '^(?:abc{2})$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L224
ASK {
  BIND(( REGEX( "abcc" , "^(?:abc{2})$" ) && ( ( ! REGEX( "abc" , "^(?:abc{2})$" ) && ! REGEX( "abccc" , "^(?:abc{2})$" ) ) && ! REGEX( "" , "^(?:abc{2})$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
