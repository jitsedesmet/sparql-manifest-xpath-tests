# QT3 test case re00009 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('ab,abc', ',') satisfies matches($s, '^(?:abc?)$')) and (every $s in tokenize('a,bc,abcc,', ',') satisfies not(matches($s, '^(?:abc?)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L80
ASK {
  BIND(( ( REGEX( "ab" , "^(?:abc?)$" ) && REGEX( "abc" , "^(?:abc?)$" ) ) && ( ( ( ! REGEX( "a" , "^(?:abc?)$" ) && ! REGEX( "bc" , "^(?:abc?)$" ) ) && ! REGEX( "abcc" , "^(?:abc?)$" ) ) && ! REGEX( "" , "^(?:abc?)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
