# QT3 test case re00972 of test set fn-matches.re, which tests the XPath expression
#   matches('33a34', '^(\d){0,2}a\1$')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L7958
ASK {
  BIND(REGEX( "33a34" , "^(\\d){0,2}a\\1$" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
