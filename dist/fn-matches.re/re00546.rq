# QT3 test case re00546 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('112233123,abcaabbccabc,abab', ',') satisfies matches($s, '^(?:([abc]+)|([123]+))$')) and (every $s in tokenize('1a,1a,x', ',') satisfies not(matches($s, '^(?:([abc]+)|([123]+))$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L4548
ASK {
  BIND(( ( ( REGEX( "112233123" , "^(?:([abc]+)|([123]+))$" ) && REGEX( "abcaabbccabc" , "^(?:([abc]+)|([123]+))$" ) ) && REGEX( "abab" , "^(?:([abc]+)|([123]+))$" ) ) && ( ( ! REGEX( "1a" , "^(?:([abc]+)|([123]+))$" ) && ! REGEX( "1a" , "^(?:([abc]+)|([123]+))$" ) ) && ! REGEX( "x" , "^(?:([abc]+)|([123]+))$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
