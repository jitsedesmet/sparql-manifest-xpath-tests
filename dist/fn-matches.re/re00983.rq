# QT3 test case re00983 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('first.last@seznam.cz,first-last@seznam.cz', ',') satisfies matches($s, '^(?:[\w\-\.]+@.*)$')) and (every $s in tokenize('first_last@seznam.cz', ',') satisfies not(matches($s, '^(?:[\w\-\.]+@.*)$')))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L8085
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( REGEX( "first.last@seznam.cz" , "^(?:[\\w\\-\\.]+@.*)$" ) && REGEX( "first-last@seznam.cz" , "^(?:[\\w\\-\\.]+@.*)$" ) ) && ! REGEX( "first_last@seznam.cz" , "^(?:[\\w\\-\\.]+@.*)$" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
