# QT3 test case re00188 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('𐍊', ',') satisfies matches($s, '^(?:\P{Nd}*)$')) and (every $s in tokenize('０𝟿', ',') satisfies not(matches($s, '^(?:\P{Nd}*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1634
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( REGEX( "𐍊" , "^(?:\\P{Nd}*)$" ) && ! REGEX( "０𝟿" , "^(?:\\P{Nd}*)$" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
