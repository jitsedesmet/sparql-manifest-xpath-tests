# QT3 test case re00889 of test set fn-matches.re, which tests the XPath expression
#   matches('qwerty','\n((?m)^b)')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L7293
ASK {
  BIND(REGEX( "qwerty" , "\\n((?m)^b)" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
