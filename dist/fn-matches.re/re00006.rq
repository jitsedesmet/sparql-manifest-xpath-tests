# QT3 test case re00006 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('a,b,c,d', ',') satisfies matches($s, '^(?:a|b|a|c|b|d|a)$')) and (every $s in tokenize('aa,ac,e', ',') satisfies not(matches($s, '^(?:a|b|a|c|b|d|a)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L55
ASK {
  BIND(( ( ( ( REGEX( "a" , "^(?:a|b|a|c|b|d|a)$" ) && REGEX( "b" , "^(?:a|b|a|c|b|d|a)$" ) ) && REGEX( "c" , "^(?:a|b|a|c|b|d|a)$" ) ) && REGEX( "d" , "^(?:a|b|a|c|b|d|a)$" ) ) && ( ( ! REGEX( "aa" , "^(?:a|b|a|c|b|d|a)$" ) && ! REGEX( "ac" , "^(?:a|b|a|c|b|d|a)$" ) ) && ! REGEX( "e" , "^(?:a|b|a|c|b|d|a)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
