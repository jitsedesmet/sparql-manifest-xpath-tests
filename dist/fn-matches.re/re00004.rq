# QT3 test case re00004 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize('a,b', ',') satisfies matches($s, '^(?:a|b)$')) and (every $s in tokenize('aa,bb,ab,', ',') satisfies not(matches($s, '^(?:a|b)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L39
ASK {
  BIND(( ( REGEX( "a" , "^(?:a|b)$" ) && REGEX( "b" , "^(?:a|b)$" ) ) && ( ( ( ! REGEX( "aa" , "^(?:a|b)$" ) && ! REGEX( "bb" , "^(?:a|b)$" ) ) && ! REGEX( "ab" , "^(?:a|b)$" ) ) && ! REGEX( "" , "^(?:a|b)$" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
