# QT3 test case re00163 of test set fn-matches.re, which tests the XPath expression
#   (every $s in tokenize(' ', ',') satisfies matches($s, '^(?:\p{Zl}*)$')) and (every $s in tokenize(' ', ',') satisfies not(matches($s, '^(?:\p{Zl}*)$')))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.re.xml#L1434
ASK {
  BIND(( REGEX( " " , "^(?:\\p{Zl}*)$" ) && ! REGEX( " " , "^(?:\\p{Zl}*)$" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
