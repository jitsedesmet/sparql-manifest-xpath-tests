# QT3 test case K-DateSubtractYMD-1 of test set op-subtract-yearMonthDuration-from-date, which tests the XPath expression
#   xs:date("1999-08-12") - xs:yearMonthDuration("P3Y7M") eq xs:date("1996-01-12")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-date.xml#L371
# The test needs the constructor function xsd:date, the constructor function xsd:yearMonthDuration, - on xsd:date, - on xsd:yearMonthDuration, = on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:date ( "1999-08-12" ) - xsd:yearMonthDuration ( "P3Y7M" ) ) = xsd:date ( "1996-01-12" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
