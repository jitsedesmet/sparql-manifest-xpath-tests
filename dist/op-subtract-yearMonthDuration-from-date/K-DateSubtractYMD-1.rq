# QT3 test case K-DateSubtractYMD-1 of test set op-subtract-yearMonthDuration-from-date, which tests the XPath expression
#   xs:date("1999-08-12") - xs:yearMonthDuration("P3Y7M") eq xs:date("1996-01-12")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-date.xml#L371
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "1999-08-12" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P3Y7M" ) ) = <http://www.w3.org/2001/XMLSchema#date> ( "1996-01-12" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
