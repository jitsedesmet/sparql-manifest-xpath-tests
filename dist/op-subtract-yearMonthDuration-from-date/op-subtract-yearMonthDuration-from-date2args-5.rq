# QT3 test case op-subtract-yearMonthDuration-from-date2args-5 of test set op-subtract-yearMonthDuration-from-date, which tests the XPath expression
#   xs:date("1970-01-01Z") - xs:yearMonthDuration("P2030Y12M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-date.xml#L79
# The test needs the constructor function xsd:date, the constructor function xsd:yearMonthDuration, - on xsd:date, - on xsd:yearMonthDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P2030Y12M" ) ) AS ?result)
  FILTER(( ( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-0062-01-01Z" ) || ( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-0061-01-01Z" ) ))
}
