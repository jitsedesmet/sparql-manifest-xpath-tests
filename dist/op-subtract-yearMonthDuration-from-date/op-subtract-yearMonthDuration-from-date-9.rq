# QT3 test case op-subtract-yearMonthDuration-from-date-9 of test set op-subtract-yearMonthDuration-from-date, which tests the XPath expression
#   fn:string((xs:date("1993-12-09Z") - xs:yearMonthDuration("P03Y03M"))) and fn:string((xs:date("1993-12-09Z") - xs:yearMonthDuration("P03Y03M")))
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#date> ( "1993-12-09Z" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P03Y03M" ) ) ) && <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#date> ( "1993-12-09Z" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P03Y03M" ) ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
