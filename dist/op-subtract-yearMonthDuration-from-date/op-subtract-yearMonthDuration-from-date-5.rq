# QT3 test case op-subtract-yearMonthDuration-from-date-5 of test set op-subtract-yearMonthDuration-from-date, which tests the XPath expression
#   fn:boolean(fn:string(xs:date("1962-03-12Z") - xs:yearMonthDuration("P10Y01M")))
ASK {
  BIND(!( ! <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#date> ( "1962-03-12Z" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P10Y01M" ) ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
