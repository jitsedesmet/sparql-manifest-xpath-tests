# QT3 test case op-subtract-yearMonthDuration-from-date-1 of test set op-subtract-yearMonthDuration-from-date, which tests the XPath expression
#   xs:date("2000-10-30") - xs:yearMonthDuration("P1Y2M")
# Expecting:
#   <assert-string-value>1999-08-30</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-date.xml#L100
# The test needs the constructor function xsd:date, the constructor function xsd:yearMonthDuration, - on xsd:date, - on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:date ( "2000-10-30" ) - xsd:yearMonthDuration ( "P1Y2M" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1999-08-30" ))
}
