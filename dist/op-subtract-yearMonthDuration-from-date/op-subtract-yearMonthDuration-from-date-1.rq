# QT3 test case op-subtract-yearMonthDuration-from-date-1 of test set op-subtract-yearMonthDuration-from-date, which tests the XPath expression
#   xs:date("2000-10-30") - xs:yearMonthDuration("P1Y2M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "2000-10-30" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1Y2M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1999-08-30" ))
}
