# QT3 test case op-subtract-yearMonthDuration-from-date-4 of test set op-subtract-yearMonthDuration-from-date, which tests the XPath expression
#   fn:not(fn:string(xs:date("1998-09-12Z") - xs:yearMonthDuration("P20Y03M")))
ASK {
  BIND(! <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#date> ( "1998-09-12Z" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P20Y03M" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
