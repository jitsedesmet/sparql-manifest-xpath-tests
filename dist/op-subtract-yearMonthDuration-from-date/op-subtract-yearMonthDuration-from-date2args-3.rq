# QT3 test case op-subtract-yearMonthDuration-from-date2args-3 of test set op-subtract-yearMonthDuration-from-date, which tests the XPath expression
#   xs:date("2030-12-31Z") - xs:yearMonthDuration("P0Y0M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "2030-12-31Z" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P0Y0M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2030-12-31Z" ))
}
