# QT3 test case op-subtract-yearMonthDuration-from-date-13 of test set op-subtract-yearMonthDuration-from-date, which tests the XPath expression
#   (xs:date("1980-05-05Z") - xs:yearMonthDuration("P23Y11M")) eq xs:date("1980-05-05Z")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-date.xml#L276
# The test needs the constructor function xsd:date, the constructor function xsd:yearMonthDuration, - on xsd:date, - on xsd:yearMonthDuration, = on xsd:date, which SPARQL does not define
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "1980-05-05Z" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P23Y11M" ) ) = <http://www.w3.org/2001/XMLSchema#date> ( "1980-05-05Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
