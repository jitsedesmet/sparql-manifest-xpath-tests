# QT3 test case op-subtract-yearMonthDuration-from-date-14 of test set op-subtract-yearMonthDuration-from-date, which tests the XPath expression
#   (xs:date("1979-12-12Z") - xs:yearMonthDuration("P08Y08M")) ne xs:date("1979-12-12Z")
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "1979-12-12Z" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P08Y08M" ) ) != <http://www.w3.org/2001/XMLSchema#date> ( "1979-12-12Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
