# QT3 test case op-subtract-yearMonthDuration-from-date2args-2 of test set op-subtract-yearMonthDuration-from-date, which tests the XPath expression
#   xs:date("1983-11-17Z") - xs:yearMonthDuration("P0Y0M")
# Expecting:
#   <assert-string-value>1983-11-17Z</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-date.xml#L25
# The test needs the constructor function xsd:date, the constructor function xsd:yearMonthDuration, - on xsd:date, - on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:date ( "1983-11-17Z" ) - xsd:yearMonthDuration ( "P0Y0M" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1983-11-17Z" ))
}
