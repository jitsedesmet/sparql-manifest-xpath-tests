# QT3 test case op-subtract-yearMonthDuration-from-date-3 of test set op-subtract-yearMonthDuration-from-date, which tests the XPath expression
#   xs:date("2000-10-31-05:00") - xs:yearMonthDuration("P1Y1M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "2000-10-31-05:00" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1Y1M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1999-09-30-05:00" ))
}
