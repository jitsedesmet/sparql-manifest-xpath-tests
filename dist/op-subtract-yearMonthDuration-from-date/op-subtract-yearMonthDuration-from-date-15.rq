# QT3 test case op-subtract-yearMonthDuration-from-date-15 of test set op-subtract-yearMonthDuration-from-date, which tests the XPath expression
#   (xs:date("1978-12-12Z") - xs:yearMonthDuration("P17Y12M")) le xs:date("1978-12-12Z")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-yearMonthDuration-from-date.xml#L308
# The test needs the constructor function xsd:date, the constructor function xsd:yearMonthDuration, - on xsd:date, - on xsd:yearMonthDuration, <= on xsd:date, which SPARQL does not define
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "1978-12-12Z" ) - <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P17Y12M" ) ) <= <http://www.w3.org/2001/XMLSchema#date> ( "1978-12-12Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
