# QT3 test case fn-seconds-from-time-14 of test set fn-seconds-from-time, which tests the XPath expression
#   +fn:seconds-from-time(xs:time("10:00:01Z"))
ASK {
  BIND(+ SECONDS( <http://www.w3.org/2001/XMLSchema#time> ( "10:00:01Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1" ))
}
