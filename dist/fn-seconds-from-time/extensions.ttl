  ) .

<#fn-seconds-from-time1args-1> a mf:QueryEvaluationTest ;
  mf:name "fn-seconds-from-time1args-1" ;
  rdfs:comment "Evaluates The \"seconds-from-time\" function with the arguments set as follows: $arg = xs:time(lower bound)" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/seconds-from-time.xml> ;
  mf:action [ qt:query <fn-seconds-from-time1args-1.rq> ] ;
  mf:result <../true.srj> .

<#fn-seconds-from-time1args-2> a mf:QueryEvaluationTest ;
  mf:name "fn-seconds-from-time1args-2" ;
  rdfs:comment "Evaluates The \"seconds-from-time\" function with the arguments set as follows: $arg = xs:time(mid range)" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/seconds-from-time.xml> ;
  mf:action [ qt:query <fn-seconds-from-time1args-2.rq> ] ;
  mf:result <../true.srj> .

<#fn-seconds-from-time1args-3> a mf:QueryEvaluationTest ;
  mf:name "fn-seconds-from-time1args-3" ;
  rdfs:comment "Evaluates The \"seconds-from-time\" function with the arguments set as follows: $arg = xs:time(upper bound)" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/seconds-from-time.xml> ;
