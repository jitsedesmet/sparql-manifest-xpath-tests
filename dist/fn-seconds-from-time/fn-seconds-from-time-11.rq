# QT3 test case fn-seconds-from-time-11 of test set fn-seconds-from-time, which tests the XPath expression
#   fn:seconds-from-time(xs:time("22:33:10Z")) div fn:seconds-from-time(xs:time("02:11:02Z"))
ASK {
  BIND(( SECONDS( <http://www.w3.org/2001/XMLSchema#time> ( "22:33:10Z" ) ) / SECONDS( <http://www.w3.org/2001/XMLSchema#time> ( "02:11:02Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "5" ))
}
