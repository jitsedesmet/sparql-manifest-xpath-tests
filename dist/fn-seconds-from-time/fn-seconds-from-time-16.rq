# QT3 test case fn-seconds-from-time-16 of test set fn-seconds-from-time, which tests the XPath expression
#   fn:seconds-from-time(xs:time("10:02:01Z")) eq fn:seconds-from-time(xs:time("10:02:00Z"))
ASK {
  BIND(( SECONDS( <http://www.w3.org/2001/XMLSchema#time> ( "10:02:01Z" ) ) = SECONDS( <http://www.w3.org/2001/XMLSchema#time> ( "10:02:00Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
