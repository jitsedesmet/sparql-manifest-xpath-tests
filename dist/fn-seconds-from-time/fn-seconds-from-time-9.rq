# QT3 test case fn-seconds-from-time-9 of test set fn-seconds-from-time, which tests the XPath expression
#   fn:seconds-from-time(xs:time("10:10:10Z")) - fn:seconds-from-time(xs:time("09:02:07Z"))
ASK {
  BIND(( SECONDS( <http://www.w3.org/2001/XMLSchema#time> ( "10:10:10Z" ) ) - SECONDS( <http://www.w3.org/2001/XMLSchema#time> ( "09:02:07Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "3" ))
}
