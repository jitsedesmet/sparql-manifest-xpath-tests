# QT3 test case fn-seconds-from-time-1 of test set fn-seconds-from-time, which tests the XPath expression
#   fn:seconds-from-time(xs:time("13:20:10.5"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/seconds-from-time.xml#L34
# The test needs the constructor function xsd:time, SECONDS on xsd:time, which SPARQL does not define
ASK {
  BIND(SECONDS( <http://www.w3.org/2001/XMLSchema#time> ( "13:20:10.5" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "10.5" ))
}
