# QT3 test case fn-seconds-from-time-6 of test set fn-seconds-from-time, which tests the XPath expression
#   fn:hours-from-time(xs:time("00:59:00Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/seconds-from-time.xml#L79
ASK {
  BIND(HOURS( <http://www.w3.org/2001/XMLSchema#time> ( "00:59:00Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0" ))
}
