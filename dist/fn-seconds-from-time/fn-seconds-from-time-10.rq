# QT3 test case fn-seconds-from-time-10 of test set fn-seconds-from-time, which tests the XPath expression
#   fn:seconds-from-time(xs:time("02:02:03Z")) * fn:seconds-from-time(xs:time("10:08:09Z"))
ASK {
  BIND(( SECONDS( <http://www.w3.org/2001/XMLSchema#time> ( "02:02:03Z" ) ) * SECONDS( <http://www.w3.org/2001/XMLSchema#time> ( "10:08:09Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "27" ))
}
