# QT3 test case fn-seconds-from-time1args-2 of test set fn-seconds-from-time, which tests the XPath expression
#   fn:seconds-from-time(xs:time("08:03:35Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/seconds-from-time.xml#L16
ASK {
  BIND(SECONDS( <http://www.w3.org/2001/XMLSchema#time> ( "08:03:35Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "35" ))
}
