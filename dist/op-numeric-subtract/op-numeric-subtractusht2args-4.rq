# QT3 test case op-numeric-subtractusht2args-4 of test set op-numeric-subtract, which tests the XPath expression
#   xs:unsignedShort("44633") - xs:unsignedShort("44633")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L304
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "44633"^^xsd:unsignedShort - "44633"^^xsd:unsignedShort ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "0"^^xsd:integer ) ))
}
