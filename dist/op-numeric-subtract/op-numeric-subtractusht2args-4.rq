# QT3 test case op-numeric-subtractusht2args-4 of test set op-numeric-subtract, which tests the XPath expression
#   xs:unsignedShort("44633") - xs:unsignedShort("44633")
ASK {
  BIND(( "44633"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> - "44633"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
