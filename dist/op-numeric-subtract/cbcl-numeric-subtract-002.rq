ASK {
  BIND(( ( - "79228162514264337593543950335"^^<http://www.w3.org/2001/XMLSchema#integer> - "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) < "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
