# QT3 test case K-NumericSubtract-22 of test set op-numeric-subtract, which tests the XPath expression
#   string(xs:double("NaN") - 3) eq "NaN"
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L826
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:double ( "NaN" ) - "3"^^xsd:integer ) ) = "NaN" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
