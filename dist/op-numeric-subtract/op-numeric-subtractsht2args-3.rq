# QT3 test case op-numeric-subtractsht2args-3 of test set op-numeric-subtract, which tests the XPath expression
#   xs:short("-1") - xs:short("-32768")
ASK {
  BIND(( "-1"^^<http://www.w3.org/2001/XMLSchema#short> - "-32768"^^<http://www.w3.org/2001/XMLSchema#short> ) AS ?result)
  FILTER(( ?result = "32767"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
