# QT3 test case op-numeric-subtractsht2args-3 of test set op-numeric-subtract, which tests the XPath expression
#   xs:short("-1") - xs:short("-32768")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L520
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-1"^^xsd:short - "-32768"^^xsd:short ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "32767"^^xsd:integer ) ))
}
