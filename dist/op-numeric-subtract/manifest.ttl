<#op-numeric-subtractint2args-1> a mf:QueryEvaluationTest ;
  mf:name "op-numeric-subtractint2args-1" ;
  rdfs:comment "Evaluates The \"op:numeric-subtract\" operator with the arguments set as follows: $arg1 = xs:int(lower bound) $arg2 = xs:int(lower bound)" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml> ;
  mf:action [ qt:query <op-numeric-subtractint2args-1.rq> ] ;
  mf:result <../true.srj> .

