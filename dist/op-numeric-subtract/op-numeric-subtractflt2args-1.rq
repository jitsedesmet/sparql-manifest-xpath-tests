# QT3 test case op-numeric-subtractflt2args-1 of test set op-numeric-subtract, which tests the XPath expression
#   xs:float("-3.4028235E38") - xs:float("-3.4028235E38")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "-3.4028235E38" ) - <http://www.w3.org/2001/XMLSchema#float> ( "-3.4028235E38" ) ) AS ?result)
