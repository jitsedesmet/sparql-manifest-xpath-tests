# QT3 test case op-numeric-subtractflt2args-1 of test set op-numeric-subtract, which tests the XPath expression
#   xs:float("-3.4028235E38") - xs:float("-3.4028235E38")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L187
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:float ( "-3.4028235E38" ) - xsd:float ( "-3.4028235E38" ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "0"^^xsd:integer ) ))
}
