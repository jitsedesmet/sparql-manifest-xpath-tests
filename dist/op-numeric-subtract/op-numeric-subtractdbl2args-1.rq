# QT3 test case op-numeric-subtractdbl2args-1 of test set op-numeric-subtract, which tests the XPath expression
#   xs:double("-1.7976931348623157E308") - xs:double("-1.7976931348623157E308")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L142
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( "-1.7976931348623157E308" ) - <http://www.w3.org/2001/XMLSchema#double> ( "-1.7976931348623157E308" ) ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
