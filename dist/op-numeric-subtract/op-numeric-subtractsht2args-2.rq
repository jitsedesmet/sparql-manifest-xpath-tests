# QT3 test case op-numeric-subtractsht2args-2 of test set op-numeric-subtract, which tests the XPath expression
#   xs:short("-5324") - xs:short("-32768")
ASK {
  BIND(( "-5324"^^<http://www.w3.org/2001/XMLSchema#short> - "-32768"^^<http://www.w3.org/2001/XMLSchema#short> ) AS ?result)
  FILTER(( ?result = "27444"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
