# QT3 test case op-numeric-subtractint2args-5 of test set op-numeric-subtract, which tests the XPath expression
#   xs:int("-1") - xs:int("2147483647")
ASK {
  BIND(( "-1"^^<http://www.w3.org/2001/XMLSchema#int> - "2147483647"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( ?result = - "2147483648"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
