# QT3 test case op-numeric-subtractint2args-2 of test set op-numeric-subtract, which tests the XPath expression
#   xs:int("-1873914410") - xs:int("-2147483648")
ASK {
  BIND(( "-1873914410"^^<http://www.w3.org/2001/XMLSchema#int> - "-2147483648"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( ?result = "273569238"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
