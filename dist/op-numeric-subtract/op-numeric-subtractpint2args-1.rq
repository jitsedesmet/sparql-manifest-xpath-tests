# QT3 test case op-numeric-subtractpint2args-1 of test set op-numeric-subtract, which tests the XPath expression
#   xs:positiveInteger("52704602390610033") - xs:positiveInteger("1")
ASK {
  BIND(( "52704602390610033"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> - "1"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) AS ?result)
  FILTER(( ?result = "52704602390610032"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
