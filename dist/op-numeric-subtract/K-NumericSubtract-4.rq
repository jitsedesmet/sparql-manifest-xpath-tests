# QT3 test case K-NumericSubtract-4 of test set op-numeric-subtract, which tests the XPath expression
#   xs:float(5) - xs:float(1) eq 4
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L664
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:float ( "5"^^xsd:integer ) - xsd:float ( "1"^^xsd:integer ) ) = "4"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
