# QT3 test case K2-NumericSubtract-1 of test set op-numeric-subtract, which tests the XPath expression
#   0 - xs:double(0)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L997
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#integer> - <http://www.w3.org/2001/XMLSchema#double> ( "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
