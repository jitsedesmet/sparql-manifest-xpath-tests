# QT3 test case op-numeric-subtractnni2args-5 of test set op-numeric-subtract, which tests the XPath expression
#   xs:nonNegativeInteger("999999999999999999") - xs:nonNegativeInteger("999999999999999999")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L493
ASK {
  BIND(( "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> - "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
