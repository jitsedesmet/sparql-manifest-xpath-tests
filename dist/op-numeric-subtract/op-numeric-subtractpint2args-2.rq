# QT3 test case op-numeric-subtractpint2args-2 of test set op-numeric-subtract, which tests the XPath expression
#   xs:positiveInteger("999999999999999999") - xs:positiveInteger("1")
ASK {
  BIND(( "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> - "1"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) AS ?result)
  FILTER(( ?result = "999999999999999998"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
