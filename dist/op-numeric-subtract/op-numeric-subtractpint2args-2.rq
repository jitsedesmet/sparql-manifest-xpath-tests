# QT3 test case op-numeric-subtractpint2args-2 of test set op-numeric-subtract, which tests the XPath expression
#   xs:positiveInteger("999999999999999999") - xs:positiveInteger("1")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L349
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "999999999999999999"^^xsd:positiveInteger - "1"^^xsd:positiveInteger ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "999999999999999998"^^xsd:integer ) ))
}
