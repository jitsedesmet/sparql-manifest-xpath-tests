# QT3 test case K-NumericSubtract-1 of test set op-numeric-subtract, which tests the XPath expression
#   xs:double(6) - xs:double(2) eq 4
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L637
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:double ( "6"^^xsd:integer ) - xsd:double ( "2"^^xsd:integer ) ) = "4"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
