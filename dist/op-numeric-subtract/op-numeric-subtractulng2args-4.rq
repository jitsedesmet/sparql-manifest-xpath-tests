# QT3 test case op-numeric-subtractulng2args-4 of test set op-numeric-subtract, which tests the XPath expression
#   xs:unsignedLong("130747108607674654") - xs:unsignedLong("130747108607674654")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L394
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "130747108607674654"^^xsd:unsignedLong - "130747108607674654"^^xsd:unsignedLong ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "0"^^xsd:integer ) ))
}
