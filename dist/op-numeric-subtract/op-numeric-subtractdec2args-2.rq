# QT3 test case op-numeric-subtractdec2args-2 of test set op-numeric-subtract, which tests the XPath expression
#   xs:decimal("0") - xs:decimal("-999999999999999999")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L106
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( "0" ) - <http://www.w3.org/2001/XMLSchema#decimal> ( "-999999999999999999" ) ) AS ?result)
  FILTER(( ?result = "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
