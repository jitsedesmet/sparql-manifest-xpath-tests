# QT3 test case op-numeric-subtractusht2args-3 of test set op-numeric-subtract, which tests the XPath expression
#   xs:unsignedShort("65535") - xs:unsignedShort("0")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L295
ASK {
  BIND(( "65535"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> - "0"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) AS ?result)
  FILTER(( ?result = "65535"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
