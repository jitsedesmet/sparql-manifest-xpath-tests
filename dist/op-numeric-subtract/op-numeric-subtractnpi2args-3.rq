# QT3 test case op-numeric-subtractnpi2args-3 of test set op-numeric-subtract, which tests the XPath expression
#   xs:nonPositiveInteger("-999999999999999999") - xs:nonPositiveInteger("-999999999999999999")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L430
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-999999999999999999"^^xsd:nonPositiveInteger - "-999999999999999999"^^xsd:nonPositiveInteger ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "0"^^xsd:integer ) ))
}
