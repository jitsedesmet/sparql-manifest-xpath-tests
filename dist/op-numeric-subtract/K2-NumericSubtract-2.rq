# QT3 test case K2-NumericSubtract-2 of test set op-numeric-subtract, which tests the XPath expression
#   0 - xs:float(0)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L1006
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "0"^^xsd:integer - xsd:float ( "0"^^xsd:integer ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "0"^^xsd:integer ) ))
}
