# QT3 test case op-numeric-subtractflt2args-2 of test set op-numeric-subtract, which tests the XPath expression
#   xs:float("0") - xs:float("-3.4028235E38")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L196
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "0" ) - <http://www.w3.org/2001/XMLSchema#float> ( "-3.4028235E38" ) ) AS ?result)
  FILTER(( ?result = <http://www.w3.org/2001/XMLSchema#float> ( "3.4028235E38"^^<http://www.w3.org/2001/XMLSchema#double> ) ))
}
