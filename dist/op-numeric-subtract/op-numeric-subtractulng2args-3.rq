# QT3 test case op-numeric-subtractulng2args-3 of test set op-numeric-subtract, which tests the XPath expression
#   xs:unsignedLong("184467440737095516") - xs:unsignedLong("0")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L385
ASK {
  BIND(( "184467440737095516"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> - "0"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( ?result = "184467440737095516"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
