# QT3 test case op-numeric-subtractintg2args-3 of test set op-numeric-subtract, which tests the XPath expression
#   xs:integer("0") - xs:integer("-999999999999999999")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L70
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#integer> ( "0" ) - <http://www.w3.org/2001/XMLSchema#integer> ( "-999999999999999999" ) ) AS ?result)
  FILTER(( ?result = "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
