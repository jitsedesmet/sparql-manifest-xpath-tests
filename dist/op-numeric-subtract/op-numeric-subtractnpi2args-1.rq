# QT3 test case op-numeric-subtractnpi2args-1 of test set op-numeric-subtract, which tests the XPath expression
#   xs:nonPositiveInteger("-999999999999999999") - xs:nonPositiveInteger("-999999999999999999")
ASK {
  BIND(( "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> - "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
