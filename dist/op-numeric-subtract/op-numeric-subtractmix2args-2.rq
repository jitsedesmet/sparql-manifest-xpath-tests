# QT3 test case op-numeric-subtractmix2args-2 of test set op-numeric-subtract, which tests the XPath expression
#   1 - '1'
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L559
ASK {
  BIND(( "1"^^<http://www.w3.org/2001/XMLSchema#integer> - "1" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
