# QT3 test case op-numeric-subtractulng2args-2 of test set op-numeric-subtract, which tests the XPath expression
#   xs:unsignedLong("130747108607674654") - xs:unsignedLong("0")
ASK {
  BIND(( "130747108607674654"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> - "0"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( ?result = "130747108607674654"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
