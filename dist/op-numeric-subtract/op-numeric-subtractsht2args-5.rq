# QT3 test case op-numeric-subtractsht2args-5 of test set op-numeric-subtract, which tests the XPath expression
#   xs:short("-1") - xs:short("32767")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L538
ASK {
  BIND(( "-1"^^<http://www.w3.org/2001/XMLSchema#short> - "32767"^^<http://www.w3.org/2001/XMLSchema#short> ) AS ?result)
  FILTER(( ?result = - "32768"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
