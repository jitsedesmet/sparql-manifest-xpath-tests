# QT3 test case op-numeric-subtractintg2args-1 of test set op-numeric-subtract, which tests the XPath expression
#   xs:integer("-999999999999999999") - xs:integer("-999999999999999999")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#integer> ( "-999999999999999999" ) - <http://www.w3.org/2001/XMLSchema#integer> ( "-999999999999999999" ) ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
