# QT3 test case op-numeric-subtractmix2args-3 of test set op-numeric-subtract, which tests the XPath expression
#   1 - xs:integer('1')
ASK {
  BIND(( "1"^^<http://www.w3.org/2001/XMLSchema#integer> - <http://www.w3.org/2001/XMLSchema#integer> ( "1" ) ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
