# QT3 test case K-NumericSubtract-25 of test set op-numeric-subtract, which tests the XPath expression
#   "3" - "3"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L853
ASK {
  BIND(( "3" - "3" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
