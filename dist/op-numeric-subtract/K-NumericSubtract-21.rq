# QT3 test case K-NumericSubtract-21 of test set op-numeric-subtract, which tests the XPath expression
#   string(xs:float("NaN") - 3) eq "NaN"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L817
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#float> ( "NaN" ) - "3"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) = "NaN" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
