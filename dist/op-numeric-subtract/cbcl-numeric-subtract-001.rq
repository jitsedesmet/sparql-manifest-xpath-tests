# QT3 test case cbcl-numeric-subtract-001 of test set op-numeric-subtract, which tests the XPath expression
#   -79228162514264337593543950335.0 - 1.0 lt 0.0
# Expecting:
#   <any-of>
#     <assert-true/>
#     <error code="FOAR0002"/>
#   </any-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L1062
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( - "79228162514264337593543950335.0"^^xsd:decimal - "1.0"^^xsd:decimal ) < "0.0"^^xsd:decimal ) AS ?result)
  FILTER(( ( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ) || ! BOUND( ?result ) ))
}
