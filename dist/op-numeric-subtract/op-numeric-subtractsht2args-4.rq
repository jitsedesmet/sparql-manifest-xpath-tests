# QT3 test case op-numeric-subtractsht2args-4 of test set op-numeric-subtract, which tests the XPath expression
#   xs:short("-32768") - xs:short("-5324")
ASK {
  BIND(( "-32768"^^<http://www.w3.org/2001/XMLSchema#short> - "-5324"^^<http://www.w3.org/2001/XMLSchema#short> ) AS ?result)
  FILTER(( ?result = - "27444"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
