# QT3 test case K-NumericSubtract-3 of test set op-numeric-subtract, which tests the XPath expression
#   xs:integer(6) - xs:integer(2) eq 4
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#integer> ( "6"^^<http://www.w3.org/2001/XMLSchema#integer> ) - <http://www.w3.org/2001/XMLSchema#integer> ( "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) = "4"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
