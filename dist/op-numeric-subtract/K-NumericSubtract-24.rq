# QT3 test case K-NumericSubtract-24 of test set op-numeric-subtract, which tests the XPath expression
#   string(3 - xs:double("NaN")) eq "NaN"
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L844
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( "3"^^xsd:integer - xsd:double ( "NaN" ) ) ) = "NaN" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
