# QT3 test case K-NumericSubtract-24 of test set op-numeric-subtract, which tests the XPath expression
#   string(3 - xs:double("NaN")) eq "NaN"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( "3"^^<http://www.w3.org/2001/XMLSchema#integer> - <http://www.w3.org/2001/XMLSchema#double> ( "NaN" ) ) ) = "NaN" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
