# QT3 test case op-numeric-subtractnint2args-2 of test set op-numeric-subtract, which tests the XPath expression
#   xs:negativeInteger("-999999999999999999") - xs:negativeInteger("-1")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L331
ASK {
  BIND(( "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> - "-1"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> ) AS ?result)
  FILTER(( ?result = - "999999999999999998"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
