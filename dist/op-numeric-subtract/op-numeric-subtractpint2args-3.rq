# QT3 test case op-numeric-subtractpint2args-3 of test set op-numeric-subtract, which tests the XPath expression
#   xs:positiveInteger("52704602390610034") - xs:positiveInteger("52704602390610033")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L358
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "52704602390610034"^^xsd:positiveInteger - "52704602390610033"^^xsd:positiveInteger ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "1"^^xsd:integer ) ))
}
