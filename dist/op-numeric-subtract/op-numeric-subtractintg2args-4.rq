# QT3 test case op-numeric-subtractintg2args-4 of test set op-numeric-subtract, which tests the XPath expression
#   xs:integer("-169006502882975695") - xs:integer("830993497117024304")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#integer> ( "-169006502882975695" ) - <http://www.w3.org/2001/XMLSchema#integer> ( "830993497117024304" ) ) AS ?result)
