# QT3 test case op-numeric-subtractdec2args-4 of test set op-numeric-subtract, which tests the XPath expression
#   xs:decimal("-382624808391485160") - xs:decimal("617375191608514839")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-subtract.xml#L124
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:decimal ( "-382624808391485160" ) - xsd:decimal ( "617375191608514839" ) ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-999999999999999999"^^xsd:integer ) ))
}
