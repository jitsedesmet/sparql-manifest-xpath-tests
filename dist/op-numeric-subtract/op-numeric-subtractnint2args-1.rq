# QT3 test case op-numeric-subtractnint2args-1 of test set op-numeric-subtract, which tests the XPath expression
#   xs:negativeInteger("-999999999999999999") - xs:negativeInteger("-297014075999096793")
ASK {
  BIND(( "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> - "-297014075999096793"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> ) AS ?result)
  FILTER(( ?result = - "702985924000903206"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
