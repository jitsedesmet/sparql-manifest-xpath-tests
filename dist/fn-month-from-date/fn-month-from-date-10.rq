# QT3 test case fn-month-from-date-10 of test set fn-month-from-date, which tests the XPath expression
#   fn:month-from-date(xs:date("1970-01-01Z")) * fn:month-from-date(xs:date("0002-01-01Z"))
# Expecting:
#   <assert-string-value>1</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/month-from-date.xml#L115
# The test needs the constructor function xsd:date, MONTH on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( MONTH( xsd:date ( "1970-01-01Z" ) ) * MONTH( xsd:date ( "0002-01-01Z" ) ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1" ))
}
