# QT3 test case K-MonthFromDateFunc-5 of test set fn-month-from-date, which tests the XPath expression
#   month-from-date(xs:date("2000-02-03")) eq 2
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/month-from-date.xml#L241
# The test needs the constructor function xsd:date, MONTH on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( MONTH( xsd:date ( "2000-02-03" ) ) = "2"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
