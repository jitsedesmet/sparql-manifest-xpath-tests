# QT3 test case fn-month-from-date-4 of test set fn-month-from-date, which tests the XPath expression
#   fn:month-from-date(xs:date("1999-12-31Z")) le fn:month-from-date(xs:date("1999-12-31Z"))
ASK {
  BIND(( MONTH( <http://www.w3.org/2001/XMLSchema#date> ( "1999-12-31Z" ) ) <= MONTH( <http://www.w3.org/2001/XMLSchema#date> ( "1999-12-31Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
