# QT3 test case fn-month-from-date1args-2 of test set fn-month-from-date, which tests the XPath expression
#   fn:month-from-date(xs:date("1983-11-17Z"))
ASK {
  BIND(MONTH( <http://www.w3.org/2001/XMLSchema#date> ( "1983-11-17Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "11" ))
}
