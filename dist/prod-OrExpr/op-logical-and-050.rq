# QT3 test case op-logical-and-050 of test set prod-OrExpr, which tests the XPath expression
#   xs:double(-1) and xs:double(0)
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/OrExpr.xml#L509
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:double ( - "1"^^xsd:integer ) && xsd:double ( "0"^^xsd:integer ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
