# QT3 test case op-logical-and-069 of test set prod-OrExpr, which tests the XPath expression
#   xs:integer(0) and xs:integer(0)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/OrExpr.xml#L705
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#integer> ( "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) && <http://www.w3.org/2001/XMLSchema#integer> ( "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
