# QT3 test case op-logical-and-053 of test set prod-OrExpr, which tests the XPath expression
#   xs:double('NaN') and xs:double(1)
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( "NaN" ) && <http://www.w3.org/2001/XMLSchema#double> ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
