# QT3 test case op-logical-and-057 of test set prod-OrExpr, which tests the XPath expression
#   xs:double('INF') and xs:double('NaN')
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( "INF" ) && <http://www.w3.org/2001/XMLSchema#double> ( "NaN" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
