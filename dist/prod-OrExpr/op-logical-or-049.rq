# QT3 test case op-logical-or-049 of test set prod-OrExpr, which tests the XPath expression
#   xs:double(0) or xs:double(1)
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) || <http://www.w3.org/2001/XMLSchema#double> ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
