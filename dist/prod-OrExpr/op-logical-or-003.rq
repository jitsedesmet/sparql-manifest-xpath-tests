# QT3 test case op-logical-or-003 of test set prod-OrExpr, which tests the XPath expression
#   false() or true()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/OrExpr.xml#L1635
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "false"^^xsd:boolean || "true"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
