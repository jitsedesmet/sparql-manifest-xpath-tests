# QT3 test case op-logical-or-023 of test set prod-OrExpr, which tests the XPath expression
#   xs:string("abc") or xs:string('')
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( "abc" ) || <http://www.w3.org/2001/XMLSchema#string> ( "" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
