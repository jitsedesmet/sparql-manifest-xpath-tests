# QT3 test case op-logical-and-054 of test set prod-OrExpr, which tests the XPath expression
#   xs:double('NaN') and xs:double('NaN')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/OrExpr.xml#L549
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( "NaN" ) && <http://www.w3.org/2001/XMLSchema#double> ( "NaN" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
