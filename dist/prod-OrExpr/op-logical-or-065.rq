# QT3 test case op-logical-or-065 of test set prod-OrExpr, which tests the XPath expression
#   xs:decimal(1) or xs:decimal(-1)
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) || <http://www.w3.org/2001/XMLSchema#decimal> ( - "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
