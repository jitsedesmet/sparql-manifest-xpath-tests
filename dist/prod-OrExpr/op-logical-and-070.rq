# QT3 test case op-logical-and-070 of test set prod-OrExpr, which tests the XPath expression
#   xs:integer(0) and xs:integer(1)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/OrExpr.xml#L715
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:integer ( "0"^^xsd:integer ) && xsd:integer ( "1"^^xsd:integer ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
