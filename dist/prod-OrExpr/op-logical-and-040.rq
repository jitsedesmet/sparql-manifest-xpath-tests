# QT3 test case op-logical-and-040 of test set prod-OrExpr, which tests the XPath expression
#   xs:float('NaN') and xs:float('NaN')
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "NaN" ) && <http://www.w3.org/2001/XMLSchema#float> ( "NaN" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
