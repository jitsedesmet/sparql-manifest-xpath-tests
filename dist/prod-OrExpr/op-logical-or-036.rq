# QT3 test case op-logical-or-036 of test set prod-OrExpr, which tests the XPath expression
#   xs:float(-1) or xs:float(0)
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/OrExpr.xml#L1968
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:float ( - "1"^^xsd:integer ) || xsd:float ( "0"^^xsd:integer ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
