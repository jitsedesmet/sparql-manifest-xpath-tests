# QT3 test case op-logical-or-066 of test set prod-OrExpr, which tests the XPath expression
#   xs:decimal(9.99999999999999999999999999) or xs:decimal(0)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/OrExpr.xml#L2268
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:decimal ( "9.99999999999999999999999999"^^xsd:decimal ) || xsd:decimal ( "0"^^xsd:integer ) ) AS ?result)
  FILTER(( ( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ) || ! BOUND( ?result ) ))
}
