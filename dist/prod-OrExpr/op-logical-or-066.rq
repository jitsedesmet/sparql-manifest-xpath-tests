# QT3 test case op-logical-or-066 of test set prod-OrExpr, which tests the XPath expression
#   xs:decimal(9.99999999999999999999999999) or xs:decimal(0)
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( "9.99999999999999999999999999"^^<http://www.w3.org/2001/XMLSchema#decimal> ) || <http://www.w3.org/2001/XMLSchema#decimal> ( "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ) || ! BOUND( ?result ) ))
}
