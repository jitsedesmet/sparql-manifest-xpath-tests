# QT3 test case op-logical-and-064 of test set prod-OrExpr, which tests the XPath expression
#   xs:decimal(-1) and xs:decimal(0)
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( - "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) && <http://www.w3.org/2001/XMLSchema#decimal> ( "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
