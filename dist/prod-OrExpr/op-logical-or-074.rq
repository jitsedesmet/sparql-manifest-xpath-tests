# QT3 test case op-logical-or-074 of test set prod-OrExpr, which tests the XPath expression
#   xs:integer(-99999999999999999) or xs:integer(1)
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#integer> ( - "99999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ) || <http://www.w3.org/2001/XMLSchema#integer> ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
