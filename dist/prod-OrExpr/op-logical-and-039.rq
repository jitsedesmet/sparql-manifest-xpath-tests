# QT3 test case op-logical-and-039 of test set prod-OrExpr, which tests the XPath expression
#   xs:float('NaN') and xs:float(1)
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "NaN" ) && <http://www.w3.org/2001/XMLSchema#float> ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
