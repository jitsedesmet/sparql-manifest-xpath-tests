# QT3 test case op-logical-or-021 of test set prod-OrExpr, which tests the XPath expression
#   xs:string("") or xs:string('')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/OrExpr.xml#L1818
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( "" ) || <http://www.w3.org/2001/XMLSchema#string> ( "" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
