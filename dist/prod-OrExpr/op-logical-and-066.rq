# QT3 test case op-logical-and-066 of test set prod-OrExpr, which tests the XPath expression
#   xs:decimal(9.99999999999999999999999999) and xs:decimal(0)
# Expecting:
#   <any-of>
#      <assert-false/>
#      <error code="FOCA0006"/>
#   </any-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/OrExpr.xml#L669
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:decimal ( "9.99999999999999999999999999"^^xsd:decimal ) && xsd:decimal ( "0"^^xsd:integer ) ) AS ?result)
  FILTER(( ( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ) || ! BOUND( ?result ) ))
}
