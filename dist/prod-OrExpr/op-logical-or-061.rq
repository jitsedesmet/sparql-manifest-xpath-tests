# QT3 test case op-logical-or-061 of test set prod-OrExpr, which tests the XPath expression
#   xs:double('-INF') or xs:double('INF')
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( "-INF" ) || <http://www.w3.org/2001/XMLSchema#double> ( "INF" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
