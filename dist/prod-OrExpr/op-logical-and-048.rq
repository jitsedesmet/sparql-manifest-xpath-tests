# QT3 test case op-logical-and-048 of test set prod-OrExpr, which tests the XPath expression
#   xs:double(0) and xs:double(0)
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) && <http://www.w3.org/2001/XMLSchema#double> ( "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
