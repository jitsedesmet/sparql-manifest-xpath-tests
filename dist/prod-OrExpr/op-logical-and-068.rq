# QT3 test case op-logical-and-068 of test set prod-OrExpr, which tests the XPath expression
#   xs:decimal(9.99999999999999999999999999) and xs:decimal(-123456789.123456789123456789)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/OrExpr.xml#L692
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:decimal ( "9.99999999999999999999999999"^^xsd:decimal ) && xsd:decimal ( - "123456789.123456789123456789"^^xsd:decimal ) ) AS ?result)
  FILTER(( ( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ) || ! BOUND( ?result ) ))
}
