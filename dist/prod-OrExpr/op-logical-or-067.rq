# QT3 test case op-logical-or-067 of test set prod-OrExpr, which tests the XPath expression
#   xs:decimal(-123456789.123456789123456789) or xs:decimal(1)
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/OrExpr.xml#L2281
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:decimal ( - "123456789.123456789123456789"^^xsd:decimal ) || xsd:decimal ( "1"^^xsd:integer ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
