# QT3 test case op-logical-or-024 of test set prod-OrExpr, which tests the XPath expression
#   xs:string("0") or xs:string('abc')
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( "0" ) || <http://www.w3.org/2001/XMLSchema#string> ( "abc" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
