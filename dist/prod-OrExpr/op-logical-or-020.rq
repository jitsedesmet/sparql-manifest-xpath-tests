# QT3 test case op-logical-or-020 of test set prod-OrExpr, which tests the XPath expression
#   "a" or '0'
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/OrExpr.xml#L1808
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "a" || "0" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
