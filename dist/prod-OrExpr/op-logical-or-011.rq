# QT3 test case op-logical-or-011 of test set prod-OrExpr, which tests the XPath expression
#   (0) or (0)
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#integer> || "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
