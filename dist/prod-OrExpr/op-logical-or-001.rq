# QT3 test case op-logical-or-001 of test set prod-OrExpr, which tests the XPath expression
#   false() or false()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/OrExpr.xml#L1615
ASK {
  BIND(( "false"^^<http://www.w3.org/2001/XMLSchema#boolean> || "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
