# QT3 test case K-LogicExpr-7 of test set prod-OrExpr, which tests the XPath expression
#   1 or 5
ASK {
  BIND(( "1"^^<http://www.w3.org/2001/XMLSchema#integer> || "5"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
