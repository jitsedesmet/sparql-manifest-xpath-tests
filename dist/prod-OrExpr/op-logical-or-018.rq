# QT3 test case op-logical-or-018 of test set prod-OrExpr, which tests the XPath expression
#   "" or 'a'
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/OrExpr.xml#L1788
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "" || "a" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
