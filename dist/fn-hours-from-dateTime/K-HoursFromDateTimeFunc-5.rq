# QT3 test case K-HoursFromDateTimeFunc-5 of test set fn-hours-from-dateTime, which tests the XPath expression
#   hours-from-dateTime(xs:dateTime("2001-02-03T08:23:12.43")) eq 8
ASK {
  BIND(( HOURS( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2001-02-03T08:23:12.43" ) ) = "8"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
