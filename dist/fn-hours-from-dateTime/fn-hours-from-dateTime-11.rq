# QT3 test case fn-hours-from-dateTime-11 of test set fn-hours-from-dateTime, which tests the XPath expression
#   fn:hours-from-dateTime(xs:dateTime("1970-01-01T02:00:00Z")) div fn:hours-from-dateTime(xs:dateTime("1970-01-01T10:00:00Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/hours-from-dateTime.xml#L124
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( HOURS( xsd:dateTime ( "1970-01-01T02:00:00Z" ) ) / HOURS( xsd:dateTime ( "1970-01-01T10:00:00Z" ) ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "0.2" ))
}
