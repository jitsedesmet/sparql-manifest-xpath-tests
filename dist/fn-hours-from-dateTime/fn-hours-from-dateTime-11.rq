# QT3 test case fn-hours-from-dateTime-11 of test set fn-hours-from-dateTime, which tests the XPath expression
#   fn:hours-from-dateTime(xs:dateTime("1970-01-01T02:00:00Z")) div fn:hours-from-dateTime(xs:dateTime("1970-01-01T10:00:00Z"))
ASK {
  BIND(( HOURS( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T02:00:00Z" ) ) / HOURS( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T10:00:00Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0.2" ))
}
