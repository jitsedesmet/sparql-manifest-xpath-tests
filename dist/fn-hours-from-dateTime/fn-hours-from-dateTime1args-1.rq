# QT3 test case fn-hours-from-dateTime1args-1 of test set fn-hours-from-dateTime, which tests the XPath expression
#   fn:hours-from-dateTime(xs:dateTime("1970-01-01T00:00:00"))
ASK {
  BIND(HOURS( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T00:00:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0" ))
}
