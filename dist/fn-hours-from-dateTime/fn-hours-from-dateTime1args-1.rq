# QT3 test case fn-hours-from-dateTime1args-1 of test set fn-hours-from-dateTime, which tests the XPath expression
#   fn:hours-from-dateTime(xs:dateTime("1970-01-01T00:00:00"))
# Expecting:
#   <assert-string-value>0</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/hours-from-dateTime.xml#L7
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(HOURS( xsd:dateTime ( "1970-01-01T00:00:00" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "0" ))
}
