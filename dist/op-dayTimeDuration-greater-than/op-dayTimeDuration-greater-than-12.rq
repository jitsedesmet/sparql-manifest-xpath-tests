# QT3 test case op-dayTimeDuration-greater-than-12 of test set op-dayTimeDuration-greater-than, which tests the XPath expression
#   (xs:dayTimeDuration("P10DT01H") ge xs:dayTimeDuration("P09DT05H")) or (fn:true())
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dayTimeDuration-greater-than.xml#L331
# The test needs the constructor function xsd:dayTimeDuration, >= on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:dayTimeDuration ( "P10DT01H" ) >= xsd:dayTimeDuration ( "P09DT05H" ) ) || "true"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
