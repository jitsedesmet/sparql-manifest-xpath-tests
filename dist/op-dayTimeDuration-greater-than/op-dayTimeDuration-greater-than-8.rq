# QT3 test case op-dayTimeDuration-greater-than-8 of test set op-dayTimeDuration-greater-than, which tests the XPath expression
#   (xs:dayTimeDuration("P10DT09H") ge xs:dayTimeDuration("P10DT01H")) and (xs:dayTimeDuration("P02DT04H") ge xs:dayTimeDuration("P09DT07H"))
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P10DT09H" ) >= <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P10DT01H" ) ) && ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P02DT04H" ) >= <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P09DT07H" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
