# QT3 test case op-dayTimeDuration-greater-than-5 of test set op-dayTimeDuration-greater-than, which tests the XPath expression
#   fn:not(xs:dayTimeDuration("P08DT10H") gt xs:dayTimeDuration("P9DT09H"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dayTimeDuration-greater-than.xml#L219
# The test needs the constructor function xsd:dayTimeDuration, > on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( xsd:dayTimeDuration ( "P08DT10H" ) > xsd:dayTimeDuration ( "P9DT09H" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
