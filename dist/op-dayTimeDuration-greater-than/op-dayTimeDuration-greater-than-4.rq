# QT3 test case op-dayTimeDuration-greater-than-4 of test set op-dayTimeDuration-greater-than, which tests the XPath expression
#   fn:not(xs:dayTimeDuration("P10DT11H") ge xs:dayTimeDuration("P10DT10H"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dayTimeDuration-greater-than.xml#L203
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P10DT11H" ) >= <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P10DT10H" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
