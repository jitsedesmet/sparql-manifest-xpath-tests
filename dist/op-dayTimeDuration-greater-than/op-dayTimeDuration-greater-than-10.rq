# QT3 test case op-dayTimeDuration-greater-than-10 of test set op-dayTimeDuration-greater-than, which tests the XPath expression
#   (xs:dayTimeDuration("P10DT01H") ge xs:dayTimeDuration("P09DT06H")) or (xs:dayTimeDuration("P15DT01H") ge xs:dayTimeDuration("P02DT04H"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dayTimeDuration-greater-than.xml#L299
# The test needs the constructor function xsd:dayTimeDuration, >= on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P10DT01H" ) >= <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P09DT06H" ) ) || ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P15DT01H" ) >= <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P02DT04H" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
