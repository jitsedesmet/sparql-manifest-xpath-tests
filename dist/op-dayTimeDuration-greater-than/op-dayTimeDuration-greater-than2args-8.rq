# QT3 test case op-dayTimeDuration-greater-than2args-8 of test set op-dayTimeDuration-greater-than, which tests the XPath expression
#   xs:dayTimeDuration("P31DT23H59M59S") le xs:dayTimeDuration("P0DT0H0M0S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dayTimeDuration-greater-than.xml#L133
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P31DT23H59M59S" ) <= <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P0DT0H0M0S" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
