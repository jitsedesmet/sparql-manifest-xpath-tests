# QT3 test case op-dayTimeDuration-greater-than-11 of test set op-dayTimeDuration-greater-than, which tests the XPath expression
#   (xs:dayTimeDuration("P10DT02H") gt xs:dayTimeDuration("P01DT10H")) or (fn:true())
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P10DT02H" ) > <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P01DT10H" ) ) || "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
