# QT3 test case op-dayTimeDuration-greater-than-9 of test set op-dayTimeDuration-greater-than, which tests the XPath expression
#   (xs:dayTimeDuration("P10DT08H") gt xs:dayTimeDuration("P10DT07H")) or (xs:dayTimeDuration("P10DT09H") gt xs:dayTimeDuration("P10DT09H"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/dayTimeDuration-greater-than.xml#L283
# The test needs the constructor function xsd:dayTimeDuration, > on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:dayTimeDuration ( "P10DT08H" ) > xsd:dayTimeDuration ( "P10DT07H" ) ) || ( xsd:dayTimeDuration ( "P10DT09H" ) > xsd:dayTimeDuration ( "P10DT09H" ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
