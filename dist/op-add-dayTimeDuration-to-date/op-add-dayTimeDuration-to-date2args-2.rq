# QT3 test case op-add-dayTimeDuration-to-date2args-2 of test set op-add-dayTimeDuration-to-date, which tests the XPath expression
#   xs:date("1983-11-17Z") + xs:dayTimeDuration("P0DT0H0M0S")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1983-11-17Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P0DT0H0M0S" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1983-11-17Z" ))
}
