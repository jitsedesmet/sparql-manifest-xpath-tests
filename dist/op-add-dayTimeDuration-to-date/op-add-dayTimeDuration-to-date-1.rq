# QT3 test case op-add-dayTimeDuration-to-date-1 of test set op-add-dayTimeDuration-to-date, which tests the XPath expression
#   xs:date("2004-10-30Z") + xs:dayTimeDuration("P2DT2H30M0S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-date.xml#L105
# The test needs the constructor function xsd:date, the constructor function xsd:dayTimeDuration, + on xsd:date, + on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "2004-10-30Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P2DT2H30M0S" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2004-11-01Z" ))
}
