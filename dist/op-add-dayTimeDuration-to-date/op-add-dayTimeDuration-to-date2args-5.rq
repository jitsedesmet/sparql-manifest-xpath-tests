# QT3 test case op-add-dayTimeDuration-to-date2args-5 of test set op-add-dayTimeDuration-to-date, which tests the XPath expression
#   xs:date("1970-01-01Z") + xs:dayTimeDuration("P31DT23H59M59S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-date.xml#L87
# The test needs the constructor function xsd:date, the constructor function xsd:dayTimeDuration, + on xsd:date, + on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P31DT23H59M59S" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1970-02-01Z" ))
}
