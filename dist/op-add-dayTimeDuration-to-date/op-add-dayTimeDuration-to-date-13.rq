# QT3 test case op-add-dayTimeDuration-to-date-13 of test set op-add-dayTimeDuration-to-date, which tests the XPath expression
#   (xs:date("1980-05-05Z") + xs:dayTimeDuration("P23DT11H11M")) eq xs:date("1980-05-05Z")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-date.xml#L283
# The test needs the constructor function xsd:date, the constructor function xsd:dayTimeDuration, + on xsd:date, + on xsd:dayTimeDuration, = on xsd:date, which SPARQL does not define
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "1980-05-05Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P23DT11H11M" ) ) = <http://www.w3.org/2001/XMLSchema#date> ( "1980-05-05Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
