# QT3 test case op-add-dayTimeDuration-to-date-16 of test set op-add-dayTimeDuration-to-date, which tests the XPath expression
#   (xs:date("1977-12-12Z") + xs:dayTimeDuration("P18DT02H02M")) ge xs:date("1977-12-12Z")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-date.xml#L331
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "1977-12-12Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P18DT02H02M" ) ) >= <http://www.w3.org/2001/XMLSchema#date> ( "1977-12-12Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
