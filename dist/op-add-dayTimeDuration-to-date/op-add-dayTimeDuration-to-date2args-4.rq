# QT3 test case op-add-dayTimeDuration-to-date2args-4 of test set op-add-dayTimeDuration-to-date, which tests the XPath expression
#   xs:date("1970-01-01Z") + xs:dayTimeDuration("P15DT11H59M59S")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P15DT11H59M59S" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1970-01-16Z" ))
}
