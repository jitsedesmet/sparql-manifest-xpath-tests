# QT3 test case op-add-dayTimeDuration-to-date-15 of test set op-add-dayTimeDuration-to-date, which tests the XPath expression
#   (xs:date("1978-12-12Z") + xs:dayTimeDuration("P17DT10H02M")) le xs:date("1978-12-12Z")
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "1978-12-12Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P17DT10H02M" ) ) <= <http://www.w3.org/2001/XMLSchema#date> ( "1978-12-12Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
