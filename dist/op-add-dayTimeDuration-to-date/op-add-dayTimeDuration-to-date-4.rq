# QT3 test case op-add-dayTimeDuration-to-date-4 of test set op-add-dayTimeDuration-to-date, which tests the XPath expression
#   fn:not(fn:string(xs:date("1998-09-12Z") + xs:dayTimeDuration("P02DT07H01M")))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-date.xml#L152
ASK {
  BIND(! <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#date> ( "1998-09-12Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P02DT07H01M" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
