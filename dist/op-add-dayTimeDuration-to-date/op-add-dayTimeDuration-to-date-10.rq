# QT3 test case op-add-dayTimeDuration-to-date-10 of test set op-add-dayTimeDuration-to-date, which tests the XPath expression
#   fn:string((xs:date("1985-07-05Z") + xs:dayTimeDuration("P03DT01H04M"))) or fn:string((xs:date("1985-07-05Z") + xs:dayTimeDuration("P01DT01H03M")))
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#date> ( "1985-07-05Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P03DT01H04M" ) ) ) || <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#date> ( "1985-07-05Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P01DT01H03M" ) ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
