# QT3 test case op-add-dayTimeDuration-to-dateTime-8 of test set op-add-dayTimeDuration-to-dateTime, which tests the XPath expression
#   (xs:dateTime("0001-01-01T11:11:11Z") + xs:dayTimeDuration("-P11DT02H02M"))
# Expecting:
#   <any-of>
#      <assert-string-value>-0001-12-21T09:09:11Z</assert-string-value>
#      <assert-string-value>0000-12-21T09:09:11Z</assert-string-value>
#   </any-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-dateTime.xml#L209
# The test needs the constructor function xsd:dayTimeDuration, + on xsd:dayTimeDuration, + on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:dateTime ( "0001-01-01T11:11:11Z" ) + xsd:dayTimeDuration ( "-P11DT02H02M" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "-0001-12-21T09:09:11Z" ) || SAMETERM( xsd:string ( ?result ) , "0000-12-21T09:09:11Z" ) ))
}
