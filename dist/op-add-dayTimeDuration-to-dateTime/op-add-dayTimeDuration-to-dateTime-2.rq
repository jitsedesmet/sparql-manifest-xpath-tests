# QT3 test case op-add-dayTimeDuration-to-dateTime-2 of test set op-add-dayTimeDuration-to-dateTime, which tests the XPath expression
#   fn:string((xs:dateTime("2000-12-12T11:10:03Z") + xs:dayTimeDuration("P12DT10H07M"))) and fn:false()
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-dateTime.xml#L113
# The test needs the constructor function xsd:dayTimeDuration, + on xsd:dayTimeDuration, + on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:dateTime ( "2000-12-12T11:10:03Z" ) + xsd:dayTimeDuration ( "P12DT10H07M" ) ) ) && "false"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
