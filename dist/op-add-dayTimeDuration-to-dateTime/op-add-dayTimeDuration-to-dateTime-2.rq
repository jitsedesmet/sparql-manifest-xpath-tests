# QT3 test case op-add-dayTimeDuration-to-dateTime-2 of test set op-add-dayTimeDuration-to-dateTime, which tests the XPath expression
#   fn:string((xs:dateTime("2000-12-12T11:10:03Z") + xs:dayTimeDuration("P12DT10H07M"))) and fn:false()
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2000-12-12T11:10:03Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P12DT10H07M" ) ) ) && "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
