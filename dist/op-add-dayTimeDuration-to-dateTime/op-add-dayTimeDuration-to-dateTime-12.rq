# QT3 test case op-add-dayTimeDuration-to-dateTime-12 of test set op-add-dayTimeDuration-to-dateTime, which tests the XPath expression
#   fn:string((xs:dateTime("1980-03-02T16:12:10Z") + xs:dayTimeDuration("P05DT08H11M"))) and (fn:true())
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-dateTime.xml#L260
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1980-03-02T16:12:10Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P05DT08H11M" ) ) ) && "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
