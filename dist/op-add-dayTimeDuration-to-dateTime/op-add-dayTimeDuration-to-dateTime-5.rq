# QT3 test case op-add-dayTimeDuration-to-dateTime-5 of test set op-add-dayTimeDuration-to-dateTime, which tests the XPath expression
#   fn:boolean(fn:string(xs:dateTime("1962-03-12T12:34:09Z") + xs:dayTimeDuration("P03DT08H06M")))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-dateTime.xml#L161
# The test needs the constructor function xsd:dayTimeDuration, + on xsd:dayTimeDuration, + on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( ! xsd:string ( ( xsd:dateTime ( "1962-03-12T12:34:09Z" ) + xsd:dayTimeDuration ( "P03DT08H06M" ) ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
