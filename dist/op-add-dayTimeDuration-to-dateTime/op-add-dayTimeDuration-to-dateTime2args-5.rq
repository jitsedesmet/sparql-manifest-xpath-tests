# QT3 test case op-add-dayTimeDuration-to-dateTime2args-5 of test set op-add-dayTimeDuration-to-dateTime, which tests the XPath expression
#   xs:dateTime("1970-01-01T00:00:00Z") + xs:dayTimeDuration("P31DT23H59M59S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-dateTime.xml#L79
# The test needs the constructor function xsd:dayTimeDuration, + on xsd:dayTimeDuration, + on xsd:dateTime, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T00:00:00Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P31DT23H59M59S" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1970-02-01T23:59:59Z" ))
}
