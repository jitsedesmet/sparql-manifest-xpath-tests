# QT3 test case op-add-dayTimeDuration-to-dateTime-4 of test set op-add-dayTimeDuration-to-dateTime, which tests the XPath expression
#   fn:not(fn:string(xs:dateTime("1998-09-12T13:23:23Z") + xs:dayTimeDuration("P02DT07H01M")))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-dateTime.xml#L145
# The test needs the constructor function xsd:dayTimeDuration, + on xsd:dayTimeDuration, + on xsd:dateTime, which SPARQL does not define
ASK {
  BIND(! <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1998-09-12T13:23:23Z" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P02DT07H01M" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
