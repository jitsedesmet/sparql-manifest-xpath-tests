# QT3 test case K-DateTimeAddDTD-2 of test set op-add-dayTimeDuration-to-dateTime, which tests the XPath expression
#   xs:dateTime("1999-10-12T08:12:12") + xs:date("1999-10-12")
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-dateTime.xml#L355
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:dateTime ( "1999-10-12T08:12:12" ) + xsd:date ( "1999-10-12" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
