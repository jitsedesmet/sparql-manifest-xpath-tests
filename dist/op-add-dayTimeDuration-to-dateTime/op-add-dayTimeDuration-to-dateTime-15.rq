# QT3 test case op-add-dayTimeDuration-to-dateTime-15 of test set op-add-dayTimeDuration-to-dateTime, which tests the XPath expression
#   (xs:dateTime("1978-12-12T12:45:12Z") + xs:dayTimeDuration("P17DT10H02M")) le xs:dateTime("1978-12-12T16:34:23Z")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-dateTime.xml#L308
# The test needs the constructor function xsd:dayTimeDuration, + on xsd:dayTimeDuration, + on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:dateTime ( "1978-12-12T12:45:12Z" ) + xsd:dayTimeDuration ( "P17DT10H02M" ) ) <= xsd:dateTime ( "1978-12-12T16:34:23Z" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
