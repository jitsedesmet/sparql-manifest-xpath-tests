# QT3 test case op-add-dayTimeDuration-to-dateTime-1 of test set op-add-dayTimeDuration-to-dateTime, which tests the XPath expression
#   xs:dateTime("2000-10-30T11:12:00") + xs:dayTimeDuration("P3DT1H15M")
# Expecting:
#   <assert-string-value>2000-11-02T12:27:00</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-dateTime.xml#L97
# The test needs the constructor function xsd:dayTimeDuration, + on xsd:dayTimeDuration, + on xsd:dateTime, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:dateTime ( "2000-10-30T11:12:00" ) + xsd:dayTimeDuration ( "P3DT1H15M" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "2000-11-02T12:27:00" ))
}
