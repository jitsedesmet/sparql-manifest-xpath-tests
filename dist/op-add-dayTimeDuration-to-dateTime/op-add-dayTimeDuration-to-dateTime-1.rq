# QT3 test case op-add-dayTimeDuration-to-dateTime-1 of test set op-add-dayTimeDuration-to-dateTime, which tests the XPath expression
#   xs:dateTime("2000-10-30T11:12:00") + xs:dayTimeDuration("P3DT1H15M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2000-10-30T11:12:00" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P3DT1H15M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2000-11-02T12:27:00" ))
}
