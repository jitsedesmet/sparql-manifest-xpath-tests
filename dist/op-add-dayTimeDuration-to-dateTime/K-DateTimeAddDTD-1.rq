# QT3 test case K-DateTimeAddDTD-1 of test set op-add-dayTimeDuration-to-dateTime, which tests the XPath expression
#   xs:date("1999-10-12") + xs:dateTime("1999-10-12T08:12:12")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDuration-to-dateTime.xml#L340
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1999-10-12" ) + <http://www.w3.org/2001/XMLSchema#dateTime> ( "1999-10-12T08:12:12" ) ) AS ?result)
  FILTER(! BOUND( ?result ))
}
