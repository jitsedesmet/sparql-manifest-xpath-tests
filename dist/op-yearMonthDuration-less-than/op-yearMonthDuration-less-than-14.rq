# QT3 test case op-yearMonthDuration-less-than-14 of test set op-yearMonthDuration-less-than, which tests the XPath expression
#   (xs:yearMonthDuration("P10Y05M") le xs:yearMonthDuration("P20Y10M")) or (fn:false())
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/yearMonthDuration-less-than.xml#L363
# The test needs the constructor function xsd:yearMonthDuration, <= on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:yearMonthDuration ( "P10Y05M" ) <= xsd:yearMonthDuration ( "P20Y10M" ) ) || "false"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
