# QT3 test case op-yearMonthDuration-less-than-4 of test set op-yearMonthDuration-less-than, which tests the XPath expression
#   fn:not(xs:yearMonthDuration("P20Y10M") le xs:yearMonthDuration("P20Y10M"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P20Y10M" ) <= <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P20Y10M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
