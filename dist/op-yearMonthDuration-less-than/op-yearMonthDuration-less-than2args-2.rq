# QT3 test case op-yearMonthDuration-less-than2args-2 of test set op-yearMonthDuration-less-than, which tests the XPath expression
#   xs:yearMonthDuration("P1000Y6M") lt xs:yearMonthDuration("P0Y0M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/yearMonthDuration-less-than.xml#L25
# The test needs the constructor function xsd:yearMonthDuration, < on xsd:yearMonthDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1000Y6M" ) < <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P0Y0M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
