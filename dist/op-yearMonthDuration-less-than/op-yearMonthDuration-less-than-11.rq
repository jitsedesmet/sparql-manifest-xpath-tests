# QT3 test case op-yearMonthDuration-less-than-11 of test set op-yearMonthDuration-less-than, which tests the XPath expression
#   (xs:yearMonthDuration("P10Y02M") lt xs:yearMonthDuration("P01Y10M")) or (fn:true())
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P10Y02M" ) < <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P01Y10M" ) ) || "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
