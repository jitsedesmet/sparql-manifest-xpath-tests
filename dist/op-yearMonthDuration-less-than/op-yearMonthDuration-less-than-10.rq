# QT3 test case op-yearMonthDuration-less-than-10 of test set op-yearMonthDuration-less-than, which tests the XPath expression
#   (xs:yearMonthDuration("P10Y01M") le xs:yearMonthDuration("P09Y06M")) or (xs:yearMonthDuration("P15Y01M") le xs:yearMonthDuration("P02Y04M"))
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P10Y01M" ) <= <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P09Y06M" ) ) || ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P15Y01M" ) <= <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P02Y04M" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
