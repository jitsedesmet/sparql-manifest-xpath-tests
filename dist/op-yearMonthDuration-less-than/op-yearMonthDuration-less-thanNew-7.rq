# QT3 test case op-yearMonthDuration-less-thanNew-7 of test set op-yearMonthDuration-less-than, which tests the XPath expression
#   (xs:yearMonthDuration("P10Y09M") lt xs:yearMonthDuration("P09Y10M")) and (xs:yearMonthDuration("P10Y01M") lt xs:yearMonthDuration("P08Y06M"))
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/yearMonthDuration-less-than.xml#L251
# The test needs the constructor function xsd:yearMonthDuration, < on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:yearMonthDuration ( "P10Y09M" ) < xsd:yearMonthDuration ( "P09Y10M" ) ) && ( xsd:yearMonthDuration ( "P10Y01M" ) < xsd:yearMonthDuration ( "P08Y06M" ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
