# QT3 test case op-yearMonthDuration-less-than-6 of test set op-yearMonthDuration-less-than, which tests the XPath expression
#   fn:not(xs:yearMonthDuration("P10Y09M") le xs:yearMonthDuration("P10Y07M"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P10Y09M" ) <= <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P10Y07M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
