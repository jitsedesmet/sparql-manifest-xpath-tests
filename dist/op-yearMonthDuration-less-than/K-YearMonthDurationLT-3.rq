# QT3 test case K-YearMonthDurationLT-3 of test set op-yearMonthDuration-less-than, which tests the XPath expression
#   not(xs:yearMonthDuration("P1999Y10M") lt xs:yearMonthDuration("P1999Y9M"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1999Y10M" ) < <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1999Y9M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
