# QT3 test case op-yearMonthDuration-less-than-9 of test set op-yearMonthDuration-less-than, which tests the XPath expression
#   (xs:yearMonthDuration("P10Y08M") lt xs:yearMonthDuration("P10Y07M")) or (xs:yearMonthDuration("P10Y09M") lt xs:yearMonthDuration("P10Y09M"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/yearMonthDuration-less-than.xml#L283
# The test needs the constructor function xsd:yearMonthDuration, < on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:yearMonthDuration ( "P10Y08M" ) < xsd:yearMonthDuration ( "P10Y07M" ) ) || ( xsd:yearMonthDuration ( "P10Y09M" ) < xsd:yearMonthDuration ( "P10Y09M" ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
