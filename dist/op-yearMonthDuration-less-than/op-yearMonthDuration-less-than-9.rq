# QT3 test case op-yearMonthDuration-less-than-9 of test set op-yearMonthDuration-less-than, which tests the XPath expression
#   (xs:yearMonthDuration("P10Y08M") lt xs:yearMonthDuration("P10Y07M")) or (xs:yearMonthDuration("P10Y09M") lt xs:yearMonthDuration("P10Y09M"))
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P10Y08M" ) < <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P10Y07M" ) ) || ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P10Y09M" ) < <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P10Y09M" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
