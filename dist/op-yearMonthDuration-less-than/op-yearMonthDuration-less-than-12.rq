# QT3 test case op-yearMonthDuration-less-than-12 of test set op-yearMonthDuration-less-than, which tests the XPath expression
#   (xs:yearMonthDuration("P10Y01M") le xs:yearMonthDuration("P09Y05M")) or (fn:true())
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/yearMonthDuration-less-than.xml#L331
# The test needs the constructor function xsd:yearMonthDuration, <= on xsd:yearMonthDuration, which SPARQL does not define
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P10Y01M" ) <= <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P09Y05M" ) ) || "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
