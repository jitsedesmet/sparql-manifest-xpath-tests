# QT3 test case K-YearMonthDurationLT-5 of test set op-yearMonthDuration-less-than, which tests the XPath expression
#   xs:yearMonthDuration("P1999Y9M") le xs:yearMonthDuration("P1999Y10M")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/yearMonthDuration-less-than.xml#L439
# The test needs the constructor function xsd:yearMonthDuration, <= on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:yearMonthDuration ( "P1999Y9M" ) <= xsd:yearMonthDuration ( "P1999Y10M" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
