# QT3 test case op-yearMonthDuration-less-than2args-5 of test set op-yearMonthDuration-less-than, which tests the XPath expression
#   xs:yearMonthDuration("P0Y0M") lt xs:yearMonthDuration("P2030Y12M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P0Y0M" ) < <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P2030Y12M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
