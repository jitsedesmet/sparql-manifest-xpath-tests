# QT3 test case op-subtract-dayTimeDuration-from-date2args-3 of test set op-subtract-dayTimeDuration-from-date, which tests the XPath expression
#   xs:date("2030-12-31Z") - xs:dayTimeDuration("P0DT0H0M0S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-date.xml#L43
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "2030-12-31Z" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P0DT0H0M0S" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2030-12-31Z" ))
}
