# QT3 test case op-subtract-dayTimeDuration-from-date2args-5 of test set op-subtract-dayTimeDuration-from-date, which tests the XPath expression
#   xs:date("1970-01-01Z") - xs:dayTimeDuration("P31DT23H59M59S")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P31DT23H59M59S" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1969-11-30Z" ))
}
