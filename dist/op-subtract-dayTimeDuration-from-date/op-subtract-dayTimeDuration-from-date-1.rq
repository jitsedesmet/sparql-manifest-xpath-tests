# QT3 test case op-subtract-dayTimeDuration-from-date-1 of test set op-subtract-dayTimeDuration-from-date, which tests the XPath expression
#   xs:date("2000-10-30") - xs:dayTimeDuration("P3DT1H15M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "2000-10-30" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P3DT1H15M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2000-10-26" ))
}
