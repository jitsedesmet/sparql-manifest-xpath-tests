# QT3 test case op-subtract-dayTimeDuration-from-date-8 of test set op-subtract-dayTimeDuration-from-date, which tests the XPath expression
#   (xs:date("0001-01-01Z") - xs:dayTimeDuration("P11DT02H02M"))
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "0001-01-01Z" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P11DT02H02M" ) ) AS ?result)
  FILTER(( ( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-0001-12-20Z" ) || ( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0000-12-20Z" ) ))
}
