# QT3 test case op-subtract-dayTimeDuration-from-date-14 of test set op-subtract-dayTimeDuration-from-date, which tests the XPath expression
#   (xs:date("1979-12-12Z") - xs:dayTimeDuration("P08DT08H05M")) ne xs:date("1979-12-12Z")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-date.xml#L291
# The test needs the constructor function xsd:date, the constructor function xsd:dayTimeDuration, - on xsd:date, - on xsd:dayTimeDuration, != on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:date ( "1979-12-12Z" ) - xsd:dayTimeDuration ( "P08DT08H05M" ) ) != xsd:date ( "1979-12-12Z" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
