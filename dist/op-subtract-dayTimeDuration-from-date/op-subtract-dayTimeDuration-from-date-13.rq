# QT3 test case op-subtract-dayTimeDuration-from-date-13 of test set op-subtract-dayTimeDuration-from-date, which tests the XPath expression
#   (xs:date("1980-05-05Z") - xs:dayTimeDuration("P23DT11H11M")) eq xs:date("1980-05-05Z")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-date.xml#L275
# The test needs the constructor function xsd:date, the constructor function xsd:dayTimeDuration, - on xsd:date, - on xsd:dayTimeDuration, = on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:date ( "1980-05-05Z" ) - xsd:dayTimeDuration ( "P23DT11H11M" ) ) = xsd:date ( "1980-05-05Z" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
