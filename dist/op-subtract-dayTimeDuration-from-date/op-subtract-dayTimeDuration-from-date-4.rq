# QT3 test case op-subtract-dayTimeDuration-from-date-4 of test set op-subtract-dayTimeDuration-from-date, which tests the XPath expression
#   fn:not(fn:string(xs:date("1998-09-12Z") - xs:dayTimeDuration("P02DT07H01M")))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-date.xml#L144
# The test needs the constructor function xsd:date, the constructor function xsd:dayTimeDuration, - on xsd:date, - on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! xsd:string ( ( xsd:date ( "1998-09-12Z" ) - xsd:dayTimeDuration ( "P02DT07H01M" ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
