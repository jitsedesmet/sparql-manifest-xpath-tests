# QT3 test case op-subtract-dayTimeDuration-from-date-2 of test set op-subtract-dayTimeDuration-from-date, which tests the XPath expression
#   fn:string(xs:date("2000-12-12Z") - xs:dayTimeDuration("P12DT10H07M")) and fn:false()
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDuration-from-date.xml#L113
# The test needs the constructor function xsd:date, the constructor function xsd:dayTimeDuration, - on xsd:date, - on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:date ( "2000-12-12Z" ) - xsd:dayTimeDuration ( "P12DT10H07M" ) ) ) && "false"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
