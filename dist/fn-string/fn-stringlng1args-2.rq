# QT3 test case fn-stringlng1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:long("-47175562203048468"))
# Expecting:
#   <assert-string-value>-47175562203048468</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string.xml#L151
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( "-47175562203048468"^^xsd:long ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-47175562203048468" ))
}
