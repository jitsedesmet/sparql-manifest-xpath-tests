# QT3 test case fn-stringflt1args-3 of test set fn-string, which tests the XPath expression
#   fn:string(xs:float("3.4028235E38"))
# Expecting:
#   <assert-string-value>3.4028235E38</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string.xml#L133
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( xsd:float ( "3.4028235E38" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "3.4028235E38" ))
}
