# QT3 test case fn-stringsht1args-1 of test set fn-string, which tests the XPath expression
#   fn:string(xs:short("-32768"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( "-32768"^^<http://www.w3.org/2001/XMLSchema#short> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-32768" ))
}
