# QT3 test case fn-stringdec1args-3 of test set fn-string, which tests the XPath expression
#   fn:string(xs:decimal("999999999999999999"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "999999999999999999" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "999999999999999999" ))
}
