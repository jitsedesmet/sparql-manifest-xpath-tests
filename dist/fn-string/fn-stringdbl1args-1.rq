# QT3 test case fn-stringdbl1args-1 of test set fn-string, which tests the XPath expression
#   fn:string(xs:double("-1.7976931348623157E308"))
# Expecting:
#   <assert-string-value>-1.7976931348623157E308</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string.xml#L88
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( xsd:double ( "-1.7976931348623157E308" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-1.7976931348623157E308" ))
}
