# QT3 test case fn-stringpint1args-1 of test set fn-string, which tests the XPath expression
#   fn:string(xs:positiveInteger("1"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string.xml#L223
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( "1"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1" ))
}
