# QT3 test case fn-stringnni1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:nonNegativeInteger("303884545991464527"))
# Expecting:
#   <assert-string-value>303884545991464527</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string.xml#L313
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( "303884545991464527"^^xsd:nonNegativeInteger ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "303884545991464527" ))
}
