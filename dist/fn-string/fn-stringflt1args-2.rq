# QT3 test case fn-stringflt1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:float("0"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#float> ( "0" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0" ))
}
