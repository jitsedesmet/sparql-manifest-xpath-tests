# QT3 test case K-StringFunc-3 of test set fn-string, which tests the XPath expression
#   string(1) eq "1"
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) = "1" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
