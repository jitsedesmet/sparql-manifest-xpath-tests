# QT3 test case fn-stringpint1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:positiveInteger("52704602390610033"))
# Expecting:
#   <assert-string-value>52704602390610033</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string.xml#L232
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( "52704602390610033"^^xsd:positiveInteger ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "52704602390610033" ))
}
