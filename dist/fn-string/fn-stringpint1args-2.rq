# QT3 test case fn-stringpint1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:positiveInteger("52704602390610033"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( "52704602390610033"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "52704602390610033" ))
}
