# QT3 test case fn-stringdbl1args-3 of test set fn-string, which tests the XPath expression
#   fn:string(xs:double("1.7976931348623157E308"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string.xml#L106
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( xsd:double ( "1.7976931348623157E308" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1.7976931348623157E308" ))
}
