# QT3 test case fn-string-7 of test set fn-string, which tests the XPath expression
#   string(xs:duration("P24M"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string.xml#L417
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#duration> ( "P24M" ) ) AS ?result)
  FILTER(( ?result = "P2Y" ))
}
