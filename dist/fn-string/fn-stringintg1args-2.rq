# QT3 test case fn-stringintg1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:integer("830993497117024304"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#integer> ( "830993497117024304" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "830993497117024304" ))
}
