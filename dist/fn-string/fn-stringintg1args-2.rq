# QT3 test case fn-stringintg1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:integer("830993497117024304"))
# Expecting:
#   <assert-string-value>830993497117024304</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string.xml#L43
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( xsd:integer ( "830993497117024304" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "830993497117024304" ))
}
