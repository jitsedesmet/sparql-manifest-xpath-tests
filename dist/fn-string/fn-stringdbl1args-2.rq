# QT3 test case fn-stringdbl1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:double("0"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#double> ( "0" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0" ))
}
