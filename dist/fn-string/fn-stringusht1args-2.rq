# QT3 test case fn-stringusht1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:unsignedShort("44633"))
# Expecting:
#   <assert-string-value>44633</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string.xml#L178
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( "44633"^^xsd:unsignedShort ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "44633" ))
}
