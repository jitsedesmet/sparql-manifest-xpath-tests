# QT3 test case fn-stringint1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:int("-1873914410"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string.xml#L16
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( "-1873914410"^^xsd:int ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-1873914410" ))
}
