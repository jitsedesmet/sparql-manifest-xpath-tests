# QT3 test case fn-stringint1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:int("-1873914410"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( "-1873914410"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-1873914410" ))
}
