# QT3 test case fn-stringulng1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:unsignedLong("130747108607674654"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( "130747108607674654"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "130747108607674654" ))
}
