# QT3 test case fn-stringdec1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:decimal("617375191608514839"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string.xml#L70
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#decimal> ( "617375191608514839" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "617375191608514839" ))
}
