# QT3 test case fn-stringulng1args-3 of test set fn-string, which tests the XPath expression
#   fn:string(xs:unsignedLong("184467440737095516"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( "184467440737095516"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "184467440737095516" ))
}
