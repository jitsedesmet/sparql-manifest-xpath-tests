# QT3 test case fn-stringnpi1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:nonPositiveInteger("-475688437271870490"))
# Expecting:
#   <assert-string-value>-475688437271870490</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string.xml#L286
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( "-475688437271870490"^^xsd:nonPositiveInteger ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-475688437271870490" ))
}
