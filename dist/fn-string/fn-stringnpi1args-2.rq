# QT3 test case fn-stringnpi1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:nonPositiveInteger("-475688437271870490"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( "-475688437271870490"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-475688437271870490" ))
}
