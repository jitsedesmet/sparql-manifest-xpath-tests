# QT3 test case fn-stringusht1args-3 of test set fn-string, which tests the XPath expression
#   fn:string(xs:unsignedShort("65535"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( "65535"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "65535" ))
}
