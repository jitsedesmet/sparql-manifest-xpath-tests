# QT3 test case fn-stringintg1args-1 of test set fn-string, which tests the XPath expression
#   fn:string(xs:integer("-999999999999999999"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( <http://www.w3.org/2001/XMLSchema#integer> ( "-999999999999999999" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-999999999999999999" ))
}
