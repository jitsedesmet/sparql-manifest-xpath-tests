# QT3 test case fn-stringsht1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:short("-5324"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( "-5324"^^<http://www.w3.org/2001/XMLSchema#short> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-5324" ))
}
