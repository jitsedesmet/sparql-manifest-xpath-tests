# QT3 test case fn-stringsht1args-2 of test set fn-string, which tests the XPath expression
#   fn:string(xs:short("-5324"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string.xml#L340
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( "-5324"^^xsd:short ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-5324" ))
}
