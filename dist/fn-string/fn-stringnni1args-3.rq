# QT3 test case fn-stringnni1args-3 of test set fn-string, which tests the XPath expression
#   fn:string(xs:nonNegativeInteger("999999999999999999"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "999999999999999999" ))
}
