# QT3 test case fn-stringnni1args-3 of test set fn-string, which tests the XPath expression
#   fn:string(xs:nonNegativeInteger("999999999999999999"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string.xml#L322
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( "999999999999999999"^^xsd:nonNegativeInteger ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "999999999999999999" ))
}
