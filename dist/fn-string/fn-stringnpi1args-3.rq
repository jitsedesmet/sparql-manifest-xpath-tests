# QT3 test case fn-stringnpi1args-3 of test set fn-string, which tests the XPath expression
#   fn:string(xs:nonPositiveInteger("0"))
# Expecting:
#   <assert-string-value>0</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/string.xml#L295
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( "0"^^xsd:nonPositiveInteger ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "0" ))
}
