# QT3 test case fn-stringnpi1args-3 of test set fn-string, which tests the XPath expression
#   fn:string(xs:nonPositiveInteger("0"))
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( "0"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0" ))
}
