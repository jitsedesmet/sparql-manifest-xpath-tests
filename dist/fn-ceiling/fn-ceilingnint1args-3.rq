# QT3 test case fn-ceilingnint1args-3 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:negativeInteger("-1"))
ASK {
  BIND(CEIL( "-1"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> ) AS ?result)
  FILTER(( ?result = - "1"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
