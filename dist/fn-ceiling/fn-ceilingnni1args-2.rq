# QT3 test case fn-ceilingnni1args-2 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:nonNegativeInteger("303884545991464527"))
ASK {
  BIND(CEIL( "303884545991464527"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ) AS ?result)
  FILTER(( ?result = "303884545991464527"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
