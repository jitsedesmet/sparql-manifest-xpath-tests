# QT3 test case fn-ceilingint1args-1 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:int("-2147483648"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L47
ASK {
  BIND(CEIL( "-2147483648"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( ?result = - "2147483648"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
