# QT3 test case fn-ceilinglng1args-3 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:long("92233720368547758"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L261
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CEIL( "92233720368547758"^^xsd:long ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "92233720368547758"^^xsd:integer ) ))
}
