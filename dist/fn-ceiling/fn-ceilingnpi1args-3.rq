# QT3 test case fn-ceilingnpi1args-3 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:nonPositiveInteger("0"))
ASK {
  BIND(CEIL( "0"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
