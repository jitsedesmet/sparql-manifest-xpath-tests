# QT3 test case K-CeilingFunc-6 of test set fn-ceiling, which tests the XPath expression
#   ceiling("a string")
# Expecting:
#   <error code="XPTY0004"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L542
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CEIL( "a string" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
