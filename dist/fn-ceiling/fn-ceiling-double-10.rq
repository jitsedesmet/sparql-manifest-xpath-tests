# QT3 test case fn-ceiling-double-10 of test set fn-ceiling, which tests the XPath expression
#   ceiling(xs:double('-INF'))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L895
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CEIL( xsd:double ( "-INF" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "-INF" ) && SAMETERM( DATATYPE( ?result ) , xsd:double ) ))
}
