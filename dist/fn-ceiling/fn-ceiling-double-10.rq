# QT3 test case fn-ceiling-double-10 of test set fn-ceiling, which tests the XPath expression
#   ceiling(xs:double('-INF'))
ASK {
  BIND(CEIL( <http://www.w3.org/2001/XMLSchema#double> ( "-INF" ) ) AS ?result)
  FILTER(( ( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-INF" ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#double> ) ) ))
}
