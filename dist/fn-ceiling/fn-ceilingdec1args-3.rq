# QT3 test case fn-ceilingdec1args-3 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:decimal("999999999999999999"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L149
ASK {
  BIND(CEIL( <http://www.w3.org/2001/XMLSchema#decimal> ( "999999999999999999" ) ) AS ?result)
  FILTER(( ?result = "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
