# QT3 test case fn-ceilingpint1args-3 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:positiveInteger("999999999999999999"))
ASK {
  BIND(CEIL( "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) AS ?result)
  FILTER(( ?result = "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
