# QT3 test case fn-ceiling-double-8 of test set fn-ceiling, which tests the XPath expression
#   ceiling(xs:double('NaN'))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L857
ASK {
  BIND(CEIL( <http://www.w3.org/2001/XMLSchema#double> ( "NaN" ) ) AS ?result)
  FILTER(( ( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "NaN" ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#double> ) ) ))
}
