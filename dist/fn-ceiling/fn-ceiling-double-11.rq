# QT3 test case fn-ceiling-double-11 of test set fn-ceiling, which tests the XPath expression
#   ceiling(xs:double('-0'))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L907
ASK {
  BIND(CEIL( <http://www.w3.org/2001/XMLSchema#double> ( "-0" ) ) AS ?result)
  FILTER(( ( ?result = - "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#double> ) ) ))
}
