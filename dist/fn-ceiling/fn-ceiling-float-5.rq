# QT3 test case fn-ceiling-float-5 of test set fn-ceiling, which tests the XPath expression
#   ceiling(xs:float(-0.1e0))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L967
ASK {
  BIND(CEIL( <http://www.w3.org/2001/XMLSchema#float> ( - "0.1e0"^^<http://www.w3.org/2001/XMLSchema#double> ) ) AS ?result)
  FILTER(( ( ( ?result = "0.0e0"^^<http://www.w3.org/2001/XMLSchema#double> ) && ( ?result = - "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#float> ) ) ))
}
