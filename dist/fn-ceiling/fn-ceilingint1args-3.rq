# QT3 test case fn-ceilingint1args-3 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:int("2147483647"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L78
ASK {
  BIND(CEIL( "2147483647"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( ?result = "2147483647"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
