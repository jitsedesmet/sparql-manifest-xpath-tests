# QT3 test case fn-ceiling-double-7 of test set fn-ceiling, which tests the XPath expression
#   ceiling(-1234567891234567.2e0)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L845
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CEIL( - "1234567891234567.2e0"^^xsd:double ) AS ?result)
  FILTER(( ( ?result = "-1234567891234567.0e0"^^xsd:double ) && SAMETERM( DATATYPE( ?result ) , xsd:double ) ))
}
