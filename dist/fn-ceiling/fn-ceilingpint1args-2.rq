# QT3 test case fn-ceilingpint1args-2 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:positiveInteger("52704602390610033"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L341
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CEIL( "52704602390610033"^^xsd:positiveInteger ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "52704602390610033"^^xsd:integer ) ))
}
