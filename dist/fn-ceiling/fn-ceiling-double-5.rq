# QT3 test case fn-ceiling-double-5 of test set fn-ceiling, which tests the XPath expression
#   ceiling(-0.1e0)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L820
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CEIL( - "0.1e0"^^xsd:double ) AS ?result)
  FILTER(( ( ?result = "-0.0e0"^^xsd:double ) && ( ?result = "-0"^^xsd:integer ) && SAMETERM( DATATYPE( ?result ) , xsd:double ) ))
}
