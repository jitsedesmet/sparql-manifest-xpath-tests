# QT3 test case fn-ceiling-double-5 of test set fn-ceiling, which tests the XPath expression
#   ceiling(-0.1e0)
ASK {
  BIND(CEIL( - "0.1e0"^^<http://www.w3.org/2001/XMLSchema#double> ) AS ?result)
  FILTER(( ( ( ?result = - "0.0e0"^^<http://www.w3.org/2001/XMLSchema#double> ) && ( ?result = - "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#double> ) ) ))
}
