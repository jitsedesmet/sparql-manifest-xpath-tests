# QT3 test case K-CeilingFunc-5 of test set fn-ceiling, which tests the XPath expression
#   ceiling(-10.5) eq -10
ASK {
  BIND(( CEIL( - "10.5"^^<http://www.w3.org/2001/XMLSchema#decimal> ) = - "10"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
