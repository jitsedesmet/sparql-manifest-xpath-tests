# QT3 test case K-CeilingFunc-5 of test set fn-ceiling, which tests the XPath expression
#   ceiling(-10.5) eq -10
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L532
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( CEIL( - "10.5"^^xsd:decimal ) = - "10"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
