# QT3 test case fn-ceiling-float-6 of test set fn-ceiling, which tests the XPath expression
#   ceiling(xs:float(-12345678.1e0))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L980
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CEIL( xsd:float ( - "12345678.1e0"^^xsd:double ) ) AS ?result)
  FILTER(( ( ISNUMERIC( ?result ) && ( ?result = "-12345678e0"^^xsd:double ) ) && SAMETERM( DATATYPE( ?result ) , xsd:float ) ))
}
