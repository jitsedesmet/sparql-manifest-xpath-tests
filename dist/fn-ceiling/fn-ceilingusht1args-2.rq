# QT3 test case fn-ceilingusht1args-2 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:unsignedShort("44633"))
ASK {
  BIND(CEIL( "44633"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) AS ?result)
  FILTER(( ?result = "44633"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
