# QT3 test case fn-ceilingpint1args-1 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:positiveInteger("1"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L331
ASK {
  BIND(CEIL( "1"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) AS ?result)
  FILTER(( ?result = "1"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
