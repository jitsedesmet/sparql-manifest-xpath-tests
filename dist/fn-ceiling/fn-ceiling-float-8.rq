# QT3 test case fn-ceiling-float-8 of test set fn-ceiling, which tests the XPath expression
#   ceiling(xs:float(xs:float('NaN')))
ASK {
  BIND(CEIL( <http://www.w3.org/2001/XMLSchema#float> ( <http://www.w3.org/2001/XMLSchema#float> ( "NaN" ) ) ) AS ?result)
  FILTER(( ( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "NaN" ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#float> ) ) ))
}
