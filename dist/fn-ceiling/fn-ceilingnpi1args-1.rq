# QT3 test case fn-ceilingnpi1args-1 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:nonPositiveInteger("-999999999999999999"))
ASK {
  BIND(CEIL( "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( ?result = - "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
