# QT3 test case fn-ceiling-float-3 of test set fn-ceiling, which tests the XPath expression
#   ceiling(xs:float(0.000000001e0))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L943
ASK {
  BIND(CEIL( <http://www.w3.org/2001/XMLSchema#float> ( "0.000000001e0"^^<http://www.w3.org/2001/XMLSchema#double> ) ) AS ?result)
  FILTER(( ( ?result = "1.0e0"^^<http://www.w3.org/2001/XMLSchema#double> ) && ( DATATYPE( ?result ) IN ( <http://www.w3.org/2001/XMLSchema#float> ) ) ))
}
