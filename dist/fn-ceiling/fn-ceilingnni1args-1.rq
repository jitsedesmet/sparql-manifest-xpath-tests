# QT3 test case fn-ceilingnni1args-1 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:nonNegativeInteger("0"))
ASK {
  BIND(CEIL( "0"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
