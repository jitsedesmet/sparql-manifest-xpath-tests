# QT3 test case fn-ceilingnni1args-1 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:nonNegativeInteger("0"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L421
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CEIL( "0"^^xsd:nonNegativeInteger ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "0"^^xsd:integer ) ))
}
