# QT3 test case fn-ceiling-double-1 of test set fn-ceiling, which tests the XPath expression
#   ceiling(12.5e0)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L772
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CEIL( "12.5e0"^^xsd:double ) AS ?result)
  FILTER(( ( ?result = "13.0e0"^^xsd:double ) && SAMETERM( DATATYPE( ?result ) , xsd:double ) ))
}
