# QT3 test case fn-ceilingnpi1args-2 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:nonPositiveInteger("-475688437271870490"))
ASK {
  BIND(CEIL( "-475688437271870490"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( ?result = - "475688437271870490"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
