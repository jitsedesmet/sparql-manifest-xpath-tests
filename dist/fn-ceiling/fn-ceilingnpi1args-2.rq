# QT3 test case fn-ceilingnpi1args-2 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:nonPositiveInteger("-475688437271870490"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L401
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CEIL( "-475688437271870490"^^xsd:nonPositiveInteger ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-475688437271870490"^^xsd:integer ) ))
}
