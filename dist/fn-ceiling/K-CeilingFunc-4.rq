# QT3 test case K-CeilingFunc-4 of test set fn-ceiling, which tests the XPath expression
#   ceiling(10.5) eq 11
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L522
ASK {
  BIND(( CEIL( "10.5"^^<http://www.w3.org/2001/XMLSchema#decimal> ) = "11"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
