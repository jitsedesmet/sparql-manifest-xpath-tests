# QT3 test case fn-ceilingulng1args-1 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:unsignedLong("0"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L361
ASK {
  BIND(CEIL( "0"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
