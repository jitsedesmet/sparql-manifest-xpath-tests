# QT3 test case fn-ceilingnint1args-1 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:negativeInteger("-999999999999999999"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L301
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CEIL( "-999999999999999999"^^xsd:negativeInteger ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-999999999999999999"^^xsd:integer ) ))
}
