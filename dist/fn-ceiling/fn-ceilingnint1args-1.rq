# QT3 test case fn-ceilingnint1args-1 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:negativeInteger("-999999999999999999"))
ASK {
  BIND(CEIL( "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> ) AS ?result)
  FILTER(( ?result = - "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
