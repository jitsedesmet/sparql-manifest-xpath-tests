# QT3 test case fn-ceilingdec1args-2 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:decimal("617375191608514839"))
ASK {
  BIND(CEIL( <http://www.w3.org/2001/XMLSchema#decimal> ( "617375191608514839" ) ) AS ?result)
  FILTER(( ?result = "617375191608514839"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
