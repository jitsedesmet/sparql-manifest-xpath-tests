# QT3 test case fn-ceilingint1args-2 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:int("-1873914410"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L68
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CEIL( "-1873914410"^^xsd:int ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "-1873914410"^^xsd:integer ) ))
}
