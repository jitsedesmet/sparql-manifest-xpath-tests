# QT3 test case fn-ceilingulng1args-3 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:unsignedLong("184467440737095516"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L381
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CEIL( "184467440737095516"^^xsd:unsignedLong ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "184467440737095516"^^xsd:integer ) ))
}
