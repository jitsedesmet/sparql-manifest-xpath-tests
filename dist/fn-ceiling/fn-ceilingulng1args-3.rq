# QT3 test case fn-ceilingulng1args-3 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:unsignedLong("184467440737095516"))
ASK {
  BIND(CEIL( "184467440737095516"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( ?result = "184467440737095516"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
