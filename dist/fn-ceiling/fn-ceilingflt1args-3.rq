# QT3 test case fn-ceilingflt1args-3 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:float("3.4028235E38"))
# Expecting:
#   <assert-string-value>3.4028235E38</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/ceiling.xml#L231
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(CEIL( xsd:float ( "3.4028235E38" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "3.4028235E38" ))
}
