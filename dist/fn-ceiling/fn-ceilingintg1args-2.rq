# QT3 test case fn-ceilingintg1args-2 of test set fn-ceiling, which tests the XPath expression
#   fn:ceiling(xs:integer("830993497117024304"))
ASK {
  BIND(CEIL( <http://www.w3.org/2001/XMLSchema#integer> ( "830993497117024304" ) ) AS ?result)
  FILTER(( ?result = "830993497117024304"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
