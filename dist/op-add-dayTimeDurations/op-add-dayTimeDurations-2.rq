# QT3 test case op-add-dayTimeDurations-2 of test set op-add-dayTimeDurations, which tests the XPath expression
#   fn:string(xs:dayTimeDuration("P10DT10H11M") + xs:dayTimeDuration("P12DT10H07M")) and fn:false()
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDurations.xml#L112
# The test needs the constructor function xsd:dayTimeDuration, + on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:dayTimeDuration ( "P10DT10H11M" ) + xsd:dayTimeDuration ( "P12DT10H07M" ) ) ) && "false"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
