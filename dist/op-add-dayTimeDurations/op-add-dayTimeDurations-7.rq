# QT3 test case op-add-dayTimeDurations-7 of test set op-add-dayTimeDurations, which tests the XPath expression
#   fn:string(xs:dayTimeDuration("P03DT04H08M") + xs:dayTimeDuration("P01DT09H02M"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDurations.xml#L195
# The test needs the constructor function xsd:dayTimeDuration, + on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(<http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P03DT04H08M" ) + <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P01DT09H02M" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "P4DT13H10M" ))
}
