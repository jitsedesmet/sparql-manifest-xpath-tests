# QT3 test case op-add-dayTimeDurations2args-1 of test set op-add-dayTimeDurations, which tests the XPath expression
#   xs:dayTimeDuration("P0DT0H0M0S") + xs:dayTimeDuration("P0DT0H0M0S")
# Expecting:
#   <assert-string-value>PT0S</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDurations.xml#L6
# The test needs the constructor function xsd:dayTimeDuration, + on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:dayTimeDuration ( "P0DT0H0M0S" ) + xsd:dayTimeDuration ( "P0DT0H0M0S" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "PT0S" ))
}
