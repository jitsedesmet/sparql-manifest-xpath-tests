# QT3 test case op-add-dayTimeDurations-14 of test set op-add-dayTimeDurations, which tests the XPath expression
#   (xs:dayTimeDuration("P21DT08H12M") + xs:dayTimeDuration("P08DT08H05M")) ne xs:dayTimeDuration("P08DT08H05M")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDurations.xml#L310
# The test needs the constructor function xsd:dayTimeDuration, + on xsd:dayTimeDuration, != on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:dayTimeDuration ( "P21DT08H12M" ) + xsd:dayTimeDuration ( "P08DT08H05M" ) ) != xsd:dayTimeDuration ( "P08DT08H05M" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
