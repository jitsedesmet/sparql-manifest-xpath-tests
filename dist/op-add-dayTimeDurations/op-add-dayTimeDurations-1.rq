# QT3 test case op-add-dayTimeDurations-1 of test set op-add-dayTimeDurations, which tests the XPath expression
#   xs:dayTimeDuration("P2DT12H5M") + xs:dayTimeDuration("P5DT12H")
# Expecting:
#   <assert-string-value>P8DT5M</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDurations.xml#L96
# The test needs the constructor function xsd:dayTimeDuration, + on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:dayTimeDuration ( "P2DT12H5M" ) + xsd:dayTimeDuration ( "P5DT12H" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "P8DT5M" ))
}
