# QT3 test case K-DayTimeDurationAdd-2 of test set op-add-dayTimeDurations, which tests the XPath expression
#   xs:dayTimeDuration("PT0S") + xs:dayTimeDuration("P3DT4H3M3.100S") eq xs:dayTimeDuration("P3DT4H3M3.100S")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-dayTimeDurations.xml#L373
# The test needs the constructor function xsd:dayTimeDuration, + on xsd:dayTimeDuration, = on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:dayTimeDuration ( "PT0S" ) + xsd:dayTimeDuration ( "P3DT4H3M3.100S" ) ) = xsd:dayTimeDuration ( "P3DT4H3M3.100S" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
