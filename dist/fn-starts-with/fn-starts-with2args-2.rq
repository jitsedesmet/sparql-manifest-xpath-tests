# QT3 test case fn-starts-with2args-2 of test set fn-starts-with, which tests the XPath expression
#   fn:starts-with(xs:string("This is a characte"),xs:string("This is a characte"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/starts-with.xml#L16
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(STRSTARTS( xsd:string ( "This is a characte" ) , xsd:string ( "This is a characte" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
