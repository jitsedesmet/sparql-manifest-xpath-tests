# QT3 test case fn-starts-with-8 of test set fn-starts-with, which tests the XPath expression
#   fn:starts-with("AAAAABBBBBCCCCC","BBBBB")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/starts-with.xml#L115
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(STRSTARTS( "AAAAABBBBBCCCCC" , "BBBBB" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
