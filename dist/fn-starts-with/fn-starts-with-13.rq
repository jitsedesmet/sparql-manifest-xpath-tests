# QT3 test case fn-starts-with-13 of test set fn-starts-with, which tests the XPath expression
#   fn:starts-with(xs:string("A"),"A")
ASK {
  BIND(STRSTARTS( <http://www.w3.org/2001/XMLSchema#string> ( "A" ) , "A" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
