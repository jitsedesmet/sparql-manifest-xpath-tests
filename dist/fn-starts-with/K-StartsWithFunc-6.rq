# QT3 test case K-StartsWithFunc-6 of test set fn-starts-with, which tests the XPath expression
#   starts-with("foo", "foo")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/starts-with.xml#L507
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(STRSTARTS( "foo" , "foo" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
