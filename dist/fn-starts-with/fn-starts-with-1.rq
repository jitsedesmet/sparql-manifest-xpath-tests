# QT3 test case fn-starts-with-1 of test set fn-starts-with, which tests the XPath expression
#   fn:starts-with("","")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/starts-with.xml#L52
ASK {
  BIND(STRSTARTS( "" , "" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
