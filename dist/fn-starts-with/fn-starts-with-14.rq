# QT3 test case fn-starts-with-14 of test set fn-starts-with, which tests the XPath expression
#   fn:starts-with("A",xs:string("A"))
ASK {
  BIND(STRSTARTS( "A" , <http://www.w3.org/2001/XMLSchema#string> ( "A" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
