# QT3 test case fn-starts-with-14 of test set fn-starts-with, which tests the XPath expression
#   fn:starts-with("A",xs:string("A"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/starts-with.xml#L169
ASK {
  BIND(STRSTARTS( "A" , <http://www.w3.org/2001/XMLSchema#string> ( "A" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
