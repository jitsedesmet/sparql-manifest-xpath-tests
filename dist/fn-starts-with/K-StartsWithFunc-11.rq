# QT3 test case K-StartsWithFunc-11 of test set fn-starts-with, which tests the XPath expression
#   not(starts-with("", "a string"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/starts-with.xml#L552
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! STRSTARTS( "" , "a string" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
