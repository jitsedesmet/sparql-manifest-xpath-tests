# QT3 test case fn-starts-with-16 of test set fn-starts-with, which tests the XPath expression
#   fn:starts-with("a","A")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/starts-with.xml#L187
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(STRSTARTS( "a" , "A" ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
