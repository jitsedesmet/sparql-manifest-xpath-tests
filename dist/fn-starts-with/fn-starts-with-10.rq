# QT3 test case fn-starts-with-10 of test set fn-starts-with, which tests the XPath expression
#   fn:starts-with(" ","AAAAABBBBB")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/starts-with.xml#L133
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(STRSTARTS( " " , "AAAAABBBBB" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
