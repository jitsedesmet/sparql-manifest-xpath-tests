# QT3 test case op-subtract-dayTimeDurations-9 of test set op-subtract-dayTimeDurations, which tests the XPath expression
#   fn:string((xs:dayTimeDuration("P01DT02H01M") - xs:dayTimeDuration("P02DT09H02M"))) and fn:string((xs:dayTimeDuration("P02DT03H03M") - xs:dayTimeDuration("P04DT04H04M")))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDurations.xml#L225
# The test needs the constructor function xsd:dayTimeDuration, - on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:string ( ( xsd:dayTimeDuration ( "P01DT02H01M" ) - xsd:dayTimeDuration ( "P02DT09H02M" ) ) ) && xsd:string ( ( xsd:dayTimeDuration ( "P02DT03H03M" ) - xsd:dayTimeDuration ( "P04DT04H04M" ) ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
