<#K-DayTimeDurationSubtract-4> a mf:QueryEvaluationTest ;
  mf:name "K-DayTimeDurationSubtract-4" ;
  rdfs:comment "*******************************************************\n Test: K-DayTimeDurationSubtract-4                     \n Written by: Frans Englich                             \n Date: 2007-11-22T11:31:21+01:00                       \n Purpose: The substraction operator is not available between xs:dayTimeDuration and xs:yearMonthDuration. \n*******************************************************" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDurations.xml> ;
  mf:action [ qt:query <K-DayTimeDurationSubtract-4.rq> ] ;
  mf:result <../true.srj> .

