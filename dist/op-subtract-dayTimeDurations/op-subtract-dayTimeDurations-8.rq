# QT3 test case op-subtract-dayTimeDurations-8 of test set op-subtract-dayTimeDurations, which tests the XPath expression
#   (xs:dayTimeDuration("P10DT01H01M") - xs:dayTimeDuration("P11DT02H02M"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDurations.xml#L209
# The test needs the constructor function xsd:dayTimeDuration, - on xsd:dayTimeDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P10DT01H01M" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P11DT02H02M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-P1DT1H1M" ))
}
