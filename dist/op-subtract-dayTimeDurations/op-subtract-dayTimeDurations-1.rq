# QT3 test case op-subtract-dayTimeDurations-1 of test set op-subtract-dayTimeDurations, which tests the XPath expression
#   xs:dayTimeDuration("P2DT12H") - xs:dayTimeDuration("P1DT10H30M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDurations.xml#L97
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P2DT12H" ) - <http://www.w3.org/2001/XMLSchema#dayTimeDuration> ( "P1DT10H30M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "P1DT1H30M" ))
}
