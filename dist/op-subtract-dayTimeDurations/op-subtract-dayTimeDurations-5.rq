# QT3 test case op-subtract-dayTimeDurations-5 of test set op-subtract-dayTimeDurations, which tests the XPath expression
#   fn:boolean(fn:string(xs:dayTimeDuration("P05DT09H08M") - xs:dayTimeDuration("P03DT08H06M")))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDurations.xml#L161
# The test needs the constructor function xsd:dayTimeDuration, - on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( ! xsd:string ( ( xsd:dayTimeDuration ( "P05DT09H08M" ) - xsd:dayTimeDuration ( "P03DT08H06M" ) ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
