# QT3 test case K-DayTimeDurationSubtract-1 of test set op-subtract-dayTimeDurations, which tests the XPath expression
#   xs:dayTimeDuration("P3DT4H3M3.100S") - xs:dayTimeDuration("PT0S") eq xs:dayTimeDuration("P3DT4H3M3.100S")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/subtract-dayTimeDurations.xml#L353
# The test needs the constructor function xsd:dayTimeDuration, - on xsd:dayTimeDuration, = on xsd:dayTimeDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:dayTimeDuration ( "P3DT4H3M3.100S" ) - xsd:dayTimeDuration ( "PT0S" ) ) = xsd:dayTimeDuration ( "P3DT4H3M3.100S" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
