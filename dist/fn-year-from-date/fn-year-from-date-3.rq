# QT3 test case fn-year-from-date-3 of test set fn-year-from-date, which tests the XPath expression
#   fn:year-from-date(xs:date("1999-12-31Z")) lt fn:year-from-date(xs:date("1999-12-31Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/year-from-date.xml#L52
# The test needs the constructor function xsd:date, YEAR on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( YEAR( xsd:date ( "1999-12-31Z" ) ) < YEAR( xsd:date ( "1999-12-31Z" ) ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
