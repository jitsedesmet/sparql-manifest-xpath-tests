# QT3 test case fn-year-from-date-4 of test set fn-year-from-date, which tests the XPath expression
#   fn:year-from-date(xs:date("1999-12-31Z")) le fn:year-from-date(xs:date("1999-12-31Z"))
ASK {
  BIND(( YEAR( <http://www.w3.org/2001/XMLSchema#date> ( "1999-12-31Z" ) ) <= YEAR( <http://www.w3.org/2001/XMLSchema#date> ( "1999-12-31Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
