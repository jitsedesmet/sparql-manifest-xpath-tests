# QT3 test case K-YearFromDateFunc-5 of test set fn-year-from-date, which tests the XPath expression
#   year-from-date(xs:date("2000-02-03")) eq 2000
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/year-from-date.xml#L245
# The test needs the constructor function xsd:date, YEAR on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( YEAR( xsd:date ( "2000-02-03" ) ) = "2000"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
