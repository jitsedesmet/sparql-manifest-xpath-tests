<#fn-year-from-date1args-1> a mf:QueryEvaluationTest ;
  mf:name "fn-year-from-date1args-1" ;
  rdfs:comment "Evaluates The \"year-from-date\" function with the arguments set as follows: $arg = xs:date(lower bound)" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/year-from-date.xml> ;
  mf:action [ qt:query <fn-year-from-date1args-1.rq> ] ;
  mf:result <../true.srj> .

<#fn-year-from-date1args-2> a mf:QueryEvaluationTest ;
  mf:name "fn-year-from-date1args-2" ;
  rdfs:comment "Evaluates The \"year-from-date\" function with the arguments set as follows: $arg = xs:date(mid range)" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/year-from-date.xml> ;
