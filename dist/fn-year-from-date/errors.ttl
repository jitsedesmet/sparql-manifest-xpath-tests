<> a mf:Manifest ;
  rdfs:label "QT3 test set fn-year-from-date" ;
  dct:license <../LICENSE.txt> ;
  mf:entries (
    <#fn-year-from-date-7>
  ) .

<#fn-year-from-date-7> a mf:QueryEvaluationTest ;
  mf:name "fn-year-from-date-7" ;
  rdfs:comment "Evaluates The \"year-from-date\" function that returns a negative number" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/year-from-date.xml#L88> ;
  mf:action [ qt:query <fn-year-from-date-7.rq> ] ;
  mf:result <../true.srj> .
