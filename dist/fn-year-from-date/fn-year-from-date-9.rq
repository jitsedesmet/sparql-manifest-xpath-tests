# QT3 test case fn-year-from-date-9 of test set fn-year-from-date, which tests the XPath expression
#   fn:year-from-date(xs:date("1970-01-01Z")) - fn:year-from-date(xs:date("1970-01-01Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/year-from-date.xml#L110
ASK {
  BIND(( YEAR( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) ) - YEAR( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0" ))
}
