# QT3 test case fn-year-from-date-15 of test set fn-year-from-date, which tests the XPath expression
#   -fn:year-from-date(xs:date("1970-01-01Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/year-from-date.xml#L164
# The test needs the constructor function xsd:date, YEAR on xsd:date, which SPARQL does not define
ASK {
  BIND(- YEAR( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-1970" ))
}
