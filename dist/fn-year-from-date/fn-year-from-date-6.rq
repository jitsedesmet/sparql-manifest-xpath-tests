# QT3 test case fn-year-from-date-6 of test set fn-year-from-date, which tests the XPath expression
#   fn:year-from-date(xs:date("0001-05-31Z"))
ASK {
  BIND(YEAR( <http://www.w3.org/2001/XMLSchema#date> ( "0001-05-31Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1" ))
}
