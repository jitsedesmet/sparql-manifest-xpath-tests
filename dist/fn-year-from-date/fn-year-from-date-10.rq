# QT3 test case fn-year-from-date-10 of test set fn-year-from-date, which tests the XPath expression
#   fn:year-from-date(xs:date("1970-01-01Z")) * fn:year-from-date(xs:date("0002-01-01Z"))
ASK {
  BIND(( YEAR( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) ) * YEAR( <http://www.w3.org/2001/XMLSchema#date> ( "0002-01-01Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "3940" ))
}
