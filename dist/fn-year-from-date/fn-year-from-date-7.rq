# QT3 test case fn-year-from-date-7 of test set fn-year-from-date, which tests the XPath expression
#   fn:year-from-date(xs:date("-1999-05-31Z"))
ASK {
  BIND(YEAR( <http://www.w3.org/2001/XMLSchema#date> ( "-1999-05-31Z" ) ) AS ?result)
  FILTER(( ( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-1999" ) || ! BOUND( ?result ) ))
}
