# QT3 test case fn-year-from-date-2 of test set fn-year-from-date, which tests the XPath expression
#   fn:year-from-date(xs:date("2000-01-01Z"))
ASK {
  BIND(YEAR( <http://www.w3.org/2001/XMLSchema#date> ( "2000-01-01Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2000" ))
}
