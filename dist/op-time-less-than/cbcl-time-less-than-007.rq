# QT3 test case cbcl-time-less-than-007 of test set op-time-less-than, which tests the XPath expression
#   xs:time("14:00:00-12:00") ge xs:time("02:00:00")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/time-less-than.xml#L569
# The test needs the constructor function xsd:time, >= on xsd:time, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:time ( "14:00:00-12:00" ) >= xsd:time ( "02:00:00" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
