# QT3 test case op-time-less-than-5 of test set op-time-less-than, which tests the XPath expression
#   fn:not(xs:time("13:00:00Z") lt xs:time("10:00:00Z"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#time> ( "13:00:00Z" ) < <http://www.w3.org/2001/XMLSchema#time> ( "10:00:00Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
