# QT3 test case K-TimeLT-2 of test set op-time-less-than, which tests the XPath expression
#   not(xs:time("23:01:03.12") gt xs:time("23:01:04.12"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/time-less-than.xml#L425
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#time> ( "23:01:03.12" ) > <http://www.w3.org/2001/XMLSchema#time> ( "23:01:04.12" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
