# QT3 test case cbcl-time-less-than-002 of test set op-time-less-than, which tests the XPath expression
#   xs:time("14:00:00-12:00") lt xs:time("02:00:00")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "14:00:00-12:00" ) < <http://www.w3.org/2001/XMLSchema#time> ( "02:00:00" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
