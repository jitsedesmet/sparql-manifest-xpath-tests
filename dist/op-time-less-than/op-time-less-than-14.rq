# QT3 test case op-time-less-than-14 of test set op-time-less-than, which tests the XPath expression
#   (xs:time("13:00:00Z") le xs:time("17:00:00Z")) or (fn:false())
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#time> ( "13:00:00Z" ) <= <http://www.w3.org/2001/XMLSchema#time> ( "17:00:00Z" ) ) || "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
