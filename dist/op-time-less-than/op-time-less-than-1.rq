# QT3 test case op-time-less-than-1 of test set op-time-less-than, which tests the XPath expression
#   (xs:time("12:00:00-05:00") lt xs:time("23:00:00+06:00"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/time-less-than.xml#L186
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "12:00:00-05:00" ) < <http://www.w3.org/2001/XMLSchema#time> ( "23:00:00+06:00" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
