# QT3 test case op-time-less-than-2 of test set op-time-less-than, which tests the XPath expression
#   xs:time("11:00:00-05:00") lt xs:time("17:00:00Z")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#time> ( "11:00:00-05:00" ) < <http://www.w3.org/2001/XMLSchema#time> ( "17:00:00Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
