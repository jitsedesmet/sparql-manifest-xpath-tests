# QT3 test case op-time-less-than-6 of test set op-time-less-than, which tests the XPath expression
#   fn:not(xs:time("13:00:00Z") le xs:time("12:00:00Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/time-less-than.xml#L266
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#time> ( "13:00:00Z" ) <= <http://www.w3.org/2001/XMLSchema#time> ( "12:00:00Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
