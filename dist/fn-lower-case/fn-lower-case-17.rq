# QT3 test case fn-lower-case-17 of test set fn-lower-case, which tests the XPath expression
#   fn:lower-case("abc") and fn:lower-case("abc")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/lower-case.xml#L178
ASK {
  BIND(( LCASE( "abc" ) && LCASE( "abc" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
