# QT3 test case fn-lower-case-13 of test set fn-lower-case, which tests the XPath expression
#   fn:concat(fn:lower-case("abcde"), fn:lower-case("fghi"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/lower-case.xml#L142
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( LCASE( "abcde" ) ) , <http://www.w3.org/2001/XMLSchema#string> ( LCASE( "fghi" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "abcdefghi" ))
}
