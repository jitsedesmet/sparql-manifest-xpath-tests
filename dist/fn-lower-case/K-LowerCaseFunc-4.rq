# QT3 test case K-LowerCaseFunc-4 of test set fn-lower-case, which tests the XPath expression
#   upper-case("abCd0") eq "ABCD0"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/lower-case.xml#L269
ASK {
  BIND(( UCASE( "abCd0" ) = "ABCD0" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
