# QT3 test case fn-lower-case-14 of test set fn-lower-case, which tests the XPath expression
#   fn:not(fn:lower-case("abcde"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/lower-case.xml#L151
ASK {
  BIND(! LCASE( "abcde" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
