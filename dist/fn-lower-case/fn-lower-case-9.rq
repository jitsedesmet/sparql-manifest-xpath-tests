# QT3 test case fn-lower-case-9 of test set fn-lower-case, which tests the XPath expression
#   fn:lower-case(upper-case("AbcDH"))
# Expecting:
#   <assert-string-value>abcdh</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/lower-case.xml#L106
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(LCASE( UCASE( "AbcDH" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "abcdh" ))
}
