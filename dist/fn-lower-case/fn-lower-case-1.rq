# QT3 test case fn-lower-case-1 of test set fn-lower-case, which tests the XPath expression
#   fn:lower-case("ABc!D")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/lower-case.xml#L34
ASK {
  BIND(LCASE( "ABc!D" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "abc!d" ))
}
