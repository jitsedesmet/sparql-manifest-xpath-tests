# QT3 test case fn-lower-case-16 of test set fn-lower-case, which tests the XPath expression
#   fn:lower-case("lower-case")
# Expecting:
#   <assert-string-value>lower-case</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/lower-case.xml#L169
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(LCASE( "lower-case" ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "lower-case" ))
}
