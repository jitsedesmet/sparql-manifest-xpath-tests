# QT3 test case fn-lower-case-6 of test set fn-lower-case, which tests the XPath expression
#   fn:lower-case("abcde")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/lower-case.xml#L79
ASK {
  BIND(LCASE( "abcde" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "abcde" ))
}
