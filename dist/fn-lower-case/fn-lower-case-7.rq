# QT3 test case fn-lower-case-7 of test set fn-lower-case, which tests the XPath expression
#   fn:lower-case("ABCDEabcde")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/lower-case.xml#L88
ASK {
  BIND(LCASE( "ABCDEabcde" ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "abcdeabcde" ))
}
