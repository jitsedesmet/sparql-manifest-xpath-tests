# QT3 test case fn-lower-case1args-1 of test set fn-lower-case, which tests the XPath expression
#   fn:lower-case(xs:string("This is a characte"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/lower-case.xml#L7
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(LCASE( xsd:string ( "This is a characte" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "this is a characte" ))
}
