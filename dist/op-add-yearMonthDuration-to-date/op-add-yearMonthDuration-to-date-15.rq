# QT3 test case op-add-yearMonthDuration-to-date-15 of test set op-add-yearMonthDuration-to-date, which tests the XPath expression
#   (xs:date("1978-12-12Z") + xs:yearMonthDuration("P17Y12M")) le xs:date("1978-12-12Z")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDuration-to-date.xml#L307
# The test needs the constructor function xsd:date, the constructor function xsd:yearMonthDuration, + on xsd:date, + on xsd:yearMonthDuration, <= on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:date ( "1978-12-12Z" ) + xsd:yearMonthDuration ( "P17Y12M" ) ) <= xsd:date ( "1978-12-12Z" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
