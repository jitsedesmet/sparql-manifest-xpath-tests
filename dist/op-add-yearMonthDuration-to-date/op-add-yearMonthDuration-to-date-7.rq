# QT3 test case op-add-yearMonthDuration-to-date-7 of test set op-add-yearMonthDuration-to-date, which tests the XPath expression
#   fn:string(xs:date("1989-07-05Z") + xs:yearMonthDuration("P08Y04M"))
# Expecting:
#   <assert-string-value>1997-11-05Z</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDuration-to-date.xml#L192
# The test needs the constructor function xsd:date, the constructor function xsd:yearMonthDuration, + on xsd:date, + on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(xsd:string ( ( xsd:date ( "1989-07-05Z" ) + xsd:yearMonthDuration ( "P08Y04M" ) ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1997-11-05Z" ))
}
