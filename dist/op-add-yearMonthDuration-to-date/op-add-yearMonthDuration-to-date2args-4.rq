# QT3 test case op-add-yearMonthDuration-to-date2args-4 of test set op-add-yearMonthDuration-to-date, which tests the XPath expression
#   xs:date("1970-01-01Z") + xs:yearMonthDuration("P1000Y6M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1000Y6M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2970-07-01Z" ))
}
