# QT3 test case op-add-yearMonthDuration-to-date2args-5 of test set op-add-yearMonthDuration-to-date, which tests the XPath expression
#   xs:date("1970-01-01Z") + xs:yearMonthDuration("P2030Y12M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDuration-to-date.xml#L79
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P2030Y12M" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "4001-01-01Z" ))
}
