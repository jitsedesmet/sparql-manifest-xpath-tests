# QT3 test case op-add-yearMonthDuration-to-date-4 of test set op-add-yearMonthDuration-to-date, which tests the XPath expression
#   fn:not(fn:string(xs:date("1998-09-12Z") + xs:yearMonthDuration("P20Y03M")))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDuration-to-date.xml#L144
# The test needs the constructor function xsd:date, the constructor function xsd:yearMonthDuration, + on xsd:date, + on xsd:yearMonthDuration, which SPARQL does not define
ASK {
  BIND(! <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#date> ( "1998-09-12Z" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P20Y03M" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
