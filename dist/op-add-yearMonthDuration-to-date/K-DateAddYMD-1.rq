# QT3 test case K-DateAddYMD-1 of test set op-add-yearMonthDuration-to-date, which tests the XPath expression
#   xs:date("1999-08-12") + xs:yearMonthDuration("P3Y7M") eq xs:date("2003-03-12")
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "1999-08-12" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P3Y7M" ) ) = <http://www.w3.org/2001/XMLSchema#date> ( "2003-03-12" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
