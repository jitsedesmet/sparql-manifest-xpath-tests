# QT3 test case K-DateAddYMD-2 of test set op-add-yearMonthDuration-to-date, which tests the XPath expression
#   xs:yearMonthDuration("P3Y7M") + xs:date("1999-08-12") eq xs:date("2003-03-12")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/add-yearMonthDuration-to-date.xml#L354
# The test needs the constructor function xsd:yearMonthDuration, the constructor function xsd:date, + on xsd:yearMonthDuration, + on xsd:date, = on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:yearMonthDuration ( "P3Y7M" ) + xsd:date ( "1999-08-12" ) ) = xsd:date ( "2003-03-12" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
