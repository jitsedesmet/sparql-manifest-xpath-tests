# QT3 test case op-add-yearMonthDuration-to-date-10 of test set op-add-yearMonthDuration-to-date, which tests the XPath expression
#   fn:string((xs:date("1985-07-05Z") + xs:yearMonthDuration("P02Y02M"))) or fn:string((xs:date("1985-07-05Z") + xs:yearMonthDuration("P02Y02M")))
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#date> ( "1985-07-05Z" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P02Y02M" ) ) ) || <http://www.w3.org/2001/XMLSchema#string> ( ( <http://www.w3.org/2001/XMLSchema#date> ( "1985-07-05Z" ) + <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P02Y02M" ) ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
