# QT3 test case cbcl-matches-051 of test set fn-matches, which tests the XPath expression
#   fn:matches('&#x10000;&#x10000;', '(&#x10000;)\1')
ASK {
  BIND(REGEX( "&#x10000;&#x10000;" , "(&#x10000;)\\1" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
