# QT3 test case caselessmatch03 of test set fn-matches, which tests the XPath expression
#   matches('abZ', '[a-z]*', 'i')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L726
ASK {
  BIND(REGEX( "abZ" , "[a-z]*" , "i" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
