# QT3 test case fn-matches-36 of test set fn-matches, which tests the XPath expression
#   fn:matches('abcdefghijj', '(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)\10')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L430
ASK {
  BIND(REGEX( "abcdefghijj" , "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)\\10" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
