# QT3 test case fn-matches-24 of test set fn-matches, which tests the XPath expression
#   fn:matches("abracadabraabracadabraabracadabra", "aa{1,2}")
ASK {
  BIND(REGEX( "abracadabraabracadabraabracadabra" , "aa{1,2}" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
