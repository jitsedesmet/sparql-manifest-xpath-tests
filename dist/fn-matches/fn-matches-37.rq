# QT3 test case fn-matches-37 of test set fn-matches, which tests the XPath expression
#   fn:matches('abcdefghijk', '(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k\11)')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L439
ASK {
  BIND(REGEX( "abcdefghijk" , "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k\\11)" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
