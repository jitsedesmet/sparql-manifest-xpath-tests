# QT3 test case K2-MatchesFunc-5 of test set fn-matches, which tests the XPath expression
#   fn:matches("hello world", "\p{ IsBasicLatin}+", "x")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L937
ASK {
  BIND(REGEX( "hello world" , "\\p{ IsBasicLatin}+" , "x" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
