# QT3 test case fn-matches2args-5 of test set fn-matches, which tests the XPath expression
#   fn:matches("This is a characte","This is a characte")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L43
ASK {
  BIND(REGEX( "This is a characte" , "This is a characte" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
