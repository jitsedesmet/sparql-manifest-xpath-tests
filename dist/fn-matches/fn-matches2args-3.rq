# QT3 test case fn-matches2args-3 of test set fn-matches, which tests the XPath expression
#   fn:matches("This is a characte","This is a characte")
ASK {
  BIND(REGEX( "This is a characte" , "This is a characte" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
