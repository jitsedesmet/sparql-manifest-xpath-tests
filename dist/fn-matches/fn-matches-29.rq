# QT3 test case fn-matches-29 of test set fn-matches, which tests the XPath expression
#   fn:matches("#abc#1", "^(#)abc\11$")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L359
ASK {
  BIND(REGEX( "#abc#1" , "^(#)abc\\11$" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
