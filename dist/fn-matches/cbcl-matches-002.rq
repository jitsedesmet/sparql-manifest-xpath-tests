# QT3 test case cbcl-matches-002 of test set fn-matches, which tests the XPath expression
#   fn:matches('foo', '[a-\b]')
# Expecting:
#   <error code="FORX0002"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L1078
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(REGEX( "foo" , "[a-\\b]" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
