# QT3 test case K2-MatchesFunc-10 of test set fn-matches, which tests the XPath expression
#   matches("input", "\3")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L982
ASK {
  BIND(REGEX( "input" , "\\3" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
