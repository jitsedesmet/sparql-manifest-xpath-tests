# QT3 test case cbcl-matches-013 of test set fn-matches, which tests the XPath expression
#   fn:matches('foo', '\P{S')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L1212
ASK {
  BIND(REGEX( "foo" , "\\P{S" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
