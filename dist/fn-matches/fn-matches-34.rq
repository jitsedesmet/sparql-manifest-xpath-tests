# QT3 test case fn-matches-34 of test set fn-matches, which tests the XPath expression
#   fn:matches("x[Y-z]", "X[y-Z]", "qi")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L410
ASK {
  BIND(REGEX( "x[Y-z]" , "X[y-Z]" , "qi" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
