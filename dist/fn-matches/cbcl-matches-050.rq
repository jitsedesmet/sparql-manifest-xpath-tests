# QT3 test case cbcl-matches-050 of test set fn-matches, which tests the XPath expression
#   fn:matches('Mum', '([md])[aeiou]\1', 'i')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L1636
ASK {
  BIND(REGEX( "Mum" , "([md])[aeiou]\\1" , "i" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
