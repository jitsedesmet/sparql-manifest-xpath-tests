# QT3 test case fn-matches-53 of test set fn-matches, which tests the XPath expression
#   fn:matches("A", "([A-Z])\1*")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L613
ASK {
  BIND(REGEX( "A" , "([A-Z])\\1*" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
