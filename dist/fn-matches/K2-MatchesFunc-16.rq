# QT3 test case K2-MatchesFunc-16 of test set fn-matches, which tests the XPath expression
#   fn:matches("input", "[0-9-.]*/")
# Expecting:
#   <assert-string-value>false</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L1036
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(REGEX( "input" , "[0-9-.]*/" ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "false" ))
}
