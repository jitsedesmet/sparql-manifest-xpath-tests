# QT3 test case fn-matches-52 of test set fn-matches, which tests the XPath expression
#   fn:matches("aaababaaabaa", "^(a*b?a*){3,3}$")
ASK {
  BIND(REGEX( "aaababaaabaa" , "^(a*b?a*){3,3}$" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
