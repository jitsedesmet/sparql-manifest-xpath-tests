# QT3 test case cbcl-matches-037 of test set fn-matches, which tests the XPath expression
#   fn:matches('&#x10000;', '&#x10000;')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L1476
ASK {
  BIND(REGEX( "&#x10000;" , "&#x10000;" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
