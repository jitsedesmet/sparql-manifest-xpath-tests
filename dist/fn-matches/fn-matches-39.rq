# QT3 test case fn-matches-39 of test set fn-matches, which tests the XPath expression
#   fn:matches('abcdefghii', '(a)(b)(c)(d)(e)(f)(g)(h)(i\9)')
# Expecting:
#   <error code="FORX0002"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L457
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(REGEX( "abcdefghii" , "(a)(b)(c)(d)(e)(f)(g)(h)(i\\9)" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
