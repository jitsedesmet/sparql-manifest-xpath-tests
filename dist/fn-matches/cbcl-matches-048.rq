# QT3 test case cbcl-matches-048 of test set fn-matches, which tests the XPath expression
#   fn:matches('&#x20;&#x9;&#xD;', '\C+')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L1614
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(REGEX( "&#x20;&#x9;&#xD;" , "\\C+" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
