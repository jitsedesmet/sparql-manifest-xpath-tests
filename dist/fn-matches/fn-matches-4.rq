# QT3 test case fn-matches-4 of test set fn-matches, which tests the XPath expression
#   fn:concat(fn:matches("abracadabra", "^bra"),fn:matches("abracadabra", "^bra", ""))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L124
ASK {
  BIND(CONCAT( <http://www.w3.org/2001/XMLSchema#string> ( REGEX( "abracadabra" , "^bra" ) ) , <http://www.w3.org/2001/XMLSchema#string> ( REGEX( "abracadabra" , "^bra" , "" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "falsefalse" ))
}
