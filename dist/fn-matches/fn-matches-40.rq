# QT3 test case fn-matches-40 of test set fn-matches, which tests the XPath expression
#   fn:matches('aa', '(a\1)')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L466
ASK {
  BIND(REGEX( "aa" , "(a\\1)" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
