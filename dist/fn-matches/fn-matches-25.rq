# QT3 test case fn-matches-25 of test set fn-matches, which tests the XPath expression
#   fn:matches("abracadabra", "**%%")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L314
ASK {
  BIND(REGEX( "abracadabra" , "**%%" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
