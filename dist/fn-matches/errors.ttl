<#fn-matchesErr-1> a mf:QueryEvaluationTest ;
  mf:name "fn-matchesErr-1" ;
  rdfs:comment "Invalid flag for third argument of fn:matches." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L52> ;
  mf:action [ qt:query <fn-matchesErr-1.rq> ] ;
  mf:result <../true.srj> .

<#fn-matchesErr-2> a mf:QueryEvaluationTest ;
  mf:name "fn-matchesErr-2" ;
  rdfs:comment "back-reference illegal in square brackets See erratum FO.E24" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L61> ;
  mf:action [ qt:query <fn-matchesErr-2.rq> ] ;
  mf:result <../true.srj> .

<#fn-matchesErr-3> a mf:QueryEvaluationTest ;
  mf:name "fn-matchesErr-3" ;
  rdfs:comment "single-digit back-reference to non-existent group See erratum FO.E24" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L70> ;
  mf:action [ qt:query <fn-matchesErr-3.rq> ] ;
  mf:result <../true.srj> .

<#fn-matchesErr-4> a mf:QueryEvaluationTest ;
  mf:name "fn-matchesErr-4" ;
  rdfs:comment "single-digit back-reference to group not yet closed See erratum FO.E24" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L79> ;
  mf:action [ qt:query <fn-matchesErr-4.rq> ] ;
  mf:result <../true.srj> .

<#fn-matchesErr-5> a mf:QueryEvaluationTest ;
  mf:name "fn-matchesErr-5" ;
  rdfs:comment "double-digit back-reference to group not yet closed See erratum FO.E24" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L88> ;
  mf:action [ qt:query <fn-matchesErr-5.rq> ] ;
  mf:result <../true.srj> .

<#fn-matches-25> a mf:QueryEvaluationTest ;
  mf:name "fn-matches-25" ;
  rdfs:comment "Evaluation of matches function with invalid regular expression" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L314> ;
  mf:action [ qt:query <fn-matches-25.rq> ] ;
  mf:result <../true.srj> .

<#fn-matches-35> a mf:QueryEvaluationTest ;
  mf:name "fn-matches-35" ;
  rdfs:comment "Test for bug fix of 5348 in Errata for F+O. Expect FORX0002 err because \\99 is an invalid reference as 99th subexpression does not exist" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L421> ;
  mf:action [ qt:query <fn-matches-35.rq> ] ;
  mf:result <../true.srj> .

<#fn-matches-37> a mf:QueryEvaluationTest ;
  mf:name "fn-matches-37" ;
  rdfs:comment "Test for bug fix of 5348 in Errata for F+O. Expect FORX0002 err because \\11 reference is made before the closing right parenthesis of 11th reference" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L439> ;
  mf:action [ qt:query <fn-matches-37.rq> ] ;
  mf:result <../true.srj> .

<#fn-matches-38> a mf:QueryEvaluationTest ;
  mf:name "fn-matches-38" ;
  rdfs:comment "Test for bug fix of 5348 in Errata for F+O. Expect FORX0002 err because \\10 reference is made before the closing right parenthesis of 10th reference" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L448> ;
  mf:action [ qt:query <fn-matches-38.rq> ] ;
  mf:result <../true.srj> .

<#fn-matches-39> a mf:QueryEvaluationTest ;
  mf:name "fn-matches-39" ;
  rdfs:comment "Test for bug fix of 5348 in Errata for F+O. Expect FORX0002 err because \\9 reference is made before the closing right parenthesis of 9th reference" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L457> ;
  mf:action [ qt:query <fn-matches-39.rq> ] ;
  mf:result <../true.srj> .

<#fn-matches-40> a mf:QueryEvaluationTest ;
  mf:name "fn-matches-40" ;
  rdfs:comment "Test for bug fix of 5348 in Errata for F+O. Expect FORX0002 err because \\1 reference is made before the closing right parenthesis of 1st reference" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L466> ;
  mf:action [ qt:query <fn-matches-40.rq> ] ;
  mf:result <../true.srj> .

<#K-MatchesFunc-5> a mf:QueryEvaluationTest ;
  mf:name "K-MatchesFunc-5" ;
  rdfs:comment "The flags argument cannot contain whitespace." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L883> ;
  mf:action [ qt:query <K-MatchesFunc-5.rq> ] ;
  mf:result <../true.srj> .

<#K-MatchesFunc-6> a mf:QueryEvaluationTest ;
  mf:name "K-MatchesFunc-6" ;
  rdfs:comment "The flags argument cannot contain 'X'." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L892> ;
  mf:action [ qt:query <K-MatchesFunc-6.rq> ] ;
  mf:result <../true.srj> .

<#K2-MatchesFunc-7> a mf:QueryEvaluationTest ;
  mf:name "K2-MatchesFunc-7" ;
  rdfs:comment "whitespace in the regexp is not collapsed, and should therefore not compile." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L955> ;
  mf:action [ qt:query <K2-MatchesFunc-7.rq> ] ;
  mf:result <../true.srj> .

<#K2-MatchesFunc-8> a mf:QueryEvaluationTest ;
  mf:name "K2-MatchesFunc-8" ;
  rdfs:comment "Since no string is captured by the back-reference, the single character is matched." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L964> ;
  mf:action [ qt:query <K2-MatchesFunc-8.rq> ] ;
  mf:result <../true.srj> .

<#K2-MatchesFunc-9> a mf:QueryEvaluationTest ;
  mf:name "K2-MatchesFunc-9" ;
  rdfs:comment "Since no string is captured by the back-reference, the single character is matched(#2)." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L973> ;
  mf:action [ qt:query <K2-MatchesFunc-9.rq> ] ;
  mf:result <../true.srj> .

<#K2-MatchesFunc-10> a mf:QueryEvaluationTest ;
  mf:name "K2-MatchesFunc-10" ;
  rdfs:comment "A non-matching backwards-reference matches the empty string." ;
