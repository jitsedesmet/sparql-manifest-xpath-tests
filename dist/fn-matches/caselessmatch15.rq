# QT3 test case caselessmatch15 of test set fn-matches, which tests the XPath expression
#   matches('m', '\P{Lu}', 'i')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L838
ASK {
  BIND(REGEX( "m" , "\\P{Lu}" , "i" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
