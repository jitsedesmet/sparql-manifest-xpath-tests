# QT3 test case fn-matches-31 of test set fn-matches, which tests the XPath expression
#   fn:matches("abracadabra", "(?:abra(?:cad)?)*")
ASK {
  BIND(REGEX( "abracadabra" , "(?:abra(?:cad)?)*" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
