# QT3 test case K2-MatchesFunc-6 of test set fn-matches, which tests the XPath expression
#   fn:matches("hello world", "\p{ I s B a s i c L a t i n }+", "x")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L946
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(REGEX( "hello world" , "\\p{ I s B a s i c L a t i n }+" , "x" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
