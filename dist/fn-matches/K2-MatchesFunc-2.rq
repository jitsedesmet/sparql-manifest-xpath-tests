# QT3 test case K2-MatchesFunc-2 of test set fn-matches, which tests the XPath expression
#   fn:matches("hello world", " hello[ ]world", "x")
ASK {
  BIND(REGEX( "hello world" , " hello[ ]world" , "x" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
