# QT3 test case fn-matches-35 of test set fn-matches, which tests the XPath expression
#   fn:matches('aA', '(a)\99')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L421
ASK {
  BIND(REGEX( "aA" , "(a)\\99" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
