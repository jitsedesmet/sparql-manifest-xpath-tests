# QT3 test case fn-matchesErr-1 of test set fn-matches, which tests the XPath expression
#   fn:matches("abracadabra", "bra", "p")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L52
ASK {
  BIND(REGEX( "abracadabra" , "bra" , "p" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
