# QT3 test case K-MatchesFunc-6 of test set fn-matches, which tests the XPath expression
#   matches("input", "pattern", "X")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L892
ASK {
  BIND(REGEX( "input" , "pattern" , "X" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
