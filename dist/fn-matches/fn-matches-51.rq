# QT3 test case fn-matches-51 of test set fn-matches, which tests the XPath expression
#   fn:matches("ab()cd()ef()gh", "^(ab)([()]*)(cd)([)(]*)ef\4gh$")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L595
ASK {
  BIND(REGEX( "ab()cd()ef()gh" , "^(ab)([()]*)(cd)([)(]*)ef\\4gh$" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
