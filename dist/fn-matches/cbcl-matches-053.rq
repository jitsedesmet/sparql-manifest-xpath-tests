# QT3 test case cbcl-matches-053 of test set fn-matches, which tests the XPath expression
#   fn:matches('Mud', '([md])[aeiou]\1', 'i')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L1669
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(REGEX( "Mud" , "([md])[aeiou]\\1" , "i" ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
