# QT3 test case fn-matchesErr-4 of test set fn-matches, which tests the XPath expression
#   fn:matches("#abc#1", "^((#)abc\1)$")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L79
ASK {
  BIND(REGEX( "#abc#1" , "^((#)abc\\1)$" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
