# QT3 test case fn-matches-27 of test set fn-matches, which tests the XPath expression
#   fn:matches("
#   abcd
#   defg
#   ", "^$", "m")
ASK {
  BIND(REGEX( "\nabcd\ndefg\n" , "^$" , "m" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
