# QT3 test case K2-MatchesFunc-11 of test set fn-matches, which tests the XPath expression
#   matches("abcd", "(asd)[\1]")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L991
ASK {
  BIND(REGEX( "abcd" , "(asd)[\\1]" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
