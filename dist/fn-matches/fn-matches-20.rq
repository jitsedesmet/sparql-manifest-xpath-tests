# QT3 test case fn-matches-20 of test set fn-matches, which tests the XPath expression
#   fn:matches("abracadabra	abracadabra", "\t")
ASK {
  BIND(REGEX( "abracadabra\tabracadabra" , "\\t" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
