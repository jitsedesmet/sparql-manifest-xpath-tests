# QT3 test case fn-matches-49 of test set fn-matches, which tests the XPath expression
#   fn:matches("abracadabra-abracadabra-3", "(124|864|377|3)")
ASK {
  BIND(REGEX( "abracadabra-abracadabra-3" , "(124|864|377|3)" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
