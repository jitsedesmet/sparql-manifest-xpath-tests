# QT3 test case K2-MatchesFunc-14 of test set fn-matches, which tests the XPath expression
#   matches("abcd", "1[asd\0]")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L1018
ASK {
  BIND(REGEX( "abcd" , "1[asd\\0]" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
