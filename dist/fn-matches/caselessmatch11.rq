# QT3 test case caselessmatch11 of test set fn-matches, which tests the XPath expression
#   matches('i', '[A-Z-[OI]]', 'i')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L802
ASK {
  BIND(REGEX( "i" , "[A-Z-[OI]]" , "i" ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
