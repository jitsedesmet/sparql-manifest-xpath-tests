# QT3 test case K2-MatchesFunc-13 of test set fn-matches, which tests the XPath expression
#   matches("abcd", "(asd)[asd\0]")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L1009
ASK {
  BIND(REGEX( "abcd" , "(asd)[asd\\0]" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
