# QT3 test case cbcl-matches-005 of test set fn-matches, which tests the XPath expression
#   fn:matches('a', '[a--]')
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L1114
ASK {
  BIND(REGEX( "a" , "[a--]" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
