<#fn-matches2args-1> a mf:QueryEvaluationTest ;
  mf:name "fn-matches2args-1" ;
  rdfs:comment "Evaluates The \"matches\" function with the arguments set as follows: $input = xs:string(lower bound) $pattern = xs:string(lower bound)" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml> ;
  mf:action [ qt:query <fn-matches2args-1.rq> ] ;
  mf:result <../true.srj> .

<#fn-matches2args-2> a mf:QueryEvaluationTest ;
  mf:name "fn-matches2args-2" ;
  rdfs:comment "Evaluates The \"matches\" function with the arguments set as follows: $input = xs:string(mid range) $pattern = xs:string(lower bound)" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml> ;
