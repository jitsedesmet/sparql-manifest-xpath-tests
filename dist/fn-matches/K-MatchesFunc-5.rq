# QT3 test case K-MatchesFunc-5 of test set fn-matches, which tests the XPath expression
#   matches("input", "pattern", " ")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/matches.xml#L883
ASK {
  BIND(REGEX( "input" , "pattern" , " " ) AS ?result)
  FILTER(! BOUND( ?result ))
}
