# QT3 test case K-GenCompGT-11 of test set prod-GeneralComp.gt, which tests the XPath expression
#   1 >= 1
ASK {
  BIND(( "1"^^<http://www.w3.org/2001/XMLSchema#integer> >= "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
