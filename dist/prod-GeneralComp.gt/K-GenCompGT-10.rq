# QT3 test case K-GenCompGT-10 of test set prod-GeneralComp.gt, which tests the XPath expression
#   2 > 1
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/prod/GeneralComp.gt.xml#L1084
ASK {
  BIND(( "2"^^<http://www.w3.org/2001/XMLSchema#integer> > "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
