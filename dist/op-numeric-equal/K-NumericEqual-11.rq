# QT3 test case K-NumericEqual-11 of test set op-numeric-equal, which tests the XPath expression
#   xs:integer(2) ne xs:decimal(2.6)
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#integer> ( "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) != <http://www.w3.org/2001/XMLSchema#decimal> ( "2.6"^^<http://www.w3.org/2001/XMLSchema#decimal> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
