# QT3 test case K-NumericEqual-11 of test set op-numeric-equal, which tests the XPath expression
#   xs:integer(2) ne xs:decimal(2.6)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L1279
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:integer ( "2"^^xsd:integer ) != xsd:decimal ( "2.6"^^xsd:decimal ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
