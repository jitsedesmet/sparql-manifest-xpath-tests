# QT3 test case K-NumericEqual-13 of test set op-numeric-equal, which tests the XPath expression
#   xs:double(-1.1) eq xs:double(-1.1)
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L1297
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( - "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> ) = <http://www.w3.org/2001/XMLSchema#double> ( - "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
