# QT3 test case op-numeric-equalsht2args-4 of test set op-numeric-equal, which tests the XPath expression
#   xs:short("-32768") eq xs:short("-5324")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L1114
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-32768"^^xsd:short = "-5324"^^xsd:short ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
