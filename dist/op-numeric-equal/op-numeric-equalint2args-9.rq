# QT3 test case op-numeric-equalint2args-9 of test set op-numeric-equal, which tests the XPath expression
#   xs:int("-2147483648") ne xs:int("-1873914410")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L79
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-2147483648"^^xsd:int != "-1873914410"^^xsd:int ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
