# QT3 test case op-numeric-equalflt2args-4 of test set op-numeric-equal, which tests the XPath expression
#   xs:float("-3.4028235E38") eq xs:float("0")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L394
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "-3.4028235E38" ) = <http://www.w3.org/2001/XMLSchema#float> ( "0" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
