# QT3 test case op-numeric-equalnpi2args-1 of test set op-numeric-equal, which tests the XPath expression
#   xs:nonPositiveInteger("-999999999999999999") eq xs:nonPositiveInteger("-999999999999999999")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L907
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-999999999999999999"^^xsd:nonPositiveInteger = "-999999999999999999"^^xsd:nonPositiveInteger ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
