# QT3 test case op-numeric-equalint2args-5 of test set op-numeric-equal, which tests the XPath expression
#   xs:int("-2147483648") eq xs:int("2147483647")
ASK {
  BIND(( "-2147483648"^^<http://www.w3.org/2001/XMLSchema#int> = "2147483647"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
