# QT3 test case op-numeric-equalnni2args-8 of test set op-numeric-equal, which tests the XPath expression
#   xs:nonNegativeInteger("999999999999999999") ne xs:nonNegativeInteger("0")
ASK {
  BIND(( "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> != "0"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
