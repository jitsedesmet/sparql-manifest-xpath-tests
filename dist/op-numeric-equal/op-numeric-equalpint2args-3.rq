# QT3 test case op-numeric-equalpint2args-3 of test set op-numeric-equal, which tests the XPath expression
#   xs:positiveInteger("999999999999999999") eq xs:positiveInteger("1")
ASK {
  BIND(( "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> = "1"^^<http://www.w3.org/2001/XMLSchema#positiveInteger> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
