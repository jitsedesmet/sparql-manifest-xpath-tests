# QT3 test case K-NumericEqual-38 of test set op-numeric-equal, which tests the XPath expression
#   xs:float("-INF") ne xs:float("0")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "-INF" ) != <http://www.w3.org/2001/XMLSchema#float> ( "0" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
