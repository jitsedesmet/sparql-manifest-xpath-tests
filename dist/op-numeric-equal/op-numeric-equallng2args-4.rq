# QT3 test case op-numeric-equallng2args-4 of test set op-numeric-equal, which tests the XPath expression
#   xs:long("-92233720368547758") eq xs:long("-47175562203048468")
ASK {
  BIND(( "-92233720368547758"^^<http://www.w3.org/2001/XMLSchema#long> = "-47175562203048468"^^<http://www.w3.org/2001/XMLSchema#long> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
