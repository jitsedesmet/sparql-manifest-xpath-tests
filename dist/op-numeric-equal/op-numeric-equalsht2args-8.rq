# QT3 test case op-numeric-equalsht2args-8 of test set op-numeric-equal, which tests the XPath expression
#   xs:short("32767") ne xs:short("-32768")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L1150
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "32767"^^xsd:short != "-32768"^^xsd:short ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
