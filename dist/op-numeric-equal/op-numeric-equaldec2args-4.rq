# QT3 test case op-numeric-equaldec2args-4 of test set op-numeric-equal, which tests the XPath expression
#   xs:decimal("-999999999999999999") eq xs:decimal("617375191608514839")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L214
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( "-999999999999999999" ) = <http://www.w3.org/2001/XMLSchema#decimal> ( "617375191608514839" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
