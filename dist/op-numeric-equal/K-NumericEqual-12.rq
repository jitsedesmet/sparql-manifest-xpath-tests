# QT3 test case K-NumericEqual-12 of test set op-numeric-equal, which tests the XPath expression
#   xs:double(1.1) eq xs:double(1.1)
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L1288
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:double ( "1.1"^^xsd:decimal ) = xsd:double ( "1.1"^^xsd:decimal ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
