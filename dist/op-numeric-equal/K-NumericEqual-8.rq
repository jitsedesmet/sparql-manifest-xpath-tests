# QT3 test case K-NumericEqual-8 of test set op-numeric-equal, which tests the XPath expression
#   xs:decimal(1.1) eq xs:decimal(1.1)
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> ) = <http://www.w3.org/2001/XMLSchema#decimal> ( "1.1"^^<http://www.w3.org/2001/XMLSchema#decimal> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
