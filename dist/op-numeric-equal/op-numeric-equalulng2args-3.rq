# QT3 test case op-numeric-equalulng2args-3 of test set op-numeric-equal, which tests the XPath expression
#   xs:unsignedLong("184467440737095516") eq xs:unsignedLong("0")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L835
ASK {
  BIND(( "184467440737095516"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> = "0"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
