# QT3 test case K-NumericEqual-39 of test set op-numeric-equal, which tests the XPath expression
#   xs:float("0") ne xs:float("INF")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L1531
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "0" ) != <http://www.w3.org/2001/XMLSchema#float> ( "INF" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
