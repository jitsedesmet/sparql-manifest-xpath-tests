# QT3 test case op-numeric-equalusht2args-3 of test set op-numeric-equal, which tests the XPath expression
#   xs:unsignedShort("65535") eq xs:unsignedShort("0")
ASK {
  BIND(( "65535"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> = "0"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
