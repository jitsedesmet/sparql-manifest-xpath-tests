# QT3 test case K-NumericEqual-29 of test set op-numeric-equal, which tests the XPath expression
#   xs:float(1.1) ne xs:float(2.1)
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L1441
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:float ( "1.1"^^xsd:decimal ) != xsd:float ( "2.1"^^xsd:decimal ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
