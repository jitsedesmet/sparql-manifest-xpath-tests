# QT3 test case op-numeric-equaldbl2args-9 of test set op-numeric-equal, which tests the XPath expression
#   xs:double("-1.7976931348623157E308") ne xs:double("0")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L349
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:double ( "-1.7976931348623157E308" ) != xsd:double ( "0" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
