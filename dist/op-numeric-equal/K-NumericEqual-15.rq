# QT3 test case K-NumericEqual-15 of test set op-numeric-equal, which tests the XPath expression
#   xs:double(-1) ne xs:double(1)
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( - "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) != <http://www.w3.org/2001/XMLSchema#double> ( "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
