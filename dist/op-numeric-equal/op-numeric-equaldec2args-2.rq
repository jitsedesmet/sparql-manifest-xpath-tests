# QT3 test case op-numeric-equaldec2args-2 of test set op-numeric-equal, which tests the XPath expression
#   xs:decimal("617375191608514839") eq xs:decimal("-999999999999999999")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( "617375191608514839" ) = <http://www.w3.org/2001/XMLSchema#decimal> ( "-999999999999999999" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
