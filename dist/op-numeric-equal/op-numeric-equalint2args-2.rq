# QT3 test case op-numeric-equalint2args-2 of test set op-numeric-equal, which tests the XPath expression
#   xs:int("-1873914410") eq xs:int("-2147483648")
ASK {
  BIND(( "-1873914410"^^<http://www.w3.org/2001/XMLSchema#int> = "-2147483648"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
