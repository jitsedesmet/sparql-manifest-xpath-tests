# QT3 test case op-numeric-equalusht2args-5 of test set op-numeric-equal, which tests the XPath expression
#   xs:unsignedShort("0") eq xs:unsignedShort("65535")
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L583
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "0"^^xsd:unsignedShort = "65535"^^xsd:unsignedShort ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
