# QT3 test case op-numeric-equalnint2args-5 of test set op-numeric-equal, which tests the XPath expression
#   xs:negativeInteger("-999999999999999999") eq xs:negativeInteger("-1")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L673
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-999999999999999999"^^xsd:negativeInteger = "-1"^^xsd:negativeInteger ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
