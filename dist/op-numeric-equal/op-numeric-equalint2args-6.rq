# QT3 test case op-numeric-equalint2args-6 of test set op-numeric-equal, which tests the XPath expression
#   xs:int("-2147483648") ne xs:int("-2147483648")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L52
ASK {
  BIND(( "-2147483648"^^<http://www.w3.org/2001/XMLSchema#int> != "-2147483648"^^<http://www.w3.org/2001/XMLSchema#int> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
