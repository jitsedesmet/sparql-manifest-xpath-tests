# QT3 test case K-NumericEqual-32 of test set op-numeric-equal, which tests the XPath expression
#   xs:float(0) ne xs:float("NaN")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) != <http://www.w3.org/2001/XMLSchema#float> ( "NaN" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
