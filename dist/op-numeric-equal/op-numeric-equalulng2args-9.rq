# QT3 test case op-numeric-equalulng2args-9 of test set op-numeric-equal, which tests the XPath expression
#   xs:unsignedLong("0") ne xs:unsignedLong("130747108607674654")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L889
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "0"^^xsd:unsignedLong != "130747108607674654"^^xsd:unsignedLong ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
