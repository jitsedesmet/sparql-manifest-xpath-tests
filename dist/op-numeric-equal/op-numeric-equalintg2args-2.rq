# QT3 test case op-numeric-equalintg2args-2 of test set op-numeric-equal, which tests the XPath expression
#   xs:integer("830993497117024304") eq xs:integer("-999999999999999999")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L106
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#integer> ( "830993497117024304" ) = <http://www.w3.org/2001/XMLSchema#integer> ( "-999999999999999999" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
