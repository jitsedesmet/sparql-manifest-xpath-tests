# QT3 test case op-numeric-equalnni2args-9 of test set op-numeric-equal, which tests the XPath expression
#   xs:nonNegativeInteger("0") ne xs:nonNegativeInteger("303884545991464527")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-equal.xml#L1069
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "0"^^xsd:nonNegativeInteger != "303884545991464527"^^xsd:nonNegativeInteger ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
