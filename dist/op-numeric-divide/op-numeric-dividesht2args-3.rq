# QT3 test case op-numeric-dividesht2args-3 of test set op-numeric-divide, which tests the XPath expression
#   xs:short("32767") div xs:short("-32768")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L511
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "32767"^^xsd:short / "-32768"^^xsd:short ) AS ?result)
  FILTER(( ( ISNUMERIC( ?result ) && ( ?result = "-0.999969482421875"^^xsd:decimal ) ) || ( ISNUMERIC( ?result ) && ( ?result = "-0.999969482421"^^xsd:decimal ) ) ))
}
