# QT3 test case op-numeric-divideint2args-1 of test set op-numeric-divide, which tests the XPath expression
#   xs:int("-2147483648") div xs:int("-2147483648")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L7
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-2147483648"^^xsd:int / "-2147483648"^^xsd:int ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "1"^^xsd:integer ) ))
}
