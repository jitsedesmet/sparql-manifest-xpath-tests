# QT3 test case op-numeric-divideulng2args-2 of test set op-numeric-divide, which tests the XPath expression
#   xs:unsignedLong("0") div xs:unsignedLong("184467440737095516")
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> / "184467440737095516"^^<http://www.w3.org/2001/XMLSchema#unsignedLong> ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
