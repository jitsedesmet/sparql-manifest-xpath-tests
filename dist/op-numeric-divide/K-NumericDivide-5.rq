# QT3 test case K-NumericDivide-5 of test set op-numeric-divide, which tests the XPath expression
#   xs:double(5) div xs:double(2) eq 2.5
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L669
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:double ( "5"^^xsd:integer ) / xsd:double ( "2"^^xsd:integer ) ) = "2.5"^^xsd:decimal ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
