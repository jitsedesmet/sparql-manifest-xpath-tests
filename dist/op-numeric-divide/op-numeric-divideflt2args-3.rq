# QT3 test case op-numeric-divideflt2args-3 of test set op-numeric-divide, which tests the XPath expression
#   xs:float("3.4028235E38") div xs:float("-3.4028235E38")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "3.4028235E38" ) / <http://www.w3.org/2001/XMLSchema#float> ( "-3.4028235E38" ) ) AS ?result)
  FILTER(( ?result = - "1"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
