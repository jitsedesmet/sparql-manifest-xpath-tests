# QT3 test case cbcl-numeric-divide-015 of test set op-numeric-divide, which tests the XPath expression
#   10000000000000000000000000000.0 div 0.1 gt 0
# Expecting:
#   <any-of>
#     <error code="FOAR0002"/>
#     <assert-true/>
#   </any-of>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L1403
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( "10000000000000000000000000000.0"^^xsd:decimal / "0.1"^^xsd:decimal ) > "0"^^xsd:integer ) AS ?result)
  FILTER(( ! BOUND( ?result ) || ( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ) ))
}
