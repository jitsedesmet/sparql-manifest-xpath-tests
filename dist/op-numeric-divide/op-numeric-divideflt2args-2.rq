# QT3 test case op-numeric-divideflt2args-2 of test set op-numeric-divide, which tests the XPath expression
#   xs:float("0") div xs:float("-3.4028235E38")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#float> ( "0" ) / <http://www.w3.org/2001/XMLSchema#float> ( "-3.4028235E38" ) ) AS ?result)
  FILTER(( ?result = - "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
