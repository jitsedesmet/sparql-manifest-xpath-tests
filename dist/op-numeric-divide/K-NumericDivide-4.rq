# QT3 test case K-NumericDivide-4 of test set op-numeric-divide, which tests the XPath expression
#   xs:float(6) div xs:float(2) eq 3
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L660
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#float> ( "6"^^<http://www.w3.org/2001/XMLSchema#integer> ) / <http://www.w3.org/2001/XMLSchema#float> ( "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) = "3"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
