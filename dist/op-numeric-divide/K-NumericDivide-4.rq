# QT3 test case K-NumericDivide-4 of test set op-numeric-divide, which tests the XPath expression
#   xs:float(6) div xs:float(2) eq 3
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L660
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:float ( "6"^^xsd:integer ) / xsd:float ( "2"^^xsd:integer ) ) = "3"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
