# QT3 test case op-numeric-divideusht2args-2 of test set op-numeric-divide, which tests the XPath expression
#   xs:unsignedShort("0") div xs:unsignedShort("65535")
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> / "65535"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
