# QT3 test case K2-NumericDivide-7 of test set op-numeric-divide, which tests the XPath expression
#   1 div xs:float(0)
ASK {
  BIND(( "1"^^<http://www.w3.org/2001/XMLSchema#integer> / <http://www.w3.org/2001/XMLSchema#float> ( "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "INF" ))
}
