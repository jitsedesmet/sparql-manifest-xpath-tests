# QT3 test case op-numeric-dividesht2args-5 of test set op-numeric-divide, which tests the XPath expression
#   xs:short("-32768") div xs:short("32767")
ASK {
  BIND(( "-32768"^^<http://www.w3.org/2001/XMLSchema#short> / "32767"^^<http://www.w3.org/2001/XMLSchema#short> ) AS ?result)
  FILTER(( ABS( ( ?result + "1.000030518509475997"^^<http://www.w3.org/2001/XMLSchema#decimal> ) ) < "1e-12"^^<http://www.w3.org/2001/XMLSchema#double> ))
}
