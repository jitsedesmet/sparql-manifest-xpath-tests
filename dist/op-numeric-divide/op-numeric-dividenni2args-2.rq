# QT3 test case op-numeric-dividenni2args-2 of test set op-numeric-divide, which tests the XPath expression
#   xs:nonNegativeInteger("0") div xs:nonNegativeInteger("999999999999999999")
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> / "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
