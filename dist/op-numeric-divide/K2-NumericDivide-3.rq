# QT3 test case K2-NumericDivide-3 of test set op-numeric-divide, which tests the XPath expression
#   1 div +0.0
# Expecting:
#   <error code="FOAR0001"/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L1053
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "1"^^xsd:integer / + "0.0"^^xsd:decimal ) AS ?result)
  FILTER(! BOUND( ?result ))
}
