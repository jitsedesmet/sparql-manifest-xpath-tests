<#op-numeric-divideint2args-1> a mf:QueryEvaluationTest ;
  mf:name "op-numeric-divideint2args-1" ;
  rdfs:comment "Evaluates The \"op:numeric-divide\" operator with the arguments set as follows: $arg1 = xs:int(lower bound) $arg2 = xs:int(lower bound)" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L7> ;
  mf:action [ qt:query <op-numeric-divideint2args-1.rq> ] ;
  mf:result <../true.srj> .

