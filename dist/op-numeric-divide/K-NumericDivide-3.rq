# QT3 test case K-NumericDivide-3 of test set op-numeric-divide, which tests the XPath expression
#   xs:integer(6) div xs:integer(2) eq 3
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L651
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:integer ( "6"^^xsd:integer ) / xsd:integer ( "2"^^xsd:integer ) ) = "3"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
