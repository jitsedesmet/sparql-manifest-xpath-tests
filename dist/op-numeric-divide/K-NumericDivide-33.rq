# QT3 test case K-NumericDivide-33 of test set op-numeric-divide, which tests the XPath expression
#   xs:double(3) div "3"
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L921
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( "3"^^<http://www.w3.org/2001/XMLSchema#integer> ) / "3" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
