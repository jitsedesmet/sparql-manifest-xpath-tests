# QT3 test case op-numeric-dividenpi2args-3 of test set op-numeric-divide, which tests the XPath expression
#   xs:nonPositiveInteger("0") div xs:nonPositiveInteger("-999999999999999999")
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> / "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#nonPositiveInteger> ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
