# QT3 test case op-numeric-dividedbl2args-4 of test set op-numeric-divide, which tests the XPath expression
#   xs:double("-1.7976931348623157E308") div xs:double("1.7976931348623157E308")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L190
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( "-1.7976931348623157E308" ) / <http://www.w3.org/2001/XMLSchema#double> ( "1.7976931348623157E308" ) ) AS ?result)
  FILTER(( ?result = - "1"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
