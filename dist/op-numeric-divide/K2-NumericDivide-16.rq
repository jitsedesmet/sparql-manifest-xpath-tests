# QT3 test case K2-NumericDivide-16 of test set op-numeric-divide, which tests the XPath expression
#   -3 div -0e0
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L1170
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( - "3"^^xsd:integer / - "0e0"^^xsd:double ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "INF" ))
}
