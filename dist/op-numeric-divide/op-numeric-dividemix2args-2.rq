# QT3 test case op-numeric-dividemix2args-2 of test set op-numeric-divide, which tests the XPath expression
#   1 div '1'
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L555
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "1"^^xsd:integer / "1" ) AS ?result)
  FILTER(! BOUND( ?result ))
}
