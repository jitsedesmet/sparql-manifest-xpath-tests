# QT3 test case K2-NumericDivide-8 of test set op-numeric-divide, which tests the XPath expression
#   -1 div xs:float(0)
# Expecting:
#   <assert-string-value>-INF</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L1098
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( - "1"^^xsd:integer / xsd:float ( "0"^^xsd:integer ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "-INF" ))
}
