# QT3 test case op-numeric-divideusht2args-1 of test set op-numeric-divide, which tests the XPath expression
#   xs:unsignedShort("0") div xs:unsignedShort("44633")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L286
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "0"^^xsd:unsignedShort / "44633"^^xsd:unsignedShort ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "0"^^xsd:integer ) ))
}
