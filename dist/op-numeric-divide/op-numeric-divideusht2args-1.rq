# QT3 test case op-numeric-divideusht2args-1 of test set op-numeric-divide, which tests the XPath expression
#   xs:unsignedShort("0") div xs:unsignedShort("44633")
ASK {
  BIND(( "0"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> / "44633"^^<http://www.w3.org/2001/XMLSchema#unsignedShort> ) AS ?result)
  FILTER(( ?result = "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
