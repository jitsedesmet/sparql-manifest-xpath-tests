# QT3 test case K-NumericDivide-2 of test set op-numeric-divide, which tests the XPath expression
#   xs:decimal(6) div xs:decimal(2) eq 3
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#decimal> ( "6"^^<http://www.w3.org/2001/XMLSchema#integer> ) / <http://www.w3.org/2001/XMLSchema#decimal> ( "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) ) = "3"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
