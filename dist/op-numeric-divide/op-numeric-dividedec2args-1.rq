# QT3 test case op-numeric-dividedec2args-1 of test set op-numeric-divide, which tests the XPath expression
#   xs:decimal("-999999999999999999") div xs:decimal("-999999999999999999")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#decimal> ( "-999999999999999999" ) / <http://www.w3.org/2001/XMLSchema#decimal> ( "-999999999999999999" ) ) AS ?result)
  FILTER(( ?result = "1"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
