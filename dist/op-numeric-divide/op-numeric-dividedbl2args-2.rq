# QT3 test case op-numeric-dividedbl2args-2 of test set op-numeric-divide, which tests the XPath expression
#   xs:double("0") div xs:double("-1.7976931348623157E308")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#double> ( "0" ) / <http://www.w3.org/2001/XMLSchema#double> ( "-1.7976931348623157E308" ) ) AS ?result)
  FILTER(( ?result = - "0"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
