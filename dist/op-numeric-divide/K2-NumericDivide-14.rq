# QT3 test case K2-NumericDivide-14 of test set op-numeric-divide, which tests the XPath expression
#   -3 div +0e0
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L1152
ASK {
  BIND(( - "3"^^<http://www.w3.org/2001/XMLSchema#integer> / + "0e0"^^<http://www.w3.org/2001/XMLSchema#double> ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "-INF" ))
}
