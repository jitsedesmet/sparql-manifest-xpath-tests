# QT3 test case K-NumericDivide-15 of test set op-numeric-divide, which tests the XPath expression
#   5.0 div 2.0 ne 2.6
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L759
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( "5.0"^^xsd:decimal / "2.0"^^xsd:decimal ) != "2.6"^^xsd:decimal ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
