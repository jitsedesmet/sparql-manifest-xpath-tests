# QT3 test case op-numeric-dividenint2args-5 of test set op-numeric-divide, which tests the XPath expression
#   xs:negativeInteger("-999999999999999999") div xs:negativeInteger("-1")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L352
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-999999999999999999"^^xsd:negativeInteger / "-1"^^xsd:negativeInteger ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "999999999999999999"^^xsd:integer ) ))
}
