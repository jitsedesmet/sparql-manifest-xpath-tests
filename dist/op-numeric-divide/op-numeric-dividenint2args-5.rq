# QT3 test case op-numeric-dividenint2args-5 of test set op-numeric-divide, which tests the XPath expression
#   xs:negativeInteger("-999999999999999999") div xs:negativeInteger("-1")
ASK {
  BIND(( "-999999999999999999"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> / "-1"^^<http://www.w3.org/2001/XMLSchema#negativeInteger> ) AS ?result)
  FILTER(( ?result = "999999999999999999"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
