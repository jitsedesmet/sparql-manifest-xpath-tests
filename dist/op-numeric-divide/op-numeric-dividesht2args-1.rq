# QT3 test case op-numeric-dividesht2args-1 of test set op-numeric-divide, which tests the XPath expression
#   xs:short("-32768") div xs:short("-32768")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/numeric-divide.xml#L493
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( "-32768"^^xsd:short / "-32768"^^xsd:short ) AS ?result)
  FILTER(( ISNUMERIC( ?result ) && ( ?result = "1"^^xsd:integer ) ))
}
