# QT3 test case op-numeric-dividesht2args-1 of test set op-numeric-divide, which tests the XPath expression
#   xs:short("-32768") div xs:short("-32768")
ASK {
  BIND(( "-32768"^^<http://www.w3.org/2001/XMLSchema#short> / "-32768"^^<http://www.w3.org/2001/XMLSchema#short> ) AS ?result)
  FILTER(( ?result = "1"^^<http://www.w3.org/2001/XMLSchema#integer> ))
}
