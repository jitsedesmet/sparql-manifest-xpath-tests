# QT3 test case fn-minutes-from-dateTime-17 of test set fn-minutes-from-dateTime, which tests the XPath expression
#   fn:minutes-from-dateTime(xs:dateTime("1970-01-01T10:10:00Z")) ne fn:minutes-from-dateTime(xs:dateTime("1970-01-01T10:10:00Z"))
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/minutes-from-dateTime.xml#L179
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( MINUTES( xsd:dateTime ( "1970-01-01T10:10:00Z" ) ) != MINUTES( xsd:dateTime ( "1970-01-01T10:10:00Z" ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
