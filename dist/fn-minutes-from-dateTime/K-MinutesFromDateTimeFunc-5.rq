# QT3 test case K-MinutesFromDateTimeFunc-5 of test set fn-minutes-from-dateTime, which tests the XPath expression
#   minutes-from-dateTime(xs:dateTime("2001-02-03T08:23:12.43")) eq 23
ASK {
  BIND(( MINUTES( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2001-02-03T08:23:12.43" ) ) = "23"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
