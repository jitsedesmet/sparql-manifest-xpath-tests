# QT3 test case K-MinutesFromDateTimeFunc-5 of test set fn-minutes-from-dateTime, which tests the XPath expression
#   minutes-from-dateTime(xs:dateTime("2001-02-03T08:23:12.43")) eq 23
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/minutes-from-dateTime.xml#L242
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( MINUTES( xsd:dateTime ( "2001-02-03T08:23:12.43" ) ) = "23"^^xsd:integer ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
