# QT3 test case fn-minutes-from-dateTime-10 of test set fn-minutes-from-dateTime, which tests the XPath expression
#   fn:minutes-from-dateTime(xs:dateTime("1970-01-01T02:02:00Z")) * fn:minutes-from-dateTime(xs:dateTime("1970-01-01T10:03:00Z"))
ASK {
  BIND(( MINUTES( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T02:02:00Z" ) ) * MINUTES( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T10:03:00Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "6" ))
}
