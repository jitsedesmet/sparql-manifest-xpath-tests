<#fn-minutes-from-dateTime1args-1> a mf:QueryEvaluationTest ;
  mf:name "fn-minutes-from-dateTime1args-1" ;
  rdfs:comment "Evaluates The \"minutes-from-dateTime\" function with the arguments set as follows: $arg = xs:dateTime(lower bound)" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/fn/minutes-from-dateTime.xml> ;
  mf:action [ qt:query <fn-minutes-from-dateTime1args-1.rq> ] ;
  mf:result <../true.srj> .

