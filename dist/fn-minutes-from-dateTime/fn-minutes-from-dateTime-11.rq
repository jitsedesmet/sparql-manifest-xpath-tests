# QT3 test case fn-minutes-from-dateTime-11 of test set fn-minutes-from-dateTime, which tests the XPath expression
#   fn:minutes-from-dateTime(xs:dateTime("1970-01-01T02:10:00Z")) div fn:minutes-from-dateTime(xs:dateTime("1970-01-01T10:05:00Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/minutes-from-dateTime.xml#L125
ASK {
  BIND(( MINUTES( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T02:10:00Z" ) ) / MINUTES( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T10:05:00Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "2" ))
}
