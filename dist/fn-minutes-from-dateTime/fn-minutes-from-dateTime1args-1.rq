# QT3 test case fn-minutes-from-dateTime1args-1 of test set fn-minutes-from-dateTime, which tests the XPath expression
#   fn:minutes-from-dateTime(xs:dateTime("1970-01-01T00:00:00Z"))
ASK {
  BIND(MINUTES( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T00:00:00Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "0" ))
}
