# QT3 test case fn-minutes-from-dateTime1args-2 of test set fn-minutes-from-dateTime, which tests the XPath expression
#   fn:minutes-from-dateTime(xs:dateTime("1996-04-07T01:40:52Z"))
ASK {
  BIND(MINUTES( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1996-04-07T01:40:52Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "40" ))
}
