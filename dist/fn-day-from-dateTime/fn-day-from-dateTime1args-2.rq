# QT3 test case fn-day-from-dateTime1args-2 of test set fn-day-from-dateTime, which tests the XPath expression
#   fn:day-from-dateTime(xs:dateTime("1996-04-07T01:40:52Z"))
# Expecting:
#   <assert-string-value>7</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/day-from-dateTime.xml#L16
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(DAY( xsd:dateTime ( "1996-04-07T01:40:52Z" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "7" ))
}
