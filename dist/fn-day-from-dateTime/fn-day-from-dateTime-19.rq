# QT3 test case fn-day-from-dateTime-19 of test set fn-day-from-dateTime, which tests the XPath expression
#   fn:day-from-dateTime(xs:dateTime("1971-01-10T10:00:00Z")) ge fn:day-from-dateTime(xs:dateTime("1970-01-11T10:00:00Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/day-from-dateTime.xml#L196
ASK {
  BIND(( DAY( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1971-01-10T10:00:00Z" ) ) >= DAY( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-11T10:00:00Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
