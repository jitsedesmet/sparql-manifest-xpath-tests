# QT3 test case fn-day-from-dateTime-6 of test set fn-day-from-dateTime, which tests the XPath expression
#   fn:day-from-dateTime(xs:dateTime("1999-01-01T00:20:00-05:00"))
# Expecting:
#   <assert-string-value>1</assert-string-value>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/day-from-dateTime.xml#L79
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(DAY( xsd:dateTime ( "1999-01-01T00:20:00-05:00" ) ) AS ?result)
  FILTER(SAMETERM( xsd:string ( ?result ) , "1" ))
}
