# QT3 test case fn-day-from-dateTime-9 of test set fn-day-from-dateTime, which tests the XPath expression
#   fn:day-from-dateTime(xs:dateTime("1970-01-10T00:00:00Z")) - fn:day-from-dateTime(xs:dateTime("1969-01-01T10:00:00Z"))
ASK {
  BIND(( DAY( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-10T00:00:00Z" ) ) - DAY( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1969-01-01T10:00:00Z" ) ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "9" ))
}
