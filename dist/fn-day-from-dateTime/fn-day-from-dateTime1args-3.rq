# QT3 test case fn-day-from-dateTime1args-3 of test set fn-day-from-dateTime, which tests the XPath expression
#   fn:day-from-dateTime(xs:dateTime("2030-12-31T23:59:59Z"))
ASK {
  BIND(DAY( <http://www.w3.org/2001/XMLSchema#dateTime> ( "2030-12-31T23:59:59Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "31" ))
}
