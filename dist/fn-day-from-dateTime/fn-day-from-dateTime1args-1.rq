# QT3 test case fn-day-from-dateTime1args-1 of test set fn-day-from-dateTime, which tests the XPath expression
#   fn:day-from-dateTime(xs:dateTime("1970-01-01T00:00:00Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/day-from-dateTime.xml#L7
ASK {
  BIND(DAY( <http://www.w3.org/2001/XMLSchema#dateTime> ( "1970-01-01T00:00:00Z" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "1" ))
}
