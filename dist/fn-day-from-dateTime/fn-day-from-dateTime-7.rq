# QT3 test case fn-day-from-dateTime-7 of test set fn-day-from-dateTime, which tests the XPath expression
#   fn:day-from-dateTime(xs:dateTime("0001-05-31T23:20:00-05:00"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/fn/day-from-dateTime.xml#L88
ASK {
  BIND(DAY( <http://www.w3.org/2001/XMLSchema#dateTime> ( "0001-05-31T23:20:00-05:00" ) ) AS ?result)
  FILTER(( <http://www.w3.org/2001/XMLSchema#string> ( ?result ) = "31" ))
}
