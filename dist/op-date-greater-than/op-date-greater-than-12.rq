# QT3 test case op-date-greater-than-12 of test set op-date-greater-than, which tests the XPath expression
#   (xs:date("2000-10-25Z") ge xs:date("2000-10-26Z")) or (fn:true())
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-greater-than.xml#L362
# The test needs the constructor function xsd:date, >= on xsd:date, which SPARQL does not define
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "2000-10-25Z" ) >= <http://www.w3.org/2001/XMLSchema#date> ( "2000-10-26Z" ) ) || "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
