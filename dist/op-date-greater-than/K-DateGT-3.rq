# QT3 test case K-DateGT-3 of test set op-date-greater-than, which tests the XPath expression
#   not(xs:date("2004-07-12") gt xs:date("2004-07-13"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-greater-than.xml#L440
# The test needs the constructor function xsd:date, > on xsd:date, which SPARQL does not define
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#date> ( "2004-07-12" ) > <http://www.w3.org/2001/XMLSchema#date> ( "2004-07-13" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
