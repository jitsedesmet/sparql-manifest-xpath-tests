# QT3 test case op-date-greater-than-13 of test set op-date-greater-than, which tests the XPath expression
#   (xs:date("1980-01-01Z") gt xs:date("1980-10-01Z")) or (fn:false())
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-greater-than.xml#L378
# The test needs the constructor function xsd:date, > on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:date ( "1980-01-01Z" ) > xsd:date ( "1980-10-01Z" ) ) || "false"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
