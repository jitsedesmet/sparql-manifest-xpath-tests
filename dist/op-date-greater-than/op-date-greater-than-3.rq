# QT3 test case op-date-greater-than-3 of test set op-date-greater-than, which tests the XPath expression
#   fn:not((xs:date("2005-12-26Z") gt xs:date("2005-12-25Z")))
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-greater-than.xml#L218
# The test needs the constructor function xsd:date, > on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( xsd:date ( "2005-12-26Z" ) > xsd:date ( "2005-12-25Z" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "false" ) ))
}
