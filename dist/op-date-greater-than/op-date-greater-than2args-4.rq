# QT3 test case op-date-greater-than2args-4 of test set op-date-greater-than, which tests the XPath expression
#   xs:date("1970-01-01Z") gt xs:date("1983-11-17Z")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) > <http://www.w3.org/2001/XMLSchema#date> ( "1983-11-17Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
