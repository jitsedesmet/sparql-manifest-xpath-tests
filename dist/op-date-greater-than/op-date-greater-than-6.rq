# QT3 test case op-date-greater-than-6 of test set op-date-greater-than, which tests the XPath expression
#   fn:not(xs:date("2005-10-23Z") ge xs:date("2005-10-25Z"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#date> ( "2005-10-23Z" ) >= <http://www.w3.org/2001/XMLSchema#date> ( "2005-10-25Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
