# QT3 test case op-date-greater-than-14 of test set op-date-greater-than, which tests the XPath expression
#   (xs:date("1980-10-25Z") ge xs:date("1980-10-26Z")) or (fn:false())
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "1980-10-25Z" ) >= <http://www.w3.org/2001/XMLSchema#date> ( "1980-10-26Z" ) ) || "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
