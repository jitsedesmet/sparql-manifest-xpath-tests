# QT3 test case cbcl-date-gt-001 of test set op-date-greater-than, which tests the XPath expression
#   xs:date("25252734927766555-07-28") > xs:date("-25252734927766555-06-07+02:00")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-greater-than.xml#L501
# The test needs the constructor function xsd:date, > on xsd:date, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "25252734927766555-07-28" ) > <http://www.w3.org/2001/XMLSchema#date> ( "-25252734927766555-06-07+02:00" ) ) AS ?result)
  FILTER(( ! BOUND( ?result ) || ( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ) ))
}
