# QT3 test case K-DateGT-6 of test set op-date-greater-than, which tests the XPath expression
#   not(xs:date("2004-07-11") ge xs:date("2004-07-12"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#date> ( "2004-07-11" ) >= <http://www.w3.org/2001/XMLSchema#date> ( "2004-07-12" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
