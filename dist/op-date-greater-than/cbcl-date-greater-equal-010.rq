# QT3 test case cbcl-date-greater-equal-010 of test set op-date-greater-than, which tests the XPath expression
#   xs:date("2008-01-31+09:00") ge xs:date("2008-01-31")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-greater-than.xml#L629
# The test needs the constructor function xsd:date, >= on xsd:date, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "2008-01-31+09:00" ) >= <http://www.w3.org/2001/XMLSchema#date> ( "2008-01-31" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
