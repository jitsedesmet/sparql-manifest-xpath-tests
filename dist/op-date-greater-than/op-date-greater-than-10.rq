# QT3 test case op-date-greater-than-10 of test set op-date-greater-than, which tests the XPath expression
#   (xs:date("1976-10-25Z") ge xs:date("1976-10-28Z")) or (xs:date("1980-08-11Z") ge xs:date("1980-08-10Z"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-greater-than.xml#L330
# The test needs the constructor function xsd:date, >= on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:date ( "1976-10-25Z" ) >= xsd:date ( "1976-10-28Z" ) ) || ( xsd:date ( "1980-08-11Z" ) >= xsd:date ( "1980-08-10Z" ) ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
