# QT3 test case op-date-greater-than-5 of test set op-date-greater-than, which tests the XPath expression
#   fn:not(xs:date("2000-11-09Z") gt xs:date("2000-11-10Z"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#date> ( "2000-11-09Z" ) > <http://www.w3.org/2001/XMLSchema#date> ( "2000-11-10Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
