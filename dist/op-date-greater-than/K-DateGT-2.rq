# QT3 test case K-DateGT-2 of test set op-date-greater-than, which tests the XPath expression
#   not(xs:date("2004-07-12") gt xs:date("2004-07-12"))
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-greater-than.xml#L425
# The test needs the constructor function xsd:date, > on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( xsd:date ( "2004-07-12" ) > xsd:date ( "2004-07-12" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
