# QT3 test case op-date-greater-than-8 of test set op-date-greater-than, which tests the XPath expression
#   (xs:date("2000-01-25Z") ge xs:date("2000-10-26Z")) and (xs:date("1975-10-26Z") ge xs:date("1975-10-28Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-greater-than.xml#L298
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "2000-01-25Z" ) >= <http://www.w3.org/2001/XMLSchema#date> ( "2000-10-26Z" ) ) && ( <http://www.w3.org/2001/XMLSchema#date> ( "1975-10-26Z" ) >= <http://www.w3.org/2001/XMLSchema#date> ( "1975-10-28Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
