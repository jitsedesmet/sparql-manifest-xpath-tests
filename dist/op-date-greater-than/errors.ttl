@prefix dct: <http://purl.org/dc/terms/> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "QT3 test set op-date-greater-than" ;
  dct:license <../LICENSE.txt> ;
  mf:entries (
    <#cbcl-date-gt-001>
  ) .

<#cbcl-date-gt-001> a mf:QueryEvaluationTest ;
  mf:name "cbcl-date-gt-001" ;
  rdfs:comment "Test that comparing large dates does not overflow." ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-greater-than.xml#L501> ;
  mf:action [ qt:query <cbcl-date-gt-001.rq> ] ;
  mf:result <../true.srj> .
