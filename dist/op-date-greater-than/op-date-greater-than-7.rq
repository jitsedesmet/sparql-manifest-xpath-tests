# QT3 test case op-date-greater-than-7 of test set op-date-greater-than, which tests the XPath expression
#   (xs:date("2000-01-01Z") gt xs:date("2000-01-01Z")) and (xs:date("2001-02-02Z") gt xs:date("2001-03-02Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-greater-than.xml#L282
# The test needs the constructor function xsd:date, > on xsd:date, which SPARQL does not define
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "2000-01-01Z" ) > <http://www.w3.org/2001/XMLSchema#date> ( "2000-01-01Z" ) ) && ( <http://www.w3.org/2001/XMLSchema#date> ( "2001-02-02Z" ) > <http://www.w3.org/2001/XMLSchema#date> ( "2001-03-02Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
