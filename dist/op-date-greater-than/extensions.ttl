<#op-date-greater-than2args-1> a mf:QueryEvaluationTest ;
  mf:name "op-date-greater-than2args-1" ;
  rdfs:comment "*******************************************************\nTest: op-date-greater-than2args-1                       \nWritten By: Carmelo Montanez                            \nDate: Tue Apr 12 16:29:07 GMT-05:00 2005                \nPurpose: Evaluates The \"op:date-greater-than\" operator \n with the arguments set as follows:                    \n$arg1 = xs:date(lower bound)                           \n$arg2 = xs:date(lower bound)                           \n*******************************************************" ;
  rdfs:seeAlso <https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-greater-than.xml#L6> ;
  mf:action [ qt:query <op-date-greater-than2args-1.rq> ] ;
  mf:result <../true.srj> .

