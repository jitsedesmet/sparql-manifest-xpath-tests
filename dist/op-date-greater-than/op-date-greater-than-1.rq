# QT3 test case op-date-greater-than-1 of test set op-date-greater-than, which tests the XPath expression
#   (xs:date("2004-12-25Z") gt xs:date("2004-12-25+07:00"))
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "2004-12-25Z" ) > <http://www.w3.org/2001/XMLSchema#date> ( "2004-12-25+07:00" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
