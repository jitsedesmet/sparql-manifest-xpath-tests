# QT3 test case op-date-greater-than-11 of test set op-date-greater-than, which tests the XPath expression
#   (xs:date("1980-05-18Z") gt xs:date("1980-05-17Z")) or (fn:true())
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-greater-than.xml#L346
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "1980-05-18Z" ) > <http://www.w3.org/2001/XMLSchema#date> ( "1980-05-17Z" ) ) || "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
