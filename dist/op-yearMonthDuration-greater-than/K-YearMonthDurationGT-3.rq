# QT3 test case K-YearMonthDurationGT-3 of test set op-yearMonthDuration-greater-than, which tests the XPath expression
#   not(xs:yearMonthDuration("P1999Y10M") gt xs:yearMonthDuration("P1999Y11M"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1999Y10M" ) > <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1999Y11M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
