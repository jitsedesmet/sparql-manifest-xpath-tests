# QT3 test case op-yearMonthDuration-greater-than2args-3 of test set op-yearMonthDuration-greater-than, which tests the XPath expression
#   xs:yearMonthDuration("P2030Y12M") gt xs:yearMonthDuration("P0Y0M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P2030Y12M" ) > <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P0Y0M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
