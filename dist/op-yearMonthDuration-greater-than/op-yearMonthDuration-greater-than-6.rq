# QT3 test case op-yearMonthDuration-greater-than-6 of test set op-yearMonthDuration-greater-than, which tests the XPath expression
#   fn:not(xs:yearMonthDuration("P10Y07M") ge xs:yearMonthDuration("P10Y09M"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P10Y07M" ) >= <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P10Y09M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
