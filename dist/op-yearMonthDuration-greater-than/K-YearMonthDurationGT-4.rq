# QT3 test case K-YearMonthDurationGT-4 of test set op-yearMonthDuration-greater-than, which tests the XPath expression
#   xs:yearMonthDuration("P1999Y11M") ge xs:yearMonthDuration("P1999Y10M")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1999Y11M" ) >= <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1999Y10M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
