# QT3 test case op-yearMonthDuration-greater-than-13 of test set op-yearMonthDuration-greater-than, which tests the XPath expression
#   (xs:yearMonthDuration("P30Y10M") gt xs:yearMonthDuration("P01Y02M")) or (fn:false())
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P30Y10M" ) > <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P01Y02M" ) ) || "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
