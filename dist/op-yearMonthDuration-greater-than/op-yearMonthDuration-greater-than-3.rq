# QT3 test case op-yearMonthDuration-greater-than-3 of test set op-yearMonthDuration-greater-than, which tests the XPath expression
#   fn:not((xs:yearMonthDuration("P20Y123M") gt xs:yearMonthDuration("P20Y11M")))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P20Y123M" ) > <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P20Y11M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
