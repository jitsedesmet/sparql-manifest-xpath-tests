# QT3 test case op-yearMonthDuration-greater-than-10 of test set op-yearMonthDuration-greater-than, which tests the XPath expression
#   (xs:yearMonthDuration("P10Y01M") ge xs:yearMonthDuration("P09Y06M")) or (xs:yearMonthDuration("P15Y01M") ge xs:yearMonthDuration("P02Y04M"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/yearMonthDuration-greater-than.xml#L299
# The test needs the constructor function xsd:yearMonthDuration, >= on xsd:yearMonthDuration, which SPARQL does not define
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P10Y01M" ) >= <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P09Y06M" ) ) || ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P15Y01M" ) >= <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P02Y04M" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
