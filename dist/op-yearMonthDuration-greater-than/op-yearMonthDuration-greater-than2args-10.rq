# QT3 test case op-yearMonthDuration-greater-than2args-10 of test set op-yearMonthDuration-greater-than, which tests the XPath expression
#   xs:yearMonthDuration("P0Y0M") le xs:yearMonthDuration("P2030Y12M")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/yearMonthDuration-greater-than.xml#L169
# The test needs the constructor function xsd:yearMonthDuration, <= on xsd:yearMonthDuration, which SPARQL does not define
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P0Y0M" ) <= <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P2030Y12M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
