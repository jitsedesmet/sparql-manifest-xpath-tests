# QT3 test case K-YearMonthDurationGT-6 of test set op-yearMonthDuration-greater-than, which tests the XPath expression
#   not(xs:yearMonthDuration("P1999Y9M") ge xs:yearMonthDuration("P1999Y10M"))
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1999Y9M" ) >= <http://www.w3.org/2001/XMLSchema#yearMonthDuration> ( "P1999Y10M" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
