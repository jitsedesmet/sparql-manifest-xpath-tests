# QT3 test case op-yearMonthDuration-greater-than-5 of test set op-yearMonthDuration-greater-than, which tests the XPath expression
#   fn:not(xs:yearMonthDuration("P20Y09M") gt xs:yearMonthDuration("P20Y10M"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/yearMonthDuration-greater-than.xml#L219
# The test needs the constructor function xsd:yearMonthDuration, > on xsd:yearMonthDuration, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( xsd:yearMonthDuration ( "P20Y09M" ) > xsd:yearMonthDuration ( "P20Y10M" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
