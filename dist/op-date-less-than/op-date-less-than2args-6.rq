# QT3 test case op-date-less-than2args-6 of test set op-date-less-than, which tests the XPath expression
#   xs:date("1970-01-01Z") ge xs:date("1970-01-01Z")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-less-than.xml#L96
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) >= <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
