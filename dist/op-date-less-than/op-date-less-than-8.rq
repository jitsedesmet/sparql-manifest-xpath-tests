# QT3 test case op-date-less-than-8 of test set op-date-less-than, which tests the XPath expression
#   (xs:date("2000-01-25Z") le xs:date("2000-10-26Z")) and (xs:date("1975-10-26Z") le xs:date("1975-10-28Z"))
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "2000-01-25Z" ) <= <http://www.w3.org/2001/XMLSchema#date> ( "2000-10-26Z" ) ) && ( <http://www.w3.org/2001/XMLSchema#date> ( "1975-10-26Z" ) <= <http://www.w3.org/2001/XMLSchema#date> ( "1975-10-28Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
