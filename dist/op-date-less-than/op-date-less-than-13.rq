# QT3 test case op-date-less-than-13 of test set op-date-less-than, which tests the XPath expression
#   (xs:date("1980-01-01Z") lt xs:date("1980-10-01Z")) or (fn:false())
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "1980-01-01Z" ) < <http://www.w3.org/2001/XMLSchema#date> ( "1980-10-01Z" ) ) || "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
