# QT3 test case cbcl-date-ge-001 of test set op-date-less-than, which tests the XPath expression
#   xs:date("25252734927766555-07-28") >= xs:date("-25252734927766555-06-07+02:00")
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-less-than.xml#L501
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:date ( "25252734927766555-07-28" ) >= xsd:date ( "-25252734927766555-06-07+02:00" ) ) AS ?result)
  FILTER(( ! BOUND( ?result ) || ( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ) ))
}
