<#op-date-less-than2args-1> a mf:QueryEvaluationTest ;
  mf:name "op-date-less-than2args-1" ;
  rdfs:comment "*******************************************************\nTest: op-date-less-than2args-1                          \nWritten By: Carmelo Montanez                            \nDate: Tue Apr 12 16:29:07 GMT-05:00 2005                \nPurpose: Evaluates The \"op:date-less-than\" operator    \n with the arguments set as follows:                    \n$arg1 = xs:date(lower bound)                           \n$arg2 = xs:date(lower bound)                           \n*******************************************************" ;
  rdfs:seeAlso <https://raw.githubusercontent.com/w3c/qt3tests/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-less-than.xml> ;
  mf:action [ qt:query <op-date-less-than2args-1.rq> ] ;
  mf:result <../true.srj> .

