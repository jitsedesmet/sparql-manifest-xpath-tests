# QT3 test case op-date-less-than2args-5 of test set op-date-less-than, which tests the XPath expression
#   xs:date("1970-01-01Z") lt xs:date("2030-12-31Z")
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-less-than.xml#L78
# The test needs the constructor function xsd:date, < on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( xsd:date ( "1970-01-01Z" ) < xsd:date ( "2030-12-31Z" ) ) AS ?result)
  FILTER(( SAMETERM( DATATYPE( ?result ) , xsd:boolean ) && SAMETERM( xsd:string ( ?result ) , "true" ) ))
}
