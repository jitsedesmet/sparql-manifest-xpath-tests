# QT3 test case op-date-less-than2args-5 of test set op-date-less-than, which tests the XPath expression
#   xs:date("1970-01-01Z") lt xs:date("2030-12-31Z")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "1970-01-01Z" ) < <http://www.w3.org/2001/XMLSchema#date> ( "2030-12-31Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
