# QT3 test case op-date-less-than-4 of test set op-date-less-than, which tests the XPath expression
#   fn:not(xs:date("2005-04-02Z") le xs:date("2005-04-02Z"))
# Expecting:
#   <assert-false/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-less-than.xml#L234
# The test needs the constructor function xsd:date, <= on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(! ( xsd:date ( "2005-04-02Z" ) <= xsd:date ( "2005-04-02Z" ) ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "false" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
