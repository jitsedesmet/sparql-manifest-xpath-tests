# QT3 test case op-date-less-than-12 of test set op-date-less-than, which tests the XPath expression
#   (xs:date("2000-10-25Z") le xs:date("2000-10-26Z")) or (fn:true())
# Expecting:
#   <assert-true/>
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-less-than.xml#L362
# The test needs the constructor function xsd:date, <= on xsd:date, which SPARQL does not define
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  BIND(( ( xsd:date ( "2000-10-25Z" ) <= xsd:date ( "2000-10-26Z" ) ) || "true"^^xsd:boolean ) AS ?result)
  FILTER(( SAMETERM( xsd:string ( ?result ) , "true" ) && SAMETERM( DATATYPE( ?result ) , xsd:boolean ) ))
}
