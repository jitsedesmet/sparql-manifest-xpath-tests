# QT3 test case op-date-less-than-11 of test set op-date-less-than, which tests the XPath expression
#   (xs:date("1980-05-18Z") lt xs:date("1980-05-17Z")) or (fn:true())
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "1980-05-18Z" ) < <http://www.w3.org/2001/XMLSchema#date> ( "1980-05-17Z" ) ) || "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
