# QT3 test case op-date-less-than-10 of test set op-date-less-than, which tests the XPath expression
#   (xs:date("1976-10-25Z") le xs:date("1976-10-28Z")) or (xs:date("1980-08-11Z") le xs:date("1980-08-10Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-less-than.xml#L330
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "1976-10-25Z" ) <= <http://www.w3.org/2001/XMLSchema#date> ( "1976-10-28Z" ) ) || ( <http://www.w3.org/2001/XMLSchema#date> ( "1980-08-11Z" ) <= <http://www.w3.org/2001/XMLSchema#date> ( "1980-08-10Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
