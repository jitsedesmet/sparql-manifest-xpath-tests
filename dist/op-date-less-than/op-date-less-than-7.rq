# QT3 test case op-date-less-than-7 of test set op-date-less-than, which tests the XPath expression
#   (xs:date("2000-01-01Z") lt xs:date("2000-01-01Z")) and (xs:date("2001-02-02Z") lt xs:date("2001-03-02Z"))
ASK {
  BIND(( ( <http://www.w3.org/2001/XMLSchema#date> ( "2000-01-01Z" ) < <http://www.w3.org/2001/XMLSchema#date> ( "2000-01-01Z" ) ) && ( <http://www.w3.org/2001/XMLSchema#date> ( "2001-02-02Z" ) < <http://www.w3.org/2001/XMLSchema#date> ( "2001-03-02Z" ) ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ! ?result ))
}
