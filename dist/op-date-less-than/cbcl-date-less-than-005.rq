# QT3 test case cbcl-date-less-than-005 of test set op-date-less-than, which tests the XPath expression
#   xs:date("2008-01-31+09:00") lt xs:date("2008-01-31")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "2008-01-31+09:00" ) < <http://www.w3.org/2001/XMLSchema#date> ( "2008-01-31" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
