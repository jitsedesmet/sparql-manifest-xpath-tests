# QT3 test case K-DateLT-5 of test set op-date-less-than, which tests the XPath expression
#   xs:date("2004-07-12") le xs:date("2004-07-12")
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "2004-07-12" ) <= <http://www.w3.org/2001/XMLSchema#date> ( "2004-07-12" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
