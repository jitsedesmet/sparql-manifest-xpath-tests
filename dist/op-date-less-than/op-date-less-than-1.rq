# QT3 test case op-date-less-than-1 of test set op-date-less-than, which tests the XPath expression
#   (xs:date("2004-12-25Z") lt xs:date("2004-12-25-05:00"))
ASK {
  BIND(( <http://www.w3.org/2001/XMLSchema#date> ( "2004-12-25Z" ) < <http://www.w3.org/2001/XMLSchema#date> ( "2004-12-25-05:00" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
