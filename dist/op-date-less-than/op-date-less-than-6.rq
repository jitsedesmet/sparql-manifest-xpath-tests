# QT3 test case op-date-less-than-6 of test set op-date-less-than, which tests the XPath expression
#   fn:not(xs:date("2005-10-25Z") le xs:date("2005-10-23Z"))
# The test case is defined at https://github.com/w3c/qt3tests/blob/201a6e466940cdfc727f4babfedcde5332b9f578/op/date-less-than.xml#L266
# The test needs the constructor function xsd:date, <= on xsd:date, which SPARQL does not define
ASK {
  BIND(! ( <http://www.w3.org/2001/XMLSchema#date> ( "2005-10-25Z" ) <= <http://www.w3.org/2001/XMLSchema#date> ( "2005-10-23Z" ) ) AS ?result)
  FILTER(( ( DATATYPE( ?result ) = <http://www.w3.org/2001/XMLSchema#boolean> ) && ?result ))
}
